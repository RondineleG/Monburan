# Variáveis de Ambiente para Desenvolvimento
# Copie este arquivo para .env e preencha os valores

# Database Connection Strings (Local Development)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=monburan_dev;Username=postgres;Password=postgres

# SendGrid (Email)
SENDGRID_API_KEY=
SendGRID__FromEmail=noreply@monburan.com
SendGRID__FromName=Monburan

# JWT (obrigatório em produção — a app falha no boot sem ele)
# Gere com: openssl rand -base64 48
JWT_SIGNING_KEY=

# URL pública da app — usada em links de e-mail (confirmação/reset de senha)
# quando a app roda atrás de proxy TLS. Vazio = usa scheme/host da request.
APP_PUBLIC_BASE_URL=https://monburan.com

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# Database (Docker)
DB_PASSWORD=postgres
DB_SERVER=localhost
DB_NAME=monburan
DB_USER=postgres

# Security (Production)
ASPNETCORE_Kestrel__Certificates__Default__Path=
ASPNETCORE_Kestrel__Certificates__Default__Password=

# Docker-specific
# Use uma senha forte para o SQL Server em Docker
# Mínimo 8 caracteres, incluindo maiúsculas, minúsculas, números e caracteres especiais

