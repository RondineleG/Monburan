# Variáveis de Ambiente para Desenvolvimento
# Copie este arquivo para .env e preencha os valores

# Database Connection String (PostgreSQL local)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=monburan_dev;Username=postgres;Password=postgres

# E-mail — opção 1: SMTP (usado em produção com Resend)
# Se SMTP_HOST ficar vazio, o app cai no SendGrid; sem nenhum dos dois, o envio
# é ignorado com LogWarning (OK em desenvolvimento).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@monburan.com.br
SMTP_FROM_NAME=Monburan

# E-mail — opção 2 (fallback quando Smtp:Host está vazio): SendGrid
SENDGRID_API_KEY=
SendGrid__FromEmail=noreply@monburan.com.br
SendGrid__FromName=Monburan

# JWT (OBRIGATÓRIO: a app falha no boot sem ele, e o docker-compose.yml recusa subir —
# até `docker compose up -d postgres` — se esta variável estiver vazia)
# Gere com: openssl rand -base64 48
JWT_SIGNING_KEY=

# URL pública da app — usada em links de e-mail (confirmação/reset de senha)
# quando a app roda atrás de proxy TLS. Vazio = usa scheme/host da request.
APP_PUBLIC_BASE_URL=https://monburan.com.br

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# Database (Docker)
# O compose cria o banco "DB_NAME"; o appsettings.Development.json usa "monburan_dev".
# Para rodar `dotnet run` contra o banco do compose, use DB_NAME=monburan_dev.
DB_PASSWORD=postgres
DB_SERVER=localhost
DB_NAME=monburan
DB_USER=postgres

# Opcionais — lidos pelo docker-compose.yml da raiz (valores abaixo são os padrões do compose)
# E-mails dos administradores (só valem com o e-mail confirmado), separados por vírgula ou ponto e vírgula
# ADMIN_EMAILS=
# 2FA obrigatório para administradores (false só como válvula de emergência)
# REQUIRE_ADMIN_2FA=true
# Hosts aceitos, separados por ; (em produção: monburan.com.br;www.monburan.com.br;127.0.0.1)
# ALLOWED_HOSTS=*

# Migrations no boot (os compose da raiz e o de desenvolvimento NÃO definem; sem isso o banco fica sem esquema).
# Com `dotnet run`: APPLY_MIGRATIONS=true dotnet run --project src/Monburan.Web
# APPLY_MIGRATIONS=true

# Security (Production)
ASPNETCORE_Kestrel__Certificates__Default__Path=
ASPNETCORE_Kestrel__Certificates__Default__Password=

# Docker-specific
# Use uma senha forte para o PostgreSQL em Docker
# Mínimo 8 caracteres, incluindo maiúsculas, minúsculas, números e caracteres especiais
