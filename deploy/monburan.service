[Unit]
Description=Monburan Web App (.NET 10 Blazor)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/monburan
ExecStart=/opt/monburan/Monburan.Web
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_HTTP_PORTS=__APP_PORT__;8080
Environment=APPLY_MIGRATIONS=true
Environment=TZ=America/Sao_Paulo
# Segredos (connection string, JWT key) ficam em arquivo 600, não na unit (0644, legível por todos)
EnvironmentFile=/opt/monburan/monburan.env
Restart=always
RestartSec=5
SyslogIdentifier=monburan
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
