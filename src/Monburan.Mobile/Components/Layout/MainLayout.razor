@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService Auth
@inject TokenService Tokens
@inject MonburanApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IToastService Toast
@inject ILogger<MainLayout> Logger
@inject NotificationBadgeState Badge
@inject Monburan.Mobile.Shared.Features.FeatureFlagsState Features

<div class="app-shell">
    @if (!IsAuthPage)
    {
        <header class="app-header">
            @if (ShowBack)
            {
                @* O iOS não tem botão voltar do sistema: telas internas (vaga, candidatura) precisam de um *@
                <button type="button" class="icon-button app-back" @onclick="GoBackAsync" aria-label="Voltar"><Icon Name="chevron-left" Size="22" /></button>
            }
            <a class="app-brand" href="/" aria-label="Monburan, início">
                <BrandMark />
                <span class="app-brand__name">Monburan</span>
            </a>
            <button type="button" class="icon-button theme-toggle" @onclick="ToggleTheme" aria-label="Tema escuro" aria-pressed="@(_isDark ? "true" : "false")">
                <Icon Name="@(_isDark ? "moon" : "sun")" Size="20" />
            </button>
        </header>
    }

    <main class="app-content @(IsAuthPage ? "no-nav" : "")">
        @Body
    </main>

    @if (!IsAuthPage)
    {
        <BottomNav UnreadCount="_unread" CurrentPath="@CurrentPath" />
    }

    <ToastHost />
</div>

@code {
    private static readonly TimeSpan UnreadTtl = TimeSpan.FromMinutes(1);

    private int _unread;
    private DateTime _lastUnreadFetch = DateTime.MinValue;
    private bool _isDark = true;

    // Destinos da barra inferior não têm "voltar"; as demais telas (detalhe, candidatura, currículos, perfil de carreira, plano) têm
    private bool ShowBack => CurrentPath is not ("/" or "/jobs" or "/applications" or "/notifications" or "/profile");

    private string CurrentPath => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');

    private async Task GoBackAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("history.back");
        }
        catch (JSException)
        {
            Nav.NavigateTo("/");
        }
    }

    private bool IsAuthPage =>
        Nav.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/register", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/forgot-password", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // Aplica o tema salvo (padrão do app: escuro)
        var saved = await JS.InvokeAsync<string>("monburan.getTheme");
        _isDark = saved != "light";
        ApplyTheme();
        
        Auth.Changed += OnAuthChanged;
        Tokens.SessionExpired += OnSessionExpired;
        Nav.LocationChanged += OnLocationChanged;
        Badge.Invalidated += OnBadgeInvalidated;
        try
        {
            await Auth.InitializeAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // A próxima tela tenta de novo (a inicialização que falha não fica guardada)
            Logger.LogError(ex, "Falha inesperada ao carregar a sessão");
        }
        // Visitante também tem flags (as liberadas para todos); com conta, o Auth.Changed recarrega depois de entrar
        await Features.RefreshAsync();
        await RefreshUnreadAsync();
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        ApplyTheme();
        await JS.InvokeVoidAsync("monburan.setTheme", _isDark ? "dark" : "light");
    }

    private void ApplyTheme()
    {
        Monburan.Mobile.Services.NativeTheme.Apply(_isDark);
        _ = JS.InvokeVoidAsync("monburan.applyTheme", _isDark ? "dark" : "light").AsTask();
    }

    private void OnAuthChanged() => InvokeAsync(async () =>
    {
        await RefreshUnreadAsync();
        StateHasChanged();
    });

    // Refresh token rejeitado: a sessão acabou de verdade. Sem isso a tela atual ficava
    // mostrando "Sessão expirada" com "Tentar novamente" em loop.
    private void OnSessionExpired() => InvokeAsync(() =>
    {
        _unread = 0;
        Toast.ShowWarning("Sua sessão expirou. Entre novamente para continuar.");
        if (!IsAuthPage)
        {
            // Volta para a mesma tela depois de entrar de novo
            var current = Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo(string.IsNullOrEmpty(current) ? "/login" : $"/login?returnUrl={Uri.EscapeDataString("/" + current)}");
        }
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(async () =>
        {
            await RefreshUnreadAsync();
            StateHasChanged();
        });

    private void OnBadgeInvalidated() =>
        InvokeAsync(async () =>
        {
            _lastUnreadFetch = DateTime.MinValue;
            await RefreshUnreadAsync();
            StateHasChanged();
        });

    private async Task RefreshUnreadAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            _unread = 0;
            return;
        }

        // Navegação dispara isso a cada rota — TTL evita um GET por troca de página
        if (DateTime.UtcNow - _lastUnreadFetch < UnreadTtl)
            return;

        _lastUnreadFetch = DateTime.UtcNow;
        try
        {
            _unread = await Api.GetUnreadCountAsync();
        }
        catch (ApiException ex)
        {
            // Badge é acessório: offline/erro não interrompe a navegação
            Logger.LogDebug(ex, "Não foi possível atualizar o contador de avisos");
        }
    }

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
        Tokens.SessionExpired -= OnSessionExpired;
        Nav.LocationChanged -= OnLocationChanged;
        Badge.Invalidated -= OnBadgeInvalidated;
    }
}
