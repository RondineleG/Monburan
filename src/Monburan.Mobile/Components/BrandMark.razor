@* Marca da Monburan (a mesma do BrandMark da web): a maleta (trabalho) com o sino no lugar da alça (o chamado) e, recortado no corpo, o Pico:
   o M de montanha que também é uma pessoa de braços erguidos (a vaga conquistada). Os recortes são máscara, então
   mostram o fundo de onde a marca estiver. Decorativa: o nome vai em texto ao lado. Cor em wwwroot/brand.css. *@
<svg class="brand-mark__star brand-mark__icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <defs>
        <mask id="@_mask" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
            <rect width="64" height="64" fill="#fff" />
            <circle cx="32" cy="30" r="3.6" fill="#000" />
            <path d="M17 48.5 L24.5 36 L32 44.5 L39.5 36 L47 48.5" fill="none" stroke="#000" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round" />
        </mask>
    </defs>
    <g class="brand-mark__metal" transform="translate(0 1.5)">
        <g class="brand-mark__bell">
            <rect x="30" y="6" width="4" height="4" rx="1.5" />
            <path d="M32 9 C27 9 24.5 12.5 24.5 17 V19 C24.5 19.8 23.8 20.3 22.5 20.6 H41.5 C40.2 20.3 39.5 19.8 39.5 19 V17 C39.5 12.5 37 9 32 9Z" />
        </g>
        <rect x="5" y="23" width="54" height="32" rx="7" mask="url(#@_mask)" />
    </g>
</svg>

@code {
    // Máscara própria por instância (id repetido some quando a primeira marca da página está escondida)
    private readonly string _mask = "brand-cut-" + Guid.NewGuid().ToString("N")[..8];
}
