@* Marca da Monburan, "O Chamado" (a versão simplificada do BrandMark da web): o sino com a cruz gravada entre duas
   penas que se abrem em M. Decorativa: o nome vai em texto ao lado. Cores em wwwroot/brand.css (tokens --brand-*). *@
<svg class="brand-mark__star brand-mark__icon" viewBox="18 18 164 164" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="@_gradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" class="brand-mark__stop1" /><stop offset=".35" class="brand-mark__stop2" />
            <stop offset=".62" class="brand-mark__stop3" /><stop offset="1" class="brand-mark__stop4" />
        </linearGradient>
    </defs>
    <g transform="translate(74 130) rotate(-30) scale(1.08)">
        <path class="brand-mark__vane" d="M0 -6 C-12 -20 -14 -54 0 -90 C12 -54 11 -20 0 -6 Z" />
        <path class="brand-mark__rachis" stroke-width="3" d="M0 4 L0 -84" />
    </g>
    <g transform="translate(126 130) rotate(30) scale(1.08)">
        <path class="brand-mark__vane" d="M0 -6 C-12 -20 -14 -54 0 -90 C12 -54 11 -20 0 -6 Z" />
        <path class="brand-mark__rachis" stroke-width="3" d="M0 4 L0 -84" />
    </g>
    <g transform="translate(100 98) scale(1.3) translate(-100 -98)">
        <path class="brand-mark__metal-line" stroke-width="4.5" d="M93 68 L93 63 C93 55 107 55 107 63 L107 68" />
        <path fill="url(#@_gradient)" d="M84 75 C84 70 89 68 100 68 C111 68 116 70 116 75 L118 98 C119 110 124 117 133 121 L133 125 L67 125 L67 121 C76 117 81 110 82 98 Z" />
        <path class="brand-mark__engrave" stroke-width="5" stroke-linecap="round" d="M92 90 L108 105 M108 90 L92 105" />
        <circle class="brand-mark__metal" cx="100" cy="134" r="5.5" />
    </g>
</svg>

@code {
    // Degradê próprio por instância (id repetido some quando a primeira marca da página está escondida)
    private readonly string _gradient = "brand-bell-" + Guid.NewGuid().ToString("N")[..8];
}
