<div class="state-box" role="alert">
    <div class="state-icon" aria-hidden="true">@(IsOffline ? "📡" : "⚠")</div>
    <h2 class="state-title">@(IsOffline ? "Sem conexão" : "Algo deu errado")</h2>
    <p>@Message</p>
    @if (OnRetry.HasDelegate)
    {
        <button type="button" class="btn btn-primary" @onclick="OnRetry">Tentar novamente</button>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Não foi possível carregar. Tente novamente.";
    [Parameter] public bool IsOffline { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
