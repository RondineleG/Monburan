@* Estado de erro (mesmo componente da web): explica o que houve e oferece "Tentar novamente". *@
<div class="empty-state error-state" role="alert">
    <div class="empty-state__icon"><Icon Name="alert" Size="24" /></div>
    <h2>@(IsOffline ? "Sem conexão" : "Algo deu errado")</h2>
    <p>@Message</p>
    @if (OnRetry.HasDelegate)
    {
        <div class="empty-state__actions">
            <button type="button" class="btn btn-primary" @onclick="OnRetry"><Icon Name="rotate-ccw" /> Tentar novamente</button>
        </div>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Não foi possível carregar. Tente novamente.";
    [Parameter] public bool IsOffline { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
