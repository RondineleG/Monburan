@* Ícone em SVG inline (traço, 24x24), cópia do componente da web (Monburan.Web/Components/Shared/Icon.razor): mesmos nomes e formas. Decorativo por padrão; com Label vira uma imagem com nome acessível. *@
<svg class="icon@(string.IsNullOrEmpty(Class) ? string.Empty : " " + Class)"
     width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
     focusable="false"
     role="@(string.IsNullOrEmpty(Label) ? null : "img")"
     aria-label="@(string.IsNullOrEmpty(Label) ? null : Label)"
     aria-hidden="@(string.IsNullOrEmpty(Label) ? "true" : null)">@((MarkupString)Shape)</svg>

@code {
    /// <summary>Nome do ícone (chaves de <see cref="Shapes"/>).</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 18;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>Texto acessível; quando omitido o ícone é escondido de leitores de tela.</summary>
    [Parameter]
    public string? Label { get; set; }

    private string Shape => Shapes.GetValueOrDefault(Name, string.Empty);

