@* Campo de senha com botão de mostrar/ocultar. Só alterna o atributo type no próprio DOM do Blazor (sem JS e sem
   chamada ao servidor): custo desprezível e o valor digitado nunca sai do campo. *@
<div class="password-field">
    <input id="@Id" class="input" type="@(_visible ? "text" : "password")" value="@Value"
           @oninput="OnInput" placeholder="@Placeholder" autocomplete="@Autocomplete"
           autocapitalize="none" autocorrect="off" spellcheck="false" />
    <button type="button" class="password-toggle" @onclick="Toggle"
            aria-label="@(_visible ? "Ocultar senha" : "Mostrar senha")" aria-pressed="@(_visible ? "true" : "false")">
        <Icon Name="@(_visible ? "eye-off" : "eye")" Size="20" />
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "current-password";

    private bool _visible;

    private void Toggle() => _visible = !_visible;

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
