@page "/"
@page "/jobs"
@inject MonburanApiClient Api
@inject NavigationManager Nav
@inject IToastService Toast

<h1 class="page-title">Oportunidades</h1>
<p class="page-subtitle">Encontre a vaga ideal para você</p>

<form class="search-row" role="search" @onsubmit="Search">
    <input class="input" type="search" aria-label="Buscar vagas" placeholder="Buscar cargo, empresa..." @bind="_searchTerm" @bind:event="oninput" />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<div class="filter-chips">
    <button type="button" class="filter-chip @(_isRemote == null ? "active" : "")" aria-pressed="@(_isRemote == null ? "true" : "false")" @onclick="() => SetRemote(null)">Todas</button>
    <button type="button" class="filter-chip @(_isRemote == true ? "active" : "")" aria-pressed="@(_isRemote == true ? "true" : "false")" @onclick="() => SetRemote(true)">Remoto</button>
    <button type="button" class="filter-chip @(_isRemote == false ? "active" : "")" aria-pressed="@(_isRemote == false ? "true" : "false")" @onclick="() => SetRemote(false)">Presencial</button>
</div>

@if (_loading)
{
    <LoadingState Message="Buscando vagas..." />
}
else if (_error is not null)
{
    <ErrorState Message="@_error.Message" IsOffline="@_error.IsNetworkError" OnRetry="LoadAsync" />
}
else if (_jobs.Count == 0)
{
    <EmptyState Icon="⌂" Title="Nenhuma vaga encontrada"
                Message="Tente ajustar os filtros ou buscar por outro termo." />
}
else
{
    @foreach (var job in _jobs)
    {
        <a class="card-link" href="/jobs/@job.Id">
            <div class="card">
                <div class="list-row">
                    <h2 class="card-title">@job.Title</h2>
                    @if (job.IsRemote)
                    {
                        <span class="badge gold">Remoto</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(job.AdvertiserName))
                {
                    <div class="text-dim">@job.AdvertiserName</div>
                }
                @if (!string.IsNullOrEmpty(job.Description))
                {
                    <p class="card-snippet">@job.Description</p>
                }
                <div class="card-meta">
                    @if (!string.IsNullOrEmpty(job.City))
                    {
                        <span class="meta-chip"><span aria-hidden="true">📍</span> @job.City@(job.State is not null ? $"/{job.State}" : "")</span>
                    }
                    @if (Formatters.Salary(job) is { } salary)
                    {
                        <span class="salary">@salary</span>
                    }
                    @if (!string.IsNullOrEmpty(job.Category))
                    {
                        <span class="badge">@job.Category</span>
                    }
                </div>
            </div>
        </a>
    }

    @if (_hasMore)
    {
        <button class="btn btn-block" @onclick="LoadMoreAsync" disabled="@_loadingMore">
            @(_loadingMore ? "Carregando..." : "Carregar mais")
        </button>
    }
}

@code {
    private readonly List<JobResponse> _jobs = [];
    private string? _searchTerm;
    private bool? _isRemote;
    private int _page = 1;
    private const int PageSize = 10;
    private bool _hasMore;
    private bool _loading = true;
    private bool _loadingMore;
    private int _loadVersion;
    private ApiException? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // Só a busca mais recente preenche a lista: buscar ou filtrar com a carga anterior
        // ainda em andamento somava as duas respostas (cards duplicados e fora do filtro)
        var version = ++_loadVersion;
        _loading = true;
        _error = null;
        _page = 1;
        _jobs.Clear();

        try
        {
            var result = await Api.GetJobsAsync(BuildRequest(1));
            if (version != _loadVersion)
                return;

            _jobs.AddRange(result.Jobs);
            _hasMore = result.HasNextPage;
        }
        catch (ApiException ex)
        {
            if (version == _loadVersion)
                _error = ex;
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        var version = _loadVersion;
        _loadingMore = true;
        try
        {
            var result = await Api.GetJobsAsync(BuildRequest(_page + 1));
            if (version != _loadVersion)
                return;

            _page++;
            _jobs.AddRange(result.Jobs);
            _hasMore = result.HasNextPage;
        }
        catch (ApiException ex)
        {
            // Mantém as vagas já carregadas; só avisa que a próxima página falhou
            if (version == _loadVersion)
                Toast.ShowError(ex.Message);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private ListJobsRequest BuildRequest(int page) => new()
    {
        Page = page,
        Size = PageSize,
        SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
        IsRemote = _isRemote,
        SortDescending = true
    };

    private Task Search() => LoadAsync();

    private Task SetRemote(bool? value)
    {
        _isRemote = value;
        return LoadAsync();
    }
}
