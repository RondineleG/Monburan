@page "/"
@page "/jobs"
@inject MonburanApiClient Api
@inject NavigationManager Nav
@inject IToastService Toast

<h1 class="page-title" tabindex="-1">Oportunidades</h1>
<p class="page-subtitle">Encontre a vaga ideal para você</p>

<form class="search-row" role="search" @onsubmit="Search">
    <input class="input" type="search" aria-label="Buscar vagas" placeholder="Buscar cargo, empresa…" @bind="_searchTerm" @bind:event="oninput" />
    <button type="submit" class="btn btn-primary"><Icon Name="search" /> Buscar</button>
</form>

@* Modalidade pelo tipo da vaga (Remote/Hybrid/OnSite), como na web: vaga híbrida não entra em "Remoto" *@
<div class="chip-group filter-chips" role="group" aria-label="Modalidade">
    @foreach (var (value, label) in Modes)
    {
        var active = _type == value;
        <button type="button" class="chip@(active ? " is-active" : string.Empty)" aria-pressed="@(active ? "true" : "false")" @onclick="() => SetType(value)">
            @if (value is not null)
            {
                <Icon Name="@Formatters.JobModeIcon(value)" Size="16" />
            }
            @label
        </button>
    }
</div>

@if (_loading)
{
    <LoadingState Message="Buscando vagas…" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error.Message" IsOffline="@_error.IsNetworkError" OnRetry="LoadAsync" />
}
else if (_jobs.Count == 0)
{
    <EmptyState IconName="search" Title="Nenhuma vaga encontrada"
                Message="Tente ajustar os filtros ou buscar por outro termo." />
}
else
{
    @foreach (var job in _jobs)
    {
        var mode = Formatters.JobMode(job);
        <a class="card-link" href="/jobs/@job.Id">
            <div class="card">
                <h2 class="card-title">@job.Title</h2>
                @if (!string.IsNullOrEmpty(job.AdvertiserName))
                {
                    <div class="text-dim">@job.AdvertiserName</div>
                }
                @if (!string.IsNullOrEmpty(job.Description))
                {
                    <p class="card-snippet">@job.Description</p>
                }
                <div class="card-meta">
                    @if (!string.IsNullOrEmpty(job.City))
                    {
                        <span class="meta-chip"><Icon Name="map-pin" Size="16" /> @job.City@(job.State is not null ? $"/{job.State}" : "")</span>
                    }
                    <span class="meta-chip"><Icon Name="@Formatters.JobModeIcon(mode)" Size="16" /> @Formatters.JobType(mode)</span>
                    @if (Formatters.Salary(job) is { } salary)
                    {
                        <span class="meta-chip salary"><Icon Name="banknote" Size="16" /> @salary</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(job.Category))
                {
                    <div class="tag-row"><span class="badge badge--neutral">@job.Category</span></div>
                }
            </div>
        </a>
    }

    @if (_hasMore)
    {
        <button type="button" class="btn btn-secondary btn-block" @onclick="LoadMoreAsync" disabled="@_loadingMore" aria-busy="@(_loadingMore ? "true" : null)">
            @(_loadingMore ? "Carregando…" : "Carregar mais")
        </button>
    }
}

@code {
    private readonly List<JobResponse> _jobs = [];
    private string? _searchTerm;
    private static readonly (string? Value, string Label)[] Modes =
    [
        (null, "Todas"),
        ("Remote", "Remoto"),
        ("Hybrid", "Híbrido"),
        ("OnSite", "Presencial")
    ];

    private string? _type;
    private int _page = 1;
    private const int PageSize = 10;
    private bool _hasMore;
    private bool _loading = true;
    private bool _loadingMore;
    private int _loadVersion;
    private ApiException? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // Só a busca mais recente preenche a lista: buscar ou filtrar com a carga anterior
        // ainda em andamento somava as duas respostas (cards duplicados e fora do filtro)
        var version = ++_loadVersion;
        _loading = true;
        _error = null;
        _page = 1;
        _jobs.Clear();

        try
        {
            var result = await Api.GetJobsAsync(BuildRequest(1));
            if (version != _loadVersion)
                return;

            _jobs.AddRange(result.Jobs);
            _hasMore = result.HasNextPage;
        }
        catch (ApiException ex)
        {
            if (version == _loadVersion)
                _error = ex;
        }
        finally
        {
            if (version == _loadVersion)
                _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        var version = _loadVersion;
        _loadingMore = true;
        try
        {
            var result = await Api.GetJobsAsync(BuildRequest(_page + 1));
            if (version != _loadVersion)
                return;

            _page++;
            _jobs.AddRange(result.Jobs);
            _hasMore = result.HasNextPage;
        }
        catch (ApiException ex)
        {
            // Mantém as vagas já carregadas; só avisa que a próxima página falhou
            if (version == _loadVersion)
                Toast.ShowError(ex.Message);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private ListJobsRequest BuildRequest(int page) => new()
    {
        Page = page,
        Size = PageSize,
        SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
        Type = _type,
        SortDescending = true
    };

    private Task Search() => LoadAsync();

    private Task SetType(string? value)
    {
        _type = value;
        return LoadAsync();
    }
}
