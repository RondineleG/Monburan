@page "/profile"
@inherits ProtectedPage
@inject MonburanApiClient Api
@inject IToastService Toast

<h1 class="page-title" tabindex="-1">Perfil</h1>
<p class="page-subtitle">Seus dados, currículos e preferências</p>

@if (_loading)
{
    <LoadingState Message="Carregando perfil…" />
}
else if (_loadError is not null)
{
    <ErrorState Message="@_loadError.Message" IsOffline="@_loadError.IsNetworkError" OnRetry="LoadAsync" />
}
else if (_candidate is not null)
{
    <div class="card">
        <div class="list-row">
            <div>
                <h2 class="card-title">@_candidate.Name</h2>
                <div class="text-dim">@_candidate.Email</div>
            </div>
            @if (_candidate.IsEmailVerified)
            {
                <span class="badge badge--ok"><Icon Name="check" Size="14" /> E-mail verificado</span>
            }
        </div>
        <div class="card-meta">
            @if (_resumesCount is int resumes)
            {
                <span class="meta-chip"><Icon Name="file" Size="16" /> @resumes @(resumes == 1 ? "currículo" : "currículos")</span>
            }
            @if (_applicationsCount is int applications)
            {
                <span class="meta-chip"><Icon Name="send" Size="16" /> @applications @(applications == 1 ? "candidatura" : "candidaturas")</span>
            }
        </div>
    </div>

    <nav aria-label="Sua conta">
        <ul class="link-list link-list--card">
            <li>
                <a class="link-list__item" href="/career-profile">
                    <Icon Name="briefcase" />
                    <span class="link-list__text">
                        <strong>Perfil de carreira</strong>
                        <small>Cargo, cidade e modalidade que você procura</small>
                    </span>
                    <Icon Name="chevron-right" />
                </a>
            </li>
            <li>
                <a class="link-list__item" href="/resumes">
                    <Icon Name="file" />
                    <span class="link-list__text">
                        <strong>Meus currículos</strong>
                        <small>Crie, edite ou envie em PDF</small>
                    </span>
                    <Icon Name="chevron-right" />
                </a>
            </li>
            <li>
                <a class="link-list__item" href="/plans">
                    <Icon Name="star" />
                    <span class="link-list__text">
                        <strong>Plano</strong>
                        <small>Seu plano e os planos disponíveis</small>
                    </span>
                    <Icon Name="chevron-right" />
                </a>
            </li>
        </ul>
    </nav>

    <h2 class="section-title">Dados pessoais</h2>
    <form class="card" @onsubmit="SaveAsync" novalidate>
        <div class="form-field">
            <label for="profile-name">Nome</label>
            <input id="profile-name" class="input" @bind="_name" autocomplete="name" maxlength="100" />
            @if (_fieldErrors.GetValueOrDefault("name") is { } nameError)
            {
                <div class="field-error">@nameError</div>
            }
        </div>
        <div class="form-field">
            <label for="profile-phone">Telefone</label>
            <input id="profile-phone" class="input" type="tel" @bind="_phone" placeholder="(11) 99999-0000" autocomplete="tel" maxlength="25" />
            @if (_fieldErrors.GetValueOrDefault("phone") is { } phoneError)
            {
                <div class="field-error">@phoneError</div>
            }
        </div>
        <div class="form-field">
            <label for="profile-linkedin">LinkedIn</label>
            <input id="profile-linkedin" class="input" type="url" @bind="_linkedIn" placeholder="https://linkedin.com/in/voce" />
            @if (_fieldErrors.GetValueOrDefault("linkedIn") is { } linkedInError)
            {
                <div class="field-error">@linkedInError</div>
            }
        </div>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
            @(_busy ? "Salvando…" : "Salvar")
        </button>
    </form>
}

@if (!_loading)
{
    @* Fora do bloco do perfil: sair continua possível mesmo quando o carregamento falha *@
    <div class="action-stack page-end">
        <button type="button" class="btn btn-secondary btn-block" @onclick="LogoutAsync"><Icon Name="log-out" /> Sair da conta</button>
    </div>
}

@if (_candidate is not null)
{
    @* Exigência das lojas: a conta pode ser excluída de dentro do app, não só pelo site *@
    <h2 class="section-title">Excluir conta</h2>
    <form class="card" @onsubmit="DeleteAccountAsync" novalidate>
        <p class="text-dim">
            Apaga sua conta e seus dados pessoais (perfil e currículos). Suas candidaturas ficam anônimas no histórico das
            empresas. Não dá para desfazer.
        </p>
        <div class="form-field">
            <label for="delete-password">Sua senha</label>
            <input id="delete-password" class="input" type="password" @bind="_deletePassword" autocomplete="current-password" />
            @if (_deleteError is not null)
            {
                <div class="field-error">@_deleteError</div>
            }
        </div>
        <button type="submit" class="btn btn-danger btn-block" disabled="@_deleting">
            <Icon Name="trash" /> @(_deleting ? "Excluindo…" : "Excluir minha conta")
        </button>
    </form>
}

<ConfirmDialog @ref="_confirm" />

@code {
    private CandidateResponse? _candidate;
    private string _name = "";
    private string? _phone;
    private string? _linkedIn;
    private Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading = true;
    private bool _busy;
    private ApiException? _loadError;
    // Contagens vêm do progresso e da lista de currículos: os campos de contagem de candidates/me chegam zerados
    private int? _resumesCount;
    private int? _applicationsCount;
    private ConfirmDialog _confirm = default!;
    private string _deletePassword = string.Empty;
    private string? _deleteError;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        if (await EnsureAuthenticatedAsync())
            await LoadAsync();
    }

    // Contagem é complemento: se falhar, o perfil continua na tela sem os números
    private async Task LoadCountsAsync()
    {
        try
        {
            var resumes = Api.GetMyResumesAsync();
            var progress = Api.GetMyProgressAsync();
            _resumesCount = (await resumes).Count;
            _applicationsCount = (await progress).Applications.Total;
        }
        catch (ApiException)
        {
            _resumesCount = null;
            _applicationsCount = null;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _candidate = await Api.GetMyCandidateAsync();
            _name = _candidate.Name;
            _phone = _candidate.Phone;
            _linkedIn = _candidate.LinkedIn;
            await LoadCountsAsync();
        }
        catch (ApiException ex)
        {
            _loadError = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_candidate is null || _busy)
            return;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _fieldErrors = new(StringComparer.OrdinalIgnoreCase) { ["name"] = "Informe seu nome." };
            return;
        }

        _busy = true;
        _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
        try
        {
            _candidate = await Api.UpdateMyCandidateAsync(new UpdateCandidateRequest
            {
                Id = _candidate.Id,
                Name = _name.Trim(),
                Phone = _phone,
                DateOfBirth = _candidate.DateOfBirth,
                LinkedIn = _linkedIn
            });
            Toast.ShowSuccess("Seus dados foram atualizados.", "Perfil salvo");
        }
        catch (ApiException ex)
        {
            foreach (var field in new[] { "name", "phone", "linkedIn", "dateOfBirth" })
            {
                if (ex.FieldError(field) is { } message)
                    _fieldErrors[field] = message;
            }

            Toast.ShowError(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAccountAsync()
    {
        if (_deleting)
            return;

        _deleteError = null;
        if (string.IsNullOrEmpty(_deletePassword))
        {
            _deleteError = "Informe sua senha para confirmar.";
            return;
        }

        var confirmed = await _confirm.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir sua conta?",
            Message = "Sua conta e seus dados pessoais serão apagados. Esta ação não pode ser desfeita.",
            ConfirmText = "Excluir conta",
            Destructive = true
        });
        if (!confirmed)
            return;

        _deleting = true;
        try
        {
            await Api.DeleteMyAccountAsync(_deletePassword);
            await Auth.SignOutAsync();
            Toast.ShowSuccess("Sua conta e seus dados pessoais foram excluídos.", "Conta excluída");
            Nav.NavigateTo("/", replace: true);
        }
        catch (ApiException ex)
        {
            _deleteError = ex.FieldError("password") ?? ex.Message;
        }
        finally
        {
            _deletePassword = string.Empty;
            _deleting = false;
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/login");
    }
}
