@page "/profile"
@inherits ProtectedPage
@inject MonburanApiClient Api

<h1 class="page-title">Perfil</h1>
<p class="page-subtitle">Seus dados de candidato</p>

@if (_loading)
{
    <LoadingState Message="Carregando perfil..." />
}
else if (_loadError is not null)
{
    <ErrorState Message="@_loadError.Message" IsOffline="@_loadError.IsNetworkError" OnRetry="LoadAsync" />
}
else if (_candidate is not null)
{
    @if (_message is not null)
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-ok")">@_message</div>
    }

    <div class="card">
        <div class="list-row">
            <div>
                <h2 class="card-title">@_candidate.Name</h2>
                <div class="text-dim">@_candidate.Email</div>
            </div>
            @if (_candidate.IsEmailVerified)
            {
                <span class="badge ok">E-mail verificado</span>
            }
        </div>
        <div class="card-meta">
            <span class="meta-chip">@_candidate.ResumesCount currículo(s)</span>
            <span class="meta-chip">@_candidate.ApplicationsCount candidatura(s)</span>
        </div>
    </div>

    <h2 class="section-label">Editar dados</h2>
    <div class="card">
        <div class="form-field">
            <label>Nome</label>
            <input class="input" @bind="_name" />
        </div>
        <div class="form-field">
            <label>Telefone</label>
            <input class="input" type="tel" @bind="_phone" placeholder="(11) 99999-0000" />
        </div>
        <div class="form-field">
            <label>LinkedIn</label>
            <input class="input" @bind="_linkedIn" placeholder="https://linkedin.com/in/voce" />
        </div>
        <button class="btn btn-primary btn-block" @onclick="SaveAsync" disabled="@_busy">
            @(_busy ? "Salvando..." : "Salvar")
        </button>
    </div>

    <a class="btn btn-block" href="/resumes" style="margin-bottom: var(--s-3)">Meus currículos</a>
    <button class="btn btn-ghost btn-block" @onclick="LogoutAsync">Sair da conta</button>
}

@code {
    private CandidateResponse? _candidate;
    private string _name = "";
    private string? _phone;
    private string? _linkedIn;
    private string? _message;
    private bool _messageIsError;
    private bool _loading = true;
    private bool _busy;
    private ApiException? _loadError;

    protected override async Task OnInitializedAsync()
    {
        if (await EnsureAuthenticatedAsync())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _candidate = await Api.GetMyCandidateAsync();
            _name = _candidate.Name;
            _phone = _candidate.Phone;
            _linkedIn = _candidate.LinkedIn;
        }
        catch (ApiException ex)
        {
            _loadError = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_candidate is null)
            return;

        _busy = true;
        _message = null;
        try
        {
            _candidate = await Api.UpdateMyCandidateAsync(new UpdateCandidateRequest
            {
                Id = _candidate.Id,
                Name = _name.Trim(),
                Phone = _phone,
                DateOfBirth = _candidate.DateOfBirth,
                LinkedIn = _linkedIn
            });
            _message = "Perfil atualizado!";
            _messageIsError = false;
        }
        catch (ApiException ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/login");
    }
}
