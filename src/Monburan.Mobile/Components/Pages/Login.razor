@page "/login"
@inject AuthApiClient AuthApi
@inject AuthStateService Auth
@inject NavigationManager Nav

<div class="auth-hero">
    <div class="brand-mark">RECRUI<em>VA</em></div>
    <p>Encontre a sua próxima oportunidade</p>
</div>

<h1 class="page-title">Entrar</h1>
<p class="page-subtitle">Acesse sua conta de candidato</p>

@if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

<div class="form-field">
    <label>E-mail</label>
    <input class="input" type="email" @bind="_email" placeholder="voce@email.com" autocomplete="email" />
</div>

<div class="form-field">
    <label>Senha</label>
    <input class="input" type="password" @bind="_password" placeholder="••••••••" autocomplete="current-password" />
</div>

<button class="btn btn-primary btn-block" @onclick="DoLogin" disabled="@_busy">
    @(_busy ? "Entrando..." : "Entrar")
</button>

<div class="auth-links">
    <p><a href="/forgot-password">Esqueci a senha</a></p>
    <p>Não tem conta? <a href="/register">Criar conta</a></p>
    <p><a href="/">Ver vagas sem entrar</a></p>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/");
    }

    private async Task DoLogin()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Informe e-mail e senha.";
            return;
        }

        _busy = true;
        try
        {
            var tokens = await AuthApi.LoginAsync(_email.Trim(), _password);
            await Auth.SignInAsync(tokens);
            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            _error = ex.IsNetworkError
                ? ex.Message
                : ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "E-mail ou senha incorretos."
                    : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
