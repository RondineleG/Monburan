@page "/login"
@inject AuthApiClient AuthApi
@inject AuthStateService Auth
@inject NavigationManager Nav

<div class="auth-hero">
    <div class="brand-mark"><BrandMark /><span>Monburan</span></div>
    <p class="auth-tagline">palavra dada.</p>
    <p>Encontre a sua próxima oportunidade</p>
</div>

<h1 class="page-title" tabindex="-1">Entrar</h1>
<p class="page-subtitle">Acesse sua conta de candidato</p>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@* <form> permite enviar pelo "Ir" do teclado do celular *@
<form @onsubmit="DoLogin" novalidate>
    <div class="form-field">
        <label for="login-email">E-mail</label>
        <input id="login-email" class="input" type="email" @bind="_email" placeholder="voce@email.com" autocomplete="email" inputmode="email" />
    </div>

    <div class="form-field">
        <label for="login-password">Senha</label>
        <input id="login-password" class="input" type="password" @bind="_password" placeholder="••••••••" autocomplete="current-password" />
    </div>

    <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
        @(_busy ? "Entrando…" : "Entrar")
    </button>
</form>

<div class="auth-links">
    <p><a href="/forgot-password">Esqueci a senha</a></p>
    <p>Não tem conta? <a href="/register">Criar conta</a></p>
    <p><a href="/jobs">Ver vagas sem entrar</a></p>
</div>

@code {
    /// <summary>Página que pediu o login (ProtectedPage); só caminhos internos são aceitos.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (Auth.IsAuthenticated)
            Nav.NavigateTo(SafeReturnUrl, replace: true);
    }

    private async Task DoLogin()
    {
        if (_busy)
            return;

        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Informe e-mail e senha.";
            return;
        }

        _busy = true;
        try
        {
            var tokens = await AuthApi.LoginAsync(_email.Trim(), _password);
            await Auth.SignInAsync(tokens);
            Nav.NavigateTo(SafeReturnUrl, replace: true);
        }
        catch (ApiException ex)
        {
            // O servidor explica a recusa (senha errada, conta bloqueada por tentativas ou inativa, verificação em duas
            // etapas ligada): mostra o motivo dele. Só um 401 sem explicação vira a mensagem padrão
            _error = ex.IsUnauthorized && ex.Message == ApiException.SessionExpiredMessage
                ? "E-mail ou senha incorretos."
                : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // Endereço externo ("//site", "https:") nunca: evita redirecionamento aberto
    private string SafeReturnUrl =>
        ReturnUrl is { Length: > 1 } url && url.StartsWith('/') && !url.StartsWith("//") && !url.Contains(':') && !url.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            ? url
            : "/";
}
