@page "/resumes"
@inherits ProtectedPage
@inject MonburanApiClient Api
@inject IToastService Toast
@inject ILogger<Resumes> Logger

<h1 class="page-title" tabindex="-1">Meus currículos</h1>
<p class="page-subtitle">Envie um PDF ou cadastre seu currículo</p>

<div class="card">
    <div class="list-row">
        <div>
            <h2 class="card-title">Enviar PDF</h2>
            <div class="text-dim">PDF até 10MB — vira um currículo na sua lista</div>
        </div>
        <button type="button" class="btn btn-secondary" @onclick="PickAndUploadAsync" disabled="@_uploading" aria-busy="@(_uploading ? "true" : null)">
            <Icon Name="upload" /> @(_uploading ? "Enviando…" : "Escolher arquivo")
        </button>
    </div>
</div>

<h2 class="section-title">Novo currículo</h2>
<form class="card" @onsubmit="CreateAsync" novalidate>
    <div class="form-field">
        <label for="resume-title">Título</label>
        <input id="resume-title" class="input" @bind="_newTitle" placeholder="Ex.: Currículo Dev .NET" maxlength="200" />
        @if (_titleError is not null)
        {
            <div class="field-error">@_titleError</div>
        }
    </div>
    <div class="form-field">
        <label for="resume-summary">Resumo</label>
        <textarea id="resume-summary" class="input" @bind="_newSummary" placeholder="Breve resumo profissional" maxlength="2000"></textarea>
    </div>
    <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
        @(_busy ? "Salvando…" : "Salvar currículo")
    </button>
</form>

<h2 class="section-title">Cadastrados</h2>

@if (_loading)
{
    <LoadingState Message="Carregando currículos…" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error.Message" IsOffline="@_error.IsNetworkError" OnRetry="LoadAsync" />
}
else if (_items.Count == 0)
{
    <EmptyState IconName="file" Compact="true" Title="Nenhum currículo" Message="Envie um PDF ou crie um currículo acima." />
}
else
{
    @foreach (var r in _items)
    {
        <div class="card">
            <div class="list-row">
                <div>
                    <h2 class="card-title">@r.Title</h2>
                    <div class="text-dim">@Formatters.MomentDate(r.CreatedAt)</div>
                </div>
                <div class="tag-row">
                    @if (r.IsActive)
                    {
                        <span class="badge badge--ok">Ativo</span>
                    }
                    <button type="button" class="btn btn-danger" @onclick="() => DeleteAsync(r)" disabled="@(_deletingId == r.Id)" aria-label="@($"Excluir o currículo {r.Title}")">
                        <Icon Name="trash" /> @(_deletingId == r.Id ? "Excluindo…" : "Excluir")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(r.Summary))
            {
                <p class="card-snippet">@r.Summary</p>
            }
        </div>
    }
}

<ConfirmDialog @ref="_confirm" />

@code {
    private const long MaxPdfBytes = 10 * 1024 * 1024;

    private List<ResumeResponse> _items = [];
    private string _newTitle = "";
    private string? _newSummary;
    private string? _titleError;
    private Guid? _deletingId;
    private ConfirmDialog _confirm = default!;
    private bool _loading = true;
    private bool _busy;
    private bool _uploading;
    private ApiException? _error;

    protected override async Task OnInitializedAsync()
    {
        if (await EnsureAuthenticatedAsync())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Api.GetMyResumesAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (_busy)
            return;

        _titleError = null;
        if (string.IsNullOrWhiteSpace(_newTitle))
        {
            _titleError = "Informe um título para o currículo.";
            return;
        }

        _busy = true;
        try
        {
            await Api.CreateResumeAsync(new CreateResumeRequest
            {
                Title = _newTitle.Trim(),
                Summary = _newSummary,
                IsActive = true
            });
            _newTitle = "";
            _newSummary = null;
            Toast.ShowSuccess("Currículo criado!");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _titleError = ex.FieldError("title");
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PickAndUploadAsync()
    {
        _uploading = true;
        try
        {
            var picked = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Selecione seu currículo em PDF",
                FileTypes = FilePickerFileType.Pdf
            });

            if (picked is null)
                return;

            if (!picked.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                Toast.ShowError("Selecione um arquivo PDF.");
                return;
            }

            await using var stream = await picked.OpenReadAsync();
            if (stream.CanSeek && stream.Length > MaxPdfBytes)
            {
                // O servidor recusa acima de 10 MB: avisa antes de gastar os dados da pessoa subindo o arquivo inteiro
                Toast.ShowError("O PDF pode ter no máximo 10 MB.");
                return;
            }

            var upload = await Api.UploadPdfAsync(stream, picked.FileName);

            // Espelha o comportamento do site: o PDF vira um currículo na lista
            var title = Path.GetFileNameWithoutExtension(picked.FileName);
            await Api.CreateResumeAsync(new CreateResumeRequest
            {
                Title = string.IsNullOrWhiteSpace(title) ? "Currículo enviado" : title,
                Summary = $"Currículo importado de PDF.\nArquivo: {upload.FileUrl}",
                IsActive = false
            });

            Toast.ShowSuccess("Currículo enviado e adicionado à sua lista!");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Seletor de arquivos e leitura do PDF (permissão negada, arquivo da nuvem indisponível) não são ApiException
            Logger.LogWarning(ex, "Não foi possível ler o PDF escolhido");
            Toast.ShowError("Não foi possível abrir o arquivo escolhido. Tente outro PDF.");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeleteAsync(ResumeResponse resume)
    {
        // Antes excluía direto, sem confirmação
        var confirmed = await _confirm.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir currículo?",
            Message = $"\"{resume.Title}\" será removido e não poderá mais ser enviado em candidaturas.",
            ConfirmText = "Excluir currículo",
            Destructive = true
        });
        if (!confirmed)
            return;

        _deletingId = resume.Id;
        try
        {
            await Api.DeleteResumeAsync(resume.Id);
            _items.Remove(resume);
            Toast.ShowSuccess("Currículo excluído.");
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _deletingId = null;
        }
    }
}
