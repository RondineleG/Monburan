@page "/resumes"
@inherits ProtectedPage
@inject MonburanApiClient Api
@inject IToastService Toast
@inject ILogger<Resumes> Logger

<h1 class="page-title" tabindex="-1">Meus currículos</h1>
<p class="page-subtitle">Crie seu currículo no app ou envie um PDF</p>

<div class="action-stack">
    <a class="btn btn-primary btn-block" href="/resumes/new"><Icon Name="plus" /> Criar currículo</a>
</div>

<div class="card upload-card">
    <div class="list-row">
        <div>
            <h2 class="card-title">Enviar PDF</h2>
            <div class="text-dim">PDF até 10 MB — vira um currículo na sua lista</div>
        </div>
        <button type="button" class="btn btn-secondary" @onclick="PickAndUploadAsync" disabled="@_uploading" aria-busy="@(_uploading ? "true" : null)">
            <Icon Name="upload" /> @(_uploading ? "Enviando…" : "Escolher arquivo")
        </button>
    </div>
</div>

<h2 class="section-title">Cadastrados</h2>

@if (_loading)
{
    <LoadingState Message="Carregando currículos…" />
}
else if (_error is not null)
{
    <ErrorState Message="@_error.Message" IsOffline="@_error.IsNetworkError" OnRetry="LoadAsync" />
}
else if (_items.Count == 0)
{
    <EmptyState IconName="file" Compact="true" Title="Nenhum currículo" Message="Crie um currículo ou envie um PDF para se candidatar mais rápido." />
}
else
{
    @foreach (var r in _items)
    {
        <a class="card-link" href="/resumes/@r.Id" @key="r.Id">
            <div class="card">
                <div class="list-row">
                    <div>
                        <h3 class="card-title">@r.Title</h3>
                        <div class="text-dim">Atualizado em @Formatters.MomentDate(r.UpdatedAt ?? r.CreatedAt)</div>
                    </div>
                    <span class="badge badge--@(r.IsActive ? "ok" : "neutral")">@(r.IsActive ? "Ativo" : "Inativo")</span>
                </div>
                @if (!string.IsNullOrEmpty(r.Summary))
                {
                    <p class="card-snippet">@r.Summary</p>
                }
            </div>
        </a>
    }
}

@code {
    private const long MaxPdfBytes = 10 * 1024 * 1024;

    private List<ResumeResponse> _items = [];
    private bool _loading = true;
    private bool _uploading;
    private ApiException? _error;

    protected override async Task OnInitializedAsync()
    {
        if (await EnsureAuthenticatedAsync())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Api.GetMyResumesAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PickAndUploadAsync()
    {
        _uploading = true;
        try
        {
            var picked = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Selecione seu currículo em PDF",
                FileTypes = FilePickerFileType.Pdf
            });

            if (picked is null)
                return;

            if (!picked.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                Toast.ShowError("Selecione um arquivo PDF.");
                return;
            }

            await using var stream = await picked.OpenReadAsync();
            if (stream.CanSeek && stream.Length > MaxPdfBytes)
            {
                // O servidor recusa acima de 10 MB: avisa antes de gastar os dados da pessoa subindo o arquivo inteiro
                Toast.ShowError("O PDF pode ter no máximo 10 MB.");
                return;
            }

            var upload = await Api.UploadPdfAsync(stream, picked.FileName);

            // Espelha o comportamento do site: o PDF vira um currículo na lista
            var title = Path.GetFileNameWithoutExtension(picked.FileName);
            await Api.CreateResumeAsync(new CreateResumeRequest
            {
                Title = string.IsNullOrWhiteSpace(title) ? "Currículo enviado" : title,
                Summary = $"Currículo importado de PDF.\nArquivo: {upload.FileUrl}",
                IsActive = false
            });

            Toast.ShowSuccess("Currículo enviado e adicionado à sua lista!");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Seletor de arquivos e leitura do PDF (permissão negada, arquivo da nuvem indisponível) não são ApiException
            Logger.LogWarning(ex, "Não foi possível ler o PDF escolhido");
            Toast.ShowError("Não foi possível abrir o arquivo escolhido. Tente outro PDF.");
        }
        finally
        {
            _uploading = false;
        }
    }
}
