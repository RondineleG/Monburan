@page "/notifications"
@inherits ProtectedPage
@inject MonburanApiClient Api
@inject IToastService Toast
@inject NotificationBadgeState Badge

<h1 class="page-title">Avisos</h1>
<p class="page-subtitle">Notificações sobre suas candidaturas</p>

@if (_loading)
{
    <LoadingState Message="Carregando avisos..." />
}
else if (_error is not null)
{
    <ErrorState Message="@_error.Message" IsOffline="@_error.IsNetworkError" OnRetry="LoadAsync" />
}
else if (_items.Count == 0)
{
    <EmptyState Icon="◈" Title="Nenhum aviso" Message="Quando houver novidades sobre suas candidaturas, elas aparecem aqui.">
        <a class="btn btn-primary" href="/">Ver vagas</a>
    </EmptyState>
}
else
{
    @if (_items.Any(n => !n.IsRead))
    {
        <button class="btn btn-block" @onclick="MarkAllAsync" disabled="@_markingAll" style="margin-bottom: var(--s-3)">
            @(_markingAll ? "Marcando..." : "Marcar todos como lidos")
        </button>
    }

    @foreach (var n in _items)
    {
        @* Enter também marca como lida: o cartão recebe foco pelo teclado, então precisa responder a ele *@
        <div class="card @(n.IsRead ? "" : "notification-unread")" role="button" tabindex="0" @onclick="() => MarkRead(n)"
             @onkeydown="@(e => e.Key == "Enter" ? MarkRead(n) : Task.CompletedTask)">
            <div class="list-row">
                <h2 class="card-title">@n.Title</h2>
                @if (!n.IsRead)
                {
                    <span class="badge gold">Novo</span>
                }
            </div>
            <p class="card-snippet">@n.Message</p>
            <div class="card-meta">
                <span class="text-dim">@Formatters.Moment(n.CreatedAt)</span>
            </div>
        </div>
    }
}

@code {
    private List<NotificationResponse> _items = [];
    private bool _loading = true;
    private bool _markingAll;
    private ApiException? _error;

    protected override async Task OnInitializedAsync()
    {
        if (await EnsureAuthenticatedAsync())
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Api.GetMyNotificationsAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task MarkRead(NotificationResponse n)
    {
        if (n.IsRead)
            return;

        try
        {
            await Api.MarkNotificationAsReadAsync(n.Id);
            n.IsRead = true;
            n.ReadAt = DateTime.UtcNow;
            Badge.Invalidate();
        }
        catch (ApiException ex)
        {
            // Antes a falha era silenciosa e o aviso continuava "Novo" sem explicação
            Toast.ShowError(ex.Message);
        }
    }

    private async Task MarkAllAsync()
    {
        if (_markingAll)
            return;

        _markingAll = true;
        try
        {
            await Api.MarkAllNotificationsAsReadAsync();
            var now = DateTime.UtcNow;
            foreach (var n in _items.Where(n => !n.IsRead))
            {
                n.IsRead = true;
                n.ReadAt = now;
            }

            Badge.Invalidate();
            Toast.ShowSuccess("Todos os avisos foram marcados como lidos.");
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _markingAll = false;
        }
    }
}
