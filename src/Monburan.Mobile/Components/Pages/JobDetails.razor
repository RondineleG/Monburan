@page "/jobs/{Id:guid}"
@inject MonburanApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject ILogger<JobDetails> Logger

@if (_loading)
{
    <LoadingState Message="Carregando vaga…" />
}
else if (_error is not null)
{
    @if (_error.StatusCode == System.Net.HttpStatusCode.NotFound)
    {
        <EmptyState IconName="search" HeadingLevel="1" Title="Vaga não encontrada" Message="Ela pode ter sido encerrada ou removida pela empresa.">
            <a class="btn btn-primary" href="/">Ver vagas abertas</a>
        </EmptyState>
    }
    else
    {
        <ErrorState Message="@_error.Message" IsOffline="@_error.IsNetworkError" OnRetry="LoadAsync" />
    }
}
else if (_job is not null)
{
    var mode = Formatters.JobMode(_job);
    <div class="detail-hero">
        <h1 tabindex="-1">@_job.Title</h1>
        @if (!string.IsNullOrEmpty(_job.AdvertiserName))
        {
            <div class="text-dim">@_job.AdvertiserName</div>
        }
        <div class="card-meta">
            @if (!string.IsNullOrEmpty(_job.City))
            {
                <span class="meta-chip"><Icon Name="map-pin" Size="16" /> @_job.City@(_job.State is not null ? $"/{_job.State}" : "")</span>
            }
            <span class="meta-chip"><Icon Name="@Formatters.JobModeIcon(mode)" Size="16" /> @Formatters.JobType(mode)</span>
            @if (Formatters.Salary(_job) is { } salary)
            {
                <span class="meta-chip salary"><Icon Name="banknote" Size="16" /> @salary</span>
            }
            <span class="meta-chip"><Icon Name="calendar" Size="16" /> Até @Formatters.CalendarDate(_job.ExpirationDate)</span>
        </div>
        @if (!string.IsNullOrEmpty(_job.Category))
        {
            <div class="tag-row"><span class="badge badge--neutral">@_job.Category</span></div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_job.Description))
    {
        <div class="detail-section">
            <h2>Sobre a vaga</h2>
            <p class="body-text">@_job.Description</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_job.Requirements))
    {
        <div class="detail-section">
            <h2>Requisitos</h2>
            <p class="body-text">@_job.Requirements</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_job.Responsibilities))
    {
        <div class="detail-section">
            <h2>Responsabilidades</h2>
            <p class="body-text">@_job.Responsibilities</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_job.Benefits))
    {
        <div class="detail-section">
            <h2>Benefícios</h2>
            <p class="body-text">@_job.Benefits</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_job.ApplicationInstructions))
    {
        <div class="detail-section">
            <h2>Como se candidatar</h2>
            <p class="body-text">@_job.ApplicationInstructions</p>
        </div>
    }

    <div class="alert alert-info">Nunca pague para participar de um processo seletivo nem envie dados bancários por canais desconhecidos.</div>

    @if (_alreadyApplied)
    {
        <div class="alert alert-success" role="status">Você já se candidatou a esta vaga.</div>
        <a class="btn btn-secondary btn-block" href="/applications">Ver minhas candidaturas</a>
    }
    else if (_job.Status != "Active")
    {
        <div class="alert alert-info">Esta vaga não está mais recebendo candidaturas.</div>
        <a class="btn btn-secondary btn-block" href="/">Ver outras vagas</a>
    }
    else
    {
        <button type="button" class="btn btn-primary btn-block" @onclick="Apply">
            Candidatar-se
        </button>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private JobResponse? _job;
    private bool _loading = true;
    private bool _alreadyApplied;
    private ApiException? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _job = await Api.GetJobAsync(Id);
            await CheckAlreadyAppliedAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
        }
        finally
        {
            _loading = false;
        }
    }

    // Evita o candidato descobrir só no envio (409) que já está no processo
    private async Task CheckAlreadyAppliedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAuthenticated)
            return;

        try
        {
            var applications = await Api.GetMyApplicationsAsync();
            _alreadyApplied = applications.Any(a => a.JobId == Id);
        }
        catch (ApiException ex)
        {
            // Informativo: se falhar, o envio ainda é validado no servidor (409)
            Logger.LogDebug(ex, "Não foi possível verificar candidaturas existentes");
            _alreadyApplied = false;
        }
    }

    private async Task Apply()
    {
        await Auth.InitializeAsync();
        Nav.NavigateTo(Auth.IsAuthenticated ? $"/apply/{Id}" : "/login");
    }
}
