@page "/forgot-password"
@inject AuthApiClient AuthApi

<div class="auth-hero">
    <div class="brand-mark">RECRUI<em>VA</em></div>
    <p>Recuperar acesso à conta</p>
</div>

<h1 class="page-title">Esqueci a senha</h1>
<p class="page-subtitle">Enviaremos um link de redefinição para o seu e-mail</p>

@if (_sent)
{
    <div class="state-box">
        <div class="state-icon">✓</div>
        <div class="state-title">Verifique seu e-mail</div>
        <p>Se existir uma conta com esse endereço, você receberá o link de redefinição.
           A redefinição é concluída no site.</p>
        <a class="btn btn-primary btn-block" href="/login">Voltar ao login</a>
    </div>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-error">@_error</div>
    }

    <div class="form-field">
        <label>E-mail</label>
        <input class="input" type="email" @bind="_email" placeholder="voce@email.com" autocomplete="email" />
    </div>

    <button class="btn btn-primary btn-block" @onclick="Submit" disabled="@_busy">
        @(_busy ? "Enviando..." : "Enviar link")
    </button>

    <div class="auth-links">
        <p><a href="/login">Voltar ao login</a></p>
    </div>
}

@code {
    private string _email = "";
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _error = "Informe um e-mail válido.";
            return;
        }

        _busy = true;
        try
        {
            await AuthApi.ForgotPasswordAsync(_email.Trim());
            _sent = true;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
