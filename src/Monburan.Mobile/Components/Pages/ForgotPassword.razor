@page "/forgot-password"
@inject AuthApiClient AuthApi

<div class="auth-hero">
    <div class="brand-mark"><BrandMark /><span>Monburan</span></div>
    <p>Recuperar acesso à conta</p>
</div>

<h1 class="page-title" tabindex="-1">Esqueci a senha</h1>
<p class="page-subtitle">Enviaremos um link de redefinição para o seu e-mail</p>

@if (_sent)
{
    <div role="status">
        <EmptyState IconName="message" Title="Verifique seu e-mail"
                    Message="Se existir uma conta com esse endereço, você receberá o link de redefinição. A redefinição é concluída no site.">
            <a class="btn btn-primary" href="/login">Voltar ao login</a>
        </EmptyState>
    </div>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <form @onsubmit="Submit" novalidate>
        <div class="form-field">
            <label for="forgot-email">E-mail</label>
            <input id="forgot-email" class="input" type="email" @bind="_email" placeholder="voce@email.com" autocomplete="email" inputmode="email" />
        </div>

        <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
            @(_busy ? "Enviando…" : "Enviar link")
        </button>
    </form>

    <div class="auth-links">
        <p><a href="/login">Voltar ao login</a></p>
    </div>
}

@code {
    private string _email = "";
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task Submit()
    {
        if (_busy)
            return;

        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _error = "Informe um e-mail válido.";
            return;
        }

        _busy = true;
        try
        {
            await AuthApi.ForgotPasswordAsync(_email.Trim());
            _sent = true;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
