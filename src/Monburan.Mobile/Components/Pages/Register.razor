@page "/register"
@using Monburan.Core.Validations
@inject AuthApiClient AuthApi
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject IToastService Toast

<div class="auth-hero">
    <div class="brand-mark"><BrandMark /><span>Monburan</span></div>
    <p class="auth-tagline">palavra dada.</p>
    <p>Crie sua conta de candidato</p>
</div>

<h1 class="page-title" tabindex="-1">Criar conta</h1>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<form @onsubmit="DoRegister" novalidate>
    <div class="form-field">
        <label for="register-name">Nome completo</label>
        <input id="register-name" class="input" @bind="_name" placeholder="Seu nome" autocomplete="name" />
        @if (FieldError("name") is { } nameError)
        {
            <div class="field-error">@nameError</div>
        }
    </div>

    <div class="form-field">
        <label for="register-email">E-mail</label>
        <input id="register-email" class="input" type="email" @bind="_email" placeholder="voce@email.com" autocomplete="email" inputmode="email" />
        @if (FieldError("email") is { } emailError)
        {
            <div class="field-error">@emailError</div>
        }
    </div>

    <div class="form-field">
        <label for="register-password">Senha</label>
        <input id="register-password" class="input" type="password" @bind="_password" placeholder="Mínimo @(PasswordPolicy.MinLength) caracteres" autocomplete="new-password" />
        <div class="form-text">Use ao menos @(PasswordPolicy.MinLength) caracteres, com letra maiúscula, minúscula e número.</div>
        @if (FieldError("password") is { } passwordError)
        {
            <div class="field-error">@passwordError</div>
        }
    </div>

    <div class="form-field">
        <label for="register-confirm">Confirmar senha</label>
        <input id="register-confirm" class="input" type="password" @bind="_confirm" placeholder="Repita a senha" autocomplete="new-password" />
        @if (FieldError("confirmPassword") is { } confirmError)
        {
            <div class="field-error">@confirmError</div>
        }
    </div>

    <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
        @(_busy ? "Criando…" : "Criar conta")
    </button>
</form>

<div class="auth-links">
    <p>Já tem conta? <a href="/login">Entrar</a></p>
</div>

@code {
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;
    private Dictionary<string, string> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/");
    }

    private string? FieldError(string field) => _fieldErrors.GetValueOrDefault(field);

    private async Task DoRegister()
    {
        if (_busy)
            return;

        _error = null;
        _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

        if (string.IsNullOrWhiteSpace(_name))
            _fieldErrors["name"] = "Informe seu nome.";
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
            _fieldErrors["email"] = "Informe um e-mail válido.";
        if (PasswordProblem(_password) is { } passwordProblem)
            _fieldErrors["password"] = passwordProblem;
        else if (_password != _confirm)
            _fieldErrors["confirmPassword"] = "As senhas não conferem.";

        if (_fieldErrors.Count > 0)
            return;

        _busy = true;
        try
        {
            var tokens = await AuthApi.RegisterAsync(new RegisterRequest
            {
                AccountType = "candidate",
                Name = _name.Trim(),
                Email = _email.Trim(),
                Password = _password,
                ConfirmPassword = _confirm
            });
            await Auth.SignInAsync(tokens);
            Toast.ShowSuccess("Sua conta foi criada. Boas-vindas à Monburan!");
            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            // Erros com campo vão para baixo do campo; os gerais (regras de senha do servidor) no alerta
            foreach (var field in new[] { "name", "email", "password", "confirmPassword" })
            {
                if (ex.FieldError(field) is { } message)
                    _fieldErrors[field] = message;
            }

            var general = ex.ValidationErrors?
                .Where(e => !_fieldErrors.ContainsKey(e.Key))
                .SelectMany(e => e.Value)
                .ToList();
            _error = general is { Count: > 0 }
                ? string.Join(" ", general)
                : _fieldErrors.Count > 0 ? null : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // As mesmas regras que o servidor aplica (Identity: só letras e números ASCII contam); a lista de senhas comuns fica
    // só no servidor e chega como erro geral
    private static string? PasswordProblem(string password)
    {
        if (password.Length < PasswordPolicy.MinLength)
            return PasswordPolicy.MinLengthMessage;
        if (password.Length > PasswordPolicy.MaxLength)
            return $"A senha pode ter no máximo {PasswordPolicy.MaxLength} caracteres.";
        if (!password.Any(c => c is >= 'A' and <= 'Z'))
            return "A senha precisa ter ao menos uma letra maiúscula.";
        if (!password.Any(c => c is >= 'a' and <= 'z'))
            return "A senha precisa ter ao menos uma letra minúscula.";
        if (!password.Any(c => c is >= '0' and <= '9'))
            return "A senha precisa ter ao menos um número.";
        return null;
    }
}
