<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cores de partida a frio (antes do WebView carregar). O MAUI usa colorPrimaryDark na barra de status; o valor
         do template (roxo) aparecia como uma faixa azul sobre a interface escura. Aqui vale o fundo do tema escuro
         (padrão do app); a troca para o tema claro é feita em NativeTheme.ApplySystemBars. -->
    <color name="colorPrimary">#0A0806</color>
    <color name="colorPrimaryDark">#0A0806</color>
    <color name="colorAccent">#E8B04A</color>
</resources>
