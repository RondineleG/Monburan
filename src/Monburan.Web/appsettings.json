{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "noreply@monburan.com.br",
    "FromName": "Monburan"
  },
  "Jwt": {
    "Issuer": "monburan.api",
    "Audience": "monburan.app",
    "AccessTokenExpiration": 3600,
    "RefreshTokenExpiration": 2592000,
    "SigningKey": ""
  },
  "Ai": {
    "//": "Ajustes gerais da IA. Os provedores (endereço, modelo, protocolo e o nome da variável AI_KEY_* da chave) são cadastrados pelo administrador na tela Provedores de IA e ficam no banco; a chave nunca fica aqui nem no banco.",
    "MaxRequestsPerHour": 5,
    "AllowPrivateNetworks": false,
    "CatalogRefreshSeconds": 60
  },
  "Security": {
    "//": "RequireTwoFactorForAdmins: administradores só abrem a administração com o 2FA ligado. RateLimit: limites por IP, geral (req/s, rajada = 2x) e nos envios de login, cadastro e recuperação de senha (por minuto).",
    "RequireTwoFactorForAdmins": true,
    "RateLimit": {
      "RequestsPerSecondPerIp": 50,
      "AuthRequestsPerMinutePerIp": 20
    }
  },
  "App": {
    "//": "Base pública usada em links de e-mail (confirmação/reset) — vazio usa Scheme://Host da request. Defina em produção, ex.: https://monburan.com.br",
    "PublicBaseUrl": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/monburan-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}