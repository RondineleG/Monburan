{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "noreply@monburan.com.br",
    "FromName": "Monburan"
  },
  "Jwt": {
    "Issuer": "monburan.api",
    "Audience": "monburan.app",
    "AccessTokenExpiration": 3600,
    "RefreshTokenExpiration": 2592000,
    "SigningKey": ""
  },
  "Ai": {
    "//": "Sugestões de melhoria de currículo por IA (protocolo de chat completions da OpenAI). ApiKey NUNCA aqui: use dotnet user-secrets (desenvolvimento) ou a variável Ai__ApiKey (produção). Sem ApiKey o recurso fica desligado.",
    "BaseUrl": "https://token-plan-sgp.xiaomimimo.com/v1",
    "Model": "mimo-v2.6-pro",
    "ProviderName": "Xiaomi MiMo",
    "ApiKey": "",
    "TimeoutSeconds": 90,
    "MaxOutputTokens": 4000,
    "Temperature": 0.4,
    "UseJsonResponseFormat": true,
    "MaxRequestsPerHour": 5
  },
  "App": {
    "//": "Base pública usada em links de e-mail (confirmação/reset) — vazio usa Scheme://Host da request. Defina em produção, ex.: https://monburan.com.br",
    "PublicBaseUrl": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/monburan-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}