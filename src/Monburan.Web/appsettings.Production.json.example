{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=monburan;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_API_KEY",
    "FromEmail": "noreply@monburan.com.br",
    "FromName": "Monburan"
  },
  "Smtp": {
    "Host": "smtp.resend.com",
    "Port": 465,
    "User": "resend",
    "Password": "YOUR_RESEND_API_KEY",
    "FromEmail": "noreply@monburan.com.br",
    "FromName": "Monburan"
  },
  "Jwt": {
    "SigningKey": "GENERATE_WITH_openssl_rand_-base64_48"
  },
  "App": {
    "PublicBaseUrl": "https://monburan.com.br"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "your-domain.com"
}
