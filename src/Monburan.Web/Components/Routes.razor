@using Microsoft.Extensions.Options
@using Monburan.Web.Services
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Client._Imports).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true && NeedsTwoFactorSetup(context.User))
                {
                    @* Administrador sem 2FA: explica e leva à configuração, em vez de um "acesso negado" sem saída *@
                    <section class="auth-message-page" data-testid="admin-2fa-required">
                        <span class="page-kicker">SEGURANÇA DA CONTA</span>
                        <h1>Ative a verificação em duas etapas</h1>
                        <p>As áreas de administração exigem a verificação em duas etapas na sua conta.</p>
                        <a class="btn btn-primary" href="/Account/Manage/TwoFactorAuthentication?adminRequired=true">Configurar agora</a>
                    </section>
                }
                else if (context.User.Identity?.IsAuthenticated == true)
                {
                    @* Logado, mas sem o perfil exigido (ex.: candidato em página de empresa) —
                       mandar para o login de novo criaria um ciclo sem explicação *@
                    <section class="auth-message-page">
                        <span class="page-kicker">ACESSO</span>
                        <h1>Esta área é restrita</h1>
                        <p>Sua conta não tem permissão para abrir esta página. Algumas áreas são exclusivas para candidatos e outras para empresas.</p>
                        <a class="btn btn-primary" href="/">Voltar ao início</a>
                    </section>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="container mt-5 text-center">
                <h1>Página não encontrada</h1>
                <p class="text-muted">A página solicitada não existe ou foi removida.</p>
                <a class="btn btn-primary" href="/">Voltar ao início</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    [Inject]
    private IOptionsMonitor<SecurityOptions> Security { get; set; } = default!;

    private bool NeedsTwoFactorSetup(System.Security.Claims.ClaimsPrincipal user) =>
        Security.CurrentValue.RequireTwoFactorForAdmins && user.IsInRole("Admin") && !AdminTwoFactorHandler.HasTwoFactor(user);
}
