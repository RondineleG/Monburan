@implements IDisposable
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.Interfaces.Repositories
@using Monburan.Core.Interfaces.Services
@using Monburan.Core.UseCases.Resumes
@using Monburan.Web.Models
@inject IAiTextClient Ai
@inject ICurrentUserHelper CurrentUser
@inject ImproveResumeUseCase ImproveResumeUseCase
@inject ISubscriptionRepository Subscriptions
@inject ResumeImprovementDraftService Drafts
@inject IJSRuntime JS
@inject IToastService Toast
@inject ILogger<ResumeAiPanel> Logger

@* Sugestões de melhoria do currículo com IA — benefício do plano Premium. Só aparece quando a IA está configurada.
   O resultado vira um rascunho criptografado no navegador (escopo por candidato + currículo): a pessoa revisa,
   escolhe o que aproveitar e só então aplica. Nada regenera sozinho. *@
@if (loaded && OpenRequested)
{
    <section class="card mb-4 ai-panel" aria-labelledby="ai-panel-title" data-testid="resume-ai-panel">
        <div class="card-body">
            <h2 id="ai-panel-title" class="ai-panel__title"><span aria-hidden="true"><Icon Name="sparkles" Size="18" /></span> Sugestões de melhoria com IA</h2>

            @if (!storageChecked)
            {
                <LoadingState Compact="true" Message="Verificando rascunho salvo…" />
            }
            else if (draft is not null)
            {
                @* Rascunho salvo: revisar, aplicar e descartar funcionam mesmo sem IA ativa nem plano agora *@
                <div class="ai-draft" data-testid="resume-ai-draft">
                    <p class="ai-draft__status">
                        <strong>Rascunho com sugestões@(draftPersisted ? " salvo neste navegador" : "")</strong>
                        · gerado em @UiLabels.FormatMoment(draft.GeneratedAtUtc)
                    </p>
                    @if (!draftPersisted)
                    {
                        <p class="alert alert-warning mb-2" role="status" data-testid="resume-ai-draft-warning">
                            Não foi possível salvar o rascunho neste navegador — ele ficará disponível só nesta sessão.
                        </p>
                    }
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary" @onclick="ReviewDraft" disabled="@isRunning" data-testid="resume-ai-review">Revisar e aplicar</button>
                        @if (!regenerating && canGenerate)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="AskReplaceAsync" disabled="@isRunning" data-testid="resume-ai-regenerate">Gerar novas sugestões</button>
                        }
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="DiscardAsync" disabled="@isRunning" data-testid="resume-ai-discard">Descartar rascunho</button>
                    </div>
                </div>
            }
            else if (!Ai.IsConfigured)
            {
                <p class="ai-panel__lead" data-testid="resume-ai-unavailable">
                    As sugestões de melhoria com IA não estão disponíveis neste ambiente no momento.
                </p>
            }
            else if (!entitled)
            {
                <p class="ai-panel__lead" data-testid="resume-ai-premium">
                    As sugestões de melhoria com IA são um benefício do plano <strong>Premium</strong>. Com ele, a IA lê o
                    conteúdo profissional do seu currículo e sugere como deixá-lo mais claro e forte — e você decide o que aproveitar.
                </p>
            }
            else
            {
                <p class="ai-panel__lead">
                    A IA lê o conteúdo profissional do currículo (título, resumo, experiências, formação, habilidades e idiomas)
                    e sugere como deixá-lo mais claro e forte. Nada muda no currículo sem a sua revisão.
                </p>
            }

            @if (storageChecked && canGenerate && (draft is null || regenerating))
            {
                <p class="ai-panel__note" id="resume-ai-processing-note">
                    Ao gerar sugestões com IA, você autoriza o envio do conteúdo profissional a um serviço externo.
                    Dados de contato do perfil não são enviados. Você revisa tudo antes de aplicar.
                    <a href="/privacidade" target="_blank" rel="noopener">Como tratamos seus dados<span class="visually-hidden"> (abre em nova aba)</span></a>.
                </p>
                <button type="button" class="btn btn-primary" @onclick="GenerateAsync" disabled="@isRunning" aria-busy="@(isRunning ? "true" : null)"
                        aria-describedby="resume-ai-processing-note" data-testid="resume-ai-generate">
                    @if (isRunning)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Analisando…</span>
                    }
                    else
                    {
                        <Icon Name="sparkles" Size="16" /><span>Gerar sugestões com IA</span>
                    }
                </button>
            }

            @if (storageLoadFailed)
            {
                <div class="alert alert-warning mt-3 mb-0" role="status" data-testid="resume-ai-storage-warning">
                    Não foi possível ler o armazenamento do navegador. Você pode gerar sugestões, mas o rascunho pode não ser salvo.
                </div>
            }

            @* Sem região viva extra em volta: o LoadingState (status) e o alerta já se anunciam sozinhos *@
            @if (isRunning)
            {
                <LoadingState Compact="true" Message="Analisando seu currículo… pode levar até um minuto." />
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-warning mt-3 mb-0" role="alert" data-testid="resume-ai-error">@errorMessage</div>
            }
        </div>
    </section>
}


<ConfirmDialog @ref="confirmDialog" />

@code {
    private readonly CancellationTokenSource cancellation = new();

    private bool isRunning;
    private bool loaded;
    private bool entitled;
    private bool storageChecked;
    private bool storageLoadFailed;
    private bool draftPersisted;
    private bool regenerating;
    private string? errorMessage;
    private ResumeImprovementDraft? draft;
    private ConfirmDialog confirmDialog = default!;

    /// <summary>Currículo dono das sugestões (snapshot que vai para o rascunho).</summary>
    [Parameter, EditorRequired]
    public ResumeResponse Resume { get; set; } = new();

    /// <summary>A página abre/fecha o painel (a tela de CV linka com ?melhorar=true).</summary>
    [Parameter]
    public bool OpenRequested { get; set; }

    /// <summary>A página hospeda a área de revisão em largura total.</summary>
    [Parameter]
    public EventCallback<ResumeImprovementDraft> OnReviewRequested { get; set; }

    /// <summary>Rascunho descartado: a página fecha a área de revisão aberta.</summary>
    [Parameter]
    public EventCallback OnDraftDiscarded { get; set; }

    /// <summary>Rascunho atual em memória (a página usa para abrir a revisão).</summary>
    public ResumeImprovementDraft? Draft => draft;

    /// <summary>A página informa se a gravação mais recente no navegador funcionou.</summary>
    public bool DraftPersisted
    {
        get => draftPersisted;
        set => draftPersisted = value;
    }

    private bool canGenerate => Ai.IsConfigured && entitled;

    /// <summary>Aplicação concluída: a página descarta o rascunho em memória.</summary>
    public void ClearDraft()
    {
        draft = null;
        draftPersisted = false;
        regenerating = false;
    }

    protected override async Task OnInitializedAsync()
    {
        // A oferta do recurso depende do plano do candidato (HasAiAssistant), não só da IA configurada
        var candidateId = CurrentUser.GetCandidateId();
        if (Ai.IsConfigured && candidateId is not null)
        {
            var active = await Subscriptions.GetActiveByCandidateIdAsync(
                Monburan.Core.ValueObjects.Id.Create(candidateId.Value), cancellation.Token);
            entitled = active.Status == EResultStatus.Success && active.Data?.Plan?.HasAiAssistant == true;
        }

        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // O rascunho mora no navegador: a leitura só acontece depois do pré-render (sem JS antes)
        var candidateId = CurrentUser.GetCandidateId();
        if (candidateId is null)
        {
            storageChecked = true;
            return;
        }

        var (outcome, found) = await Drafts.LoadAsync(candidateId.Value, Resume.Id, cancellation.Token);
        if (outcome == ResumeImprovementDraftLoad.Found && found is not null)
        {
            draft = found;
            draftPersisted = true;
        }
        else if (outcome == ResumeImprovementDraftLoad.Error)
        {
            storageLoadFailed = true;
        }

        storageChecked = true;
        StateHasChanged();
    }

    private async Task AskReplaceAsync()
    {
        // Gerar de novo chama a IA outra vez e substitui o rascunho — a pessoa confirma antes
        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Gerar novas sugestões?",
            Message = "A IA vai analisar o currículo novamente e, ao terminar, o novo rascunho substitui o atual. Suas seleções e edições atuais serão descartadas.",
            ConfirmText = "Gerar novas sugestões"
        });
        if (!confirmed)
            return;

        regenerating = true;
        await GenerateAsync();
    }

    private async Task GenerateAsync()
    {
        var candidateId = CurrentUser.GetCandidateId();
        if (!canGenerate || isRunning || candidateId is null)
            return;

        isRunning = true;
        errorMessage = null;

        try
        {
            var result = await ImproveResumeUseCase.ExecuteAsync(
                new ImproveResumeRequest
                {
                    ResumeId = Resume.Id,
                    CandidateId = candidateId.Value,
                    AcceptsExternalProcessing = true
                },
                cancellation.Token);

            if (result.Status == EResultStatus.Success && result.Data is not null)
            {
                var newDraft = ResumeImprovementEditor.CreateDraft(candidateId.Value, Resume, result.Data);
                draftPersisted = await Drafts.SaveAsync(newDraft, cancellation.Token);
                draft = newDraft;
                regenerating = false;
                if (draftPersisted)
                    Toast.ShowSuccess("Rascunho salvo neste navegador.");
            }
            else
            {
                errorMessage = ResultMessages.ToUserMessage(result, "Não foi possível gerar as sugestões agora. Tente novamente em instantes.");
            }
        }
        catch (OperationCanceledException)
        {
            // A pessoa saiu da página: nada a mostrar
        }
        finally
        {
            isRunning = false;
        }
    }

    private async Task DiscardAsync()
    {
        if (draft is null || isRunning)
            return;

        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Descartar rascunho?",
            Message = "As sugestões e edições deste rascunho serão removidas deste navegador. O currículo não muda.",
            ConfirmText = "Descartar",
            Destructive = true
        });
        if (!confirmed)
            return;

        var candidateId = CurrentUser.GetCandidateId();
        if (candidateId is null)
            return;

        if (await Drafts.DeleteAsync(candidateId.Value, Resume.Id, cancellation.Token))
        {
            draft = null;
            draftPersisted = false;
            regenerating = false;
            await OnDraftDiscarded.InvokeAsync();
        }
        else
        {
            Toast.ShowError("Não foi possível remover o rascunho deste navegador. Tente novamente.");
        }
    }

    private async Task ReviewDraft()
    {
        if (draft is not null)
            await OnReviewRequested.InvokeAsync(draft);
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
