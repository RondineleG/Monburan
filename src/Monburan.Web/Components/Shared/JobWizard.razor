@using Monburan.Core.Catalogs
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Web.Services
@inject IJSRuntime JS

@* Formulário de vaga em etapas, compartilhado entre criação e edição. O rascunho vive no Model do pai:
   navegar entre etapas não perde nada do que já foi digitado. *@
<EditForm EditContext="editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="ShowInvalidStepsAsync" novalidate>
    <DataAnnotationsValidator />
    <ServerValidationErrors @ref="serverErrors" FieldMap="ServerFieldMap" />

    <p class="form-required-note">Campos com * são obrigatórios.</p>

    <ol class="job-wizard__steps" aria-label="Etapas da vaga">
        @foreach (var item in StepTitles)
        {
            var stepNumber = item.Key;
            var hasErrors = errorSteps.Contains(stepNumber);
            var stepClass = "job-wizard__step"
                + (step == stepNumber ? " job-wizard__step--active" : string.Empty)
                + (hasErrors ? " job-wizard__step--error" : string.Empty);
            <li class="@stepClass" aria-current="@(step == stepNumber ? "step" : null)">
                @if ((stepNumber <= maxStep || hasErrors) && stepNumber != step)
                {
                    <button type="button" class="job-wizard__step-link" @onclick="() => GoToStep(stepNumber)" data-testid="job-wizard-step-@stepNumber">
                        @stepNumber. @item.Value@(hasErrors ? " (revisar)" : string.Empty)
                    </button>
                }
                else
                {
                    <span data-testid="job-wizard-step-@stepNumber">@stepNumber. @item.Value@(hasErrors ? " (revisar)" : string.Empty)</span>
                }
            </li>
        }
    </ol>

    <div class="job-wizard__layout">
    <div class="job-wizard__main">
    @if (stepErrors.Count > 0)
    {
        <div class="alert alert-danger" role="alert" data-testid="job-wizard-errors">
            Revise os campos destacados para continuar.
        </div>
    }
    else if (errorSteps.Count > 0)
    {
        @* Erro do envio (do servidor ou de outra etapa): diz onde está, já que só uma etapa aparece por vez *@
        <div class="alert alert-danger" role="alert" data-testid="job-wizard-errors">
            Corrija @(errorSteps.Count == 1 ? "a etapa" : "as etapas") @string.Join(", ", errorSteps.Select(s => $"{s}. {StepTitles[s]}")) antes de @(IsEdit ? "salvar" : "publicar").
        </div>
    }

    @if (!string.IsNullOrEmpty(ServerError))
    {
        <div class="alert alert-danger" role="alert" data-testid="job-wizard-server-error">@ServerError</div>
    }

    @if (step == 1)
    {
        <h2 class="h5" id="job-wizard-title" tabindex="-1">Sobre a vaga</h2>

        <div class="mb-3">
            <label class="form-label" for="model.Title">Título da vaga *</label>
            <InputText class="form-control" @bind-Value="Model.Title" id="model.Title" maxlength="200"
                       placeholder="Ex.: Atendente de loja" data-testid="job-title-input"
                       aria-describedby="model.Title-help" />
            <div class="form-text" id="model.Title-help">Seja direto: cargo, senioridade e principal atividade.</div>
            <ValidationMessage class="text-danger" For="@(() => Model.Title)" />
        </div>

        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="model.Category">Categoria</label>
                <InputSelect class="form-select" @bind-Value="Model.Category" id="model.Category" data-testid="job-category-select">
                    <option value="">Sem categoria</option>
                    @if (!string.IsNullOrWhiteSpace(Model.Category) && !JobCategories.All.Contains(Model.Category))
                    {
                        @* Vaga antiga com categoria em texto livre continua editável *@
                        <option value="@Model.Category">@Model.Category</option>
                    }
                    @foreach (var category in JobCategories.All)
                    {
                        <option value="@category">@category</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label" for="model.ContractType">Tipo de contrato</label>
                <InputSelect class="form-select" @bind-Value="Model.ContractType" id="model.ContractType" data-testid="job-contract-select">
                    <option value="">Não informado</option>
                    @foreach (var contract in Enum.GetValues<EContractType>())
                    {
                        <option value="@contract">@UiLabels.ContractType(contract.ToString())</option>
                    }
                </InputSelect>
            </div>
        </div>

        <fieldset class="mb-3 job-type-fieldset" aria-describedby="@(HasFieldError(nameof(CreateJobRequest.Type)) ? "job-wizard-error-Type" : null)">
            <legend class="form-label">Modalidade *</legend>
            <div class="job-type-cards">
                @foreach (var option in Modes)
                {
                    <label class="job-type-card@(Model.Type == option.Value ? " is-active" : string.Empty)">
                        <input type="radio" name="job-mode" value="@option.Value"
                               checked="@(Model.Type == option.Value)"
                               @onchange="() => SelectMode(option.Value)"
                               data-testid="job-mode-@option.Value.ToLowerInvariant()" />
                        <span>@option.Label</span>
                    </label>
                }
            </div>
            @FieldError(nameof(CreateJobRequest.Type))
        </fieldset>

        @if (Model.Type != "Remote")
        {
            <div class="row g-2">
                <div class="col-md-8 mb-3">
                    <label class="form-label" for="model.City">Cidade</label>
                    <InputText class="form-control" @bind-Value="Model.City" id="model.City" maxlength="100" autocomplete="address-level2" data-testid="job-city-input" />
                    <ValidationMessage class="text-danger" For="@(() => Model.City)" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" for="model.State">UF</label>
                    <InputText class="form-control" @bind-Value="Model.State" id="model.State" maxlength="2" autocomplete="address-level1" autocapitalize="characters" data-testid="job-state-input" />
                    <ValidationMessage class="text-danger" For="@(() => Model.State)" />
                </div>
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="model.Tags">Tags</label>
            <InputText class="form-control" @bind-Value="Model.Tags" id="model.Tags" maxlength="500" placeholder="Ex.: atendimento, vendas, caixa (separadas por vírgula)" />
            <ValidationMessage class="text-danger" For="@(() => Model.Tags)" />
        </div>
    }
    else if (step == 2)
    {
        <h2 class="h5" id="job-wizard-title" tabindex="-1">Descrição</h2>

        <div class="mb-3">
            <label class="form-label" for="model.Description">Descrição da vaga *</label>
            <InputTextArea class="form-control" @bind-Value="Model.Description" id="model.Description" rows="5" maxlength="2000"
                           placeholder="Descreva a rotina, a equipe e o que torna a oportunidade interessante"
                           data-testid="job-description-input" aria-describedby="model.Description-count" />
            <div class="form-text" id="model.Description-count">@Count(Model.Description)/2000 caracteres</div>
            <ValidationMessage class="text-danger" For="@(() => Model.Description)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="model.Responsibilities">Responsabilidades</label>
            <InputTextArea class="form-control" @bind-Value="Model.Responsibilities" id="model.Responsibilities" rows="4" maxlength="2000"
                           aria-describedby="model.Responsibilities-count" />
            <div class="form-text" id="model.Responsibilities-count">@Count(Model.Responsibilities)/2000 caracteres</div>
            <ValidationMessage class="text-danger" For="@(() => Model.Responsibilities)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="model.Requirements">Requisitos</label>
            <InputTextArea class="form-control" @bind-Value="Model.Requirements" id="model.Requirements" rows="4" maxlength="2000"
                           aria-describedby="model.Requirements-count" />
            <div class="form-text" id="model.Requirements-count">@Count(Model.Requirements)/2000 caracteres</div>
            <ValidationMessage class="text-danger" For="@(() => Model.Requirements)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="model.Benefits">Benefícios</label>
            <InputTextArea class="form-control" @bind-Value="Model.Benefits" id="model.Benefits" rows="3" maxlength="2000"
                           aria-describedby="model.Benefits-count" />
            <div class="form-text" id="model.Benefits-count">@Count(Model.Benefits)/2000 caracteres</div>
            <ValidationMessage class="text-danger" For="@(() => Model.Benefits)" />
        </div>
    }
    else if (step == 3)
    {
        <h2 class="h5" id="job-wizard-title" tabindex="-1">Remuneração e candidatura</h2>

        <div class="row g-2">
            <div class="col-md-4 mb-3">
                <label class="form-label" for="model.SalaryMin">Salário mínimo (R$)</label>
                <InputNumber ParsingErrorMessage="Informe um número válido." class="form-control" @bind-Value="Model.SalaryMin" id="model.SalaryMin" />
                <ValidationMessage class="text-danger" For="@(() => Model.SalaryMin)" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="model.SalaryMax">Salário máximo (R$)</label>
                <InputNumber ParsingErrorMessage="Informe um número válido." class="form-control" @bind-Value="Model.SalaryMax" id="model.SalaryMax" />
                <ValidationMessage class="text-danger" For="@(() => Model.SalaryMax)" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="model.SalaryPeriod">Período do salário</label>
                <InputSelect class="form-select" @bind-Value="Model.SalaryPeriod" id="model.SalaryPeriod" data-testid="job-salary-period-select">
                    <option value="">Não informado</option>
                    @foreach (var period in Enum.GetValues<ESalaryPeriod>())
                    {
                        <option value="@period">@UiLabels.SalaryPeriod(period.ToString())</option>
                    }
                </InputSelect>
            </div>
        </div>

        <label class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="Model.SalaryDisplay" id="model.SalaryDisplay" />
            <span class="form-check-label">Mostrar faixa salarial na página da vaga</span>
        </label>

        <div class="row g-2">
            <div class="col-md-4 mb-3">
                <label class="form-label" for="model.NumberOfOpenings">Número de vagas *</label>
                <InputNumber ParsingErrorMessage="Informe um número válido." class="form-control" @bind-Value="Model.NumberOfOpenings" id="model.NumberOfOpenings" min="1" />
                <ValidationMessage For="@(() => Model.NumberOfOpenings)" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" for="model.ExpirationDate">Data de validade *</label>
                <InputDate ParsingErrorMessage="Informe uma data válida." class="form-control" @bind-Value="Model.ExpirationDate" id="model.ExpirationDate" />
                <ValidationMessage class="text-danger" For="@(() => Model.ExpirationDate)" />
                <div class="form-text">A vaga expira automaticamente nesta data.</div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="model.ApplicationInstructions">Instruções de candidatura</label>
            <InputTextArea class="form-control" @bind-Value="Model.ApplicationInstructions" id="model.ApplicationInstructions" rows="3" maxlength="2000"
                           aria-describedby="model.ApplicationInstructions-help" />
            <div class="form-text" id="model.ApplicationInstructions-help">Não inclua dados sensíveis nem solicite pagamentos.</div>
            <ValidationMessage class="text-danger" For="@(() => Model.ApplicationInstructions)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="model.Observations">Observações</label>
            <InputTextArea class="form-control" @bind-Value="Model.Observations" id="model.Observations" rows="3" maxlength="2000" />
            <ValidationMessage class="text-danger" For="@(() => Model.Observations)" />
        </div>
    }
    else
    {
        <h2 class="h5" id="job-wizard-title" tabindex="-1">Revisar e publicar</h2>
        <p class="text-muted">É assim que os candidatos vão ver sua vaga:</p>

        <div class="job-wizard__preview" data-testid="job-wizard-preview">
            <JobCard Job="PreviewJob" Preview="true" />
        </div>

        <dl class="apply-summary">
            <dt>Modalidade</dt>
            <dd>@UiLabels.JobType(Model.Type)</dd>
            @if (Model.Type != "Remote")
            {
                <dt>Local</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.City) ? "Não informado" : $"{Model.City}{(string.IsNullOrWhiteSpace(Model.State) ? string.Empty : $" / {Model.State}")}")</dd>
            }
            @if (!string.IsNullOrWhiteSpace(UiLabels.ContractType(Model.ContractType?.ToString())))
            {
                <dt>Contrato</dt>
                <dd>@UiLabels.ContractType(Model.ContractType?.ToString())</dd>
            }
            @if (Model.SalaryMin is not null || Model.SalaryMax is not null)
            {
                <dt>Salário</dt>
                <dd>@PreviewSalary</dd>
            }
            <dt>Vagas</dt>
            <dd>@Model.NumberOfOpenings</dd>
            <dt>Validade</dt>
            <dd>@UiLabels.FormatDate(Model.ExpirationDate)</dd>
        </dl>
    }

    </div>
    <aside class="job-wizard__guide" aria-label="Ajuda desta etapa">
        @switch (step)
        {
            case 1:
                <h3>Sobre a vaga</h3>
                <p>Um título claro e o modo de trabalho correto ajudam a oportunidade a aparecer nas buscas certas.</p>
                break;
            case 2:
                <h3>Descrição</h3>
                <p>Separe o que é essencial do que é diferencial: quem candidata entende melhor para que tipo de perfil a vaga foi pensada.</p>
                break;
            case 3:
                <h3>Remuneração</h3>
                <p>Mostrar faixa salarial deixa a oferta transparente; mantenha oculta só quando fizer sentido para a vaga.</p>
                break;
            default:
                <h3>Revisão</h3>
                <p>Confira o que será publicado: título, descrição e local ficam visíveis para quem explora as vagas.</p>
                break;
        }
    </aside>
    </div>
    <div class="job-wizard__actions">
        @* Primária primeiro; "Cancelar" por último *@
        @if (step < JobWizardStepValidator.StepCount)
        {
            <button type="button" class="btn btn-primary" @onclick="GoForward" data-testid="job-wizard-continue">
                Continuar <Icon Name="arrow-right" Size="16" />
            </button>
        }
        else
        {
            <button type="submit" class="btn btn-primary btn-lg" disabled="@(IsSubmitting || !CanPublish)" aria-busy="@(IsSubmitting ? "true" : null)" data-testid="job-create-submit">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>@(IsEdit ? "Salvando…" : "Publicando…")</span>
                }
                else
                {
                    <span>@(IsEdit ? "Salvar alterações" : "Publicar vaga")</span>
                }
            </button>
        }
        @if (step > 1)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="GoBack" data-testid="job-wizard-back">
                <Icon Name="arrow-left" Size="16" /> Voltar
            </button>
        }
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">Cancelar</button>
    </div>
</EditForm>

<UnsavedChangesGuard HasChanges="() => editContext.IsModified() && !submitting" />

@code {
    private static readonly Dictionary<int, string> StepTitles = new()
    {
        [1] = "Sobre a vaga",
        [2] = "Descrição",
        [3] = "Remuneração e candidatura",
        [4] = "Revisar e publicar"
    };

    private static readonly (string Value, string Label)[] Modes =
    [
        ("OnSite", "Presencial"),
        ("Remote", "Remoto"),
        ("Hybrid", "Híbrido")
    ];

    private static readonly Dictionary<string, string> ServerFieldMap = new() { ["Salary"] = nameof(CreateJobRequest.SalaryMax) };

    [Parameter, EditorRequired]
    public CreateJobRequest Model { get; set; } = default!;

    /// <summary>Modo edição: o botão final grava em vez de publicar.</summary>
    [Parameter]
    public bool IsEdit { get; set; }

    /// <summary>Nome da empresa, só para a pré-visualização do cartão.</summary>
    [Parameter]
    public string? CompanyName { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    /// <summary>Falso quando o plano não permite outra vaga ativa.</summary>
    [Parameter]
    public bool CanPublish { get; set; } = true;

    [Parameter]
    public string? ServerError { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private ServerValidationErrors serverErrors = default!;
    private EditContext editContext = default!;
    // Erros da validação por etapa entram no EditContext: o campo ganha aria-invalid e o estilo de inválido
    private ValidationMessageStore stepStore = default!;
    private IReadOnlyList<JobWizardStepError> stepErrors = [];
    private SortedSet<int> errorSteps = [];
    private int step = 1;
    private int maxStep = 1;
    private bool submitting;

    protected override void OnParametersSet()
    {
        if (editContext is not null && ReferenceEquals(editContext.Model, Model))
            return;

        editContext = new EditContext(Model);
        stepStore = new ValidationMessageStore(editContext);
        editContext.OnFieldChanged += (_, e) => stepStore.Clear(e.FieldIdentifier);
    }

    private bool HasFieldError(string field) => stepErrors.Any(error => error.Field == field);

    private JobResponse PreviewJob => new()
    {
        Id = Guid.Empty,
        Title = Model.Title,
        Description = Model.Description ?? string.Empty,
        Requirements = Model.Requirements,
        Responsibilities = Model.Responsibilities,
        Benefits = Model.Benefits,
        Category = Model.Category,
        Tags = Model.Tags,
        AdvertiserName = CompanyName,
        City = Model.City,
        State = Model.State,
        Country = Model.Country,
        Type = Model.Type,
        IsRemote = Model.Type is "Remote" or "Hybrid",
        SalaryMin = Model.SalaryMin,
        SalaryMax = Model.SalaryMax,
        SalaryCurrency = Model.SalaryCurrency,
        SalaryDisplay = Model.SalaryDisplay,
        SalaryPeriod = Model.SalaryPeriod?.ToString(),
        ContractType = Model.ContractType?.ToString(),
        NumberOfOpenings = Model.NumberOfOpenings,
        ExpirationDate = Model.ExpirationDate,
        CreatedAt = DateTime.UtcNow,
        Status = "Active"
    };

    private string PreviewSalary
    {
        get
        {
            var text = JobDisplay.Salary(PreviewJob) ?? "Não informado";
            var period = UiLabels.SalaryPeriod(Model.SalaryPeriod?.ToString());
            return period.Length > 0 ? $"{text} {period}" : text;
        }
    }

    private static int Count(string? text) => text?.Length ?? 0;

    private void SelectMode(string mode) => Model.Type = mode;

    /// <summary>
    /// Erros do servidor por campo (a tela do pai decide a mensagem geral). Só uma etapa aparece por vez:
    /// o assistente vai para a primeira etapa com erro e marca as outras no indicador.
    /// </summary>
    public IReadOnlyList<string> DisplayServerFieldErrors(IReadOnlyDictionary<string, string[]> fieldErrors)
    {
        var unmatched = serverErrors.Display(fieldErrors);
        _ = InvokeAsync(ShowStepsWithErrorsAsync);
        return unmatched;
    }

    private async Task GoForward()
    {
        stepErrors = JobWizardStepValidator.Validate(step, Model);
        stepStore.Clear();
        foreach (var error in stepErrors)
            stepStore.Add(editContext.Field(error.Field), error.Message);
        editContext.NotifyValidationStateChanged();

        if (stepErrors.Count > 0)
        {
            await FocusFieldAsync(stepErrors[0].Field == nameof(CreateJobRequest.Type) ? "job-wizard-title" : $"model.{stepErrors[0].Field}");
            return;
        }

        errorSteps.Remove(step);
        await GoToStep(step + 1);
    }

    private Task GoBack() => GoToStep(step - 1);

    private async Task GoToStep(int target)
    {
        step = Math.Clamp(target, 1, JobWizardStepValidator.StepCount);
        maxStep = Math.Max(maxStep, step);
        stepErrors = [];
        await FocusFieldAsync("job-wizard-title");
    }

    // Envio com campo inválido em etapa que não está na tela: sem isto o botão "não fazia nada"
    private Task ShowInvalidStepsAsync(EditContext context) => ShowStepsWithErrorsAsync();

    private async Task ShowStepsWithErrorsAsync()
    {
        var invalidFields = JobWizardStepValidator.Fields
            .Where(field => editContext.GetValidationMessages(editContext.Field(field)).Any())
            .ToList();
        errorSteps = new SortedSet<int>(invalidFields.Select(JobWizardStepValidator.StepOf));
        if (errorSteps.Count == 0)
        {
            StateHasChanged();
            return;
        }

        step = errorSteps.Min;
        maxStep = Math.Max(maxStep, step);
        stepErrors = [];
        StateHasChanged();
        var first = invalidFields.First(field => JobWizardStepValidator.StepOf(field) == step);
        await FocusFieldAsync(first == nameof(CreateJobRequest.Type) ? "job-wizard-title" : $"model.{first}");
    }

    private async Task FocusFieldAsync(string elementId)
    {
        try
        {
            await JS.InvokeVoidAsync("monburanFocusById", elementId);
        }
        catch (JSException)
        {
            // Sem JS o foco é o de menos: as etapas continuam funcionando
        }
    }

    private async Task CancelAsync() => await OnCancel.InvokeAsync();

    private async Task SubmitAsync()
    {
        errorSteps.Clear();
        // Publicar com sucesso navega para outra página: a guarda de alterações não pode barrar essa saída
        submitting = true;
        try
        {
            await OnSubmit.InvokeAsync();
        }
        finally
        {
            submitting = false;
        }
    }

    // Só a modalidade (grupo de rádios) usa mensagem própria; os demais campos usam ValidationMessage
    private RenderFragment FieldError(string field) => builder =>
    {
        var error = stepErrors.FirstOrDefault(item => item.Field == field);
        if (error is null)
            return;

        builder.OpenElement(0, "p");
        builder.AddAttribute(1, "class", "text-danger");
        builder.AddAttribute(2, "id", $"job-wizard-error-{field}");
        builder.AddAttribute(3, "data-testid", $"job-wizard-error-{field}");
        builder.AddContent(4, error.Message);
        builder.CloseElement();
    };
}
