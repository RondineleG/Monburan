@* Cartão de vaga da lista. O cartão inteiro é clicável pelo link do título (página pública da vaga). *@
<article class="job-card@(Compact ? " job-card--compact" : string.Empty)" data-testid="job-card">
    <div class="job-card__head">
        <span class="job-logo" aria-hidden="true">
            @JobDisplay.Initial(Job.AdvertiserName)
            @if (!string.IsNullOrWhiteSpace(Job.AdvertiserLogoUrl))
            {
                <img src="@Job.AdvertiserLogoUrl" alt="" loading="lazy" decoding="async" onerror="this.hidden=true" />
            }
        </span>
        <div class="job-card__heading">
            <h3 class="job-card__title">
                @if (Preview)
                {
                    @Job.Title
                }
                else
                {
                    <a class="job-card__link" href="/jobs/@Job.Id" data-testid="job-card-link">@Job.Title</a>
                }
            </h3>
            @if (!string.IsNullOrWhiteSpace(Job.AdvertiserName))
            {
                <p class="job-card__company">@Job.AdvertiserName</p>
            }
        </div>
        @if (isNew)
        {
            <span class="job-flag">Nova</span>
        }
    </div>

    <ul class="job-facts" aria-label="Resumo da vaga">
        <li><Icon Name="map-pin" Size="16" /><span>@JobDisplay.Location(Job)</span></li>
        <li><Icon Name="@JobDisplay.ModeIcon(Job.Type)" Size="16" /><span>@UiLabels.JobType(Job.Type)</span></li>
        @if (salary is not null)
        {
            <li class="job-facts__salary"><Icon Name="banknote" Size="16" /><span>@salary</span></li>
        }
    </ul>

    @if (!Compact && !string.IsNullOrWhiteSpace(Job.Description))
    {
        <p class="job-card__excerpt">@JobDisplay.Excerpt(Job.Description, 180)</p>
    }

    @if (!string.IsNullOrWhiteSpace(Job.Category) || tags.Count > 0)
    {
        <ul class="job-tags" aria-label="Categorias">
            @if (!string.IsNullOrWhiteSpace(Job.Category))
            {
                <li class="job-tag job-tag--category">@Job.Category</li>
            }
            @foreach (var tag in tags)
            {
                <li class="job-tag">@tag</li>
            }
        </ul>
    }

    <div class="job-card__foot">
        <span>Publicada @JobDisplay.Age(Job.CreatedAt)</span>
        @if (closing is not null)
        {
            <span class="job-card__closing">@closing</span>
        }
        @if (IsOwner)
        {
            <span class="job-card__owner">@Job.Applications @(Job.Applications == 1 ? "candidatura" : "candidaturas")</span>
        }
        @if (ShowSave)
        {
            <span class="job-card__save">
                <SaveJobButton JobId="Job.Id" IsSaved="Job.IsSaved" CanSave="CanSave" ReturnUrl="@SaveReturnUrl" />
            </span>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public JobResponse Job { get; set; } = default!;

    /// <summary>Vaga do anunciante logado: mostra o total de candidaturas.</summary>
    [Parameter]
    public bool IsOwner { get; set; }

    /// <summary>Versão enxuta (sem trecho da descrição), usada em "Vagas semelhantes".</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Mostra o botão de salvar (o visitante vê "Entrar para salvar").</summary>
    [Parameter]
    public bool ShowSave { get; set; }

    /// <summary>Candidato autenticado pode salvar de verdade.</summary>
    [Parameter]
    public bool CanSave { get; set; }

    /// <summary>Página atual para retorno depois do login.</summary>
    [Parameter]
    public string? SaveReturnUrl { get; set; }

    /// <summary>
    /// Pré-visualização do assistente de vaga: a vaga ainda não existe (Id vazio), então o título não é link. O link cobria o
    /// cartão inteiro e levava para /jobs/{Guid.Empty}, uma página de erro, perdendo o rascunho.
    /// </summary>
    [Parameter]
    public bool Preview { get; set; }

    private bool isNew;
    private string? salary;
    private string? closing;
    private IReadOnlyList<string> tags = [];

    protected override void OnParametersSet()
    {
        isNew = JobDisplay.IsNew(Job.CreatedAt);
        salary = JobDisplay.Salary(Job);
        closing = JobDisplay.ClosingNotice(Job.ExpirationDate);
        tags = JobDisplay.Tags(Job.Tags, 3);
    }
}
