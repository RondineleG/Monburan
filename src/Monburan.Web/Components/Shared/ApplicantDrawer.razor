@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Applications
@using Monburan.Web.Services
@inject ListApplicationHistoryUseCase ListApplicationHistoryUseCase
@inject UpdateApplicationStatusUseCase UpdateApplicationStatusUseCase
@inject ResumeViewerService ResumeViewer
@inject ICurrentUserHelper CurrentUserHelper
@inject IToastService Toast
@inject IJSRuntime JS
@inject ILogger<ApplicantDrawer> Logger

@* Gaveta do candidato: perfil resumido, mudança de situação com nota e a linha do tempo de etapas.
   Abrir fecha com Esc, o foco fica preso dentro e volta para quem abriu. *@
@if (Application is not null)
{
    <div class="applicant-drawer__backdrop" @onclick="CloseAsync" data-testid="applicant-drawer-backdrop"></div>
    <section class="applicant-drawer"
             role="dialog"
             aria-modal="true"
             aria-labelledby="applicant-drawer-title"
             tabindex="-1"
             @ref="drawerElement"
             @onkeydown="OnKeyDownAsync"
             data-testid="applicant-drawer">
        <header class="applicant-drawer__header">
            <div>
                <span class="page-kicker">CANDIDATO</span>
                <h2 id="applicant-drawer-title" class="h4">@Application.CandidateName</h2>
            </div>
            <button type="button" class="applicant-drawer__close" @onclick="CloseAsync" aria-label="Fechar" data-testid="applicant-drawer-close">
                <span aria-hidden="true">×</span>
            </button>
        </header>

        <dl class="apply-summary">
            <dt>E-mail</dt>
            <dd>@(Application.CandidateEmail ?? "Não informado")</dd>
            <dt>Telefone</dt>
            <dd>@(Application.CandidatePhone ?? "Não informado")</dd>
            <dt>Vaga</dt>
            <dd>@Application.JobTitle</dd>
            <dt>Situação</dt>
            <dd><span class="badge @UiLabels.ApplicationStatusBadge(Application.Status)">@UiLabels.ApplicationStatus(Application.Status)</span></dd>
        </dl>

        @if (Application.ResumeId.HasValue)
        {
            <section aria-label="Currículo enviado" data-testid="applicant-resume-section">
                <h3 class="h6">Currículo enviado</h3>
                @if (resumeLoading)
                {
                    <p class="text-muted">Carregando currículo…</p>
                }
                else if (attachedResume is not null)
                {
                    <p class="mb-2"><strong>@attachedResume.Resume.Title</strong></p>
                    @if (!string.IsNullOrWhiteSpace(attachedResume.Resume.Summary))
                    {
                        <p class="small resume-pre">@attachedResume.Resume.Summary</p>
                    }
                    @if (attachedResume.Resume.ExperienceHistory is { Count: > 0 })
                    {
                        <details class="applicant-resume__details">
                            <summary>Experiências (@attachedResume.Resume.ExperienceHistory.Count)</summary>
                            <ul class="small mt-1">
                                @foreach (var exp in attachedResume.Resume.ExperienceHistory)
                                {
                                    <li><strong>@exp.Position</strong> — @exp.Company</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (attachedResume.Resume.EducationHistory is { Count: > 0 })
                    {
                        <details class="applicant-resume__details">
                            <summary>Formação (@attachedResume.Resume.EducationHistory.Count)</summary>
                            <ul class="small mt-1">
                                @foreach (var edu in attachedResume.Resume.EducationHistory)
                                {
                                    <li>@edu.Course — @edu.Institution</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (attachedResume.Resume.Skills is { Count: > 0 })
                    {
                        <details class="applicant-resume__details">
                            <summary>Habilidades (@attachedResume.Resume.Skills.Count)</summary>
                            <p class="small mt-1">@string.Join(" · ", attachedResume.Resume.Skills.Select(s => s.Skill))</p>
                        </details>
                    }
                    @if (SafeLinkedIn is not null)
                    {
                        <p class="small mb-2"><a href="@SafeLinkedIn" target="_blank" rel="noopener noreferrer">LinkedIn do candidato</a></p>
                    }
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a class="btn btn-outline-primary btn-sm" href="@($"/resumes/{Application.ResumeId}")" data-testid="applicant-resume">Ver currículo completo</a>
                        <a class="btn btn-outline-primary btn-sm" href="@($"/resumes/{Application.ResumeId}/cv")" data-testid="applicant-resume-cv">Visualizar CV</a>
                    </div>
                }
                else
                {
                    <p class="text-muted">Não foi possível carregar o currículo enviado.</p>
                }
            </section>
        }
        else
        {
            <p class="text-muted">O candidato não enviou currículo nesta candidatura.</p>
        }

        @if (!string.IsNullOrWhiteSpace(Application.Notes))
        {
            <section aria-label="Observações do candidato">
                <h3 class="h6">Observações do candidato</h3>
                <p>@Application.Notes</p>
            </section>
        }

        <section aria-label="Mudar situação da candidatura">
            <h3 class="h6">Mudar situação</h3>
            <div class="mb-2">
                <label class="form-label" for="applicant-note">Nota (opcional)</label>
                <textarea id="applicant-note" class="form-control" rows="2" @bind="statusNote" data-testid="applicant-note"></textarea>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => ChangeStatusAsync(EApplicationStatus.Viewed)" disabled="@isUpdating" data-testid="application-viewed">Visualizar</button>
                <button type="button" class="btn btn-success btn-sm" @onclick="() => ChangeStatusAsync(EApplicationStatus.Selected)" disabled="@isUpdating" data-testid="application-select">Selecionar</button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="() => ChangeStatusAsync(EApplicationStatus.Rejected)" disabled="@isUpdating" data-testid="application-reject">Rejeitar</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeStatusAsync(EApplicationStatus.Archived)" disabled="@isUpdating" data-testid="application-archive">Arquivar</button>
            </div>
        </section>

        <section aria-label="Etapas da candidatura" class="mt-3">
            <h3 class="h6">Etapas</h3>
            @if (timeline.Count > 0)
            {
                <ol class="application-timeline">
                    @foreach (var step in timeline)
                    {
                        <li class="application-timeline__step">
                            <span class="application-timeline__label">@UiLabels.ApplicationStatus(step.Status)</span>
                            <time class="application-timeline__date" datetime="@step.Date.ToString("o")">@UiLabels.FormatMoment(step.Date)</time>
                            @if (!string.IsNullOrWhiteSpace(step.Note))
                            {
                                <p class="application-timeline__note">@step.Note</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(step.Responsible))
                            {
                                <p class="application-timeline__by">@step.Responsible</p>
                            }
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="text-muted" data-testid="applicant-timeline-empty">Ainda não há etapas registradas.</p>
            }
        </section>
    </section>
}

@code {
    /// <summary>Candidatura aberta; nulo mantém a gaveta fechada.</summary>
    [Parameter]
    public ApplicationResponse? Application { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<ApplicationResponse> OnStatusChanged { get; set; }

    private ElementReference drawerElement;
    private List<(string Status, DateTime Date, string? Note, string? Responsible)> timeline = [];
    private ResumeViewerResponse? attachedResume;
    private bool resumeLoading;
    private Guid? loadedResumeFor;
    private string statusNote = string.Empty;
    private bool isUpdating;
    private bool trapInstalled;

    // LinkedIn só vira link quando é URL absoluta http(s) — texto solto nunca vira href
    private string? SafeLinkedIn =>
        attachedResume?.LinkedIn is { } url
        && Uri.TryCreate(url, UriKind.Absolute, out var uri)
        && uri.Scheme is "https" or "http"
            ? uri.ToString()
            : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Application is not null)
        {
            statusNote = string.Empty;
            await LoadTimelineAsync();
            // Cada candidatura aberta recarrega o currículo anexado (não reusa o da anterior)
            if (loadedResumeFor != Application.Id)
            {
                loadedResumeFor = Application.Id;
                attachedResume = null;
                await LoadResumeAsync();
            }
        }
        else
        {
            loadedResumeFor = null;
            attachedResume = null;
        }
    }

    private async Task LoadResumeAsync()
    {
        if (Application?.ResumeId is not { } resumeId)
            return;

        resumeLoading = true;
        var result = await ResumeViewer.GetAsync(resumeId);
        if (result.Status == EResultStatus.Success)
            attachedResume = result.Data;
        else if (result.Status is not EResultStatus.EntityNotFound)
            Logger.LogFailure(result, "Carregar currículo anexado à candidatura");
        resumeLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Application is null || trapInstalled)
            return;

        trapInstalled = true;
        try
        {
            // Foco dentro da gaveta e tecla Tab presa nela enquanto estiver aberta
            await JS.InvokeVoidAsync("monburanTrapFocus", drawerElement);
            await drawerElement.FocusAsync();
        }
        catch (JSException)
        {
            // Sem JS a gaveta continua utilizável: Esc e o botão de fechar seguem funcionando
        }
    }

    private async Task LoadTimelineAsync()
    {
        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        var result = await ListApplicationHistoryUseCase.ExecuteAsync(
            new ListApplicationHistoryRequest(Application!.Id, null, advertiserId));
        if (result.Status == EResultStatus.Success)
        {
            timeline = (result.Data ?? [])
                .OrderBy(item => item.Date)
                .Select(item => (item.Status, item.Date, item.Note, item.Responsible))
                .ToList();
        }
        else
        {
            Logger.LogFailure(result, "Carregar etapas da candidatura");
            timeline = [];
        }
    }

    private async Task ChangeStatusAsync(EApplicationStatus newStatus)
    {
        if (isUpdating || Application is null)
            return;

        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        if (!advertiserId.HasValue)
            return;

        isUpdating = true;
        var result = await UpdateApplicationStatusUseCase.ExecuteAsync(new UpdateApplicationStatusRequest
        {
            ApplicationId = Application.Id,
            AdvertiserId = advertiserId.Value,
            NewStatus = newStatus,
            Notes = string.IsNullOrWhiteSpace(statusNote) ? null : statusNote.Trim()
        });
        isUpdating = false;

        if (result.Status == EResultStatus.Success)
        {
            Application.Status = newStatus.ToString();
            statusNote = string.Empty;
            await LoadTimelineAsync();
            Toast.ShowSuccess($"Situação atualizada para {UiLabels.ApplicationStatus(newStatus.ToString()).ToLowerInvariant()}.");
            await OnStatusChanged.InvokeAsync(Application);
        }
        else
        {
            Logger.LogFailure(result, "Atualizar situação da candidatura");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível atualizar a candidatura. Tente novamente."));
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            await CloseAsync();
    }

    private async Task CloseAsync()
    {
        trapInstalled = false;
        await OnClose.InvokeAsync();
    }
}
