<section class="empty-state" data-testid="@TestId">
    <span class="empty-state__icon" aria-hidden="true">@Icon</span>
    @if (!string.IsNullOrWhiteSpace(Kicker))
    {
        <span class="page-kicker">@Kicker</span>
    }
    <StateHeading Level="HeadingLevel" Text="@Title" />
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p>@Message</p>
    }
    @ChildContent
</section>

@code {
    [Parameter]
    public string Icon { get; set; } = "◌";

    [Parameter]
    public string? Kicker { get; set; }

    [Parameter]
    public string Title { get; set; } = "Nada por aqui ainda";

    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// Nível do título: 2 dentro de uma página que já tem h1; 1 quando o estado é a página inteira
    /// (ex.: vaga não encontrada), para o foco de navegação e o leitor de tela acharem o título principal.
    /// </summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    /// <summary>Chamada para ação (ex.: link "Explorar vagas").</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string TestId { get; set; } = "empty-state";
}
