@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Confirmação para ações destrutivas. Uso:
        <ConfirmDialog @ref="confirm" />
        if (!await confirm.ShowAsync(new ConfirmOptions { ... })) return;
    ChildContent permite campos extras (ex.: motivo do cancelamento).
    <dialog> nativo aberto com showModal(): o navegador prende o foco e torna o resto da página inerte;
    Esc e clique fora acionam o Cancelar (monburan-ui.js) e o foco volta para quem abriu o diálogo.
*@
@if (isOpen)
{
    <dialog class="confirm-dialog"
            role="alertdialog"
            aria-labelledby="@titleId"
            aria-describedby="@messageId"
            data-testid="confirm-dialog"
            @ref="dialog">
        <header class="confirm-dialog__header">
            <span class="confirm-dialog__icon @(options.Destructive ? "confirm-dialog__icon--danger" : string.Empty)" aria-hidden="true"><Icon Name="@(options.Destructive ? "alert" : "info")" Size="18" /></span>
            <h2 id="@titleId">@options.Title</h2>
        </header>
        <div class="confirm-dialog__body">
            <p id="@messageId">@options.Message</p>
            @ChildContent
        </div>
        <footer class="confirm-dialog__footer">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" data-dialog-cancel data-testid="confirm-cancel">@options.CancelText</button>
            <button type="button" class="btn @(options.Destructive ? "btn-danger" : "btn-primary")" @onclick="Confirm" data-testid="confirm-accept">@options.ConfirmText</button>
        </footer>
    </dialog>
}

@code {
    private readonly string titleId = $"confirm-title-{Guid.NewGuid():N}";
    private readonly string messageId = $"confirm-message-{Guid.NewGuid():N}";
    private ConfirmOptions options = new();
    private TaskCompletionSource<bool>? pending;
    private ElementReference dialog;
    private bool isOpen;
    private bool openPending;
    private bool restorePending;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Abre o diálogo e devolve <c>true</c> só se o usuário confirmar.</summary>
    public Task<bool> ShowAsync(ConfirmOptions confirmOptions)
    {
        pending?.TrySetResult(false);

        options = confirmOptions;
        pending = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        isOpen = true;
        openPending = true;
        StateHasChanged();

        return pending.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (openPending && isOpen)
            {
                openPending = false;
                // Abre modal e põe o foco na opção segura: Enter acidental não exclui nada
                await JS.InvokeVoidAsync("monburanDialog.open", dialog);
            }
            else if (restorePending && !isOpen)
            {
                restorePending = false;
                await JS.InvokeVoidAsync("monburanDialog.restoreFocus");
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuito encerrado: não há mais página para focar
        }
        catch (JSException)
        {
            // Diálogo fechado no mesmo ciclo — nada a abrir ou focar
        }
    }

    private void Confirm() => Close(true);

    private void Cancel() => Close(false);

    private void Close(bool confirmed)
    {
        isOpen = false;
        restorePending = true;
        var completion = pending;
        pending = null;
        completion?.TrySetResult(confirmed);
    }

    public ValueTask DisposeAsync()
    {
        pending?.TrySetResult(false);
        return ValueTask.CompletedTask;
    }
}
