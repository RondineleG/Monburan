@* Marca da Monburan, "O Chamado": o sino com a cruz gravada (o X que marca o tesouro) entre duas penas que se abrem
   em M. A partir de 64px entra a versão completa (barbas das penas, aros do sino e o mar, o caminho de volta); abaixo,
   a versão simplificada, legível em 16px. Decorativa; as cores vêm dos tokens --brand-* de cada tema. *@
@if (Detailed)
{
    <svg class="brand-mark brand-mark--full@(Extra)" viewBox="20 20 160 168" width="@Size" height="@Size" focusable="false" aria-hidden="true">
        <defs>
            <linearGradient id="@_gradient" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" class="brand-mark__stop1" /><stop offset=".35" class="brand-mark__stop2" />
                <stop offset=".62" class="brand-mark__stop3" /><stop offset="1" class="brand-mark__stop4" />
            </linearGradient>
        </defs>
        @foreach (var feather in FullFeathers)
        {
            <g class="brand-mark__feather" transform="@feather">
                <path class="brand-mark__vane" d="M0 -6 C-11 -20 -13 -52 0 -88 C11 -52 10 -20 0 -6 Z" />
                <path class="brand-mark__rachis" stroke-width="1.6" d="M0 4 L0 -84" />
                <path class="brand-mark__rachis" stroke-width="1.3" d="M0 -26 L-8 -33 M0 -42 L-9.5 -50 M0 -58 L-7.5 -66 M0 -34 L8 -41 M0 -50 L8.5 -58 M0 -66 L5.5 -73" />
                <path class="brand-mark__down" d="M-6 -14 L-12 -18 M6 -16 L11 -20" />
            </g>
        }
        <g class="brand-mark__bell" transform="translate(100 98) scale(1.22) translate(-100 -98)">
            <path class="brand-mark__metal-line" stroke-width="3.2" d="M93 68 L93 63 C93 55 107 55 107 63 L107 68" />
            <path fill="url(#@_gradient)" d="@BellBody" />
            <path class="brand-mark__engrave" stroke-width="1" d="M83.6 80 L116.4 80 M83.2 84.5 L116.8 84.5 M80 110 L120 110 M76.5 116 L123.5 116" />
            <path class="brand-mark__engrave" stroke-width="3" stroke-linecap="round" d="M93 91 L107 104 M107 91 L93 104" />
            <path class="brand-mark__metal-line" stroke-width="3.4" stroke-linecap="round" d="M64 125.5 L136 125.5" />
            <circle class="brand-mark__metal brand-mark__clapper" cx="100" cy="133" r="4.4" />
        </g>
        <path class="brand-mark__metal-line" stroke-width="2" stroke-linecap="round" d="M44 168 C60 162 76 172 100 166 C124 160 140 172 156 166" />
        <path class="brand-mark__metal-line" stroke-width="1.2" stroke-linecap="round" opacity=".55" d="M58 176 C72 172 84 179 100 175 C116 171 128 179 142 176" />
    </svg>
}
else
{
    <svg class="brand-mark@(Extra)" viewBox="18 18 164 164" width="@Size" height="@Size" focusable="false" aria-hidden="true">
        <defs>
            <linearGradient id="@_gradient" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" class="brand-mark__stop1" /><stop offset=".35" class="brand-mark__stop2" />
                <stop offset=".62" class="brand-mark__stop3" /><stop offset="1" class="brand-mark__stop4" />
            </linearGradient>
        </defs>
        @foreach (var feather in SmallFeathers)
        {
            <g class="brand-mark__feather" transform="@feather">
                <path class="brand-mark__vane" d="M0 -6 C-12 -20 -14 -54 0 -90 C12 -54 11 -20 0 -6 Z" />
                <path class="brand-mark__rachis" stroke-width="3" d="M0 4 L0 -84" />
            </g>
        }
        <g class="brand-mark__bell" transform="translate(100 98) scale(1.3) translate(-100 -98)">
            <path class="brand-mark__metal-line" stroke-width="4.5" d="M93 68 L93 63 C93 55 107 55 107 63 L107 68" />
            <path fill="url(#@_gradient)" d="@BellBody" />
            <path class="brand-mark__engrave" stroke-width="5" stroke-linecap="round" d="M92 90 L108 105 M108 90 L92 105" />
            <circle class="brand-mark__metal brand-mark__clapper" cx="100" cy="134" r="5.5" />
        </g>
    </svg>
}

@code {
    private const string BellBody = "M84 75 C84 70 89 68 100 68 C111 68 116 70 116 75 L118 98 C119 110 124 117 133 121 L133 125 L67 125 L67 121 C76 117 81 110 82 98 Z";
    private static readonly string[] FullFeathers = ["translate(76 128) rotate(-30)", "translate(124 128) rotate(30)"];
    private static readonly string[] SmallFeathers = ["translate(74 130) rotate(-30) scale(1.08)", "translate(126 130) rotate(30) scale(1.08)"];

    // Cada instância tem o próprio degradê: com id repetido, uma marca escondida (menu fechado) apagaria as outras
    private readonly string _gradient = "brand-bell-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter]
    public int Size { get; set; } = 32;

    [Parameter]
    public string? Class { get; set; }

    private bool Detailed => Size >= 64;

    private string Extra => string.IsNullOrEmpty(Class) ? string.Empty : " " + Class;
}
