@rendermode InteractiveServer
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Jobs
@using Monburan.Web.Services
@inject SaveJobUseCase SaveJobUseCase
@inject UnsaveJobUseCase UnsaveJobUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject IToastService Toast

@* Botão de salvar vaga, interativo por conta própria: o restante da página pode continuar estático. *@
@if (CanSave)
{
    @* O texto já diz o estado ("Salva"/"Salvar"); aria-pressed repetiria a mesma informação *@
    <button type="button"
            class="btn btn-outline-secondary btn-sm save-job-button@(IsSaved ? " is-saved" : string.Empty)"
            disabled="@isWorking"
            aria-busy="@(isWorking ? "true" : null)"
            data-testid="save-job-button"
            @onclick="ToggleAsync">
        <Icon Name="star" Size="16" />
        @(IsSaved ? "Salva" : "Salvar")
    </button>
}
else
{
    <a class="btn btn-outline-secondary btn-sm save-job-button" href="@LoginUrl" data-testid="save-job-login">
        <Icon Name="star" Size="16" />Entrar para salvar
    </a>
}

@code {
    /// <summary>Vaga salva pelo candidato logado.</summary>
    [Parameter]
    public bool IsSaved { get; set; }

    /// <summary>Candidato autenticado: pode salvar. Visitante recebe o convite para entrar.</summary>
    [Parameter]
    public bool CanSave { get; set; }

    [Parameter]
    public Guid JobId { get; set; }

    /// <summary>Página atual, para voltar depois do login.</summary>
    [Parameter]
    public string? ReturnUrl { get; set; }

    private bool isWorking;

    private string LoginUrl =>
        $"/Account/Login?returnUrl={Uri.EscapeDataString(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl)}";

    private async Task ToggleAsync()
    {
        // Clique duplo antes do re-render não pode salvar e dessalvar
        if (isWorking)
            return;

        var candidateId = CurrentUserHelper.GetCandidateId();
        if (candidateId is null)
            return;

        isWorking = true;
        try
        {
            var wasSaved = IsSaved;
            var result = wasSaved
                ? await UnsaveJobUseCase.ExecuteAsync(new UnsaveJobRequest(candidateId.Value, JobId))
                : await SaveJobUseCase.ExecuteAsync(new SaveJobRequest(candidateId.Value, JobId));

            if (result.Status == EResultStatus.Success)
            {
                IsSaved = !wasSaved;
                Toast.ShowSuccess(
                    IsSaved ? "Ela fica na aba Vagas salvas de Minhas candidaturas." : "Vaga removida das suas vagas salvas.",
                    IsSaved ? "Vaga salva" : "Vaga removida");
            }
            else
            {
                Toast.ShowError("Não foi possível atualizar suas vagas salvas. Tente novamente.");
            }
        }
        finally
        {
            // Falha inesperada não pode deixar o botão travado em "ocupado"
            isWorking = false;
        }
    }
}
