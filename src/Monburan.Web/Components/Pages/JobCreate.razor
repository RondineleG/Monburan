@page "/vagas/nova"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdvertiserOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Advertisers
@using Monburan.Core.UseCases.Jobs
@using Monburan.Core.UseCases.Subscriptions
@using Monburan.Web.Services
@inject CreateJobUseCase CreateJobUseCase
@inject GetAdvertiserByIdUseCase GetAdvertiserByIdUseCase
@inject CheckJobLimitUseCase CheckJobLimitUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<JobCreate> Logger

<PageTitle>Nova vaga - Monburan</PageTitle>

@if (isAdvertiser)
{
<div class="container page-form-shell">
    <PageHeader Title="Publicar vaga"
                Description="Compartilhe uma descrição clara para atrair pessoas alinhadas à oportunidade."
                BackHref="/minhas-vagas"
                BackText="Minhas vagas" />
    <div class="row">
        <div class="col-12">

            @if (jobLimit is { CanCreate: false })
            {
                <div class="alert alert-warning" role="status" data-testid="job-limit-reached">
                    <strong>Você atingiu o limite do plano @UiLabels.PlanName(jobLimit.PlanName).</strong>
                    Ele permite até @jobLimit.MaxJobs vagas ativas ao mesmo tempo.
                    Encerre uma vaga em <a href="/minhas-vagas">Minhas vagas</a> ou <a href="/plans">mude de plano</a> para publicar outra.
                </div>
            }

            <div class="card page-form-card">
                <div class="card-body">
                    <JobWizard @ref="wizard"
                               Model="model"
                               CompanyName="@CompanyName"
                               IsSubmitting="isSubmitting"
                               CanPublish="jobLimit is not { CanCreate: false }"
                               ServerError="@errorMessage"
                               OnSubmit="SubmitForm"
                               OnCancel="Cancel" />
                </div>
            </div>
        </div>
    </div>
</div>
}
else
{
    <AccessRestricted Reason="Esta área é exclusiva para empresas." />
}

@code {
    private CreateJobRequest model = new()
    {
        NumberOfOpenings = 1,
        ExpirationDate = DateTime.UtcNow.AddDays(30),
        Country = "BR",
        Type = "OnSite",
        ShowAddress = true,
        SalaryCurrency = "BRL",
        SalaryDisplay = true,
        SalaryPeriod = Core.Enums.ESalaryPeriod.Month
    };

    private string errorMessage = string.Empty;
    private bool isSubmitting;
    private bool isAdvertiser;
    private string? CompanyName;
    private CheckJobLimitResponse? jobLimit;
    private JobWizard wizard = default!;

    protected override async Task OnInitializedAsync()
    {
        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        isAdvertiser = advertiserId.HasValue;
        if (!isAdvertiser)
            return;

        // Avisa do limite antes de a pessoa preencher o formulário inteiro
        var limit = await CheckJobLimitUseCase.ExecuteAsync(new CheckJobLimitRequest(advertiserId!.Value));
        if (limit.Status == EResultStatus.Success)
            jobLimit = limit.Data;

        var advertiser = await GetAdvertiserByIdUseCase.ExecuteAsync(advertiserId!.Value);
        if (advertiser.Status == EResultStatus.Success && advertiser.Data is not null)
            CompanyName = advertiser.Data.Name;
    }

    private async Task SubmitForm()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = string.Empty;

        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        if (!advertiserId.HasValue)
        {
            errorMessage = "Somente contas de empresa podem publicar vagas.";
            isSubmitting = false;
            return;
        }

        model.AdvertiserId = advertiserId.Value;
        model.IsRemote = model.Type is "Remote" or "Hybrid";

        var result = await CreateJobUseCase.ExecuteAsync(model);

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess("Sua vaga já está visível para os candidatos.", "Vaga publicada");
            Navigation.NavigateTo($"/jobs/{result.Data!.Id}");
            return;
        }

        // Validação de domínio voltava com Message vazio: a tela não mostrava nada
        Logger.LogFailure(result, "Publicar vaga");
        var fieldErrors = ResultMessages.FieldErrors(result);
        var unmatched = wizard.DisplayServerFieldErrors(fieldErrors);
        // Erros de campo: o assistente mostra a etapa e o campo. Mensagem geral só para o que não tem campo,
        // num alerta da página (sem toast repetindo)
        errorMessage = fieldErrors.Count > 0 && unmatched.Count == 0
            ? string.Empty
            : ResultMessages.ToUserMessage(result, "Não foi possível publicar a vaga. Tente novamente.");

        isSubmitting = false;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/minhas-vagas");
    }
}
