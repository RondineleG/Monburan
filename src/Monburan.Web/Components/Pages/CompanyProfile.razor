@page "/companies/{advertiserId:guid}"
@* Página pública renderizada no servidor (como a da vaga): indexável e com 404 de verdade para empresa inexistente *@
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.Interfaces.Repositories
@using Monburan.Core.UseCases.Jobs
@using Monburan.Core.ValueObjects
@using Monburan.Web.Services
@inject SearchJobsUseCase SearchJobsUseCase
@inject IAdvertiserRepository AdvertiserRepository
@inject ICurrentUserHelper CurrentUserHelper
@inject ILogger<CompanyProfile> Logger

<PageTitle>@(advertiser?.Name ?? (loadFailed ? "Empresa" : "Empresa não encontrada")) - Monburan</PageTitle>

<HeadContent>
    @if (advertiser is null)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <meta name="description" content="Vagas abertas na @advertiser.Name - Monburan" />
    }
</HeadContent>

<div class="container mt-4">
    @if (loadFailed)
    {
        <section class="empty-state error-state" role="alert" data-testid="error-state">
            <span class="empty-state__icon error-state__icon" aria-hidden="true">!</span>
            <h1 tabindex="-1">Não foi possível carregar a empresa</h1>
            <p>Tivemos um problema ao abrir este perfil. Tente novamente em instantes.</p>
            <a class="btn btn-primary" href="/companies/@AdvertiserId" data-enhance-nav="false" data-testid="error-retry">Tentar novamente</a>
        </section>
    }
    else if (advertiser is null)
    {
        <EmptyState Icon="?" Title="Empresa não encontrada" HeadingLevel="1" Message="Ela pode ter sido removida ou o link está incorreto." TestId="company-not-found">
            <a class="btn btn-primary" href="/jobs">Ver vagas abertas</a>
        </EmptyState>
    }
    else
    {
        <header class="page-heading">
            <div class="page-heading__copy">
                <span class="page-kicker">EMPRESA</span>
                <h1>@advertiser.Name</h1>
                @if (!string.IsNullOrWhiteSpace(advertiser.CompanyDescription))
                {
                    <p>@advertiser.CompanyDescription</p>
                }
            </div>
            @if (isOwner)
            {
                <a class="btn btn-primary" href="/jobs/create">Publicar vaga</a>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(advertiser.Website))
        {
            <p class="mb-4"><a href="@advertiser.Website" target="_blank" rel="noopener noreferrer">@advertiser.Website</a></p>
        }

        <h2 class="h4 mb-3">Vagas abertas (@jobs.TotalCount)</h2>
        @if (jobs.TotalCount > jobs.Jobs.Count())
        {
            <p class="text-muted" data-testid="company-jobs-truncated">Mostrando as @jobs.Jobs.Count() vagas mais recentes.</p>
        }

        @if (jobs.Jobs.Any())
        {
            <div class="jobs-grid">
                @foreach (var job in jobs.Jobs)
                {
                    <JobCard @key="job.Id" Job="job" />
                }
            </div>
        }
        else
        {
            <EmptyState Icon="▣" Title="Nenhuma vaga aberta" Message="Esta empresa não tem vagas publicadas no momento.">
                <a class="btn btn-outline-secondary" href="/jobs">Ver todas as vagas</a>
            </EmptyState>
        }
    }
</div>

@code {
    [Parameter]
    public Guid AdvertiserId { get; set; }

    private Monburan.Core.Entities.Advertiser? advertiser;
    private ListJobsResponse jobs = new();
    private bool loadFailed;
    private bool isOwner;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isOwner = CurrentUserHelper.GetAdvertiserId() == AdvertiserId;

        var found = AdvertiserId == Guid.Empty
            ? null
            : await AdvertiserRepository.GetByIdAsync(Id.Create(AdvertiserId));
        if (found?.Status == EResultStatus.Success && found.Data is not null)
            advertiser = found.Data;
        else if (found is not null && found.Status != EResultStatus.EntityNotFound)
        {
            // Falha de consulta não se disfarça de "não existe"
            Logger.LogFailure(found, "Carregar perfil público da empresa");
            loadFailed = true;
            return;
        }

        if (advertiser is null)
        {
            // Mesmo cuidado da página da vaga: o 404 só entra quando os cabeçalhos saem, senão o corpo some
            if (HttpContext is { Response.HasStarted: false } http)
                http.Response.OnStarting(() =>
                {
                    http.Response.StatusCode = StatusCodes.Status404NotFound;
                    return Task.CompletedTask;
                });
            return;
        }

        var result = await SearchJobsUseCase.ExecuteAsync(new ListJobsRequest
        {
            AdvertiserId = AdvertiserId,
            Size = 50
        });
        if (result.Status == EResultStatus.Success && result.Data is not null)
            jobs = result.Data;
        else if (result.Status != EResultStatus.Success)
            Logger.LogFailure(result, "Listar vagas da empresa");
    }
}
