@page "/jobs/edit/{jobId:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdvertiserOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Jobs
@using Monburan.Web.Services
@inject GetJobByIdUseCase GetJobByIdUseCase
@inject UpdateJobUseCase UpdateJobUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<JobEdit> Logger

<PageTitle>Editar Vaga - Monburan</PageTitle>

<div class="container mt-4 page-form-shell">
    @if (isLoading)
    {
        <LoadingState Message="Carregando a vaga..." />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar a vaga"
                    Message="Tivemos um problema ao abrir esta vaga para edição. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (!isJobOwner)
    {
        <section class="auth-message-page">
            <h1>Vaga não encontrada</h1>
            <p>Esta vaga não existe ou pertence a outra empresa.</p>
            <a class="btn btn-primary" href="/my-jobs">Voltar para Minhas vagas</a>
        </section>
    }
    else
    {
        <header class="page-heading">
            <div class="page-heading__copy">
                <span class="page-kicker">ÁREA DA EMPRESA</span>
                <h1>Editar vaga</h1>
                <p>Atualize as informações da publicação. O que os candidatos já enviaram continua valendo.</p>
            </div>
        </header>
        <div class="row">
            <div class="col-12">
                <div class="card page-form-card">
                    <div class="card-body">
                        <JobWizard @ref="wizard"
                                   Model="draft"
                                   IsEdit="true"
                                   CompanyName="@companyName"
                                   IsSubmitting="isSubmitting"
                                   ServerError="@errorMessage"
                                   OnSubmit="SubmitForm"
                                   OnCancel="Cancel" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid JobId { get; set; }

    private CreateJobRequest draft = new();
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isJobOwner;
    private bool isSubmitting;
    private string? companyName;
    private JobWizard wizard = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        var result = await GetJobByIdUseCase.ExecuteAsync(JobId);

        if (result.Status != EResultStatus.Success || result.Data is null)
        {
            if (result.Status != EResultStatus.EntityNotFound)
            {
                Logger.LogFailure(result, "Carregar vaga para edição");
                loadFailed = true;
            }

            isJobOwner = false;
            isLoading = false;
            return;
        }

        var job = result.Data;
        isJobOwner = advertiserId.HasValue && job.AdvertiserId == advertiserId.Value;
        if (!isJobOwner)
        {
            isLoading = false;
            return;
        }

        companyName = job.AdvertiserName;
        // Vaga antiga com categoria em texto livre e sem contrato/período continua editável
        draft = new CreateJobRequest
        {
            AdvertiserId = job.AdvertiserId,
            Title = job.Title,
            Description = job.Description,
            Requirements = job.Requirements,
            Responsibilities = job.Responsibilities,
            Benefits = job.Benefits,
            ApplicationInstructions = job.ApplicationInstructions,
            NumberOfOpenings = job.NumberOfOpenings,
            Observations = job.Observations,
            Category = job.Category,
            Tags = job.Tags,
            ContractType = Enum.TryParse<EContractType>(job.ContractType, out var contractType) ? contractType : null,
            ExpirationDate = job.ExpirationDate,
            City = job.City,
            State = job.State,
            Type = job.Type ?? "OnSite",
            IsRemote = job.IsRemote,
            ShowAddress = true,
            SalaryMin = job.SalaryMin,
            SalaryMax = job.SalaryMax,
            SalaryPeriod = Enum.TryParse<ESalaryPeriod>(job.SalaryPeriod, out var salaryPeriod) ? salaryPeriod : null,
            SalaryCurrency = job.SalaryCurrency ?? "BRL",
            SalaryDisplay = job.SalaryDisplay
        };

        isLoading = false;
    }

    private async Task SubmitForm()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = string.Empty;

        draft.IsRemote = draft.Type is "Remote" or "Hybrid";

        var result = await UpdateJobUseCase.ExecuteAsync(new UpdateJobRequest
        {
            Id = JobId,
            Title = draft.Title,
            Description = draft.Description,
            Requirements = draft.Requirements,
            Responsibilities = draft.Responsibilities,
            Benefits = draft.Benefits,
            ApplicationInstructions = draft.ApplicationInstructions,
            NumberOfOpenings = draft.NumberOfOpenings,
            Observations = draft.Observations,
            Category = draft.Category,
            Tags = draft.Tags,
            ContractType = draft.ContractType,
            ExpirationDate = draft.ExpirationDate,
            City = draft.City,
            State = draft.State,
            Country = draft.Country,
            Type = draft.Type,
            IsRemote = draft.IsRemote,
            ShowAddress = draft.ShowAddress,
            SalaryMin = draft.SalaryMin,
            SalaryMax = draft.SalaryMax,
            SalaryPeriod = draft.SalaryPeriod,
            SalaryCurrency = draft.SalaryCurrency,
            SalaryDisplay = draft.SalaryDisplay
        });

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess($"As alterações em \"{draft.Title}\" foram salvas.", "Vaga atualizada");
            Navigation.NavigateTo("/my-jobs");
            return;
        }

        Logger.LogFailure(result, "Atualizar vaga");
        var fieldErrors = ResultMessages.FieldErrors(result);
        var unmatched = wizard.DisplayServerFieldErrors(fieldErrors);
        errorMessage = fieldErrors.Count > 0 && unmatched.Count == 0
            ? "Revise os campos destacados no formulário."
            : ResultMessages.ToUserMessage(result, "Não foi possível salvar a vaga. Tente novamente.");
        Toast.ShowError(errorMessage);

        isSubmitting = false;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/my-jobs");
    }
}
