@page "/plans"
@rendermode InteractiveServer
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.UseCases.Subscriptions
@inject GetAvailablePlansUseCase GetAvailablePlansUseCase
@inject UpgradePlanUseCase UpgradePlanUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<Plans> Logger

<PageTitle>Planos e preços - Monburan</PageTitle>

<div class="container plans-page">
    <PageHeader Title="Planos para crescer no seu ritmo" Description="Compare os recursos e escolha o que faz sentido para suas contratações." />

    @if (isLoading)
    {
        <LoadingState Message="Carregando planos…" />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar os planos"
                    Message="Tivemos um problema ao buscar os planos disponíveis. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (availablePlans is null || availablePlans.Plans.Count == 0)
    {
        <EmptyState Icon="banknote" Title="Nenhum plano disponível no momento" Message="Volte em breve para conhecer as opções para empresas." />
    }
    else
    {
        @if (availablePlans.CurrentSubscription != null)
        {
            <div class="alert alert-info d-flex align-items-center mb-4" role="status">
                <div>
                    <strong>Seu plano atual:</strong> @UiLabels.PlanName(availablePlans.CurrentSubscription.PlanName)
                    @if (availablePlans.CurrentSubscription.EndDate.HasValue)
                    {
                        <span class="ms-2">· Válido até @UiLabels.FormatMomentDate(availablePlans.CurrentSubscription.EndDate)</span>
                    }
                </div>
            </div>
        }
        else if (!isAdvertiser)
        {
            <div class="alert alert-info d-flex align-items-center mb-4" role="note">
                <div>
                    <strong>Planos para empresas.</strong> Os recursos abaixo valem para contas de empresa — candidatos usam o Monburan gratuitamente.
                </div>
            </div>
        }

        <div class="row g-4 plans-grid">
            @foreach (var plan in availablePlans.Plans.OrderBy(p => p.Price))
            {
                var isCurrentPlan = availablePlans.CurrentSubscription?.PlanName == plan.Name;
                var isFeatured = plan.Name == "Premium";

                <div class="col-md-4">
                    <div class="card h-100 plan-card @(isCurrentPlan ? "plan-card--current" : isFeatured ? "plan-card--featured" : "")">
                        <div class="plan-card__ribbon">
                            @if (isCurrentPlan)
                            {
                                <span><Icon Name="check" Size="16" /> Plano atual</span>
                            }
                            else if (isFeatured)
                            {
                                <span><Icon Name="star" Size="16" /> Mais escolhido</span>
                            }
                        </div>
                        <div class="card-body">
                            <h2 class="card-title text-center">@UiLabels.PlanName(plan.Name)</h2>
                            <p class="plan-card__desc text-center">@plan.Description</p>

                            <div class="plan-card__price text-center">
                                @if (plan.Price == 0)
                                {
                                    <strong>Grátis</strong>
                                }
                                else
                                {
                                    <strong>R$ @plan.Price.ToString("N2")</strong>
                                    <small>@PeriodSuffix(plan)</small>
                                }
                            </div>

                            @* Só recursos aplicados pelo backend: o limite de vagas ativas (CreateJobUseCase).
                               Boost, destaque e analytics por plano não têm implementação — não são anunciados. *@
                            <ul class="list-unstyled">
                                <li>
                                    <Icon Name="briefcase" Size="16" />
                                    @(plan.MaxJobs == -1 ? "Vagas ativas ilimitadas" : $"Até {plan.MaxJobs} vagas ativas ao mesmo tempo")
                                </li>
                                <li>
                                    <Icon Name="users" Size="16" />
                                    Candidaturas ilimitadas em cada vaga
                                </li>
                                <li>
                                    <Icon Name="layout" Size="16" />
                                    Painel com indicadores das suas vagas
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-transparent text-center">
                            @if (isAdvertiser)
                            {
                                if (isCurrentPlan)
                                {
                                    <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                        Plano atual
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary w-100" @onclick="() => ChangePlanAsync(plan)" disabled="@(changingPlanId is not null)"
                                            aria-busy="@(changingPlanId == plan.Id ? "true" : null)"
                                            aria-label="@(plan.Price == 0 ? "Mudar para o plano" : "Fazer upgrade para o plano") @UiLabels.PlanName(plan.Name)">
                                        @if (changingPlanId == plan.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                            <span>Ativando…</span>
                                        }
                                        else
                                        {
                                            @(plan.Price == 0 ? "Mudar para este plano" : "Fazer upgrade")
                                        }
                                    </button>
                                }
                            }
                            else if (isCandidate)
                            {
                                <span class="plan-card__note">Exclusivo para contas de empresa</span>
                            }
                            else
                            {
                                <a class="btn btn-primary w-100" href="/criar-conta?AccountType=advertiser">
                                    Criar conta de empresa
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!isAdvertiser && !isCandidate)
        {
            <p class="plans-footnote">Já tem conta de empresa? <a href="/entrar?ReturnUrl=%2Fplans">Entre para assinar</a>.</p>
        }
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    // O preço do plano anual é anual: o rótulo não pode dizer "/mês"
    private static string PeriodSuffix(PlanResponse plan) => plan.Period == "Annual" ? "/ano" : "/mês";

    private AvailablePlansResponse? availablePlans;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isAdvertiser;
    private bool isCandidate;
    private Guid? changingPlanId;
    private ConfirmDialog confirmDialog = default!;

    protected override async Task OnInitializedAsync()
    {
        isAdvertiser = CurrentUserHelper.GetAdvertiserId().HasValue;
        isCandidate = CurrentUserHelper.GetCandidateId().HasValue;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        var result = await GetAvailablePlansUseCase.ExecuteAsync(CurrentUserHelper.GetAdvertiserId() ?? Guid.Empty);
        if (result.Status == Core.Enums.EResultStatus.Success)
        {
            availablePlans = result.Data;
        }
        else
        {
            Logger.LogFailure(result, "Carregar planos");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task ChangePlanAsync(PlanResponse plan)
    {
        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        if (!advertiserId.HasValue || changingPlanId is not null)
            return;

        var price = plan.Price == 0 ? "gratuito" : $"R$ {plan.Price:N2} por {(plan.Period == "Annual" ? "ano" : "mês")}";
        var limit = plan.MaxJobs == -1 ? "vagas ativas ilimitadas" : $"até {plan.MaxJobs} vagas ativas";
        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = $"Mudar para o plano {UiLabels.PlanName(plan.Name)}?",
            Message = $"O plano {UiLabels.PlanName(plan.Name)} ({price}, {limit}) substitui o plano atual a partir de agora.",
            ConfirmText = "Confirmar mudança"
        });
        if (!confirmed)
            return;

        changingPlanId = plan.Id;
        var result = await UpgradePlanUseCase.ExecuteAsync(new UpgradePlanRequest
        {
            AdvertiserId = advertiserId.Value,
            NewPlanId = plan.Id,
            PaymentMethod = "manual"
        });
        changingPlanId = null;

        if (result.Status == Core.Enums.EResultStatus.Success)
        {
            Toast.ShowSuccess($"Seu plano agora é o {UiLabels.PlanName(plan.Name)}.", "Plano atualizado");
            Navigation.NavigateTo("/minha-assinatura");
            return;
        }

        Logger.LogFailure(result, "Mudar de plano");
        Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível mudar de plano. Tente novamente."));
    }
}
