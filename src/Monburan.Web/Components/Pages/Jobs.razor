@page "/jobs"
@using System.Globalization
@using Monburan.Core.Enums
@inject SearchJobsUseCase SearchJobsUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject ILogger<Jobs> Logger

@* Página pública, renderizada no servidor: a busca inteira vive na URL (?q=&local=&modo=&salario=&ordem=&pagina=),
   então o botão Voltar, o compartilhamento e o recarregamento reproduzem a mesma lista. O formulário é GET e o
   Blazor o trata como navegação melhorada (data-enhance); os filtros enviam o formulário ao mudar (monburan-ui.js).
   O endereço não leva âncora (#): com ela o Blazor entende o Voltar como mudança só de âncora e não recarrega a lista. *@

<PageTitle>@TitleText</PageTitle>

<HeadContent>
    <meta name="description" content="Encontre vagas de emprego por cargo, cidade e modalidade de trabalho. Candidate-se gratuitamente no Monburan." />
    <meta property="og:title" content="Vagas de emprego - Monburan" />
    <meta property="og:description" content="Busque por cargo, cidade e modalidade de trabalho e candidate-se gratuitamente." />
    <meta property="og:type" content="website" />
    @if (isFiltered || page > 1)
    {
        @* Cada combinação de filtros é uma página nova: só a lista sem filtros entra no índice *@
        <meta name="robots" content="noindex, follow" />
    }
</HeadContent>

<div class="container jobs-page">
    <header class="jobs-header">
        <div>
            <span class="page-kicker">OPORTUNIDADES ABERTAS</span>
            <h1 class="jobs-header__title">Encontre sua próxima vaga</h1>
        </div>
        @if (isAdvertiser)
        {
            <a class="btn btn-outline-primary" href="/jobs/create">Publicar uma vaga <span aria-hidden="true">↗</span></a>
        }
        else if (!isAuthenticated)
        {
            <a class="btn btn-outline-primary" href="/Account/Register?AccountType=advertiser">Para empresas <span aria-hidden="true">↗</span></a>
        }
    </header>

    <form id="jobs-search-form" class="jobs-search" method="get" action="/jobs" role="search"
          aria-label="Buscar vagas" data-enhance data-clean-query data-scroll-results data-testid="jobs-search-form">
        <div class="jobs-search__bar">
            <label class="search-field">
                <Icon Name="search" Size="20" />
                <span class="visually-hidden">Cargo, habilidade ou palavra-chave</span>
                <input id="job-search" name="q" type="search" value="@searchTerm" maxlength="100" autocomplete="off"
                       enterkeyhint="search" placeholder="Cargo, habilidade ou palavra-chave" data-testid="job-search" />
            </label>
            <label class="search-field">
                <Icon Name="map-pin" Size="20" />
                <span class="visually-hidden">Cidade ou estado</span>
                <input id="job-location" name="local" type="text" value="@locationText" maxlength="80" autocomplete="off"
                       enterkeyhint="search" placeholder="Cidade ou estado" data-testid="job-location" />
            </label>
            <button type="submit" class="btn btn-primary btn-cta jobs-search__submit" data-testid="job-search-submit">Buscar vagas</button>
        </div>

        <div class="jobs-filters">
            <fieldset class="chip-group">
                <legend class="visually-hidden">Modalidade de trabalho</legend>
                <label class="chip" data-testid="filter-mode-all">
                    <input type="radio" name="modo" value="" checked="@(jobType.Length == 0)" data-autosubmit data-default="" />
                    <span>Todas</span>
                </label>
                @foreach (var mode in Modes)
                {
                    <label class="chip" data-testid="@($"filter-mode-{mode.Value}")">
                        <input type="radio" name="modo" value="@mode.Value" checked="@(jobType == mode.Value)" data-autosubmit data-default="" />
                        <span><Icon Name="@mode.Icon" Size="15" />@mode.Label</span>
                    </label>
                }
            </fieldset>

            <label class="chip-select@(salaryFloor.Length > 0 ? " is-active" : string.Empty)">
                <span class="visually-hidden">Salário mínimo</span>
                <select name="salario" data-autosubmit data-default="" data-testid="filter-salary">
                    <option value="">Qualquer salário</option>
                    @foreach (var floor in SalaryFloors)
                    {
                        var value = floor.ToString(CultureInfo.InvariantCulture);
                        <option value="@value" selected="@(salaryFloor == value)">A partir de R$ @JobDisplay.Money(floor)</option>
                    }
                </select>
                <Icon Name="chevron-down" Size="14" />
            </label>

            @if (isFiltered)
            {
                @* Navegação completa de propósito: recarrega a página e esvazia os campos do formulário *@
                <a class="chip-clear" href="/jobs" data-enhance-nav="false" data-testid="filters-clear">
                    <Icon Name="rotate-ccw" Size="14" />Limpar filtros
                </a>
            }
        </div>
    </form>

    @if (loadFailed)
    {
        <section class="empty-state error-state" role="alert" data-testid="error-state">
            <span class="empty-state__icon error-state__icon" aria-hidden="true">!</span>
            <h2>Não foi possível carregar as vagas</h2>
            <p>Tivemos um problema ao buscar as oportunidades. Tente novamente em instantes.</p>
            <a class="btn btn-primary" href="@Navigation.Uri" data-enhance-nav="false" data-testid="error-retry">Tentar novamente</a>
        </section>
    }
    else
    {
        <section id="jobs-results" class="jobs-results" aria-labelledby="jobs-results-title"
                 data-testid="jobs-results" data-sort="@sortKey" data-mode="@jobType" data-page="@(page)">
            <div class="jobs-results__bar">
                <div>
                    <h2 id="jobs-results-title" class="jobs-results__title" data-testid="jobs-count">@CountText</h2>
                    @if (ContextText is not null)
                    {
                        <p class="jobs-results__context" data-testid="jobs-context">@ContextText</p>
                    }
                </div>
                <label class="chip-select chip-select--sort">
                    <span class="chip-select__label">Ordenar por</span>
                    <select name="ordem" form="jobs-search-form" data-autosubmit data-default="@DefaultSort" data-testid="jobs-sort">
                        <option value="recentes" selected="@(sortKey == "recentes")">Mais recentes</option>
                        <option value="salario" selected="@(sortKey == "salario")">Maior salário</option>
                        <option value="titulo" selected="@(sortKey == "titulo")">Título (A–Z)</option>
                    </select>
                    <Icon Name="chevron-down" Size="14" />
                </label>
                @if (isCandidate)
                {
                    <a class="btn btn-outline-primary btn-sm" href="@AlertUrl" data-testid="create-job-alert">
                        <Icon Name="bell" Size="14" />Criar alerta com esta busca
                    </a>
                }
            </div>

            @if (!results.Jobs.Any())
            {
                <EmptyState Icon="⌕"
                            Title="Nenhuma vaga encontrada"
                            Message="Tente outras palavras-chave, remova algum filtro ou volte mais tarde — novas vagas são publicadas todos os dias."
                            TestId="jobs-empty">
                    @if (isFiltered)
                    {
                        <a class="btn btn-outline-primary" href="/jobs" data-enhance-nav="false">Limpar filtros</a>
                    }
                </EmptyState>
            }
            else
            {
                <div class="jobs-grid" data-testid="jobs-grid">
                    @foreach (var job in results.Jobs)
                    {
                        <JobCard @key="job.Id" Job="job" IsOwner="@(advertiserId.HasValue && job.AdvertiserId == advertiserId.Value)"
                                 ShowSave="@(isCandidate || !isAuthenticated)" CanSave="isCandidate" SaveReturnUrl="@Navigation.Uri" />
                    }
                </div>

                @if (results.TotalPages > 1)
                {
                    <nav class="jobs-pagination" aria-label="Paginação das vagas">
                        <ul class="pagination justify-content-center">
                            @if (results.HasPreviousPage)
                            {
                                <li class="page-item"><a class="page-link" href="@PageUrl(page - 1)" rel="prev" data-scroll-results>Anterior</a></li>
                            }
                            @foreach (var number in VisiblePages())
                            {
                                <li class="page-item @(number == page ? "active" : string.Empty)">
                                    <a class="page-link" href="@PageUrl(number)" aria-current="@(number == page ? "page" : null)" data-scroll-results>@number</a>
                                </li>
                            }
                            @if (results.HasNextPage)
                            {
                                <li class="page-item"><a class="page-link" href="@PageUrl(page + 1)" rel="next" data-scroll-results>Próxima</a></li>
                            }
                        </ul>
                    </nav>
                }

                <p class="jobs-footnote">Mostrando @RangeStart–@RangeEnd de @results.TotalCount.ToString("N0", PtBr) @(results.TotalCount == 1 ? "vaga" : "vagas")</p>
            }
        </section>

        @* Convite para empresas só para quem ainda não tem conta: a empresa logada já publica pelo topo *@
        @if (!isAuthenticated)
        {
            <aside class="promo-strip" aria-label="Para empresas">
                <span class="promo-strip__tag">Para empresas</span>
                <div class="promo-strip__body">
                    <p class="promo-strip__title">Sua empresa contratando por aqui</p>
                    <p class="promo-strip__text">Publique vagas gratuitamente e receba candidaturas organizadas em um só lugar.</p>
                </div>
                <a class="btn btn-outline-primary" href="/plans">Ver planos <span aria-hidden="true">↗</span></a>
            </aside>
        }
    }
</div>

@code {
    private const int PageSize = 20;
    private const string DefaultSort = "recentes";

    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");

    private static readonly (string Value, string Label, string Icon)[] Modes =
    [
        ("Remote", "Remoto", "home"),
        ("Hybrid", "Híbrido", "shuffle"),
        ("OnSite", "Presencial", "building")
    ];

    private static readonly decimal[] SalaryFloors = [1500, 2500, 4000, 6000, 8000, 12000, 20000];

    [SupplyParameterFromQuery(Name = "q")]
    private string? QueryTerm { get; set; }

    [SupplyParameterFromQuery(Name = "local")]
    private string? QueryLocation { get; set; }

    [SupplyParameterFromQuery(Name = "modo")]
    private string? QueryMode { get; set; }

    [SupplyParameterFromQuery(Name = "salario")]
    private string? QuerySalary { get; set; }

    [SupplyParameterFromQuery(Name = "ordem")]
    private string? QuerySort { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int? QueryPage { get; set; }

    // Links antigos (/jobs?jobId=...) abriam um modal; hoje a vaga tem página própria
    [SupplyParameterFromQuery(Name = "jobId")]
    private Guid? LegacyJobId { get; set; }

    private string searchTerm = string.Empty;
    private string locationText = string.Empty;
    private string jobType = string.Empty;
    private string salaryFloor = string.Empty;
    private string sortKey = DefaultSort;
    private int page = 1;

    private ListJobsResponse results = new();
    private bool loadFailed;
    private bool isAuthenticated;
    private bool isAdvertiser;
    private bool isCandidate;
    private Guid? advertiserId;

    private bool isFiltered =>
        searchTerm.Length > 0 || locationText.Length > 0 || jobType.Length > 0 || salaryFloor.Length > 0;

    // Leva a busca atual para o formulário de alerta da área do candidato
    private string AlertUrl
    {
        get
        {
            var parts = new List<string> { "aba=alertas" };
            if (searchTerm.Length > 0) parts.Add($"q={Uri.EscapeDataString(searchTerm)}");
            if (locationText.Length > 0) parts.Add($"local={Uri.EscapeDataString(locationText)}");
            if (jobType.Length > 0) parts.Add($"modo={Uri.EscapeDataString(jobType)}");
            return $"/my-applications?{string.Join("&", parts)}";
        }
    }

    private string TitleText => searchTerm.Length > 0
        ? $"Vagas de {searchTerm} - Monburan"
        : "Vagas de emprego - Monburan";

    private string CountText => results.TotalCount switch
    {
        0 => "Nenhuma vaga encontrada",
        1 => "1 vaga encontrada",
        var total => $"{total.ToString("N0", PtBr)} vagas encontradas"
    };

    private int RangeStart => (page - 1) * PageSize + 1;

    private int RangeEnd => RangeStart + results.Jobs.Count() - 1;

    private string? ContextText
    {
        get
        {
            var parts = new List<string>();

            var what = new List<string>();
            if (searchTerm.Length > 0)
                what.Add($"para “{searchTerm}”");
            if (locationText.Length > 0)
                what.Add($"em {locationText}");
            if (what.Count > 0)
                parts.Add(string.Join(' ', what));

            if (jobType.Length > 0)
                parts.Add(UiLabels.JobType(jobType));
            if (decimal.TryParse(salaryFloor, NumberStyles.Number, CultureInfo.InvariantCulture, out var floor))
                parts.Add($"A partir de R$ {JobDisplay.Money(floor)}");

            return parts.Count == 0 ? null : string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (LegacyJobId.HasValue)
        {
            Navigation.NavigateTo($"/jobs/{LegacyJobId.Value}", replace: true);
            return;
        }

        isAuthenticated = CurrentUserHelper.IsAuthenticated();
        advertiserId = CurrentUserHelper.GetAdvertiserId();
        isAdvertiser = advertiserId.HasValue;
        isCandidate = CurrentUserHelper.GetCandidateId().HasValue;

        ReadFilters();

        var result = await SearchJobsUseCase.ExecuteAsync(BuildRequest());
        if (result.Status != EResultStatus.Success)
        {
            // Antes uma falha virava "Nenhuma vaga encontrada"
            Logger.LogFailure(result, "Buscar vagas");
            loadFailed = true;
            return;
        }

        results = result.Data ?? new ListJobsResponse();

        // Filtros novos podem deixar a página pedida além do fim: volta para a primeira
        if (page > 1 && !results.Jobs.Any() && results.TotalCount > 0)
            Navigation.NavigateTo(PageUrl(1), replace: true);
    }

    private void ReadFilters()
    {
        searchTerm = (QueryTerm ?? string.Empty).Trim();
        locationText = (QueryLocation ?? string.Empty).Trim();
        jobType = QueryMode is "OnSite" or "Remote" or "Hybrid" ? QueryMode : string.Empty;
        salaryFloor = decimal.TryParse(QuerySalary, NumberStyles.Number, CultureInfo.InvariantCulture, out var floor) && floor > 0
            ? floor.ToString(CultureInfo.InvariantCulture)
            : string.Empty;
        sortKey = QuerySort is "salario" or "titulo" ? QuerySort : DefaultSort;
        page = Math.Max(1, QueryPage ?? 1);

        // "Remoto" no campo de local é o mesmo que o filtro de modalidade
        if (JobSearch.IsRemoteKeyword(locationText))
        {
            locationText = string.Empty;
            jobType = "Remote";
        }
    }

    private ListJobsRequest BuildRequest()
    {
        JobSearch.ParseLocation(locationText, out var city, out var state);
        var (sortBy, descending) = sortKey switch
        {
            "salario" => ("salary", true),
            "titulo" => ("title", false),
            _ => ("createdAt", true)
        };

        return new ListJobsRequest
        {
            Page = page,
            Size = PageSize,
            SearchTerm = searchTerm,
            City = city,
            State = state,
            Type = jobType.Length == 0 ? null : jobType,
            SalaryMin = decimal.TryParse(salaryFloor, NumberStyles.Number, CultureInfo.InvariantCulture, out var floor) ? floor : null,
            SortBy = sortBy,
            SortDescending = descending
        };
    }

    private string PageUrl(int target)
    {
        var parts = new List<string>();

        void Add(string key, string value)
        {
            if (value.Length > 0)
                parts.Add($"{key}={Uri.EscapeDataString(value)}");
        }

        Add("q", searchTerm);
        Add("local", locationText);
        Add("modo", jobType);
        Add("salario", salaryFloor);
        if (sortKey != DefaultSort)
            Add("ordem", sortKey);
        if (target > 1)
            Add("pagina", target.ToString(CultureInfo.InvariantCulture));

        return "/jobs" + (parts.Count > 0 ? "?" + string.Join('&', parts) : string.Empty);
    }

    private IEnumerable<int> VisiblePages()
    {
        // Até 5 páginas ao redor da atual
        var total = results.TotalPages;
        var first = Math.Max(1, Math.Min(page - 2, total - 4));
        var last = Math.Min(total, first + 4);
        return Enumerable.Range(first, last - first + 1);
    }
}
