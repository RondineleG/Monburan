@page "/enderecos/{Id:guid}/excluir"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Data.Common
@inject AddressService AddressService
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<Delete> Logger
@using Monburan.Core.Entities;
@using Monburan.Web.Services;

<PageTitle>Excluir endereço - Monburan</PageTitle>

<div class="container page-form-shell address-form-page">
    @if (isLoading)
    {
        <LoadingState Message="Carregando endereço…" />
    }
    else if (address == null)
    {
        <EmptyState Icon="search" Title="Endereço não encontrado" HeadingLevel="1" Message="O endereço solicitado não existe ou já foi removido.">
            <a class="btn btn-primary" href="/enderecos">Voltar para a lista</a>
        </EmptyState>
    }
    else
    {
        <PageHeader Title="Excluir endereço" Description="Confirme se deseja excluir este endereço do perfil."
                    BackHref="/enderecos" BackText="Voltar a endereços" />
        <section class="card address-delete-card">
            <div class="card-body">
                <span class="address-delete-card__icon" aria-hidden="true"><Icon Name="alert" Size="20" /></span>
                <h2>Excluir este endereço?</h2>
                <p>
                    <strong>@address.Street, @address.Number</strong><br />
                    @if (!string.IsNullOrEmpty(address.Complement))
                    {
                        <span>@address.Complement<br /></span>
                    }
                    @address.District — @address.City/@address.State
                    @if (!string.IsNullOrEmpty(address.ZipCode))
                    {
                        <span> · CEP @address.ZipCode</span>
                    }
                </p>
                <p class="text-muted">Essa ação não pode ser desfeita.</p>
                <div class="address-delete-card__actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isDeleting">Manter endereço</button>
                    <button type="button" class="btn btn-outline-danger" @onclick="Remove" disabled="@isDeleting" aria-busy="@(isDeleting ? "true" : null)">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>Excluindo…</span>
                        }
                        else
                        {
                            <span>Excluir endereço</span>
                        }
                    </button>
                </div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Address? address;
    private bool isLoading = true;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        var ownedIds = await AddressService.GetOwnedIdsAsync(
            CurrentUserHelper.GetCandidateId(),
            CurrentUserHelper.GetAdvertiserId());

        if (Monburan.Core.ValueObjects.Id.TryCreate(Id, out var key) && key is not null && ownedIds.Contains(key))
            address = await AddressService.GetByIdAsync(Id);

        isLoading = false;
    }

    private async Task Remove()
    {
        // Só existe "address" quando o endereço pertence ao perfil (checado no carregamento)
        if (address is null || isDeleting)
            return;

        isDeleting = true;
        try
        {
            await AddressService.UnlinkFromOwnerAsync(address.Id);
            await AddressService.DeleteAsync(Id);
            Toast.ShowSuccess("Endereço removido.");
            Navigation.NavigateTo("/enderecos");
        }
        catch (Exception ex) when (ex is DbException or DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(ex, "Falha ao excluir endereço {AddressId}", Id);
            Toast.ShowError("Não foi possível remover o endereço. Tente novamente.");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/enderecos");
}