@page "/admin/auditoria"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Entities
@using Monburan.Core.Interfaces.Services
@using Monburan.Core.Services
@inject IAdminAuditLog AuditLog
@inject NavigationManager Navigation
@inject ILogger<AdminAudit> Logger

<PageTitle>Auditoria - Monburan</PageTitle>

@* Os filtros e a página ficam no endereço (?busca=&acao=&alvo=&pagina=): Voltar e recarregar reproduzem a lista. *@
<div class="container admin-list-page">
    <PageHeader Title="Auditoria"
                Description="Quem fez o quê e quando nas áreas de administração. Os registros só se acrescentam: nada aqui é editado nem apagado." />

    <div class="admin-filters" role="search" aria-label="Filtrar registros">
        <div>
            <label class="form-label" for="audit-search">Buscar</label>
            <input id="audit-search" type="text" class="form-control" @bind="searchTerm" @bind:event="oninput" @onkeydown="OnSearchKeyDown"
                   placeholder="Quem fez, alvo ou motivo" enterkeyhint="search" autocomplete="off" data-testid="audit-search" />
        </div>
        <div>
            <label class="form-label" for="audit-action">Ação</label>
            <select id="audit-action" class="form-select" @bind="actionFilter" @bind:after="ApplyFiltersAsync" data-testid="audit-action">
                <option value="">Todas</option>
                @foreach (var action in AdminAuditActions.All)
                {
                    <option value="@action">@AdminAuditActions.Label(action)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="audit-target">Alvo</label>
            <select id="audit-target" class="form-select" @bind="targetFilter" @bind:after="ApplyFiltersAsync" data-testid="audit-target">
                <option value="">Todos</option>
                @foreach (var target in AdminAuditActions.Targets)
                {
                    <option value="@target">@AdminAuditActions.TargetLabel(target)</option>
                }
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="ApplyFiltersAsync" disabled="@isLoading" data-testid="audit-apply">Buscar</button>
            @if (IsFiltered)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" data-testid="audit-clear">Limpar filtros</button>
            }
        </div>
    </div>

    @if (isLoading && entries is null)
    {
        <LoadingState Message="Carregando registros…" />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar a auditoria"
                    Message="Tivemos um problema ao buscar os registros. Tente novamente em instantes."
                    OnRetry="() => LoadAsync(currentPage)" />
    }
    else if (entries is null || !entries.Data.Any())
    {
        if (IsFiltered)
        {
            <EmptyState Icon="search" Title="Nenhum resultado para estes filtros" Message="Tente outra busca ou mude a ação e o alvo." TestId="audit-empty">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">Limpar filtros</button>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="clock" Title="Nenhum registro ainda" Message="Cada ação feita na administração aparece aqui." TestId="audit-empty" />
        }
    }
    else
    {
        <div class="card" aria-busy="@(isLoading ? "true" : null)">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-cards mb-0" data-testid="audit-table">
                        <caption class="visually-hidden">Ações de administração registradas</caption>
                        <thead>
                            <tr>
                                <th scope="col">Ação</th>
                                <th scope="col">Quando</th>
                                <th scope="col">Quem</th>
                                <th scope="col">Alvo</th>
                                <th scope="col">Detalhes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in entries.Data)
                            {
                                <tr data-testid="audit-row" data-action="@entry.Action">
                                    <td data-label="Ação"><strong>@AdminAuditActions.Label(entry.Action)</strong></td>
                                    <td data-label="Quando" class="text-nowrap">@UiLabels.FormatMoment(entry.CreatedAt)</td>
                                    <td data-label="Quem">@entry.ActorEmail</td>
                                    <td data-label="Alvo">
                                        <span class="text-muted">@AdminAuditActions.TargetLabel(entry.TargetType):</span>
                                        @entry.TargetLabel
                                    </td>
                                    <td data-label="Detalhes">@(string.IsNullOrWhiteSpace(entry.Details) ? "Sem detalhes" : entry.Details)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <Pager Page="entries.Page" TotalPages="entries.TotalPages" OnPageChanged="GoToPageAsync"
               Total="entries.TotalCount" PageSize="PageSize" ItemName="@(entries.TotalCount == 1 ? "registro" : "registros")"
               AriaLabel="Paginação da auditoria" />
    }
</div>

@code {
    private const int PageSize = 25;

    [SupplyParameterFromQuery(Name = "busca")]
    private string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "acao")]
    private string? ActionQuery { get; set; }

    [SupplyParameterFromQuery(Name = "alvo")]
    private string? TargetQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int? PageQuery { get; set; }

    private PagedResponse<AdminAuditEntry>? entries;
    private string searchTerm = string.Empty;
    private string actionFilter = string.Empty;
    private string targetFilter = string.Empty;
    private int currentPage = 1;
    private bool isLoading = true;
    private bool loadFailed;
    private int loadVersion;

    // Filtros que já estão no endereço: quando o endereço muda por fora (Voltar/Avançar), a lista recarrega
    private string? appliedQuery;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(searchTerm) || actionFilter.Length > 0 || targetFilter.Length > 0;

    private string StateKey => $"{searchTerm}\n{actionFilter}\n{targetFilter}\n{currentPage}";

    protected override async Task OnParametersSetAsync()
    {
        var search = (SearchQuery ?? string.Empty).Trim();
        var action = ActionQuery is not null && AdminAuditActions.All.Contains(ActionQuery) ? ActionQuery : string.Empty;
        var target = TargetQuery is not null && AdminAuditActions.Targets.Contains(TargetQuery) ? TargetQuery : string.Empty;
        var page = Math.Max(1, PageQuery ?? 1);

        var key = $"{search}\n{action}\n{target}\n{page}";
        if (key == appliedQuery)
            return;

        appliedQuery = key;
        searchTerm = search;
        actionFilter = action;
        targetFilter = target;
        await LoadAsync(page);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync() => GoToPageAsync(1);

    private Task ClearFiltersAsync()
    {
        searchTerm = string.Empty;
        actionFilter = string.Empty;
        targetFilter = string.Empty;
        return GoToPageAsync(1);
    }

    private async Task GoToPageAsync(int page)
    {
        searchTerm = searchTerm.Trim();
        currentPage = page;
        SyncUrl();
        await LoadAsync(page);
    }

    // Leva os filtros para o endereço (entrada nova no histórico); a recarga é feita aqui mesmo
    private void SyncUrl()
    {
        appliedQuery = StateKey;
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["busca"] = searchTerm.Length > 0 ? searchTerm : null,
            ["acao"] = actionFilter.Length > 0 ? actionFilter : null,
            ["alvo"] = targetFilter.Length > 0 ? targetFilter : null,
            ["pagina"] = currentPage > 1 ? currentPage : null
        });

        if (uri != Navigation.Uri)
            Navigation.NavigateTo(uri, replace: false);
    }

    private async Task LoadAsync(int page)
    {
        // Filtros trocados em sequência: só a última busca vale
        var version = ++loadVersion;
        isLoading = true;
        loadFailed = false;
        currentPage = page;

        try
        {
            var loaded = await AuditLog.ListAsync(
                new AdminAuditFilter(searchTerm, actionFilter, targetFilter), page, PageSize);
            if (version != loadVersion)
                return;
            entries = loaded;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            if (version != loadVersion)
                return;
            Logger.LogError(exception, "Auditoria: falha ao listar os registros");
            loadFailed = true;
        }

        isLoading = false;
    }
}
