@page "/notifications"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Notifications
@using Monburan.Web.Services
@inject ListNotificationsByUserUseCase ListNotificationsUseCase
@inject MarkNotificationAsReadUseCase MarkNotificationAsReadUseCase
@inject MarkAllNotificationsAsReadUseCase MarkAllNotificationsAsReadUseCase
@inject CurrentUserHelper CurrentUserHelper
@inject IToastService Toast
@inject ILogger<Notifications> Logger

<PageTitle>Notificações - Monburan</PageTitle>

<div class="container notifications-page">
    <PageHeader Title="Notificações" Description="Acompanhe as atualizações das suas vagas e candidaturas." />

    @if (recipientId is null)
    {
        <EmptyState Icon="bell" Title="Sem notificações para esta conta" Message="As notificações chegam para perfis de candidato e de empresa.">
            <a class="btn btn-primary" href="/dashboard">Voltar ao início</a>
        </EmptyState>
    }
    else
    {
        <section class="row g-3 mb-4 notification-metrics" aria-label="Resumo das notificações">
            <div class="col-md-4">
                <article class="card notification-metric">
                    <div class="card-body">
                        <span class="notification-metric__label">Total</span>
                        <strong class="notification-metric__value">@totalNotifications</strong>
                    </div>
                </article>
            </div>
            <div class="col-md-4">
                <article class="card notification-metric">
                    <div class="card-body">
                        <span class="notification-metric__label">Não lidas</span>
                        <strong class="notification-metric__value">@unreadCount</strong>
                    </div>
                </article>
            </div>
            <div class="col-md-4">
                <article class="card notification-metric">
                    <div class="card-body">
                        <span class="notification-metric__label">Lidas</span>
                        <strong class="notification-metric__value">@readCount</strong>
                    </div>
                </article>
            </div>
        </section>

        <section class="notifications-toolbar">
            <h2>Atualizações recentes</h2>
            <div class="notifications-toolbar__actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="MarkAllAsReadAsync" disabled="@(unreadCount == 0 || isMarkingAll)" aria-busy="@(isMarkingAll ? "true" : null)">
                    @(isMarkingAll ? "Marcando…" : "Marcar todas como lidas")
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="LoadNotificationsAsync" disabled="@isLoading" aria-busy="@(isLoading ? "true" : null)">Recarregar</button>
            </div>
        </section>

        @if (isLoading)
        {
            <div class="skeleton-stack" role="status" aria-live="polite" data-testid="loading-state">
                <span class="visually-hidden">Carregando notificações…</span>
                <div class="skeleton-grid">
                    <SkeletonBlock Height="5.5rem" Radius="var(--r-md)" />
                    <SkeletonBlock Height="5.5rem" Radius="var(--r-md)" />
                    <SkeletonBlock Height="5.5rem" Radius="var(--r-md)" />
                </div>
                <SkeletonBlock Height="3.8rem" />
                <SkeletonBlock Height="3.8rem" />
                <SkeletonBlock Height="3.8rem" />
                <SkeletonBlock Height="3.8rem" />
            </div>
        }
        else if (loadFailed)
        {
            <ErrorState Title="Não foi possível carregar as notificações"
                        Message="Tivemos um problema ao buscar suas atualizações. Tente novamente em instantes."
                        OnRetry="LoadNotificationsAsync" />
        }
        else if (notifications.Count > 0)
        {
            <ul class="list-group list-unstyled" aria-label="Notificações">
                @foreach (var notification in notifications)
                {
                    <li class="list-group-item @(notification.IsRead ? "" : "list-group-item-info")" data-testid="notification-item">
                        <div class="d-flex w-100 justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-1">
                                    @if (!notification.IsRead)
                                    {
                                        <StatusBadge Text="Nova" Tone="StatusTone.Brand" />
                                    }
                                    <h3 class="h6 mb-1">
                                        <Icon Name="@GetNotificationIcon(notification.Type)" Size="16" /> @notification.Title
                                    </h3>
                                </div>
                                <p class="mb-1">@notification.Message</p>
                                <small class="text-muted">
                                    @FormatDate(notification.CreatedAt)
                                    @if (notification.IsRead && notification.ReadAt.HasValue)
                                    {
                                        <span class="ms-3">Lida @FormatDate(notification.ReadAt.Value)</span>
                                    }
                                </small>
                            </div>
                            @if (!notification.IsRead)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => MarkAsReadAsync(notification)" disabled="@(markingId == notification.Id)"
                                        aria-label="Marcar como lida: @notification.Title">
                                    Marcar como lida
                                </button>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <EmptyState Icon="bell"
                        Title="Nenhuma notificação por enquanto"
                        Message="Avisamos aqui quando houver novidades sobre suas vagas e candidaturas."
                        TestId="notifications-empty" />
        }
    }
</div>

@code {
    private List<NotificationResponse> notifications = [];
    private bool isLoading = true;
    private bool loadFailed;
    private bool isMarkingAll;
    private Guid? markingId;
    private string? recipientId;

    private int totalNotifications => notifications.Count;
    private int unreadCount => notifications.Count(n => !n.IsRead);
    private int readCount => notifications.Count(n => n.IsRead);

    protected override async Task OnInitializedAsync()
    {
        // Destinatário é o id do perfil (candidato/anunciante) — sem perfil não há notificações
        recipientId = CurrentUserHelper.GetUserType() switch
        {
            "candidate" => CurrentUserHelper.GetCandidateId()?.ToString(),
            "advertiser" => CurrentUserHelper.GetAdvertiserId()?.ToString(),
            _ => null
        };

        if (recipientId is not null)
            await LoadNotificationsAsync();

        isLoading = false;
    }

    private async Task LoadNotificationsAsync()
    {
        if (recipientId is null)
            return;

        isLoading = true;
        loadFailed = false;

        var result = await ListNotificationsUseCase.ExecuteAsync(recipientId);
        if (result.Status == EResultStatus.Success)
        {
            notifications = result.Data ?? [];
        }
        else
        {
            Logger.LogFailure(result, "Listar notificações");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task MarkAsReadAsync(NotificationResponse notification)
    {
        // A lista só contém notificações do próprio usuário — o id vem dela
        markingId = notification.Id;
        var result = await MarkNotificationAsReadUseCase.ExecuteAsync(notification.Id);
        markingId = null;

        if (result.Status == EResultStatus.Success)
        {
            notification.IsRead = true;
            notification.ReadAt = DateTime.UtcNow;
        }
        else
        {
            Logger.LogFailure(result, "Marcar notificação como lida");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível marcar a notificação como lida."));
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        if (recipientId is null || isMarkingAll)
            return;

        isMarkingAll = true;
        var result = await MarkAllNotificationsAsReadUseCase.ExecuteAsync(recipientId);
        isMarkingAll = false;

        if (result.Status == EResultStatus.Success)
        {
            var now = DateTime.UtcNow;
            foreach (var notification in notifications.Where(n => !n.IsRead))
            {
                notification.IsRead = true;
                notification.ReadAt = now;
            }

            Toast.ShowSuccess("Todas as notificações foram marcadas como lidas.");
        }
        else
        {
            Logger.LogFailure(result, "Marcar todas as notificações como lidas");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível marcar as notificações como lidas."));
        }
    }

    private static string GetNotificationIcon(ENotificationType type) => type switch
    {
        ENotificationType.System => "info",
        ENotificationType.NewJob => "briefcase",
        ENotificationType.ApplicationStatus => "send",
        ENotificationType.JobExpired => "clock",
        ENotificationType.Promotional => "sparkles",
        _ => "bell"
    };

    private static string FormatDate(DateTime date)
    {
        var utc = date.Kind == DateTimeKind.Utc ? date : DateTime.SpecifyKind(date, DateTimeKind.Utc);
        var diff = DateTime.UtcNow - utc;

        if (diff.TotalMinutes < 1)
            return "agora mesmo";
        if (diff.TotalMinutes < 60)
            return $"há {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24)
            return $"há {(int)diff.TotalHours} h";
        if (diff.TotalDays < 7)
            return (int)diff.TotalDays == 1 ? "há 1 dia" : $"há {(int)diff.TotalDays} dias";

        return $"em {UiLabels.FormatMoment(date)}";
    }
}
