@page "/admin/contas"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@using Monburan.Core.Interfaces.Services
@inject AdminAccountService Accounts
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<AdminAccounts> Logger
@inject IJSRuntime JS

<PageTitle>Contas - Monburan</PageTitle>

@* Gestão das contas: busca, situação (ativa, inativa, bloqueada por tentativas), e-mail, verificação em duas etapas e as
   ações da administração. Toda ação é auditada e tem trava no serviço (ninguém inativa a si mesmo, o último administrador fica).
   Os filtros e a página ficam no endereço (?busca=&tipo=&situacao=&pagina=): Voltar e recarregar reproduzem a lista. *@
<div class="container admin-list-page">
    <PageHeader Title="Contas"
                Description="Todas as contas da plataforma, de candidatos, empresas e administradores. Inative quem violar as regras, desbloqueie quem errou a senha e acompanhe o acesso." />

    @if (list is not null)
    {
        <section class="admin-counters" aria-label="Resumo das contas">
            <div class="admin-counter"><strong data-testid="acct-count-total">@list.Counts.Total</strong><span>Contas</span></div>
            <div class="admin-counter"><strong data-testid="acct-count-active">@list.Counts.Active</strong><span>Ativas</span></div>
            <div class="admin-counter"><strong data-testid="acct-count-inactive">@list.Counts.Inactive</strong><span>Inativas</span></div>
            <div class="admin-counter"><strong data-testid="acct-count-locked">@list.Counts.Locked</strong><span>Bloqueadas por tentativas</span></div>
        </section>
    }

    <div class="admin-filters" role="search" aria-label="Filtrar contas">
        <div>
            <label class="form-label" for="acct-search">Buscar</label>
            <input id="acct-search" type="text" class="form-control" @bind="searchTerm" @bind:event="oninput" @onkeydown="OnSearchKeyDown"
                   placeholder="Nome ou e-mail" enterkeyhint="search" autocomplete="off" data-testid="acct-search" />
        </div>
        <div>
            <label class="form-label" for="acct-type">Tipo</label>
            <select id="acct-type" class="form-select" @bind="typeFilter" @bind:after="ApplyFiltersAsync" data-testid="acct-type">
                <option value="">Todos</option>
                <option value="candidate">Candidato</option>
                <option value="advertiser">Empresa</option>
                <option value="admin">Administrador</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="acct-status">Situação</label>
            <select id="acct-status" class="form-select" @bind="statusFilter" @bind:after="ApplyFiltersAsync" data-testid="acct-status">
                <option value="">Todas</option>
                <option value="active">Ativa</option>
                <option value="inactive">Inativa</option>
                <option value="locked">Bloqueada por tentativas</option>
                <option value="unconfirmed">E-mail não confirmado</option>
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="ApplyFiltersAsync" disabled="@isLoading" data-testid="acct-apply">Buscar</button>
            @if (IsFiltered)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" data-testid="acct-clear">Limpar filtros</button>
            }
        </div>
    </div>

    @if (selected is not null)
    {
        var self = IsSelf(selected);
        <section class="card acct-panel" aria-labelledby="acct-panel-title" data-testid="acct-panel" data-email="@selected.Email">
            <div class="card-body">
                <div class="acct-panel__head">
                    <div>
                        <h2 id="acct-panel-title" tabindex="-1">@selected.Name</h2>
                        <p class="acct-panel__email">@selected.Email</p>
                    </div>
                    <ul class="ai-badges" aria-label="Situação da conta">
                        <li><StatusBadge Text="@(selected.IsActive ? "Ativa" : "Inativa")" Tone="@(selected.IsActive ? StatusTone.Ok : StatusTone.Error)" TestId="acct-panel-state" /></li>
                        @if (selected.IsLockedOut)
                        {
                            <li><StatusBadge Text="Bloqueada por tentativas" Tone="StatusTone.Warn" /></li>
                        }
                        @if (selected.IsAdmin)
                        {
                            <li><StatusBadge Text="Administrador" Tone="StatusTone.Brand" /></li>
                        }
                    </ul>
                </div>

                <dl class="acct-panel__meta">
                    <div><dt>Tipo</dt><dd>@AccountTypeLabel(selected)</dd></div>
                    <div><dt>Plano</dt><dd data-testid="acct-panel-plan">@(selected.PlanName is null ? "Sem plano" : UiLabels.PlanName(selected.PlanName))</dd></div>
                    <div><dt>E-mail confirmado</dt><dd>@(selected.EmailConfirmed ? "Sim" : "Não")</dd></div>
                    <div><dt>Verificação em duas etapas</dt><dd>@(selected.TwoFactorEnabled ? "Ativada" : "Desativada")</dd></div>
                    <div><dt>Cadastro</dt><dd>@UiLabels.FormatMomentDate(selected.CreatedAt)</dd></div>
                    <div><dt>Último acesso</dt><dd>@(selected.LastLoginAt is null ? "Nunca" : UiLabels.FormatMoment(selected.LastLoginAt))</dd></div>
                    @if (selected.IsLockedOut && selected.LockoutEnd is { } until)
                    {
                        <div><dt>Bloqueada até</dt><dd>@UiLabels.FormatMoment(until.UtcDateTime)</dd></div>
                    }
                </dl>

                @if (!selected.IsActive)
                {
                    <p class="alert alert-warning" role="status" data-testid="acct-panel-deactivation">
                        Inativada em @UiLabels.FormatMoment(selected.DeactivatedAt) por @(selected.DeactivatedBy ?? "administração").
                        Motivo: @(string.IsNullOrWhiteSpace(selected.DeactivationReason) ? "não informado" : selected.DeactivationReason)
                    </p>
                }

                @if (self)
                {
                    <p class="text-muted" data-testid="acct-panel-self">Esta é a sua conta: inativar, retirar o próprio papel e redefinir a verificação em duas etapas ficam desativados (use Minha conta).</p>
                }

                @if (selected.IsConfiguredAdmin)
                {
                    <p class="text-muted">
                        Este e-mail está na lista de administradores definida na configuração do servidor (<code>ADMIN_EMAILS</code>).
                        Para retirar o acesso, peça a quem cuida do servidor para tirar o e-mail dessa lista.
                    </p>
                }

                @if (deactivating)
                {
                    <div class="acct-reason" data-testid="acct-deactivate-form">
                        <label class="form-label" for="acct-reason">Motivo da inativação (a conta é desconectada na hora e fica registrado na auditoria)</label>
                        <textarea id="acct-reason" class="form-control" rows="3" maxlength="500" @bind="reason" @bind:event="oninput" data-testid="acct-reason"></textarea>
                        @if (!string.IsNullOrEmpty(reasonError))
                        {
                            <div class="text-danger" role="alert" data-testid="acct-reason-error">@reasonError</div>
                        }
                        <div class="acct-actions">
                            <button type="button" class="btn btn-danger" @onclick="DeactivateAsync" disabled="@busy" aria-busy="@(busy ? "true" : null)" data-testid="acct-deactivate-confirm">@(busy ? "Inativando…" : "Inativar conta")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelDeactivation" disabled="@busy" data-testid="acct-deactivate-cancel">Cancelar</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="acct-actions">
                        @if (selected.IsActive)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="StartDeactivation" disabled="@(busy || self)" data-testid="acct-deactivate">Inativar</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary btn-sm" @onclick="ActivateAsync" disabled="@busy" data-testid="acct-activate">Reativar</button>
                        }
                        @if (selected.IsLockedOut)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="UnlockAsync" disabled="@busy" data-testid="acct-unlock">Desbloquear</button>
                        }
                        @if (!selected.EmailConfirmed)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ConfirmEmailAsync" disabled="@busy" data-testid="acct-confirm-email">Confirmar e-mail</button>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RevokeSessionsAsync" disabled="@busy" data-testid="acct-revoke-sessions">Encerrar sessões</button>
                        @if (selected.TwoFactorEnabled)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="ResetTwoFactorAsync" disabled="@(busy || self)" data-testid="acct-reset-2fa">Redefinir verificação em duas etapas</button>
                        }
                        @if (!selected.IsAdmin)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => SetAdminAsync(true)" disabled="@busy" data-testid="acct-grant-admin">Tornar administrador</button>
                        }
                        else if (!selected.IsConfiguredAdmin)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => SetAdminAsync(false)" disabled="@(busy || self)" data-testid="acct-revoke-admin">Remover papel de administrador</button>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClosePanel" data-testid="acct-panel-close">Fechar</button>
                    </div>

                    @if (selected.ProfileType is not null && planOptions.Count > 0)
                    {
                        <div class="acct-plan mt-3" data-testid="acct-plan">
                            <label class="form-label" for="acct-plan-select">Plano da conta (a mudança não gera cobrança; o plano gratuito inativa o premium)</label>
                            <div class="d-flex gap-2 align-items-center">
                                <select id="acct-plan-select" class="form-select form-select-sm" @bind="selectedPlanId" data-testid="acct-plan-select">
                                    <option value="">Escolha um plano…</option>
                                    @foreach (var plan in planOptions)
                                    {
                                        <option value="@plan.Id">@UiLabels.PlanName(plan.Name) — @PlanPeriodLabel(plan)</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" @onclick="ApplyPlanAsync" disabled="@(busy || selectedPlanId == Guid.Empty)" data-testid="acct-plan-apply">Aplicar plano</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }

    @if (isLoading && list is null)
    {
        <LoadingState Message="Carregando contas…" />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar as contas"
                    Message="Tivemos um problema ao buscar as contas. Tente novamente em instantes."
                    OnRetry="() => LoadAsync(currentPage)" />
    }
    else if (list is null || list.Items.Count == 0)
    {
        if (IsFiltered)
        {
            <EmptyState Icon="search" Title="Nenhum resultado para estes filtros" Message="Tente outra busca ou mude o tipo e a situação." TestId="acct-empty">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">Limpar filtros</button>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="users" Title="Nenhuma conta encontrada" Message="As contas aparecem aqui assim que alguém se cadastra." TestId="acct-empty" />
        }
    }
    else
    {
        <div class="card" aria-busy="@(isLoading ? "true" : null)">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-cards mb-0" data-testid="acct-table">
                        <caption class="visually-hidden">Contas da plataforma</caption>
                        <thead>
                            <tr>
                                <th scope="col">Conta</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Situação</th>
                                <th scope="col">E-mail</th>
                                <th scope="col">Verificação em duas etapas</th>
                                <th scope="col">Último acesso</th>
                                <th scope="col">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in list.Items)
                            {
                                <tr data-testid="acct-row" data-email="@account.Email">
                                    <td data-label="Conta">
                                        <strong>@account.Name</strong>
                                        <div class="text-muted small">@account.Email</div>
                                    </td>
                                    <td data-label="Tipo">
                                        @AccountTypeLabel(account)
                                        @if (account.PlanName is not null)
                                        {
                                            <div class="text-muted small">Plano @UiLabels.PlanName(account.PlanName)</div>
                                        }
                                    </td>
                                    <td data-label="Situação">
                                        <StatusBadge Text="@(account.IsActive ? "Ativa" : "Inativa")" Tone="@(account.IsActive ? StatusTone.Ok : StatusTone.Error)" />
                                        @if (account.IsLockedOut)
                                        {
                                            <StatusBadge Text="Bloqueada por tentativas" Tone="StatusTone.Warn" />
                                        }
                                    </td>
                                    <td data-label="E-mail">@(account.EmailConfirmed ? "Confirmado" : "Não confirmado")</td>
                                    <td data-label="Verificação em duas etapas">@(account.TwoFactorEnabled ? "Ativada" : "Desativada")</td>
                                    <td data-label="Último acesso">@(account.LastLoginAt is null ? "Nunca" : UiLabels.FormatMomentDate(account.LastLoginAt))</td>
                                    <td data-label="Ações">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenPanelAsync(account.Id)" data-testid="acct-manage" aria-label="Gerenciar a conta de @account.Name">Gerenciar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <Pager Page="list.Page" TotalPages="list.TotalPages" OnPageChanged="GoToPageAsync"
               Total="list.TotalCount" PageSize="PageSize" ItemName="@(list.TotalCount == 1 ? "conta" : "contas")"
               AriaLabel="Paginação das contas" />
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private const int PageSize = 20;

    private static readonly string[] TypeValues = ["candidate", "advertiser", "admin"];
    private static readonly string[] StatusValues = ["active", "inactive", "locked", "unconfirmed"];

    [SupplyParameterFromQuery(Name = "busca")]
    private string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tipo")]
    private string? TypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "situacao")]
    private string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int? PageQuery { get; set; }

    private AdminAccountPage? list;
    private AdminAccountRow? selected;
    private AdminActor actor = new(string.Empty, "administrador");
    private ConfirmDialog confirmDialog = default!;

    private string searchTerm = string.Empty;
    private string typeFilter = string.Empty;
    private string statusFilter = string.Empty;
    private int currentPage = 1;
    private bool isLoading = true;
    private bool loadFailed;
    private bool busy;
    private int loadVersion;

    // Filtros que já estão no endereço: quando o endereço muda por fora (Voltar/Avançar), a lista recarrega
    private string? appliedQuery;

    private bool deactivating;
    private string reason = string.Empty;
    private string? reasonError;

    private IReadOnlyList<AdminPlanOption> planOptions = [];
    private Guid selectedPlanId;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(searchTerm) || typeFilter.Length > 0 || statusFilter.Length > 0;

    private string StateKey => $"{searchTerm}\n{typeFilter}\n{statusFilter}\n{currentPage}";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        actor = state.User.ToAdminActor();
    }

    protected override async Task OnParametersSetAsync()
    {
        var search = (SearchQuery ?? string.Empty).Trim();
        var type = TypeQuery is not null && TypeValues.Contains(TypeQuery) ? TypeQuery : string.Empty;
        var status = StatusQuery is not null && StatusValues.Contains(StatusQuery) ? StatusQuery : string.Empty;
        var page = Math.Max(1, PageQuery ?? 1);

        var key = $"{search}\n{type}\n{status}\n{page}";
        if (key == appliedQuery)
            return;

        appliedQuery = key;
        searchTerm = search;
        typeFilter = type;
        statusFilter = status;
        await LoadAsync(page);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync() => GoToPageAsync(1);

    private Task ClearFiltersAsync()
    {
        searchTerm = string.Empty;
        typeFilter = string.Empty;
        statusFilter = string.Empty;
        return GoToPageAsync(1);
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        searchTerm = searchTerm.Trim();
        currentPage = pageNumber;
        SyncUrl();
        await LoadAsync(pageNumber);
    }

    // Leva os filtros para o endereço (entrada nova no histórico); a recarga é feita aqui mesmo
    private void SyncUrl()
    {
        appliedQuery = StateKey;
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["busca"] = searchTerm.Length > 0 ? searchTerm : null,
            ["tipo"] = typeFilter.Length > 0 ? typeFilter : null,
            ["situacao"] = statusFilter.Length > 0 ? statusFilter : null,
            ["pagina"] = currentPage > 1 ? currentPage : null
        });

        if (uri != Navigation.Uri)
            Navigation.NavigateTo(uri, replace: false);
    }

    private async Task LoadAsync(int pageNumber)
    {
        // Filtros trocados em sequência: só a última busca vale
        var version = ++loadVersion;
        isLoading = true;
        loadFailed = false;
        currentPage = pageNumber;

        try
        {
            var loaded = await Accounts.ListAsync(new AdminAccountFilter(searchTerm, typeFilter, statusFilter), pageNumber, PageSize);
            if (version != loadVersion)
                return;
            list = loaded;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            if (version != loadVersion)
                return;
            Logger.LogError(exception, "Contas: falha ao listar");
            loadFailed = true;
        }

        isLoading = false;
    }

    private bool IsSelf(AdminAccountRow account) => string.Equals(account.Id.ToString(), actor.Id, StringComparison.OrdinalIgnoreCase);

    private async Task OpenPanelAsync(Guid id)
    {
        deactivating = false;
        reason = string.Empty;
        reasonError = null;
        selected = await Accounts.GetAsync(id);
        planOptions = selected is null ? [] : await Accounts.ListPlansAsync(selected.ProfileType);
        selectedPlanId = planOptions.FirstOrDefault(plan => plan.Name == selected?.PlanName)?.Id ?? Guid.Empty;

        // O painel abre acima da tabela: o foco vai para o título dele (quem usa teclado não fica preso lá embaixo)
        if (selected is not null)
        {
            StateHasChanged();
            try
            {
                await JS.InvokeVoidAsync("monburanFocusById", "acct-panel-title");
            }
            catch (JSException)
            {
            }
        }
    }

    private void ClosePanel()
    {
        selected = null;
        deactivating = false;
    }

    private void StartDeactivation()
    {
        deactivating = true;
        reason = string.Empty;
        reasonError = null;
    }

    private void CancelDeactivation()
    {
        deactivating = false;
        reasonError = null;
    }

    private async Task DeactivateAsync()
    {
        if (selected is null)
            return;

        reasonError = null;
        await RunAsync(
            () => Accounts.DeactivateAsync(selected.Id, reason, actor),
            $"Conta de {selected.Email} inativada.",
            error => reasonError = error);

        if (reasonError is null)
            deactivating = false;
    }

    private async Task ActivateAsync()
    {
        if (selected is null)
            return;

        var withJobs = selected.ProfileType == "advertiser" ? " As vagas que a inativação escondeu voltam ao site." : string.Empty;
        if (await ConfirmAsync("Reativar conta?", $"{selected.Email} poderá entrar de novo.{withJobs}", "Reativar", destructive: false))
            await RunAsync(() => Accounts.ActivateAsync(selected.Id, actor), $"Conta de {selected.Email} reativada.");
    }

    private async Task UnlockAsync()
    {
        if (selected is null)
            return;

        if (await ConfirmAsync("Desbloquear conta?", "A contagem de senhas erradas será zerada e a pessoa poderá tentar entrar de novo.", "Desbloquear", destructive: false))
            await RunAsync(() => Accounts.UnlockAsync(selected.Id, actor), $"Conta de {selected.Email} desbloqueada.");
    }

    private async Task ConfirmEmailAsync()
    {
        if (selected is null)
            return;

        if (await ConfirmAsync("Confirmar o e-mail manualmente?", "Use só quando você verificou, por outro meio, que o e-mail é da pessoa.", "Confirmar e-mail", destructive: false))
            await RunAsync(() => Accounts.ConfirmEmailAsync(selected.Id, actor), $"E-mail de {selected.Email} confirmado.");
    }

    private async Task RevokeSessionsAsync()
    {
        if (selected is null)
            return;

        if (await ConfirmAsync("Encerrar as sessões?", $"{selected.Email} será desconectada em todos os dispositivos e precisará entrar de novo.", "Encerrar sessões", destructive: true))
            await RunAsync(() => Accounts.RevokeSessionsAsync(selected.Id, actor), $"Sessões de {selected.Email} encerradas.");
    }

    private async Task ResetTwoFactorAsync()
    {
        if (selected is null)
            return;

        if (await ConfirmAsync(
                "Redefinir a verificação em duas etapas?",
                "O autenticador e os códigos de recuperação serão apagados e a pessoa terá de configurar tudo de novo. Administradores não entram na administração até lá.",
                "Redefinir verificação", destructive: true))
        {
            await RunAsync(() => Accounts.ResetTwoFactorAsync(selected.Id, actor), $"Verificação em duas etapas de {selected.Email} redefinida.");
        }
    }

    private async Task SetAdminAsync(bool grant)
    {
        if (selected is null)
            return;

        var confirmed = grant
            ? await ConfirmAsync(
                "Tornar administrador?",
                $"{selected.Email} passará a ver os dados de todos os usuários e a gerenciar contas, vagas e provedores de IA. A pessoa precisará ativar a verificação em duas etapas.",
                "Tornar administrador", destructive: true)
            : await ConfirmAsync(
                "Remover o papel de administrador?",
                $"{selected.Email} perde o acesso às áreas de administração.",
                "Remover papel", destructive: true);

        if (confirmed)
        {
            await RunAsync(
                () => Accounts.SetAdminAsync(selected.Id, grant, actor),
                grant ? $"{selected.Email} agora é administradora." : $"Papel de administrador de {selected.Email} removido.");
        }
    }

    private async Task ApplyPlanAsync()
    {
        if (selected is null || selectedPlanId == Guid.Empty)
            return;

        var plan = planOptions.FirstOrDefault(item => item.Id == selectedPlanId);
        if (plan is null)
            return;

        var planName = UiLabels.PlanName(plan.Name);
        if (await ConfirmAsync(
                "Aplicar plano?",
                $"{selected.Email} passa para o plano {planName}. A mudança não gera cobrança e fica registrada na auditoria.",
                "Aplicar plano", destructive: false))
        {
            await RunAsync(
                () => Accounts.SetPlanAsync(selected.Id, selectedPlanId, actor),
                $"Plano de {selected.Email} alterado para {planName}.");
        }
    }

    private static string PlanPeriodLabel(AdminPlanOption plan) => plan.Period switch
    {
        ESubscriptionPeriod.Monthly => $"R$ {plan.Price:0.00}/mês",
        ESubscriptionPeriod.Annual => $"R$ {plan.Price:0.00}/ano",
        _ => "gratuito"
    };

    private Task<bool> ConfirmAsync(string title, string message, string confirmText, bool destructive) =>
        confirmDialog.ShowAsync(new ConfirmOptions { Title = title, Message = message, ConfirmText = confirmText, Destructive = destructive });

    private async Task RunAsync(Func<Task<Monburan.Core.Requests.RequestResult>> action, string successMessage, Action<string>? onError = null)
    {
        if (busy || selected is null)
            return;

        busy = true;
        var id = selected.Id;
        try
        {
            var result = await action();
            if (result.Status == EResultStatus.Success)
            {
                Toast.ShowSuccess(successMessage);
                selected = await Accounts.GetAsync(id);
                await LoadAsync(currentPage);
                return;
            }

            var message = ResultMessages.ToUserMessage(result, "Não foi possível concluir a ação.");
            if (onError is not null && result.Status == EResultStatus.HasValidation)
                onError(message);
            else
                Toast.ShowError(message);
        }
        finally
        {
            busy = false;
        }
    }

    // "Candidato", "Empresa" ou "Administrador"; perfil e papel juntos quando a pessoa tem os dois
    private static string AccountTypeLabel(AdminAccountRow account)
    {
        var profile = account.ProfileType switch
        {
            "candidate" => "Candidato",
            "advertiser" => "Empresa",
            _ => null
        };

        if (profile is null)
            return account.IsAdmin ? "Administrador" : "Sem perfil";

        return account.IsAdmin ? $"{profile} e administrador" : profile;
    }
}
