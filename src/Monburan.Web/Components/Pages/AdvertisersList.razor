@page "/admin/advertisers"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Advertisers
@inject ListAdvertisersUseCase ListAdvertisersUseCase
@inject DeleteAdvertiserUseCase DeleteAdvertiserUseCase
@inject IToastService Toast
@inject ILogger<AdvertisersList> Logger

<PageTitle>Gerenciar Empresas - Monburan</PageTitle>

<div class="container mt-4 admin-list-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">ADMINISTRAÇÃO</span>
            <h1>Empresas</h1>
            <p>Consulte empresas cadastradas, situação da conta e vagas publicadas.</p>
        </div>
    </header>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="advertiser-search">Buscar</label>
                    <input id="advertiser-search" type="text" class="form-control" @bind="searchTerm" @onkeydown="OnSearchKeyDown" placeholder="Nome, e-mail ou CNPJ/CPF..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="status-filter">Situação</label>
                    @* Valores de EAdvertiserStatus — opções inexistentes eram ignoradas pelo filtro *@
                    <select id="status-filter" class="form-select" @bind="statusFilter">
                        <option value="">Todas</option>
                        <option value="Active">Ativa</option>
                        <option value="Incomplete">Cadastro incompleto</option>
                        <option value="Blocked">Bloqueada</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="() => LoadAsync(1)" disabled="@isLoading">Aplicar filtros <span aria-hidden="true">↗</span></button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <LoadingState Message="Carregando empresas..." />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar as empresas"
                    Message="Tivemos um problema ao buscar as empresas. Tente novamente em instantes."
                    OnRetry="() => LoadAsync(currentPage)" />
    }
    else if (listResponse is null || !listResponse.Items.Any())
    {
        <EmptyState Icon="▦" Title="Nenhuma empresa encontrada" Message="Ajuste a busca ou os filtros." />
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>CNPJ/CPF</th>
                                <th>Situação</th>
                                <th>Cidade/UF</th>
                                <th>Vagas</th>
                                <th>Cadastro</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var advertiser in listResponse.Items)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(advertiser.LogoUrl))
                                        {
                                            <img src="@advertiser.LogoUrl" alt="" class="rounded-circle me-2" width="30" height="30" />
                                        }
                                        @advertiser.Name
                                    </td>
                                    <td>@advertiser.Email</td>
                                    <td>@FormatTaxId(advertiser.TaxId)</td>
                                    <td><span class="badge @StatusBadge(advertiser.Status)">@StatusLabel(advertiser.Status)</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(advertiser.City))
                                        {
                                            @advertiser.City@(string.IsNullOrEmpty(advertiser.State) ? "" : $" / {advertiser.State}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">@advertiser.JobsCount</td>
                                    <td>@UiLabels.FormatMomentDate(advertiser.CreatedAt)</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(advertiser)" disabled="@(deletingId == advertiser.Id)" title="Excluir empresa">
                                            @(deletingId == advertiser.Id ? "Excluindo..." : "Excluir")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (listResponse.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Paginação de empresas">
                <ul class="pagination justify-content-center">
                    @if (listResponse.HasPreviousPage)
                    {
                        <li class="page-item">
                            <button class="page-link" @onclick="() => LoadAsync(listResponse.Page - 1)">Anterior</button>
                        </li>
                    }

                    @{
                        var startPage = Math.Max(1, listResponse.Page - 2);
                        var endPage = Math.Min(listResponse.TotalPages, startPage + 4);
                        startPage = Math.Max(1, endPage - 4);
                    }
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(pageNum == listResponse.Page ? "active" : "")">
                            <button class="page-link" @onclick="() => LoadAsync(pageNum)">@pageNum</button>
                        </li>
                    }

                    @if (listResponse.HasNextPage)
                    {
                        <li class="page-item">
                            <button class="page-link" @onclick="() => LoadAsync(listResponse.Page + 1)">Próximo</button>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="text-muted text-center mt-3">
            Mostrando @listResponse.Items.Count() de @listResponse.TotalCount empresas
        </div>
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private ListAdvertisersResponse? listResponse;
    private bool isLoading = true;
    private bool loadFailed;
    private int currentPage = 1;
    private Guid? deletingId;
    private ConfirmDialog confirmDialog = default!;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        isLoading = true;
        loadFailed = false;

        var result = await ListAdvertisersUseCase.ExecuteAsync(new ListAdvertisersRequest
        {
            Page = page,
            Size = 20,
            SearchTerm = searchTerm,
            Status = statusFilter
        });

        if (result.Status == EResultStatus.Success)
        {
            listResponse = result.Data;
            currentPage = page;
        }
        else
        {
            Logger.LogFailure(result, "Listar empresas (admin)");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadAsync(1);
    }

    private async Task DeleteAsync(AdvertiserResponse advertiser)
    {
        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir empresa?",
            Message = $"O perfil de {advertiser.Name} ({advertiser.Email}) será desativado e deixará de aparecer na plataforma.",
            ConfirmText = "Excluir empresa",
            Destructive = true
        });
        if (!confirmed)
            return;

        deletingId = advertiser.Id;
        var result = await DeleteAdvertiserUseCase.ExecuteAsync(advertiser.Id);
        deletingId = null;

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess($"O perfil de {advertiser.Name} foi excluído.");
            await LoadAsync(currentPage);
        }
        else
        {
            Logger.LogFailure(result, "Excluir empresa (admin)");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível excluir a empresa. Tente novamente."));
        }
    }

    private static string StatusLabel(string status) =>
        Enum.TryParse<EAdvertiserStatus>(status, out var parsed) ? UiLabels.AccountStatus(parsed) : "Indefinida";

    private static string StatusBadge(string status) => status switch
    {
        "Active" => "bg-success",
        "Incomplete" => "bg-warning",
        "Blocked" => "bg-danger",
        _ => "bg-secondary"
    };

    private static string FormatTaxId(string? taxId)
    {
        if (string.IsNullOrEmpty(taxId)) return "—";

        // CPF: 123.456.789-00
        if (taxId.Length == 11)
            return $"{taxId[..3]}.{taxId.Substring(3, 3)}.{taxId.Substring(6, 3)}-{taxId.Substring(9, 2)}";

        // CNPJ: 12.345.678/0001-90
        if (taxId.Length == 14)
            return $"{taxId[..2]}.{taxId.Substring(2, 3)}.{taxId.Substring(5, 3)}/{taxId.Substring(8, 4)}-{taxId.Substring(12, 2)}";

        return taxId;
    }
}
