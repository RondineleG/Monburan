@page "/curriculos/{resumeId:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Resumes
@inject ResumeViewerService ResumeViewer
@inject DeleteResumeUseCase DeleteResumeUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<ResumeDetails> Logger

<PageTitle>@(resume is null ? "Detalhes do currículo" : resume.Title) - Monburan</PageTitle>

<div class="container">
    @if (isLoading)
    {
        @* A página ainda precisa de um título principal enquanto carrega *@
        <h1 class="visually-hidden">Currículo</h1>
        <LoadingState Message="Carregando currículo…" />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar o currículo"
                    Message="Tivemos um problema ao abrir este currículo. Tente novamente em instantes."
                    HeadingLevel="1"
                    OnRetry="LoadAsync" />
    }
    else if (viewer is null)
    {
        <EmptyState Icon="search" Title="Currículo não encontrado" Message="Ele pode ter sido excluído ou você não tem acesso a ele." HeadingLevel="1">
            <a class="btn btn-primary" href="@BackHref">@(isOwner ? "Ir para meus currículos" : "Voltar para candidaturas recebidas")</a>
        </EmptyState>
    }
    else
    {
        @* O status fica fora do h1: o título principal é só o nome do currículo *@
        <PageHeader Title="@resume!.Title" Description="@viewer?.Name"
                    BackHref="@BackHref" BackText="@(isOwner ? "Meus currículos" : "Candidaturas recebidas")">
            <Actions>
                @if (isOwner && !showWorkspace)
                {
                    <a class="btn btn-primary" href="/curriculos/@ResumeId/editar">Editar currículo</a>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleImprovementAsync" data-testid="resume-improve-toggle"><Icon Name="sparkles" Size="16" />Melhorar currículo</button>
                    <details class="page-heading__more">
                        <summary class="btn btn-outline-secondary">Outras ações<Icon Name="chevron-down" Size="16" /></summary>
                        <div class="page-heading__more-menu">
                            <a href="/curriculos/@ResumeId/cv" data-testid="resume-export-pdf">Ver CV</a>
                            <a href="/curriculos/@ResumeId/assistente" aria-label="Completar o currículo no passo a passo">Completar no passo a passo</a>
                            <button type="button" class="link-danger" @onclick="DeleteAsync" disabled="@isDeleting" data-testid="resume-delete"
                                    aria-busy="@(isDeleting ? "true" : null)"
                                    aria-label="@(isDeleting ? "Excluindo currículo…" : $"Excluir o currículo {resume.Title}")">
                                @(isDeleting ? "Excluindo…" : "Excluir currículo")
                            </button>
                        </div>
                    </details>
                }
                else if (!isOwner)
                {
                    <a class="btn btn-outline-secondary" href="/curriculos/@ResumeId/cv" data-testid="resume-export-pdf"><Icon Name="download" Size="16" />Imprimir ou salvar PDF</a>
                }
            </Actions>
            <ChildContent>
                <StatusBadge Text="@(resume.IsActive ? "Ativo" : "Inativo")" Tone="@(resume.IsActive ? StatusTone.Ok : StatusTone.Neutral)" TestId="resume-status" />
            </ChildContent>
        </PageHeader>

        <div class="resume-overview">
            @if (resume.ExperienceHistory?.Count > 0) { <span>@resume.ExperienceHistory.Count @(resume.ExperienceHistory.Count == 1 ? "experiência" : "experiências")</span> }
            @if (resume.EducationHistory?.Count > 0) { <span>@resume.EducationHistory.Count @(resume.EducationHistory.Count == 1 ? "formação" : "formações")</span> }
            @if (resume.Languages?.Count > 0) { <span>@resume.Languages.Count @(resume.Languages.Count == 1 ? "idioma" : "idiomas")</span> }
            @if (resume.Skills?.Count > 0) { <span>@resume.Skills.Count @(resume.Skills.Count == 1 ? "habilidade" : "habilidades")</span> }
            <span>Atualizado em @((resume.UpdatedAt ?? resume.CreatedAt).ToString("dd/MM/yyyy"))</span>
        </div>
        <div hidden="@showWorkspace">
        @if (isOwner)
        {
            <ResumeAiPanel @key="@($"ai-panel-{ResumeId}")" Resume="resume"
                           OpenRequested="openImprovement"
                           OnReviewRequested="OpenWorkspace"
                           OnDraftDiscarded="CloseWorkspace"
                           @ref="aiPanel" />
        }
        </div>

        @if (showWorkspace && workspaceDraft is not null)
        {
            <ResumeImprovementWorkspace @key="@($"ai-workspace-{ResumeId}")" Resume="resume"
                                        Draft="workspaceDraft"
                                        DraftPersisted="@(aiPanel?.DraftPersisted ?? true)"
                                        ContactName="@viewer?.Name"
                                        ContactEmail="@viewer?.Email"
                                        ContactPhone="@viewer?.Phone"
                                        ContactLinkedIn="@viewer?.LinkedIn"
                                        OnApplied="OnImprovementAppliedAsync"
                                        OnDraftPersisted="OnDraftPersisted"
                                        OnClose="CloseWorkspace" />
        }

        <div hidden="@showWorkspace">
            <div class="resume-layout">
                <ResumeDocument Resume="resume"
                                Name="@viewer?.Name" Email="@viewer?.Email" Phone="@viewer?.Phone" LinkedIn="@viewer?.LinkedIn"
                                SectionIdPrefix="resume" ShowHeader="false" />
                <aside class="resume-layout__aside" aria-label="Seções do currículo">
                    <strong class="text-muted">Seções</strong>
                    @if (!string.IsNullOrWhiteSpace(resume.Summary)) { <a href="#resume-summary">Resumo</a> }
                    @if (resume.ExperienceHistory?.Count > 0) { <a href="#resume-experience">Experiência</a> }
                    @if (resume.EducationHistory?.Count > 0) { <a href="#resume-education">Formação</a> }
                    @if (resume.Languages?.Count > 0) { <a href="#resume-languages">Idiomas</a> }
                    @if (resume.Skills?.Count > 0) { <a href="#resume-skills">Habilidades</a> }
                    @if (viewer is not null && (!string.IsNullOrWhiteSpace(viewer.Phone) || !string.IsNullOrWhiteSpace(viewer.Email) || !string.IsNullOrWhiteSpace(viewer.LinkedIn)))
                    {
                        <small class="text-muted mt-2">Contato da pessoa candidata fica disponível apenas nesta visualização autorizada.</small>
                    }
                </aside>
            </div>
        </div>
    }

    @if (isOwner)
    {
        <div class="container">
            <ResumeShareCard ResumeId="ResumeId" />
        </div>
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    [Parameter]
    public Guid ResumeId { get; set; }

    [SupplyParameterFromQuery(Name = "melhorar")]
    public string? ImproveQuery { get; set; }

    private ResumeViewerResponse? viewer;
    private ResumeResponse? resume;
    private bool isOwner;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isDeleting;
    private bool openImprovement;
    private bool showWorkspace;
    private Monburan.Web.Models.ResumeImprovementDraft? workspaceDraft;
    private ResumeAiPanel? aiPanel;
    private ConfirmDialog confirmDialog = default!;

    private Guid? loadedId;
    private int loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        // Outro currículo (ou mudança de ?melhorar) no mesmo componente: estado anterior some
        openImprovement = ImproveQuery == "true";
        if (loadedId != ResumeId)
        {
            showWorkspace = false;
            workspaceDraft = null;
            viewer = null;
            resume = null;
            isOwner = false;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var version = ++loadVersion;
        var resumeId = ResumeId;
        isLoading = true;
        loadFailed = false;
        loadedId = resumeId;
        viewer = null;
        resume = null;
        isOwner = false;

        var result = await ResumeViewer.GetAsync(resumeId);
        if (version != loadVersion || resumeId != ResumeId)
            return;
        if (result.Status == EResultStatus.Success && result.Data is not null)
        {
            viewer = result.Data;
            resume = result.Data.Resume;
            isOwner = result.Data.IsOwner;
        }
        else if (result.Status is EResultStatus.HasError or EResultStatus.EntityHasError)
        {
            Logger.LogFailure(result, "Carregar currículo");
            loadFailed = true;
        }

        // Sem permissão cai em "Currículo não encontrado" — não revela que o id existe
        isLoading = false;
    }

    private async Task ToggleImprovementAsync()
    {
        openImprovement = !openImprovement;
        if (openImprovement && aiPanel?.Draft is { } draft)
        {
            workspaceDraft = draft;
            showWorkspace = true;
        }
        await Task.CompletedTask;
    }

    private void OpenWorkspace(Monburan.Web.Models.ResumeImprovementDraft draft)
    {
        workspaceDraft = draft;
        showWorkspace = true;
    }

    private void OnDraftPersisted(bool persisted)
    {
        // O painel reflete se o rascunho realmente ficou salvo no navegador
        if (aiPanel is not null)
            aiPanel.DraftPersisted = persisted;
    }

    private void CloseWorkspace() => showWorkspace = false;

    private async Task OnImprovementAppliedAsync(ResumeResponse updated)
    {
        showWorkspace = false;
        aiPanel?.ClearDraft();
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (!isOwner || resume is null || isDeleting)
            return;

        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir currículo?",
            Message = $"O currículo \"{resume.Title}\" será removido e não poderá mais ser enviado em candidaturas.",
            ConfirmText = "Excluir currículo",
            Destructive = true
        });
        if (!confirmed)
            return;

        isDeleting = true;
        var result = await DeleteResumeUseCase.ExecuteAsync(ResumeId);
        isDeleting = false;

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess($"O currículo \"{resume.Title}\" foi excluído.");
            Navigation.NavigateTo("/curriculos");
            return;
        }

        Logger.LogFailure(result, "Excluir currículo");
        Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível excluir o currículo. Tente novamente."));
    }

    private string BackHref => isOwner ? "/curriculos" : "/candidaturas-recebidas";
}
