@page "/empresa/logo"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdvertiserOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.UseCases.Advertisers
@using Monburan.Core.UseCases.Storage
@inject UploadFileUseCase UploadFileUseCase
@inject UpdateAdvertiserLogoUseCase UpdateAdvertiserLogoUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<UploadLogo> Logger

<PageTitle>Logo da empresa - Monburan</PageTitle>

<div class="container page-form-shell upload-page">
    <PageHeader Title="Atualizar logo da empresa"
                Description="Escolha uma imagem nítida que represente sua organização."
                BackHref="/perfil/empresa"
                BackText="Perfil da empresa" />
    <div class="row">
        <div class="col-lg-6 mx-auto">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            @* O aviso de sucesso vai no toast; aqui fica só a logo nova, para conferir *@
            @if (!string.IsNullOrEmpty(successMessage) && !string.IsNullOrEmpty(logoUrl))
            {
                <figure class="mb-3 text-center" data-testid="upload-logo-current">
                    <img src="@logoUrl" alt="Logo atual da empresa" class="img-thumbnail logo-preview logo-preview--lg" />
                    <figcaption class="form-text">Logo atual da empresa</figcaption>
                </figure>
            }

            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="logo-file">Selecione o arquivo de logo</label>
                        <InputFile class="form-control" id="logo-file" OnChange="OnFileSelected" accept="image/jpeg,image/png,image/gif,image/webp" aria-describedby="logo-file-help" />
                        <div class="form-text" id="logo-file-help">
                            Formatos aceitos: JPEG, PNG, GIF ou WebP, com até 5 MB.
                        </div>
                    </div>

                    @if (selectedFile != null)
                    {
                        <dl class="apply-summary" aria-label="Arquivo selecionado">
                            <dt>Arquivo</dt>
                            <dd>@selectedFile.Name</dd>
                            <dt>Tamanho</dt>
                            <dd>@(selectedFile.Size / 1024) KB</dd>
                        </dl>
                    }

                    @if (imagePreviewUrl != null)
                    {
                        <div class="mb-3 text-center">
                            <img src="@imagePreviewUrl" alt="Prévia do novo logo" class="img-thumbnail logo-preview logo-preview--lg" />
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary btn-lg" @onclick="UploadLogoAsync" disabled="@(!isFileSelected || isUploading)" aria-busy="@(isUploading ? "true" : null)">
                            @if (isUploading)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Enviando…</span>
                            }
                            else
                            {
                                <span>Enviar logo</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private bool isFileSelected;
    private bool isUploading;
    private string? errorMessage;
    private string? successMessage;
    private string? logoUrl;
    private string? imagePreviewUrl;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            selectedFile = e.File;
            isFileSelected = selectedFile != null;
            errorMessage = null;

            if (selectedFile != null)
            {
                // Validar tamanho (5MB)
                const long maxSize = 5 * 1024 * 1024;
                if (selectedFile.Size > maxSize)
                {
                    errorMessage = $"Arquivo muito grande. Tamanho máximo: 5MB. Seu arquivo: {selectedFile.Size / 1024 / 1024}MB";
                    isFileSelected = false;
                    selectedFile = null;
                    return;
                }

                // Validar tipo
                var allowedTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
                {
                    "image/jpeg",
                    "image/png",
                    "image/gif",
                    "image/webp"
                };

                if (!allowedTypes.Contains(selectedFile.ContentType))
                {
                    errorMessage = "Tipo de arquivo inválido. Use JPEG, PNG, GIF ou WebP.";
                    isFileSelected = false;
                    selectedFile = null;
                    return;
                }

                // Criar preview da imagem
                using var stream = selectedFile.OpenReadStream(maxSize);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                imagePreviewUrl = $"data:{selectedFile.ContentType};base64,{Convert.ToBase64String(memoryStream.ToArray())}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao processar arquivo selecionado");
            errorMessage = "Erro ao processar arquivo. Tente novamente.";
        }
    }

    private async Task UploadLogoAsync()
    {
        if (selectedFile == null)
        {
            errorMessage = "Selecione um arquivo primeiro.";
            Toast.ShowError(errorMessage);
            return;
        }

        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        if (!advertiserId.HasValue)
        {
            errorMessage = "Esta área é exclusiva para contas de empresa.";
            Toast.ShowError(errorMessage);
            return;
        }

        isUploading = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            const long maxSize = 5 * 1024 * 1024;
            await using var stream = selectedFile.OpenReadStream(maxSize);

            // UseCase valida tipo/tamanho/assinatura do arquivo antes de gravar
            var upload = await UploadFileUseCase.ExecuteAsync(new UploadFileRequest
            {
                FileStream = stream,
                FileName = selectedFile.Name,
                ContentType = selectedFile.ContentType,
                FileType = EFileType.Image
            });
            if (upload.Status != EResultStatus.Success || upload.Data is null)
            {
                Logger.LogFailure(upload, "Upload da logo");
                errorMessage = ResultMessages.ToUserMessage(upload, "Não foi possível enviar a imagem. Tente novamente.");
                Toast.ShowError(errorMessage);
                return;
            }

            // Antes o arquivo era salvo, mas o perfil nunca recebia a nova LogoUrl
            var update = await UpdateAdvertiserLogoUseCase.ExecuteAsync(
                new UpdateAdvertiserLogoRequest(advertiserId.Value, upload.Data.FileUrl));
            if (update.Status != EResultStatus.Success)
            {
                Logger.LogFailure(update, "Atualização da logo");
                errorMessage = ResultMessages.ToUserMessage(update, "A imagem foi enviada, mas não foi possível atualizar o perfil. Tente novamente.");
                Toast.ShowError(errorMessage);
                return;
            }

            logoUrl = upload.Data.FileUrl;
            selectedFile = null;
            isFileSelected = false;
            imagePreviewUrl = null;
            successMessage = "Logo atualizada! Ela já aparece no perfil da empresa e nas suas vagas.";
            Toast.ShowSuccess(successMessage);
        }
        catch (IOException ex)
        {
            Logger.LogWarning(ex, "Falha ao ler o arquivo de logo enviado");
            errorMessage = "Não foi possível ler o arquivo. Verifique se ele tem no máximo 5 MB e tente novamente.";
            Toast.ShowError(errorMessage);
        }
        finally
        {
            isUploading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/perfil/empresa");
    }
}
