@page "/my-applications"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Applications
@using Monburan.Web.Services
@inject ListApplicationsByCandidateUseCase ListApplicationsByCandidateUseCase
@inject CurrentUserHelper CurrentUserHelper
@inject ILogger<MyApplications> Logger

<PageTitle>Minhas candidaturas - Monburan</PageTitle>

<div class="container my-applications-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Minhas candidaturas</h1>
            <p>Acompanhe as oportunidades para as quais você já se candidatou.</p>
        </div>
    </header>

    @if (isLoading)
    {
        <LoadingState Message="Carregando suas candidaturas..." />
    }
    else if (!isCandidate)
    {
        <EmptyState Icon="!" Title="Área exclusiva para candidatos" Message="Entre com uma conta de candidato para acompanhar candidaturas.">
            <a href="/dashboard" class="btn btn-primary">Voltar ao início</a>
        </EmptyState>
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar suas candidaturas"
                    Message="Tivemos um problema ao buscar suas candidaturas. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (applications.Count > 0)
    {
        <div class="card received-applications-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Vaga</th>
                                <th>Situação</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in applications)
                            {
                                <tr data-testid="my-application-row">
                                    <td><a href="@($"/jobs/{app.JobId}")"><strong>@(app.JobTitle ?? "Vaga")</strong></a></td>
                                    <td>
                                        <span class="badge @UiLabels.ApplicationStatusBadge(app.Status)">@UiLabels.ApplicationStatus(app.Status)</span>
                                    </td>
                                    <td>@UiLabels.FormatMoment(app.AppliedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <EmptyState Icon="↗"
                    Kicker="SUA PRÓXIMA OPORTUNIDADE"
                    Title="Sua jornada começa com uma candidatura"
                    Message="Quando você se candidatar, poderá acompanhar aqui as atualizações de cada processo seletivo."
                    TestId="applications-empty">
            <a href="/jobs" class="btn btn-primary">Explorar vagas <span aria-hidden="true">↗</span></a>
        </EmptyState>
    }
</div>

@code {
    private List<ApplicationResponse> applications = [];
    private bool isLoading = true;
    private bool isCandidate;
    private bool loadFailed;

    protected override async Task OnInitializedAsync()
    {
        isCandidate = CurrentUserHelper.GetCandidateId().HasValue;
        if (isCandidate)
            await LoadAsync();

        isLoading = false;
    }

    private async Task LoadAsync()
    {
        loadFailed = false;
        var result = await ListApplicationsByCandidateUseCase.ExecuteAsync(CurrentUserHelper.GetCandidateId()!.Value);
        if (result.Status == EResultStatus.Success)
        {
            applications = result.Data?.ToList() ?? [];
        }
        else
        {
            Logger.LogFailure(result, "Listar candidaturas do candidato");
            loadFailed = true;
        }
    }
}
