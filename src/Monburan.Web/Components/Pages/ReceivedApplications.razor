@page "/received-applications"
@page "/jobs/{jobId:guid}/applications"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdvertiserOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.Interfaces.Repositories
@using Monburan.Core.UseCases.Applications
@using Monburan.Core.UseCases.Jobs
@using Monburan.Web.Services
@inject ListApplicationsByJobUseCase ListApplicationsByJobUseCase
@inject SearchJobsUseCase SearchJobsUseCase
@inject CurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject IJSRuntime JS
@inject ILogger<ReceivedApplications> Logger

<PageTitle>Candidaturas recebidas - Monburan</PageTitle>

@if (!isLoading && !isAdvertiser)
{
    <AccessRestricted Reason="Esta área é exclusiva para empresas." />
}
else
{
<div class="container received-applications-page">
    <PageHeader Title="Candidaturas recebidas" BackHref="/my-jobs" BackText="Minhas vagas">
        <p>
            @if (JobId.HasValue && !string.IsNullOrEmpty(filteredJobTitle))
            {
                <text>Candidatos da vaga <strong>@filteredJobTitle</strong>. <a href="/received-applications">Ver de todas as vagas</a></text>
            }
            else
            {
                <text>Revise os perfis e escolha os próximos passos do processo.</text>
            }
        </p>
    </PageHeader>

    @if (isLoading)
    {
        <div class="skeleton-stack" role="status" aria-live="polite" data-testid="loading-state">
            <span class="visually-hidden">Carregando candidaturas…</span>
            <SkeletonBlock Height="2.8rem" />
            <SkeletonBlock Height="3.2rem" />
            <SkeletonBlock Height="3.2rem" />
            <SkeletonBlock Height="3.2rem" />
            <SkeletonBlock Height="3.2rem" />
            <SkeletonBlock Height="3.2rem" />
        </div>
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar as candidaturas"
                    Message="Tivemos um problema ao buscar as candidaturas recebidas. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else
    {
        <form class="received-filters" method="get" action="@FilterAction" data-clean-query data-testid="applications-filters">
            <label class="received-filter">
                <span class="received-filter__label">Vaga</span>
                <select class="form-select" name="vaga" data-autosubmit data-default="" data-testid="filter-job">
                    <option value="">Todas as vagas</option>
                    @foreach (var job in advertiserJobs)
                    {
                        <option value="@job.Id" selected="@(FilterJobId == job.Id)">@job.Title</option>
                    }
                </select>
            </label>
            <label class="received-filter">
                <span class="received-filter__label">Situação</span>
                <select class="form-select" name="situacao" data-autosubmit data-default="" data-testid="filter-status">
                    <option value="">Todas as situações</option>
                    <option value="sent" selected="@(FilterStatus == "sent")">Enviada</option>
                    <option value="viewed" selected="@(FilterStatus == "viewed")">Visualizada</option>
                    <option value="selected" selected="@(FilterStatus == "selected")">Selecionada</option>
                    <option value="rejected" selected="@(FilterStatus == "rejected")">Não selecionada</option>
                    <option value="archived" selected="@(FilterStatus == "archived")">Arquivada</option>
                </select>
            </label>
            <label class="received-filter">
                <span class="received-filter__label">Período</span>
                <select class="form-select" name="periodo" data-autosubmit data-default="" data-testid="filter-period">
                    <option value="">Todo o período</option>
                    <option value="7" selected="@(FilterPeriod == "7")">Últimos 7 dias</option>
                    <option value="30" selected="@(FilterPeriod == "30")">Últimos 30 dias</option>
                </select>
            </label>
            <label class="received-filter received-filter--search">
                <span class="received-filter__label">Buscar por nome</span>
                <input type="search" class="form-control" name="busca" value="@FilterSearch" maxlength="80" placeholder="Buscar por nome" data-testid="filter-search" />
            </label>
            <button type="submit" class="btn btn-outline-secondary received-filters__submit" data-testid="filter-submit">Buscar</button>
            <span class="received-filters__count" data-testid="applications-count">@filteredApplications.Count @(filteredApplications.Count == 1 ? "candidatura" : "candidaturas")</span>
            @if (isFiltered)
            {
                <a class="chip-clear" href="@FilterAction" data-enhance-nav="false" data-testid="filters-clear">
                    <Icon Name="rotate-ccw" Size="14" />Limpar filtros
                </a>
            }
        </form>

        @if (jobsFilterIncomplete)
        {
            <p class="alert alert-warning" role="status" data-testid="jobs-filter-incomplete">
                Não foi possível carregar todas as vagas para o filtro. As candidaturas abaixo continuam disponíveis, mas algumas vagas podem não aparecer nas opções.
            </p>
        }
        @if (applications.Count >= IApplicationRepository.MaxListSize)
        {
            <p class="alert alert-warning" role="status" data-testid="applications-list-incomplete">
                A lista pode estar incompleta. Busca e filtros consideram apenas as candidaturas carregadas.
            </p>
        }

        @* Ao trocar um filtro a lista atual fica na tela (sem esqueleto), marcada como ocupada até recarregar *@
        <div class="received-applications-results" aria-busy="@(isRefreshing ? "true" : null)" data-testid="applications-results">
        @if (filteredApplications.Count > 0)
        {
            <div class="card received-applications-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-cards">
                            <caption class="visually-hidden">Candidaturas recebidas: candidato, vaga, situação e data</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Candidato</th>
                                    <th scope="col">Vaga</th>
                                    <th scope="col">Situação</th>
                                    <th scope="col">Data</th>
                                    <th scope="col">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in filteredApplications)
                                {
                                    <tr data-testid="received-application-row">
                                        <td data-label="Candidato">
                                            <span class="candidate-initials" aria-hidden="true">@Initials(app.CandidateName)</span> <button type="button"
                                                    id="application-open-@app.Id"
                                                    class="btn btn-link p-0 candidate-name-btn"
                                                    data-testid="application-open"
                                                    @onclick="() => OpenDrawerAsync(app)">
                                                <strong>@app.CandidateName</strong>
                                            </button>
                                            <br />
                                            <small class="text-muted">@app.CandidateEmail</small>
                                            @if (app.ResumeId.HasValue)
                                            {
                                                <a class="d-block small" href="@($"/resumes/{app.ResumeId}")">Ver currículo enviado</a>
                                            }
                                            else
                                            {
                                                <small class="d-block text-muted">Sem currículo anexado</small>
                                            }
                                        </td>
                                        <td data-label="Vaga">@app.JobTitle</td>
                                        <td data-label="Situação">
                                            <StatusBadge Kind="StatusKind.Application" Value="@app.Status" />
                                        </td>
                                        <td data-label="Data">@UiLabels.FormatMoment(app.AppliedAt)</td>
                                        <td data-label="Ações">
                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-sm"
                                                    aria-label="Perfil e currículo de @app.CandidateName"
                                                    @onclick="() => OpenDrawerAsync(app)">
                                                Perfil e currículo
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (applications.Count > 0)
        {
            <EmptyState Icon="search"
                        Title="Nenhum resultado para estes filtros"
                        Message="Ajuste a vaga, a situação ou o período para ver outras candidaturas."
                        TestId="received-applications-filtered-empty">
                <a class="btn btn-outline-secondary" href="@FilterAction" data-enhance-nav="false">Limpar filtros</a>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="users"
                        Title="Nenhuma candidatura recebida ainda"
                        Message="Quando alguém se candidatar às suas vagas, os perfis aparecem aqui."
                        TestId="received-applications-empty">
                <a class="btn btn-primary" href="/my-jobs">Ver minhas vagas</a>
            </EmptyState>
        }
        </div>
    }
</div>
}

<ApplicantDrawer Application="selected"
                 OnClose="CloseDrawerAsync"
                 OnStatusChanged="OnStatusChangedAsync" />

@code {
    private static string Initials(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?"
            : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));

    [Parameter]
    public Guid? JobId { get; set; }

    [SupplyParameterFromQuery(Name = "vaga")]
    public string? JobQuery { get; set; }

    [SupplyParameterFromQuery(Name = "situacao")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "periodo")]
    public string? PeriodQuery { get; set; }

    [SupplyParameterFromQuery(Name = "busca")]
    public string? SearchQuery { get; set; }

    private List<ApplicationResponse> applications = [];
    private List<ApplicationResponse> filteredApplications = [];
    private List<JobResponse> advertiserJobs = [];
    private ApplicationResponse? selected;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isAdvertiser;
    private Guid? advertiserId;
    private string? filteredJobTitle;
    private Guid? lastOpenedId;
    private bool isRefreshing;
    private bool jobsFilterIncomplete;

    private Guid? FilterJobId => JobId ?? (Guid.TryParse(JobQuery, out var id) ? id : null);
    private string FilterStatus => StatusQuery ?? string.Empty;
    private string FilterPeriod => PeriodQuery ?? string.Empty;
    private string FilterSearch => SearchQuery ?? string.Empty;

    private bool isFiltered => FilterJobId.HasValue || FilterStatus.Length > 0 || FilterPeriod.Length > 0 || FilterSearch.Length > 0;

    private string FilterAction => JobId.HasValue ? $"/jobs/{JobId}/applications" : "/received-applications";

    protected override async Task OnParametersSetAsync()
    {
        advertiserId = CurrentUserHelper.GetAdvertiserId();
        isAdvertiser = advertiserId.HasValue;

        if (isAdvertiser)
        {
            // Primeira carga mostra o esqueleto; troca de filtro mantém a lista e marca o contêiner como ocupado
            isRefreshing = !isLoading;
            await LoadAsync();
            isRefreshing = false;
        }

        isLoading = false;
    }

    private async Task LoadAsync()
    {
        loadFailed = false;
        var result = await ListApplicationsByJobUseCase.ExecuteAsync(new ListApplicationsByJobRequest
        {
            AdvertiserId = advertiserId!.Value,
            JobId = FilterJobId
        });

        if (result.Status == EResultStatus.Success)
        {
            applications = result.Data?.ToList() ?? [];
            filteredJobTitle = JobId.HasValue ? applications.FirstOrDefault()?.JobTitle : null;
            await LoadJobsAsync();
            ApplyFilters();
        }
        else
        {
            Logger.LogFailure(result, "Listar candidaturas recebidas");
            loadFailed = true;
        }
    }

    // Filtro "Vaga": todas as vagas da empresa (antes só as 100 primeiras apareciam na lista)
    private async Task LoadJobsAsync()
    {
        var loaded = new List<JobResponse>();
        jobsFilterIncomplete = false;
        for (var page = 1; page <= 20; page++)
        {
            var result = await SearchJobsUseCase.ExecuteAsync(new ListJobsRequest
            {
                Page = page,
                Size = 100,
                AdvertiserId = advertiserId
            });
            if (result.Status != EResultStatus.Success || result.Data is null)
            {
                Logger.LogFailure(result, "Carregar vagas para filtrar candidaturas");
                jobsFilterIncomplete = true;
                break;
            }

            loaded.AddRange(result.Data.Jobs);
            if (!result.Data.HasNextPage)
                break;
            if (page == 20)
                jobsFilterIncomplete = true;
        }

        advertiserJobs = loaded.OrderBy(job => job.Title).ToList();
    }

    private void ApplyFilters()
    {
        IEnumerable<ApplicationResponse> query = applications;

        if (FilterStatus.Length > 0)
            query = query.Where(app => string.Equals(app.Status, StatusValue(FilterStatus), StringComparison.OrdinalIgnoreCase));

        if (FilterPeriod is "7" or "30")
        {
            var limit = DateTime.UtcNow.AddDays(FilterPeriod == "7" ? -7 : -30);
            query = query.Where(app => (app.AppliedAt ?? app.CreatedAt) >= limit);
        }

        if (FilterSearch.Length > 0)
            query = query.Where(app => app.CandidateName?.Contains(FilterSearch.Trim(), StringComparison.OrdinalIgnoreCase) == true);

        filteredApplications = query.ToList();
    }

    private static string StatusValue(string value) => value switch
    {
        "sent" => "Sent",
        "viewed" => "Viewed",
        "selected" => "Selected",
        "rejected" => "Rejected",
        "archived" => "Archived",
        _ => value
    };

    private async Task OpenDrawerAsync(ApplicationResponse application)
    {
        lastOpenedId = application.Id;
        selected = application;
        await Task.CompletedTask;
    }

    private async Task CloseDrawerAsync()
    {
        selected = null;

        // O foco volta para quem abriu a gaveta
        if (lastOpenedId is { } id)
        {
            try
            {
                await JS.InvokeVoidAsync("monburanFocusById", $"application-open-{id}");
            }
            catch (JSException)
            {
                // Sem JS o foco volta sozinho para o início do documento
            }
        }
    }

    private Task OnStatusChangedAsync(ApplicationResponse application)
    {
        ApplyFilters();
        return Task.CompletedTask;
    }
}
