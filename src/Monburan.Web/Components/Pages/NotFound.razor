@page "/404"

<PageTitle>Página não encontrada - Monburan</PageTitle>

@* No layout principal a margem lateral vem do .container (sem ele o texto encostava na borda do celular) *@
<div class="container">
    <section class="auth-message-page">
        <h1>Página não encontrada</h1>
        <p>O endereço que você tentou acessar não existe ou foi movido. Que tal voltar a explorar oportunidades?</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="/jobs">Ver vagas abertas</a>
            <a class="btn btn-outline-secondary" href="/">Voltar ao início</a>
        </div>
    </section>
</div>
