@page "/resumes/{resumeId:guid}/edit"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Resumes
@using Monburan.Web.Services
@inject GetResumeByIdUseCase GetResumeByIdUseCase
@inject UpdateResumeUseCase UpdateResumeUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<ResumeEdit> Logger

<PageTitle>Editar currículo - Monburan</PageTitle>

<UnsavedChangesGuard HasChanges="HasUnsavedChanges" />

<div class="container page-form-shell resume-edit-page">
    <PageHeader Title="Editar currículo" Description="Melhore seu currículo: complete as seções e mantenha as informações atualizadas."
                BackHref="@($"/resumes/{ResumeId}")" BackText="Voltar ao currículo" />
    <div class="row">
        <div class="col-lg-9 mx-auto">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }

            @if (isLoading)
            {
                <LoadingState Message="Carregando currículo…" />
            }
            else if (loadFailed)
            {
                <ErrorState Title="Não foi possível carregar o currículo"
                            Message="Tivemos um problema ao abrir o currículo para edição. Tente novamente em instantes."
                            OnRetry="LoadAsync" />
            }
            else if (!isOwner)
            {
                <EmptyState Icon="alert" Title="Currículo não disponível" Message="Ele não existe mais ou pertence a outra pessoa.">
                    <a class="btn btn-primary" href="/resumes">Voltar para meus currículos</a>
                </EmptyState>
            }
            else
            {
            <div class="card page-form-card">
                <div class="card-body">
                    <EditForm Model="model" OnValidSubmit="SubmitForm">
                        <DataAnnotationsValidator />
                        <ServerValidationErrors @ref="serverErrors" />

                        <p class="form-required-note">Campos com * são obrigatórios.</p>

                        <h2 class="form-section-title">Informações básicas</h2>

                        <div class="mb-3">
                            <label class="form-label" for="model.Title">Título do currículo *</label>
                            <InputText class="form-control" @bind-Value="model.Title" id="model.Title" data-testid="resume-title-input" />
                            <ValidationMessage For="@(() => model.Title)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="model.Summary">Resumo profissional</label>
                            <div class="form-text" id="model-summary-hint">Máximo de 2000 caracteres.</div>
                            <InputTextArea class="form-control" @bind-Value="model.Summary" id="model.Summary" rows="5" aria-describedby="model-summary-hint" data-testid="resume-summary-input" />
                            <ValidationMessage For="@(() => model.Summary)" />
                        </div>

                        <label class="form-check mb-3" for="model.IsActive">
                            <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="model.IsActive" />
                            <span class="form-check-label">Definir como currículo ativo</span>
                        </label>

                        <section class="resume-section" aria-labelledby="resume-edit-experiences">
                            <div class="resume-section__head form-section-title">
                                <h2 class="h5" id="resume-edit-experiences">Experiência profissional</h2>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddExperience"><Icon Name="plus" Size="16" />Adicionar experiência</button>
                            </div>
                            @for (var i = 0; i < experiences.Count; i++)
                            {
                                var index = i;
                                var exp = experiences[index];
                                <div class="resume-item">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label" for="@($"exp-position-{index}")">Cargo</label>
                                            <input id="@($"exp-position-{index}")" class="form-control" aria-label="@($"Cargo da experiência {index + 1}")" @bind="exp.Position" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="@($"exp-company-{index}")">Empresa</label>
                                            <input id="@($"exp-company-{index}")" class="form-control" autocomplete="organization" aria-label="@($"Empresa da experiência {index + 1}")" @bind="exp.Company" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="@($"exp-description-{index}")">Descrição das atividades</label>
                                            <textarea id="@($"exp-description-{index}")" class="form-control" rows="2" aria-label="@($"Descrição das atividades da experiência {index + 1}")" @bind="exp.Description"></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="@($"exp-start-{index}")">Início</label>
                                            <input id="@($"exp-start-{index}")" type="date" class="form-control" @bind="exp.StartDate" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="@($"exp-end-{index}")">Fim</label>
                                            <input id="@($"exp-end-{index}")" type="date" class="form-control" @bind="exp.EndDate" />
                                        </div>
                                        <div class="col-md-4 d-flex align-items-end justify-content-between">
                                            <label class="form-check" for="@($"exp-current-{index}")">
                                                <input type="checkbox" class="form-check-input" @bind="exp.IsCurrent" id="@($"exp-current-{index}")" />
                                                <span class="form-check-label">Emprego atual</span>
                                            </label>
                                            <button type="button" class="btn btn-outline-danger btn-sm" aria-label="@($"Remover experiência {index + 1}")" @onclick="() => experiences.RemoveAt(index)">Remover</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (experiences.Count == 0)
                            {
                                <p class="text-muted small mb-0">Nenhuma experiência adicionada.</p>
                            }
                        </section>

                        <section class="resume-section" aria-labelledby="resume-edit-educations">
                            <div class="resume-section__head form-section-title">
                                <h2 class="h5" id="resume-edit-educations">Formação acadêmica</h2>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddEducation"><Icon Name="plus" Size="16" />Adicionar formação</button>
                            </div>
                            @for (var i = 0; i < educations.Count; i++)
                            {
                                var index = i;
                                var edu = educations[index];
                                <div class="resume-item">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label" for="@($"edu-course-{index}")">Curso</label>
                                            <input id="@($"edu-course-{index}")" class="form-control" aria-label="@($"Curso da formação {index + 1}")" @bind="edu.Course" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="@($"edu-institution-{index}")">Instituição</label>
                                            <input id="@($"edu-institution-{index}")" class="form-control" aria-label="@($"Instituição da formação {index + 1}")" @bind="edu.Institution" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="@($"edu-level-{index}")">Nível</label>
                                            <select id="@($"edu-level-{index}")" class="form-select" aria-label="@($"Nível da formação {index + 1}")" @bind="edu.Level">
                                                @foreach (var level in Enum.GetValues<EEducationLevel>())
                                                {
                                                    <option value="@level">@UiLabels.EducationLevel(level.ToString())</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="@($"edu-status-{index}")">Situação</label>
                                            <select id="@($"edu-status-{index}")" class="form-select" aria-label="@($"Situação da formação {index + 1}")" @bind="edu.Status">
                                                @foreach (var st in Enum.GetValues<EEducationStatus>())
                                                {
                                                    <option value="@st">@UiLabels.EducationStatus(st.ToString())</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4 d-flex align-items-end justify-content-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm" aria-label="@($"Remover formação {index + 1}")" @onclick="() => educations.RemoveAt(index)">Remover</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (educations.Count == 0)
                            {
                                <p class="text-muted small mb-0">Nenhuma formação adicionada.</p>
                            }
                        </section>

                        <section class="resume-section" aria-labelledby="resume-edit-languages">
                            <div class="resume-section__head form-section-title">
                                <h2 class="h5" id="resume-edit-languages">Idiomas</h2>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddLanguage"><Icon Name="plus" Size="16" />Adicionar idioma</button>
                            </div>
                            @for (var i = 0; i < languages.Count; i++)
                            {
                                var index = i;
                                var lang = languages[index];
                                <div class="resume-item">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-6">
                                            <label class="form-label" for="@($"lang-name-{index}")">Idioma</label>
                                            <input id="@($"lang-name-{index}")" class="form-control" aria-label="@($"Idioma {index + 1}")" @bind="lang.Language" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="@($"lang-level-{index}")">Nível</label>
                                            <select id="@($"lang-level-{index}")" class="form-select" aria-label="@($"Nível do idioma {index + 1}")" @bind="lang.Level">
                                                @foreach (var level in Enum.GetValues<ELanguageLevel>())
                                                {
                                                    <option value="@level">@UiLabels.LanguageLevel(level.ToString())</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2 d-flex justify-content-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm" aria-label="@($"Remover idioma {index + 1}")" @onclick="() => languages.RemoveAt(index)">Remover</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (languages.Count == 0)
                            {
                                <p class="text-muted small mb-0">Nenhum idioma adicionado.</p>
                            }
                        </section>

                        <section class="resume-section" aria-labelledby="resume-edit-skills">
                            <div class="resume-section__head form-section-title">
                                <h2 class="h5" id="resume-edit-skills">Habilidades</h2>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddSkill"><Icon Name="plus" Size="16" />Adicionar habilidade</button>
                            </div>
                            @for (var i = 0; i < skills.Count; i++)
                            {
                                var index = i;
                                var skill = skills[index];
                                <div class="resume-item">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-5">
                                            <label class="form-label" for="@($"skill-name-{index}")">Habilidade</label>
                                            <input id="@($"skill-name-{index}")" class="form-control" aria-label="@($"Habilidade {index + 1}")" @bind="skill.Skill" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label" for="@($"skill-level-{index}")">Nível (1 a 5)</label>
                                            <input id="@($"skill-level-{index}")" type="number" inputmode="numeric" class="form-control" min="1" max="5" @bind="skill.Level" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label" for="@($"skill-years-{index}")">Anos</label>
                                            <input id="@($"skill-years-{index}")" type="number" inputmode="numeric" class="form-control" min="0" @bind="skill.YearsOfExperience" />
                                        </div>
                                        <div class="col-md-2 d-flex justify-content-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm" aria-label="@($"Remover habilidade {index + 1}")" @onclick="() => skills.RemoveAt(index)">Remover</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (skills.Count == 0)
                            {
                                <p class="text-muted small mb-0">Nenhuma habilidade adicionada.</p>
                            }
                        </section>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting" aria-busy="@(isSubmitting ? "true" : null)" data-testid="resume-edit-submit">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    <span>Salvando…</span>
                                }
                                else
                                {
                                    <span>Salvar alterações</span>
                                }
                            </button>
                            <a class="btn btn-outline-secondary" href="@($"/resumes/{ResumeId}")">Cancelar</a>
                        </div>
                    </EditForm>
                </div>
            </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid ResumeId { get; set; }

    private UpdateResumeRequest model = new();
    private List<ExperienceRequest> experiences = [];
    private List<EducationRequest> educations = [];
    private List<LanguageRequest> languages = [];
    private List<SkillRequest> skills = [];
    private string errorMessage = string.Empty;
    private bool isSubmitting;
    private bool saved;
    private string? initialSnapshot;
    private bool isLoading = true;
    private bool isOwner;
    private bool loadFailed;
    private ServerValidationErrors serverErrors = default!;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        var candidateId = CurrentUserHelper.GetCandidateId();
        var result = await GetResumeByIdUseCase.ExecuteAsync(ResumeId);

        if (result.Status != EResultStatus.Success || result.Data is null)
        {
            if (result.Status != EResultStatus.EntityNotFound)
            {
                Logger.LogFailure(result, "Carregar currículo para edição");
                loadFailed = true;
            }

            isOwner = false;
            isLoading = false;
            return;
        }

        var r = result.Data;
        isOwner = candidateId.HasValue && r.CandidateId == candidateId.Value;
        if (!isOwner)
        {
            isLoading = false;
            return;
        }

        model = new UpdateResumeRequest
        {
            Id = r.Id,
            CandidateId = r.CandidateId,
            Title = r.Title,
            Summary = r.Summary,
            IsActive = r.IsActive
        };

        experiences = r.ExperienceHistory?.Select(e => new ExperienceRequest
        {
            Company = e.Company,
            Position = e.Position,
            Description = e.Description,
            StartDate = e.StartDate,
            EndDate = e.EndDate,
            IsCurrent = e.IsCurrent
        }).ToList() ?? [];

        educations = r.EducationHistory?.Select(e => new EducationRequest
        {
            Institution = e.Institution,
            Course = e.Course,
            Level = Enum.TryParse<EEducationLevel>(e.Level, out var lv) ? lv : EEducationLevel.HighSchool,
            StartDate = e.StartDate,
            EndDate = e.EndDate,
            Status = Enum.TryParse<EEducationStatus>(e.Status, out var st) ? st : EEducationStatus.Completed
        }).ToList() ?? [];

        languages = r.Languages?.Select(l => new LanguageRequest
        {
            Language = l.Language,
            Level = Enum.TryParse<ELanguageLevel>(l.Level, out var lv) ? lv : ELanguageLevel.Intermediate
        }).ToList() ?? [];

        skills = r.Skills?.Select(s => new SkillRequest
        {
            Skill = s.Skill,
            Level = s.Level,
            YearsOfExperience = s.YearsOfExperience
        }).ToList() ?? [];

        isLoading = false;
        initialSnapshot = Snapshot();
    }

    // As listas usam @bind direto, fora do EditContext: compara um retrato do estado na hora da navegação
    private bool HasUnsavedChanges() =>
        !saved && !isSubmitting && initialSnapshot is not null && Snapshot() != initialSnapshot;

    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(new
    {
        model.Title, model.Summary, model.IsActive, experiences, educations, languages, skills
    });

    private void AddExperience() => experiences.Add(new ExperienceRequest());
    private void AddEducation() => educations.Add(new EducationRequest());
    private void AddLanguage() => languages.Add(new LanguageRequest());
    private void AddSkill() => skills.Add(new SkillRequest());

    private async Task SubmitForm()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = string.Empty;

        model.ExperienceHistory = experiences.Where(e => !string.IsNullOrWhiteSpace(e.Position) || !string.IsNullOrWhiteSpace(e.Company)).ToList();
        model.EducationHistory = educations.Where(e => !string.IsNullOrWhiteSpace(e.Course) || !string.IsNullOrWhiteSpace(e.Institution)).ToList();
        model.Languages = languages.Where(l => !string.IsNullOrWhiteSpace(l.Language)).ToList();
        model.Skills = skills.Where(s => !string.IsNullOrWhiteSpace(s.Skill)).ToList();

        var result = await UpdateResumeUseCase.ExecuteAsync(model);

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess("Suas alterações foram salvas.", "Currículo atualizado");
            saved = true;
            Navigation.NavigateTo($"/resumes/{ResumeId}");
            return;
        }

        Logger.LogFailure(result, "Atualizar currículo");
        var fieldErrors = ResultMessages.FieldErrors(result);
        var unmatched = serverErrors.Display(fieldErrors);
        errorMessage = fieldErrors.Count > 0 && unmatched.Count == 0
            ? "Revise os campos destacados no formulário."
            : ResultMessages.ToUserMessage(result, "Não foi possível salvar o currículo. Tente novamente.");
        Toast.ShowError(errorMessage);

        isSubmitting = false;
    }
}
