@page "/resumes/upload"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Interfaces.Services
@using Monburan.Core.UseCases.Resumes
@using Monburan.Core.UseCases.Storage
@using Monburan.Web.Services
@inject UploadFileUseCase UploadFileUseCase
@inject ImportResumeFromPdfUseCase ImportResumeFromPdfUseCase
@inject IAiTextClient AiTextClient
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<UploadResume> Logger

<PageTitle>Importar Currículo - Monburan</PageTitle>

<div class="container mt-4 page-form-shell upload-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Importar currículo em PDF</h1>
            <p>Nós lemos o seu PDF, preenchemos as seções do currículo e depois você revisa e completa o que faltar.</p>
        </div>
        <button class="btn btn-secondary" @onclick="Cancel">Voltar</button>
    </header>
    <div class="row">
        <div class="col-lg-6 mx-auto">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> @errorMessage
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="resume-file">Selecione o currículo em PDF</label>
                        <InputFile id="resume-file" class="form-control" OnChange="OnFileSelected" accept="application/pdf" />
                        <div class="form-text">
                            Formato aceito: PDF | Tamanho máximo: 10MB
                        </div>
                    </div>

                    @if (selectedFile != null)
                    {
                        <div class="alert alert-info">
                            <strong>Arquivo selecionado:</strong><br />
                            Nome: @selectedFile.Name<br />
                            Tamanho: @(selectedFile.Size / 1024) KB<br />
                            Tipo: @selectedFile.ContentType
                        </div>
                    }

                    @if (AiTextClient.IsConfigured)
                    {
                        <p class="form-text" id="resume-import-ai-note">
                            <strong>Importar com IA</strong> envia o texto do PDF a um serviço externo para preencher
                            o currículo com mais precisão. <strong>Importar sem IA</strong> faz a leitura no Monburan
                            e pode preencher menos campos. Você revisa o resultado antes de usar.
                            <a href="/privacy" target="_blank" rel="noopener">Como tratamos seus dados</a>.
                        </p>
                        <div class="d-grid gap-2 d-sm-flex">
                            <button type="button" class="btn btn-primary" @onclick="() => UploadResumeAsync(true)" disabled="@(!isFileSelected || isUploading)" aria-describedby="resume-import-ai-note" data-testid="resume-import-ai">
                                @(isUploading ? "Lendo o PDF..." : "Importar com IA")
                            </button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => UploadResumeAsync(false)" disabled="@(!isFileSelected || isUploading)" data-testid="resume-import-local">
                                @(isUploading ? "Lendo o PDF..." : "Importar sem IA")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary btn-lg" @onclick="() => UploadResumeAsync(false)" disabled="@(!isFileSelected || isUploading)">
                                @(isUploading ? "Lendo o PDF..." : "Importar currículo")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private bool isFileSelected;
    private bool isUploading;
    private string? errorMessage;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            selectedFile = e.File;
            isFileSelected = selectedFile != null;
            errorMessage = null;

            if (selectedFile != null)
            {
                const long maxSize = 10 * 1024 * 1024;
                if (selectedFile.Size > maxSize)
                {
                    errorMessage = $"Arquivo muito grande. Tamanho máximo: 10MB. Seu arquivo: {selectedFile.Size / 1024 / 1024}MB";
                    isFileSelected = false;
                    selectedFile = null;
                    return;
                }

                if (!string.Equals(selectedFile.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase))
                {
                    errorMessage = "Tipo de arquivo inválido. Use apenas PDF.";
                    isFileSelected = false;
                    selectedFile = null;
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao processar arquivo selecionado");
            errorMessage = "Erro ao processar arquivo. Tente novamente.";
        }
    }

    private async Task UploadResumeAsync(bool useAi)
    {
        if (isUploading)
            return;

        if (selectedFile == null)
        {
            errorMessage = "Selecione um arquivo primeiro.";
            Toast.ShowError(errorMessage);
            return;
        }

        var candidateId = CurrentUserHelper.GetCandidateId();
        if (!candidateId.HasValue)
        {
            errorMessage = "Esta área é exclusiva para candidatos.";
            Toast.ShowError(errorMessage);
            return;
        }

        isUploading = true;
        errorMessage = null;
        try
        {
            const long maxSize = 10 * 1024 * 1024;
            string? fileUrl = null;

            // Primeiro grava o PDF como documento de origem
            await using (var uploadStream = selectedFile.OpenReadStream(maxSize))
            {
                var upload = await UploadFileUseCase.ExecuteAsync(new UploadFileRequest
                {
                    FileStream = uploadStream,
                    FileName = selectedFile.Name,
                    ContentType = selectedFile.ContentType,
                    FileType = EFileType.Pdf
                });
                if (upload.Status != EResultStatus.Success || upload.Data is null)
                {
                    Logger.LogFailure(upload, "Upload de currículo em PDF");
                    errorMessage = ResultMessages.ToUserMessage(upload, "Não foi possível enviar o PDF. Tente novamente.");
                    Toast.ShowError(errorMessage);
                    return;
                }

                fileUrl = upload.Data.FileUrl;
            }

            // Depois lê o conteúdo e monta o currículo estruturado
            await using var readStream = selectedFile.OpenReadStream(maxSize);
            var import = await ImportResumeFromPdfUseCase.ExecuteAsync(new ImportResumeRequest
            {
                FileStream = readStream,
                FileName = selectedFile.Name,
                FileUrl = fileUrl,
                CandidateId = candidateId.Value,
                AcceptsExternalProcessing = useAi && AiTextClient.IsConfigured
            });

            if (import.Status != EResultStatus.Success || import.Data is null)
            {
                Logger.LogFailure(import, "Leitura do PDF importado");
                errorMessage = ResultMessages.ToUserMessage(import, "O PDF foi enviado, mas não conseguimos ler o conteúdo. Tente outro arquivo.");
                Toast.ShowError(errorMessage);
                return;
            }

            var result = import.Data;
            var message = result.ExtractedBy switch
            {
                EResumeImportMode.Ai => $"A IA leu seu PDF e encontrou {result.SectionsFound} de 5 seções preenchidas. Revise e complete o que faltar.",
                EResumeImportMode.Local => $"Lemos seu PDF e encontramos {result.SectionsFound} de 5 seções preenchidas. Revise e complete o que faltar.",
                _ => "Este PDF parece digitalizado (sem texto selecionável), então não conseguimos ler nada. Preencha as seções pelo passo a passo."
            };
            Toast.ShowSuccess(message, result.ExtractedBy == EResumeImportMode.None ? "PDF sem texto legível" : "Currículo importado");
            Navigation.NavigateTo($"/resumes/{result.ResumeId}/wizard");
        }
        catch (IOException ex)
        {
            Logger.LogWarning(ex, "Falha ao ler o PDF enviado");
            errorMessage = "Não foi possível ler o arquivo. Verifique se ele tem no máximo 10 MB e tente novamente.";
            Toast.ShowError(errorMessage);
        }
        finally
        {
            isUploading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/resumes");
    }
}
