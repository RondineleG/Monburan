@page "/curriculos/{resumeId:guid}/cv"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Web.Services
@inject ResumeViewerService ResumeViewer
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<ResumeCvView> Logger

<PageTitle>@(viewer?.Resume.Title ?? "Currículo") - Monburan</PageTitle>

@if (isLoading)
{
    @* Enquanto carrega, a página ainda precisa de um título principal (o h1 normal vem do documento) *@
    <div class="container">
        <h1 class="visually-hidden">Currículo</h1>
        <LoadingState Message="Montando o currículo…" />
    </div>
}
else if (loadFailed)
{
    <div class="container">
        <ErrorState Title="Não foi possível carregar o currículo"
                    Message="Tivemos um problema ao montar o documento. Tente novamente em instantes."
                    HeadingLevel="1"
                    OnRetry="LoadAsync" />
    </div>
}
else if (viewer is null)
{
    <div class="container">
        <EmptyState Icon="alert" Title="Currículo não disponível" Message="Ele não existe mais ou você não tem acesso a ele." HeadingLevel="1">
            <a class="btn btn-primary" href="@BackHref">@(isOwnerView ? "Voltar para meus currículos" : "Voltar para candidaturas")</a>
        </EmptyState>
    </div>
}
else
{
    @* Cabeçalho e dica somem na impressão (pages.css, @media print): só a folha vai para o papel *@
    <div class="container">
        <PageHeader Title="@($"CV: {viewer.Resume.Title}")" TestId="cv-toolbar"
                    BackHref="@($"/curriculos/{ResumeId}")" BackText="Voltar ao currículo">
            <Actions>
                <button type="button" class="btn btn-primary" @onclick="PrintAsync" data-testid="cv-print"><Icon Name="download" Size="16" />Imprimir ou salvar PDF</button>
                @if (viewer.IsOwner)
                {
                    <a class="btn btn-outline-secondary" href="/curriculos/@ResumeId/editar">Editar currículo</a>
                    <a class="btn btn-outline-secondary" href="/curriculos/@ResumeId?melhorar=true"><Icon Name="sparkles" Size="16" />Melhorar currículo</a>
                }
            </Actions>
            <ChildContent>
                <p class="cv-print-hint">Na janela de impressão do navegador, escolha <strong>Salvar como PDF</strong>. Se aparecerem data ou endereço da página, desative a opção <strong>Cabeçalhos e rodapés</strong>.</p>
            </ChildContent>
        </PageHeader>
    </div>

    <div class="container my-4 cv-print-area">
        @* A página já tem o h1 no cabeçalho: o nome na folha desce para h2 (o estilo vem de .cv-name) *@
        <ResumeDocument Resume="viewer.Resume"
                        Name="@viewer.Name"
                        Email="@viewer.Email"
                        Phone="@viewer.Phone"
                        LinkedIn="@viewer.LinkedIn"
                        HeadingLevel="2" />
    </div>
}

@code {
    [Parameter]
    public Guid ResumeId { get; set; }

    private ResumeViewerResponse? viewer;
    private bool isLoading = true;
    private bool loadFailed;
    private Guid? loadedId;
    private int loadVersion;

    private bool isCandidateView => CurrentUserHelper.GetCandidateId().HasValue;
    private bool isOwnerView => isCandidateView && viewer?.Resume.CandidateId == CurrentUserHelper.GetCandidateId();
    private string BackHref => isCandidateView ? "/curriculos" : "/candidaturas-recebidas";

    // Trocar de currículo reaproveita o componente: recarrega por id e zera o estado anterior
    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == ResumeId)
            return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++loadVersion;
        var resumeId = ResumeId;
        isLoading = true;
        loadFailed = false;
        viewer = null;
        loadedId = resumeId;

        var result = await ResumeViewer.GetAsync(resumeId);
        if (version != loadVersion || resumeId != ResumeId)
            return;
        if (result.Status == EResultStatus.Success && result.Data is not null)
        {
            viewer = result.Data;
        }
        else if (result.Status != EResultStatus.EntityNotFound)
        {
            Logger.LogFailure(result, "Carregar currículo para visualização de CV");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");
}
