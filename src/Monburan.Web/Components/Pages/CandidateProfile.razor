@page "/perfil/candidato"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@inject Monburan.Core.UseCases.Candidates.UpdateCandidateUseCase UpdateCandidateUseCase
@inject Monburan.Core.Interfaces.Repositories.Base.IBaseRepository<Monburan.Core.Entities.Candidate> CandidateRepository
@inject Monburan.Core.UseCases.Resumes.ListResumesByCandidateUseCase ListResumesByCandidateUseCase
@inject Monburan.Web.Services.ICurrentUserHelper CurrentUserHelper
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject ILogger<CandidateProfile> Logger
@inject IToastService Toast

<PageTitle>Meu perfil - Monburan</PageTitle>

<div class="container profile-layout candidate-profile-page">
    <PageHeader Title="Meu perfil" Description="Mantenha suas informações profissionais atualizadas para se candidatar com confiança." />

    @if (_isLoading)
    {
        <div class="skeleton-stack" role="status" aria-live="polite" data-testid="loading-state">
            <span class="visually-hidden">Carregando seu perfil…</span>
            <SkeletonCard ShowFooter="false" />
            <SkeletonCard ShowFooter="false" />
        </div>
    }
    else if (_loadFailed)
    {
        <ErrorState Title="Não foi possível carregar o perfil"
                    Message="Tivemos um problema ao buscar seus dados. Tente novamente em instantes."
                    OnRetry="LoadCandidateAsync" />
    }
    else if (_candidate != null)
    {
        <div class="profile-identity">
            <span class="profile-identity__avatar" aria-hidden="true">@ClaimsExtensions.Initials(_candidate.Name ?? string.Empty)</span>
            <div>
                <strong>@_candidate.Name</strong>
                <span class="text-muted d-block small">@_candidate.Email</span>
            </div>
        </div>

        <div class="settings-layout">
            <section class="settings-main" aria-labelledby="personal-heading">
                <h2 id="personal-heading">Dados pessoais e contato</h2>
                <p class="text-muted small"><Icon Name="shield" Size="14" /> Seu e-mail e telefone são compartilhados com a empresa quando você se candidata a uma vaga.</p>
                        <EditForm Model="_editModel" OnValidSubmit="HandleSaveAsync" Context="form">
                            <UnsavedChangesGuard HasChanges="() => form.IsModified() && !_isSaving" />
                            <p class="form-required-note">Campos com * são obrigatórios.</p>
                            <DataAnnotationsValidator />
                            <ServerValidationErrors @ref="_serverErrors" />
                            <div class="form-grid">

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="candidate-name">Nome completo *</label>
                                <InputText @bind-Value="_editModel.Name" class="form-control" id="candidate-name" autocomplete="name" data-testid="candidate-profile-name" />
                                <ValidationMessage For="@(() => _editModel.Name)" />
                            </div>

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="candidate-email">E-mail</label>
                                <InputText @bind-Value="_editModel.Email" type="email" class="form-control" id="candidate-email" autocomplete="email" disabled aria-describedby="candidate-email-help" />
                                <small class="form-text" id="candidate-email-help">Para trocar o e-mail de acesso, use <a href="/conta/email">Conta e segurança</a>.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="candidate-phone">Telefone</label>
                                <InputText @bind-Value="_editModel.Phone" type="tel" class="form-control" id="candidate-phone" autocomplete="tel" placeholder="(00) 00000-0000" />
                                <ValidationMessage class="text-danger" For="@(() => _editModel.Phone)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="candidate-dob">Data de nascimento *</label>
                                <InputDate ParsingErrorMessage="Informe uma data válida." @bind-Value="_editModel.DateOfBirth" class="form-control" id="candidate-dob" autocomplete="bday" max="@DateTime.Today.AddYears(-14).ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => _editModel.DateOfBirth)" />
                            </div>

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="candidate-linkedin">LinkedIn</label>
                                <InputText @bind-Value="_editModel.LinkedIn" type="url" class="form-control" id="candidate-linkedin" autocomplete="url" placeholder="https://linkedin.com/in/seu-perfil" />
                                <ValidationMessage class="text-danger" For="@(() => _editModel.LinkedIn)" />
                            </div>

                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving" aria-busy="@(_isSaving ? "true" : null)">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Salvando…</span>
                                    }
                                    else
                                    {
                                        <span>Salvar alterações</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@_isSaving">Desfazer alterações</button>
                            </div>
                        </EditForm>
            </section>

            <aside class="settings-aside" aria-label="Links da conta">
                <div class="settings-group">
                    <h3>Currículo</h3>
                    <p class="text-muted small">Experiências e habilidades ficam no currículo enviado nas candidaturas.</p>
                    @if (_mainResume is not null)
                    {
                        <p class="small"><strong>@_mainResume.Title</strong></p>
                        <a class="btn btn-outline-secondary btn-sm" href="/curriculos/@_mainResume.Id/edit">Editar currículo</a>
                        <a class="btn btn-outline-secondary btn-sm" href="/curriculos/@_mainResume.Id/cv">Ver CV</a>
                    }
                    <a class="btn btn-outline-secondary btn-sm" href="/curriculos">Meus currículos</a>
                </div>
                <div class="settings-group">
                    <h3>Conta</h3>
                    <p class="small"><StatusBadge Text="@UiLabels.AccountStatus(_candidate.Status)" Tone="@UiLabels.AccountStatusTone(_candidate.Status)" />
                        <span class="text-muted"> desde @UiLabels.FormatMomentDate(_candidate.CreatedAt)</span></p>
                    <a class="btn btn-outline-secondary btn-sm" href="/enderecos">Meu endereço</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/conta">Senha e segurança</a>
                </div>
            </aside>
        </div>
    }
    else
    {
        <EmptyState Icon="alert" Title="Perfil de candidato não encontrado" Message="Esta área é exclusiva para contas de candidato.">
            <a class="btn btn-primary" href="/painel">Voltar ao início</a>
        </EmptyState>
    }
</div>

@code {
    private Monburan.Core.Entities.Candidate? _candidate;
    private Monburan.Core.DTOs.Response.ResumeResponse? _mainResume;
    private EditModel _editModel = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _loadFailed;
    private ServerValidationErrors _serverErrors = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadCandidateAsync();
    }

    private async Task LoadCandidateAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        try
        {
            var candidateId = CurrentUserHelper.GetCandidateId();
            if (candidateId.HasValue)
            {
                var result = await CandidateRepository.GetByIdAsync(Monburan.Core.ValueObjects.Id.Create(candidateId.Value));
                if (result.Status is not (Monburan.Core.Enums.EResultStatus.Success or Monburan.Core.Enums.EResultStatus.EntityNotFound))
                {
                    Logger.LogFailure(result, "Carregar perfil do candidato");
                    _loadFailed = true;
                }
                else if (result.Status == Monburan.Core.Enums.EResultStatus.Success && result.Data != null)
                {
                    _candidate = result.Data;
                    _editModel = NewEditModel(_candidate);
                    await LoadMainResumeAsync(candidateId.Value);
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        if (_isSaving)
            return;

        _isSaving = true;

        try
        {
            var request = new Monburan.Core.DTOs.Request.UpdateCandidateRequest
            {
                Id = _editModel.Id,
                Name = _editModel.Name,
                Phone = _editModel.Phone,
                DateOfBirth = _editModel.DateOfBirth,
                LinkedIn = _editModel.LinkedIn,
                AddressId = _editModel.AddressId
            };

            var result = await UpdateCandidateUseCase.ExecuteAsync(request);

            if (result.Status == Monburan.Core.Enums.EResultStatus.Success)
            {
                Toast.ShowSuccess("Seus dados foram atualizados.", "Perfil salvo");
                await LoadCandidateAsync();
            }
            else
            {
                Logger.LogFailure(result, "Atualizar perfil do candidato");
                var fieldErrors = ResultMessages.FieldErrors(result);
                var unmatched = _serverErrors.Display(fieldErrors);
                Toast.ShowError(fieldErrors.Count > 0 && unmatched.Count == 0
                    ? "Revise os campos destacados no formulário."
                    : ResultMessages.ToUserMessage(result, "Não foi possível salvar o perfil. Tente novamente."));
            }
        }
        catch (Exception ex)
        {
            // Exceção nunca vai crua para a tela (pode conter SQL/caminhos internos)
            Logger.LogError(ex, "Erro ao salvar o perfil do candidato");
            Toast.ShowError(ResultMessages.GenericError);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task LoadMainResumeAsync(Guid candidateId)
    {
        // Atalho para o currículo enviado nas candidaturas: o ativo, senão o primeiro da lista
        var result = await ListResumesByCandidateUseCase.ExecuteAsync(candidateId);
        _mainResume = result.Status == Monburan.Core.Enums.EResultStatus.Success
            ? result.Data?.FirstOrDefault(resume => resume.IsActive) ?? result.Data?.FirstOrDefault()
            : null;
    }

    // O AddressId mora fora do formulário: sem ele aqui, carregar/desfazer apagava o endereço no salvar
    private static EditModel NewEditModel(Monburan.Core.Entities.Candidate candidate) => new()
    {
        Id = candidate.Id.Value,
        Name = candidate.Name,
        Email = candidate.Email,
        Phone = candidate.Phone,
        DateOfBirth = candidate.DateOfBirth,
        LinkedIn = candidate.LinkedIn,
        AddressId = candidate.AddressId?.Value
    };

    private void CancelEdit()
    {
        if (_candidate != null)
        {
            _editModel = NewEditModel(_candidate);
            _serverErrors.Clear();
        }
    }

    private class EditModel
    {
        public Guid Id { get; set; }
        [Required(ErrorMessage = "Informe seu nome completo.")]
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        [Required(ErrorMessage = "Informe sua data de nascimento.")]
        public DateTime? DateOfBirth { get; set; }
        public string? LinkedIn { get; set; }
        public Guid? AddressId { get; set; }
    }
}
