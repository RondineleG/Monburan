@page "/profile/candidate"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@inject Monburan.Core.UseCases.Candidates.UpdateCandidateUseCase UpdateCandidateUseCase
@inject Monburan.Core.Interfaces.Repositories.Base.IBaseRepository<Monburan.Core.Entities.Candidate> CandidateRepository
@inject Monburan.Web.Services.ICurrentUserHelper CurrentUserHelper
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject ILogger<CandidateProfile> Logger
@inject IToastService Toast

<PageTitle>Meu Perfil - Monburan</PageTitle>

<div class="container mt-4 profile-layout candidate-profile-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Meu perfil</h1>
            <p>Mantenha suas informações profissionais atualizadas para se candidatar com confiança.</p>
        </div>
    </header>

    @if (_isLoading)
    {
        <LoadingState Message="Carregando seu perfil..." />
    }
    else if (_loadFailed)
    {
        <ErrorState Title="Não foi possível carregar o perfil"
                    Message="Tivemos um problema ao buscar seus dados. Tente novamente em instantes."
                    OnRetry="LoadCandidateAsync" />
    }
    else if (_candidate != null)
    {
        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card profile-form-card">
                    <div class="card-header">
                        <h5 class="mb-0">Dados Pessoais</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="_editModel" OnValidSubmit="HandleSaveAsync">
                            <DataAnnotationsValidator />
                            <ServerValidationErrors @ref="_serverErrors" />

                            <div class="mb-3">
                                <label class="form-label" for="candidate-name">Nome Completo *</label>
                                <InputText @bind-Value="_editModel.Name" class="form-control" id="candidate-name" data-testid="candidate-profile-name" />
                                <ValidationMessage For="@(() => _editModel.Name)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="candidate-email">Email</label>
                                <InputText @bind-Value="_editModel.Email" class="form-control" id="candidate-email" disabled />
                                <small class="text-muted">Email não pode ser alterado</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="candidate-phone">Telefone</label>
                                <InputText @bind-Value="_editModel.Phone" class="form-control" id="candidate-phone" placeholder="(00) 00000-0000" />
                                <ValidationMessage class="text-danger" For="@(() => _editModel.Phone)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="candidate-dob">Data de Nascimento *</label>
                                <InputDate ParsingErrorMessage="Informe uma data válida." @bind-Value="_editModel.DateOfBirth" class="form-control" id="candidate-dob" max="@DateTime.Today.AddYears(-14).ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => _editModel.DateOfBirth)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="candidate-linkedin">LinkedIn</label>
                                <InputText @bind-Value="_editModel.LinkedIn" class="form-control" id="candidate-linkedin" placeholder="https://linkedin.com/in/seu-perfil" />
                                <ValidationMessage class="text-danger" For="@(() => _editModel.LinkedIn)" />
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    Salvar Alterações
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@_isSaving">Cancelar</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Informações da Conta</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7">
                                <span class="badge @(GetStatusBadgeClass())">@UiLabels.AccountStatus(_candidate.Status)</span>
                            </dd>

                            <dt class="col-sm-5">E-mail verificado</dt>
                            <dd class="col-sm-7">
                                @if (_candidate.IsEmailVerified)
                                {
                                    <span class="badge bg-success">Sim</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Não</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Membro desde</dt>
                            <dd class="col-sm-7">@UiLabels.FormatMomentDate(_candidate.CreatedAt)</dd>
                        </dl>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Atalhos</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-primary btn-sm" href="/resumes">Meus currículos</a>
                            <a class="btn btn-outline-primary btn-sm" href="/address/list">Meu endereço</a>
                            <a class="btn btn-outline-primary btn-sm" href="/Account/Manage">Senha e segurança da conta</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <EmptyState Icon="!" Title="Perfil de candidato não encontrado" Message="Esta área é exclusiva para contas de candidato.">
            <a class="btn btn-primary" href="/dashboard">Voltar ao início</a>
        </EmptyState>
    }
</div>

@code {
    private Monburan.Core.Entities.Candidate? _candidate;
    private EditModel _editModel = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _loadFailed;
    private ServerValidationErrors _serverErrors = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadCandidateAsync();
    }

    private async Task LoadCandidateAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        try
        {
            var candidateId = CurrentUserHelper.GetCandidateId();
            if (candidateId.HasValue)
            {
                var result = await CandidateRepository.GetByIdAsync(Monburan.Core.ValueObjects.Id.Create(candidateId.Value));
                if (result.Status is not (Monburan.Core.Enums.EResultStatus.Success or Monburan.Core.Enums.EResultStatus.EntityNotFound))
                {
                    Logger.LogFailure(result, "Carregar perfil do candidato");
                    _loadFailed = true;
                }
                else if (result.Status == Monburan.Core.Enums.EResultStatus.Success && result.Data != null)
                {
                    _candidate = result.Data;
                    _editModel = new EditModel
                    {
                        Id = _candidate.Id.Value,
                        Name = _candidate.Name,
                        Email = _candidate.Email,
                        Phone = _candidate.Phone,
                        DateOfBirth = _candidate.DateOfBirth,
                        LinkedIn = _candidate.LinkedIn
                    };
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        if (_isSaving)
            return;

        _isSaving = true;

        try
        {
            var request = new Monburan.Core.DTOs.Request.UpdateCandidateRequest
            {
                Id = _editModel.Id,
                Name = _editModel.Name,
                Phone = _editModel.Phone,
                DateOfBirth = _editModel.DateOfBirth,
                LinkedIn = _editModel.LinkedIn,
                AddressId = _editModel.AddressId
            };

            var result = await UpdateCandidateUseCase.ExecuteAsync(request);

            if (result.Status == Monburan.Core.Enums.EResultStatus.Success)
            {
                Toast.ShowSuccess("Seus dados foram atualizados.", "Perfil salvo");
                await LoadCandidateAsync();
            }
            else
            {
                Logger.LogFailure(result, "Atualizar perfil do candidato");
                var fieldErrors = ResultMessages.FieldErrors(result);
                var unmatched = _serverErrors.Display(fieldErrors);
                Toast.ShowError(fieldErrors.Count > 0 && unmatched.Count == 0
                    ? "Revise os campos destacados no formulário."
                    : ResultMessages.ToUserMessage(result, "Não foi possível salvar o perfil. Tente novamente."));
            }
        }
        catch (Exception ex)
        {
            // Exceção nunca vai crua para a tela (pode conter SQL/caminhos internos)
            Logger.LogError(ex, "Erro ao salvar o perfil do candidato");
            Toast.ShowError(ResultMessages.GenericError);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CancelEdit()
    {
        if (_candidate != null)
        {
            _editModel = new EditModel
            {
                Id = _candidate.Id.Value,
                Name = _candidate.Name,
                Email = _candidate.Email,
                Phone = _candidate.Phone,
                DateOfBirth = _candidate.DateOfBirth,
                LinkedIn = _candidate.LinkedIn
            };
            _serverErrors.Clear();
        }
    }

    private string GetStatusBadgeClass()
    {
        return _candidate?.Status switch
        {
            Monburan.Core.Enums.EAccountStatus.Active => "bg-success",
            Monburan.Core.Enums.EAccountStatus.Incomplete => "bg-warning",
            Monburan.Core.Enums.EAccountStatus.Blocked => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private class EditModel
    {
        public Guid Id { get; set; }
        [Required(ErrorMessage = "Informe seu nome completo.")]
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        [Required(ErrorMessage = "Informe sua data de nascimento.")]
        public DateTime? DateOfBirth { get; set; }
        public string? LinkedIn { get; set; }
        public Guid? AddressId { get; set; }
    }
}
