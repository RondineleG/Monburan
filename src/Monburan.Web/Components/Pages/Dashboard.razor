@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Candidates
@using Monburan.Core.UseCases.Jobs
@using Monburan.Web.Services
@using Monburan.Web.UseCases.Analytics
@inject SearchJobsUseCase SearchJobsUseCase
@inject GetDashboardAnalyticsUseCase DashboardAnalyticsUseCase
@inject GetCandidateProgressUseCase GetCandidateProgressUseCase
@inject ListRecommendedJobsUseCase ListRecommendedJobsUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject ILogger<Dashboard> Logger

<PageTitle>@(isAnonymous ? "Monburan - Vagas de emprego e recrutamento" : "Início - Monburan")</PageTitle>

<HeadContent>
    <meta name="description" content="Monburan - Encontre vagas de emprego, acompanhe suas candidaturas ou publique vagas e organize os candidatos." />
    <meta property="og:title" content="Monburan - Vagas de emprego e recrutamento" />
    <meta property="og:description" content="Plataforma gratuita de recrutamento e seleção" />
    <meta property="og:type" content="website" />
</HeadContent>

<div class="container dashboard-page">
    @if (isAnonymous)
    {
        <section class="landing-hero" aria-labelledby="landing-title">
            <h1 id="landing-title" tabindex="-1">O trabalho certo muda tudo.</h1>
            <p>Encontre vagas por cargo e cidade, candidate-se de graça e acompanhe cada etapa em um só lugar.</p>
            @* Busca primeiro: o mesmo formulário GET da lista de vagas *@
            <form class="jobs-search landing-search" method="get" action="/jobs" role="search" aria-label="Buscar vagas" data-clean-query data-testid="landing-search">
                <div class="jobs-search__bar">
                    <label class="search-field">
                        <Icon Name="search" Size="20" />
                        <span class="visually-hidden">Cargo, habilidade ou palavra-chave</span>
                        <input name="q" type="search" maxlength="100" autocomplete="off" enterkeyhint="search" placeholder="Cargo, habilidade ou palavra-chave" />
                    </label>
                    <label class="search-field">
                        <Icon Name="map-pin" Size="20" />
                        <span class="visually-hidden">Cidade ou estado</span>
                        <input name="local" type="text" maxlength="80" autocomplete="address-level2" enterkeyhint="search" placeholder="Cidade ou estado" />
                    </label>
                    <button type="submit" class="btn btn-cta jobs-search__submit">Buscar vagas</button>
                </div>
            </form>
            <div class="landing-hero__actions">
                <a class="btn btn-outline-secondary" href="/Account/Register">Criar conta gratuita</a>
                <a class="btn btn-ghost" href="/Account/Register?AccountType=advertiser">Sou empresa e quero contratar</a>
            </div>
            <ul class="landing-hero__proof">
                <li><Icon Name="check" Size="16" />Vagas abertas a todos, sem login para ler</li>
                <li><Icon Name="check" Size="16" />Candidatura gratuita</li>
                <li><Icon Name="check" Size="16" />Acompanhamento de cada etapa</li>
            </ul>
        </section>
    }
    else if (isAdminOnly)
    {
        @* Administrador sem perfil de candidato ou empresa: visão própria, sem o convite "Criar conta / Entrar" *@
        <PageHeader Title="Visão geral" Description="Modere contas e vagas, acompanhe a auditoria e configure os provedores de IA.">
            <Actions>
                <a class="btn btn-primary" href="/admin/jobs" data-testid="dashboard-primary">Moderar vagas</a>
            </Actions>
        </PageHeader>
        <nav class="admin-overview" aria-label="Áreas de administração">
            <a class="admin-overview__item" href="/admin/accounts">
                <strong>Contas</strong>
                <span>Ative, inative e desbloqueie contas de candidatos, empresas e administradores.</span>
            </a>
            <a class="admin-overview__item" href="/admin/jobs">
                <strong>Vagas</strong>
                <span>Revise, oculte ou reprove vagas de todas as empresas.</span>
            </a>
            <a class="admin-overview__item" href="/admin/audit">
                <strong>Auditoria</strong>
                <span>Veja quem fez cada ação de administração e quando.</span>
            </a>
            <a class="admin-overview__item" href="/admin/ai-providers">
                <strong>Provedores de IA</strong>
                <span>Cadastre, teste e escolha o provedor usado nas sugestões de currículo.</span>
            </a>
        </nav>
    }
    else if (isAdvertiser)
    {
        @* A ação "Publicar vaga" fica na barra superior em todas as telas da empresa *@
        <PageHeader Title="Visão geral" Description="Acompanhe suas vagas e as candidaturas recebidas em um só lugar.">
            <Actions>
                <a class="btn btn-outline-secondary" href="/received-applications" data-testid="dashboard-primary">Ver candidaturas recebidas</a>
            </Actions>
        </PageHeader>
    }
    else
    {
        <PageHeader Title="Continue sua jornada" Description="Acompanhe suas candidaturas e descubra a próxima oportunidade.">
            <Actions>
                <a class="btn btn-primary" href="/jobs" data-testid="dashboard-primary">Explorar vagas</a>
            </Actions>
        </PageHeader>
    }

    @if (isLoading)
    {
        <div class="skeleton-stack" role="status" data-testid="loading-state">
            <span class="visually-hidden">Carregando…</span>
            <div class="skeleton-grid">
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
            </div>
            <SkeletonBlock Height="12rem" Radius="var(--r-md)" />
        </div>
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar o painel"
                    Message="Tivemos um problema ao buscar seus indicadores. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (isAdvertiser && analytics is not null)
    {
        <section class="mb-4" aria-labelledby="metrics-title">
            <h2 id="metrics-title" class="visually-hidden">Indicadores de recrutamento</h2>
            <div class="dashboard-summary dashboard-summary--four">
                <a class="dashboard-summary__cell" href="/my-jobs">
                    <strong>@analytics.TotalJobs</strong>
                    <span>Total de vagas</span>
                </a>
                <a class="dashboard-summary__cell" href="/my-jobs">
                    <strong>@analytics.ActiveJobs</strong>
                    <span>Vagas ativas</span>
                </a>
                <a class="dashboard-summary__cell" href="/received-applications">
                    <strong>@analytics.TotalCandidates</strong>
                    <span>Candidatos</span>
                </a>
                <a class="dashboard-summary__cell" href="/received-applications">
                    <strong>@analytics.TotalApplications</strong>
                    <span>Candidaturas</span>
                </a>
            </div>
        </section>

        <div class="dashboard-breakdowns">
            @if (analytics.JobsByStatus is { Count: > 0 })
            {
                <section class="card" aria-labelledby="jobs-by-status">
                    <div class="card-body">
                        <h2 id="jobs-by-status" class="card-title">Vagas por situação</h2>
                        @foreach (var status in analytics.JobsByStatus)
                        {
                            var percentage = analytics.TotalJobs > 0 ? (status.Value * 100 / analytics.TotalJobs) : 0;
                            <div class="breakdown-row">
                                <div class="breakdown-row__label">
                                    <span>@UiLabels.JobStatusPlural(status.Key)</span>
                                    <span>@status.Value (@percentage%)</span>
                                </div>
                                @* A proporção já está no texto: a barra é só visual *@
                                <div class="progress" aria-hidden="true">
                                    <div class="progress-bar @ToneBar(UiLabels.JobStatusTone(status.Key))" style="width: @percentage%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (analytics.ApplicationsByStatus is { Count: > 0 })
            {
                <section class="card" aria-labelledby="applications-by-status">
                    <div class="card-body">
                        <h2 id="applications-by-status" class="card-title">Candidaturas por situação</h2>
                        @foreach (var status in analytics.ApplicationsByStatus)
                        {
                            var percentage = analytics.TotalApplications > 0 ? (status.Value * 100 / analytics.TotalApplications) : 0;
                            <div class="breakdown-row">
                                <div class="breakdown-row__label">
                                    <span>@UiLabels.ApplicationStatusPlural(status.Key)</span>
                                    <span>@status.Value (@percentage%)</span>
                                </div>
                                <div class="progress" aria-hidden="true">
                                    <div class="progress-bar @ToneBar(UiLabels.ApplicationStatusTone(status.Key))" style="width: @percentage%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }

    @if (isCandidate && progress is not null)
    {
        <section class="dashboard-progress mb-4" aria-labelledby="progress-title">
            <div class="page-section__heading">
                <h2 id="progress-title">Continue de onde parou</h2>
                <p class="dashboard-progress__label" data-testid="candidate-progress-label">@CandidateProgressText.Completeness(progress.CompletenessPercent)</p>
            </div>

            <div class="progress dashboard-progress__bar" role="progressbar"
                 aria-valuenow="@progress.CompletenessPercent" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Perfil completo">
                <div class="progress-bar" style="width: @(progress.CompletenessPercent)%"></div>
            </div>

            <div class="dashboard-candidate">
                <article class="card">
                    <div class="card-body">
                        <h3>Próximos passos</h3>
                        @if (nextSteps.Count > 0)
                        {
                            <ul class="next-steps" data-testid="candidate-next-steps">
                                @foreach (var step in nextSteps)
                                {
                                    <li><a href="@step.ActionUrl">@step.Label<Icon Name="arrow-right" Size="16" /></a></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Tudo certo por aqui: seu perfil está completo.</p>
                        }
                    </div>
                </article>
                <nav class="dashboard-summary" aria-label="Resumo das suas candidaturas">
                    <a class="dashboard-summary__cell" href="/my-applications?aba=candidaturas">
                        <strong>@progress.Applications.Total</strong>
                        <span>Candidaturas</span>
                        <small>@InProgressApplications em andamento</small>
                    </a>
                    <a class="dashboard-summary__cell" href="/my-applications?aba=candidaturas">
                        <strong>@progress.Applications.Selected</strong>
                        <span>Selecionadas</span>
                    </a>
                    <a class="dashboard-summary__cell" href="/my-applications?aba=salvas">
                        <strong>@progress.SavedJobs</strong>
                        <span>Vagas salvas</span>
                    </a>
                    <a class="dashboard-summary__cell" href="/my-applications?aba=alertas">
                        <strong>@progress.ActiveAlerts</strong>
                        <span>Alertas ativos</span>
                    </a>
                </nav>
            </div>
        </section>
    }

    @if (isCandidate && !hasCareerProfile && !isLoading && !loadFailed)
    {
        <aside class="promo-strip mb-4" aria-label="Perfil de carreira">
            <div class="promo-strip__body">
                <p class="promo-strip__title">Receba vagas que combinam com você</p>
                <p class="promo-strip__text">Conte o cargo, a cidade e a modalidade que procura no perfil de carreira.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/career-profile">Completar perfil de carreira</a>
        </aside>
    }

    @if (!isLoading && !loadFailed)
    {
        <section class="page-section" aria-labelledby="jobs-title">
            <div class="page-section__heading">
                <h2 id="jobs-title">@JobsHeading</h2>
                @if (displayJobs.Count > 0)
                {
                    <a class="btn btn-ghost" href="/jobs">Ver todas as vagas<Icon Name="arrow-right" Size="16" /></a>
                }
            </div>

            @if (displayJobs.Count > 0)
            {
                <ul class="jobs-grid">
                    @foreach (var job in displayJobs.Take(6))
                    {
                        <li><JobCard Job="job" ShowSave="isCandidate" CanSave="isCandidate" SaveReturnUrl="/" /></li>
                    }
                </ul>
            }
            else
            {
                <EmptyState Icon="briefcase"
                            Title="@(isAdvertiser ? "Você ainda não publicou vagas" : "Nenhuma vaga disponível no momento")"
                            Message="@(isAdvertiser ? "Publique sua primeira vaga para começar a receber candidaturas." : "Novas oportunidades são publicadas todos os dias. Volte em breve.")"
                            TestId="dashboard-jobs-empty">
                    @if (isAdvertiser)
                    {
                        <a class="btn btn-primary" href="/jobs/create">Publicar vaga</a>
                    }
                </EmptyState>
            }
        </section>
    }

    @if (isAdvertiser && !isLoading)
    {
        @* Só anuncia o que os planos entregam de fato: mais vagas ativas simultâneas *@
        <aside class="promo-strip" aria-label="Planos">
            <div class="promo-strip__body">
                <p class="promo-strip__title">Precisa de mais vagas abertas?</p>
                <p class="promo-strip__text">Os planos ampliam quantas vagas você mantém ativas ao mesmo tempo.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/plans">Conhecer planos</a>
        </aside>
    }
</div>

@code {
    private DashboardAnalyticsResponse? analytics;
    private List<JobResponse> recentJobs = [];
    private List<JobResponse> recommendedJobs = [];
    private CandidateProgressResponse? progress;
    private IReadOnlyList<CandidateProgressChecklistItem> nextSteps = [];
    private bool hasCareerProfile;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isAuthenticated;
    private bool isAdvertiser;
    private bool isCandidate;
    private bool isAnonymous => !isAuthenticated;
    private bool isAdminOnly;

    private List<JobResponse> displayJobs => isCandidate && recommendedJobs.Count > 0 ? recommendedJobs : recentJobs;

    private string JobsHeading => isCandidate
        ? (recommendedJobs.Count > 0 ? "Recomendadas para você" : "Vagas recentes")
        : (isAnonymous ? "Vagas em destaque" : "Vagas recentes");

    private int InProgressApplications =>
        (progress?.Applications.Sent ?? 0) + (progress?.Applications.Viewed ?? 0);

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = CurrentUserHelper.IsAuthenticated();
        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        isAdvertiser = advertiserId.HasValue;
        isCandidate = CurrentUserHelper.GetCandidateId().HasValue;
        isAdminOnly = isAuthenticated && !isAdvertiser && !isCandidate && CurrentUserHelper.IsAdmin();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        if (isAdvertiser)
        {
            var analyticsResult = await DashboardAnalyticsUseCase.ExecuteAsync(CurrentUserHelper.GetAdvertiserId());
            if (analyticsResult.Status == EResultStatus.Success)
            {
                analytics = analyticsResult.Data;
                recentJobs = analytics?.RecentJobs ?? [];
            }
            else
            {
                Logger.LogFailure(analyticsResult, "Carregar painel do anunciante");
                loadFailed = true;
            }
        }
        else if (isCandidate)
        {
            var candidateId = CurrentUserHelper.GetCandidateId()!.Value;
            var progressResult = await GetCandidateProgressUseCase.ExecuteAsync(candidateId);
            var recommendedResult = await ListRecommendedJobsUseCase.ExecuteAsync(candidateId);
            var jobsResult = await SearchJobsUseCase.ExecuteAsync(new ListJobsRequest { Page = 1, Size = 6 });

            if (progressResult.Status == EResultStatus.Success && progressResult.Data is not null
                && recommendedResult.Status == EResultStatus.Success
                && jobsResult.Status == EResultStatus.Success)
            {
                progress = progressResult.Data;
                nextSteps = CandidateProgressText.NextSteps(progress);
                hasCareerProfile = progress.Checklist.Any(item => item.Key == "careerProfile" && item.Done);
                recommendedJobs = recommendedResult.Data?.Jobs.ToList() ?? [];
                recentJobs = jobsResult.Data?.Jobs.ToList() ?? [];
            }
            else
            {
                Logger.LogFailure(progressResult, "Carregar progresso do candidato");
                Logger.LogFailure(recommendedResult, "Carregar vagas recomendadas");
                Logger.LogFailure(jobsResult, "Carregar vagas recentes");
                loadFailed = true;
            }
        }
        else
        {
            var jobsResult = await SearchJobsUseCase.ExecuteAsync(new ListJobsRequest { Page = 1, Size = 6 });
            if (jobsResult.Status == EResultStatus.Success && jobsResult.Data is not null)
            {
                recentJobs = jobsResult.Data.Jobs.ToList();
            }
            else
            {
                Logger.LogFailure(jobsResult, "Carregar vagas recentes");
                loadFailed = true;
            }
        }

        isLoading = false;
    }

    // Barra de proporção no tom da situação (o número e a porcentagem estão no texto ao lado)
    private static string ToneBar(StatusTone tone) => "progress-bar--" + UiLabels.ToneClass(tone)["badge--".Length..];
}
