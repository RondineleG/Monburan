@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Candidates
@using Monburan.Core.UseCases.Jobs
@using Monburan.Web.Services
@using Monburan.Web.UseCases.Analytics
@inject SearchJobsUseCase SearchJobsUseCase
@inject GetDashboardAnalyticsUseCase DashboardAnalyticsUseCase
@inject GetCandidateProgressUseCase GetCandidateProgressUseCase
@inject ListRecommendedJobsUseCase ListRecommendedJobsUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard - Monburan | Plataforma de Recrutamento</PageTitle>

<HeadContent>
    <meta name="description" content="Dashboard Monburan - Acompanhe suas vagas, candidaturas e estatísticas em tempo real." />
    <meta property="og:title" content="Monburan - Dashboard" />
    <meta property="og:description" content="Plataforma gratuita de recrutamento e seleção" />
    <meta property="og:type" content="website" />
</HeadContent>

<div class="container-fluid mt-4 dashboard-page">
    @if (isAnonymous)
    {
        <section class="landing-hero">
            <span class="page-kicker">MONBURAN · TALENTOS QUE FICAM</span>
            <h1>O trabalho certo muda tudo.</h1>
            <p>Uma forma mais humana de encontrar oportunidades, contratar melhor e construir o próximo capítulo.</p>
            <div class="landing-hero__actions">
                <a class="btn btn-primary btn-lg" href="/Account/Register">Criar conta gratuita</a>
                <a class="btn btn-outline-primary btn-lg" href="/jobs">Explorar vagas</a>
            </div>
            <ul class="landing-hero__proof">
                <li><span aria-hidden="true">✓</span> Perfil em um só lugar</li>
                <li><span aria-hidden="true">⌕</span> Busca sem complicação</li>
                <li><span aria-hidden="true">◈</span> Ambiente seguro e gratuito</li>
            </ul>
        </section>
    }
    else
    {
        <header class="page-heading">
            <div class="page-heading__copy">
                <span class="page-kicker">@(isAdvertiser ? "SEU ESPAÇO MONBURAN" : "SUA JORNADA")</span>
                <h1>@(isAdvertiser ? "Visão geral" : "Continue sua jornada")</h1>
                <p>@(isAdvertiser ? "Acompanhe suas vagas e candidaturas em um só lugar." : "Acompanhe suas candidaturas e descubra a próxima oportunidade.")</p>
            </div>
            <a class="btn btn-primary" href="@(isAdvertiser ? "/jobs/create" : "/jobs")" data-testid="dashboard-primary">
                @(isAdvertiser ? "Publicar vaga" : "Explorar vagas")
            </a>
        </header>
    }

    @if (isLoading)
    {
        <div class="skeleton-stack" role="status" aria-live="polite" data-testid="loading-state">
            <span class="visually-hidden">Carregando seus indicadores...</span>
            <div class="skeleton-grid">
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
            </div>
            <SkeletonBlock Height="12rem" Radius="var(--r-md)" />
            <SkeletonBlock Height="12rem" Radius="var(--r-md)" />
        </div>
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar o painel"
                    Message="Tivemos um problema ao buscar seus indicadores. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (isAdvertiser)
    {
        <section class="dashboard-section" aria-label="Indicadores de recrutamento">
            <div class="row g-3 dashboard-metrics">
                <div class="col-md-3">
                    <article class="card dashboard-metric">
                        <div class="card-body">
                            <span class="dashboard-metric__icon" aria-hidden="true">▣</span>
                            <span class="dashboard-metric__label">Total de vagas</span>
                            <strong class="dashboard-metric__value">@analytics?.TotalJobs</strong>
                        </div>
                    </article>
                </div>
                <div class="col-md-3">
                    <article class="card dashboard-metric">
                        <div class="card-body">
                            <span class="dashboard-metric__icon" aria-hidden="true">✓</span>
                            <span class="dashboard-metric__label">Vagas ativas</span>
                            <strong class="dashboard-metric__value">@analytics?.ActiveJobs</strong>
                        </div>
                    </article>
                </div>
                <div class="col-md-3">
                    <article class="card dashboard-metric">
                        <div class="card-body">
                            <span class="dashboard-metric__icon" aria-hidden="true">◉</span>
                            <span class="dashboard-metric__label">Candidatos</span>
                            <strong class="dashboard-metric__value">@analytics?.TotalCandidates</strong>
                        </div>
                    </article>
                </div>
                <div class="col-md-3">
                    <article class="card dashboard-metric">
                        <div class="card-body">
                            <span class="dashboard-metric__icon" aria-hidden="true">↗</span>
                            <span class="dashboard-metric__label">Candidaturas</span>
                            <strong class="dashboard-metric__value">@analytics?.TotalApplications</strong>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Gráfico de Vagas por Status -->
        @if (analytics?.JobsByStatus != null && analytics.JobsByStatus.Any())
        {
            <div class="row mb-4">
                <div class="col">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="card-title">Vagas por situação</h2>
                            <div class="mt-3">
                                @foreach (var status in analytics.JobsByStatus)
                                {
                                    var percentage = analytics.TotalJobs > 0 ? (status.Value * 100 / analytics.TotalJobs) : 0;
                                    var bgColor = status.Key switch
                                    {
                                        "Active" => "bg-success",
                                        "Expired" => "bg-danger",
                                        "Paused" => "bg-warning",
                                        "Hidden" => "bg-secondary",
                                        "Rejected" => "bg-dark",
                                        _ => "bg-primary"
                                    };

                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between">
                                            <span>@GetStatusLabel(status.Key)</span>
                                            <span>@status.Value (@percentage%)</span>
                                        </div>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @bgColor" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Gráfico de Candidaturas por Status -->
        @if (analytics?.ApplicationsByStatus != null && analytics.ApplicationsByStatus.Any())
        {
            <div class="row mb-4">
                <div class="col">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="card-title">Candidaturas por situação</h2>
                            <div class="mt-3">
                                @foreach (var status in analytics.ApplicationsByStatus)
                                {
                                    var percentage = analytics.TotalApplications > 0 ? (status.Value * 100 / analytics.TotalApplications) : 0;
                                    var bgColor = status.Key switch
                                    {
                                        "Sent" => "bg-primary",
                                        "Viewed" => "bg-info",
                                        "Selected" => "bg-success",
                                        "Rejected" => "bg-danger",
                                        _ => "bg-secondary"
                                    };

                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between">
                                            <span>@GetStatusLabel(status.Key)</span>
                                            <span>@status.Value (@percentage%)</span>
                                        </div>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @bgColor" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @if (isCandidate && progress is not null)
    {
        <section class="page-section dashboard-progress" aria-labelledby="progress-title">
            <div class="page-section__heading">
                <div>
                    <span class="page-kicker">SEU PROGRESSO</span>
                    <h2 id="progress-title">Continue de onde parou</h2>
                </div>
                <p class="dashboard-progress__label" data-testid="candidate-progress-label">@CandidateProgressText.Completeness(progress.CompletenessPercent)</p>
            </div>

            <div class="progress dashboard-progress__bar" role="progressbar"
                 aria-valuenow="@progress.CompletenessPercent" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Completude do perfil">
                <div class="progress-bar" style="width: @(progress.CompletenessPercent)%"></div>
            </div>

            <div class="row g-3">
                <div class="col-lg-6">
                    <article class="card h-100">
                        <div class="card-body">
                            <h3 class="h5">Próximos passos</h3>
                            @if (nextSteps.Count > 0)
                            {
                                <ul class="next-steps" data-testid="candidate-next-steps">
                                    @foreach (var step in nextSteps)
                                    {
                                        <li><a href="@step.ActionUrl">@step.Label <span aria-hidden="true">→</span></a></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Tudo certo por aqui: seu perfil está completo.</p>
                            }
                        </div>
                    </article>
                </div>
                <div class="col-lg-6">
                    <nav class="dashboard-summary" aria-label="Resumo das suas candidaturas">
                        <a class="dashboard-summary__cell" href="/my-applications?aba=candidaturas">
                            <strong>@progress.Applications.Total</strong>
                            <span>Candidaturas</span>
                            <small>@InProgressApplications em andamento</small>
                        </a>
                        <a class="dashboard-summary__cell" href="/my-applications?aba=candidaturas">
                            <strong>@progress.Applications.Selected</strong>
                            <span>Selecionadas</span>
                        </a>
                        <a class="dashboard-summary__cell" href="/my-applications?aba=salvas">
                            <strong>@progress.SavedJobs</strong>
                            <span>Vagas salvas</span>
                        </a>
                        <a class="dashboard-summary__cell" href="/my-applications?aba=alertas">
                            <strong>@progress.ActiveAlerts</strong>
                            <span>Alertas ativos</span>
                        </a>
                    </nav>
                </div>
            </div>
        </section>
    }

    <nav class="page-section shortcut-nav" aria-label="Acessos rápidos">
        <span class="page-kicker">ACESSOS RÁPIDOS</span>
        @if (isAdvertiser)
        {
            <a href="/my-jobs">Minhas vagas</a>
            <a href="/received-applications">Candidaturas recebidas</a>
            <a href="/profile/advertiser">Perfil da empresa</a>
        }
        else if (isCandidate)
        {
            <a href="/my-applications">Candidaturas e salvas</a>
            <a href="/resumes">Meus currículos</a>
            <a href="/profile/candidate">Meu perfil</a>
        }
        else
        {
            <a href="/Account/Register">Criar conta</a>
            <a href="/Account/Login">Entrar</a>
            <a href="/jobs">Explorar vagas</a>
        }
    </nav>

    <!-- Vagas recomendadas para o candidato; sem recomendações, as recentes como fallback -->
    <div class="row">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>@JobsHeading</h2>
                <a class="btn btn-outline-primary" href="/jobs">
                    Ver todas as vagas <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>

    @if (isCandidate && !hasCareerProfile && !isLoading && !loadFailed)
    {
        <aside class="promo-strip" aria-label="Perfil de carreira">
            <span class="promo-strip__tag">Recomendações</span>
            <div class="promo-strip__body">
                <p class="promo-strip__title">Conte o que você procura</p>
                <p class="promo-strip__text">Preencha o perfil de carreira para receber vagas que combinam com você.</p>
            </div>
            <a class="btn btn-outline-primary" href="/career-profile">Completar perfil de carreira</a>
        </aside>
    }

    @if (displayJobs.Count > 0)
    {
        <div class="row g-3">
            @foreach (var job in displayJobs.Take(6))
            {
                <div class="col-md-6 col-lg-4">
                    <JobCard Job="job" ShowSave="isCandidate" CanSave="isCandidate" SaveReturnUrl="/" />
                </div>
            }
        </div>
    }
    else if (!isLoading && !loadFailed)
    {
        <EmptyState Icon="▣"
                    Title="@(isAdvertiser ? "Você ainda não publicou vagas" : "Nenhuma vaga disponível no momento")"
                    Message="@(isAdvertiser ? "Publique sua primeira vaga para começar a receber candidaturas." : "Novas oportunidades são publicadas todos os dias. Volte em breve.")"
                    TestId="dashboard-jobs-empty">
            @if (isAdvertiser)
            {
                <a class="btn btn-primary" href="/jobs/create">Publicar vaga</a>
            }
        </EmptyState>
    }

    @if (isAdvertiser && !isLoading)
    {
        @* Só anuncia o que os planos entregam de fato: mais vagas ativas simultâneas *@
        <aside class="promo-strip" aria-label="Planos">
            <span class="promo-strip__tag">Planos</span>
            <div class="promo-strip__body">
                <p class="promo-strip__title">Precisa de mais vagas abertas?</p>
                <p class="promo-strip__text">Os planos ampliam quantas vagas você mantém ativas ao mesmo tempo.</p>
            </div>
            <a class="btn btn-outline-primary" href="/plans">Conhecer planos <span aria-hidden="true">↗</span></a>
        </aside>
    }
</div>

@code {
    private DashboardAnalyticsResponse? analytics;
    private List<JobResponse> recentJobs = [];
    private List<JobResponse> recommendedJobs = [];
    private CandidateProgressResponse? progress;
    private IReadOnlyList<CandidateProgressChecklistItem> nextSteps = [];
    private bool hasCareerProfile;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isAuthenticated;
    private bool isAdvertiser;
    private bool isCandidate;
    private bool isAnonymous => !isAuthenticated;

    private List<JobResponse> displayJobs => isCandidate && recommendedJobs.Count > 0 ? recommendedJobs : recentJobs;

    private string JobsHeading => isCandidate
        ? (recommendedJobs.Count > 0 ? "Recomendadas para você" : "Vagas recentes")
        : (isAnonymous ? "Vagas em destaque" : "Vagas recentes");

    private int InProgressApplications =>
        (progress?.Applications.Sent ?? 0) + (progress?.Applications.Viewed ?? 0);

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = CurrentUserHelper.IsAuthenticated();
        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        isAdvertiser = advertiserId.HasValue;
        isCandidate = CurrentUserHelper.GetCandidateId().HasValue;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        if (isAdvertiser)
        {
            var analyticsResult = await DashboardAnalyticsUseCase.ExecuteAsync(CurrentUserHelper.GetAdvertiserId());
            if (analyticsResult.Status == EResultStatus.Success)
            {
                analytics = analyticsResult.Data;
                recentJobs = analytics?.RecentJobs ?? [];
            }
            else
            {
                Logger.LogFailure(analyticsResult, "Carregar painel do anunciante");
                loadFailed = true;
            }
        }
        else if (isCandidate)
        {
            var candidateId = CurrentUserHelper.GetCandidateId()!.Value;
            var progressResult = await GetCandidateProgressUseCase.ExecuteAsync(candidateId);
            var recommendedResult = await ListRecommendedJobsUseCase.ExecuteAsync(candidateId);
            var jobsResult = await SearchJobsUseCase.ExecuteAsync(new ListJobsRequest { Page = 1, Size = 6 });

            if (progressResult.Status == EResultStatus.Success && progressResult.Data is not null
                && recommendedResult.Status == EResultStatus.Success
                && jobsResult.Status == EResultStatus.Success)
            {
                progress = progressResult.Data;
                nextSteps = CandidateProgressText.NextSteps(progress);
                hasCareerProfile = progress.Checklist.Any(item => item.Key == "careerProfile" && item.Done);
                recommendedJobs = recommendedResult.Data?.Jobs.ToList() ?? [];
                recentJobs = jobsResult.Data?.Jobs.ToList() ?? [];
            }
            else
            {
                Logger.LogFailure(progressResult, "Carregar progresso do candidato");
                Logger.LogFailure(recommendedResult, "Carregar vagas recomendadas");
                Logger.LogFailure(jobsResult, "Carregar vagas recentes");
                loadFailed = true;
            }
        }
        else
        {
            var jobsResult = await SearchJobsUseCase.ExecuteAsync(new ListJobsRequest { Page = 1, Size = 6 });
            if (jobsResult.Status == EResultStatus.Success && jobsResult.Data is not null)
            {
                recentJobs = jobsResult.Data.Jobs.ToList();
            }
            else
            {
                Logger.LogFailure(jobsResult, "Carregar vagas recentes");
                loadFailed = true;
            }
        }

        isLoading = false;
    }

    private void NavigateToJobs()
    {
        Navigation.NavigateTo("/jobs");
    }

    private void NavigateToCreateJob()
    {
        Navigation.NavigateTo("/jobs/create");
    }

    private void NavigateToMyJobs()
    {
        Navigation.NavigateTo("/my-jobs");
    }

    private void NavigateToApplications()
    {
        Navigation.NavigateTo("/received-applications");
    }

    private void NavigateToMyApplications()
    {
        Navigation.NavigateTo("/my-applications");
    }

    private void NavigateToResumes()
    {
        Navigation.NavigateTo("/resumes");
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "Active" => "Ativas",
        "Expired" => "Expiradas",
        "Paused" => "Pausadas",
        "Hidden" => "Ocultas",
        "Rejected" => "Rejeitadas",
        "Sent" => "Enviadas",
        "Viewed" => "Visualizadas",
        "Selected" => "Selecionadas",
        _ => status
    };
}
