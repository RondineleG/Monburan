@page "/my-jobs"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdvertiserOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Jobs
@using Monburan.Web.Services
@inject SearchJobsUseCase SearchJobsUseCase
@inject DeleteJobUseCase DeleteJobUseCase
@inject ChangeJobStatusUseCase ChangeJobStatusUseCase
@inject GetJobByIdUseCase GetJobByIdUseCase
@inject CurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject IJSRuntime JS
@inject ILogger<MyJobs> Logger

<PageTitle>Minhas vagas - Monburan</PageTitle>

<div class="container my-jobs-page">
    @* "Publicar vaga" fica na barra superior, em todas as telas da empresa *@
    <PageHeader Title="Minhas vagas" Description="Gerencie publicações, acompanhe o interesse e avance com os candidatos." />

    @if (isLoading)
    {
        <div class="skeleton-stack" role="status" aria-live="polite" data-testid="loading-state">
            <span class="visually-hidden">Carregando suas vagas…</span>
            <div class="skeleton-grid">
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
                <SkeletonBlock Height="6.5rem" Radius="var(--r-md)" />
            </div>
            <SkeletonBlock Height="2.8rem" />
            <SkeletonBlock Height="3.2rem" />
            <SkeletonBlock Height="3.2rem" />
            <SkeletonBlock Height="3.2rem" />
        </div>
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar suas vagas"
                    Message="Tivemos um problema ao buscar suas publicações. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else
    {
        <nav class="journey-tabs" aria-label="Filtrar vagas por situação">
            @foreach (var tab in Tabs)
            {
                <a class="journey-tab@(Situation == tab.Value ? " journey-tab--active" : string.Empty)"
                   href="@TabUrl(tab.Value)"
                   aria-current="@(Situation == tab.Value ? "page" : null)"
                   data-testid="my-jobs-tab-@tab.Value">
                    @tab.Label <span class="journey-tab__count">@CountFor(tab.Value)</span>
                </a>
            }
        </nav>

        <div class="list-toolbar">
        <form class="my-jobs-search" method="get" action="/my-jobs" data-clean-query role="search">
            <input type="hidden" name="situacao" value="@Situation" />
            <label class="my-jobs-search__field" for="my-jobs-search">
                <span class="form-label">Buscar vagas</span>
                <input type="search" class="form-control" name="busca" id="my-jobs-search" value="@SearchQuery" maxlength="80" placeholder="Buscar nas suas vagas" data-testid="my-jobs-search" />
            </label>
            <button type="submit" class="btn btn-outline-secondary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                <a class="chip-clear" href="@ClearSearchUrl" data-enhance-nav="false" data-testid="my-jobs-clear-search">
                    <Icon Name="rotate-ccw" Size="14" />Limpar busca
                </a>
            }
        </form>
        <span class="received-filters__count" data-testid="my-jobs-count">@visibleJobs.Count @(visibleJobs.Count == 1 ? "vaga" : "vagas")</span>
        </div>
        @if (IsTruncated)
        {
            <p class="alert alert-info" role="status" data-testid="my-jobs-truncated">
                Mostrando as @jobs.Count vagas mais recentes de @totalJobs. As contagens e a busca consideram só essas.
            </p>
        }

        @if (visibleJobs.Count > 0)
        {
            <div class="jobs-management-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-cards">
                            <caption class="visually-hidden">Suas vagas: situação, visualizações, candidaturas e validade</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Vaga</th>
                                    <th scope="col">Local</th>
                                    <th scope="col">Situação</th>
                                    <th scope="col">Visualizações</th>
                                    <th scope="col">Candidaturas</th>
                                    <th scope="col">Validade</th>
                                    <th scope="col">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in visibleJobs)
                                {
                                    <tr data-testid="my-job-row">
                                        <td data-label="Vaga">
                                            <a class="my-job-title" href="/jobs/@job.Id"><strong>@job.Title</strong></a>
                                            @if (!string.IsNullOrEmpty(job.Category))
                                            {
                                                <br />
                                                <small class="text-muted">@job.Category</small>
                                            }
                                        </td>
                                        <td data-label="Local">@(string.IsNullOrWhiteSpace(job.City) ? "—" : $"{job.City}{(string.IsNullOrWhiteSpace(job.State) ? string.Empty : $" / {job.State}")}")</td>
                                        <td data-label="Situação">
                                            <StatusBadge Kind="StatusKind.Job" Value="@job.Status" />
                                            @if (!string.IsNullOrWhiteSpace(job.ModerationReason))
                                            {
                                                <div class="text-muted small" data-testid="my-job-moderation">Motivo da moderação: @job.ModerationReason</div>
                                            }
                                        </td>
                                        <td data-label="Visualizações">@job.Views</td>
                                        <td data-label="Candidaturas">
                                            <a href="/jobs/@job.Id/applications" data-testid="my-job-applications-link">@job.Applications @(job.Applications == 1 ? "candidatura" : "candidaturas")</a>
                                        </td>
                                        <td data-label="Validade">
                                            @if (job.ExpirationDate.Date < DateTime.UtcNow.Date)
                                            {
                                                <span class="text-danger">Expirada</span>
                                            }
                                            else
                                            {
                                                @UiLabels.FormatDate(job.ExpirationDate)
                                            }
                                        </td>
                                        <td data-label="Ações">
                                            @* Divulgação simples (botão + lista), não role="menu": Tab percorre as ações e Esc fecha *@
                                            <div class="job-actions" @onkeydown="OnMenuKeyDown">
                                                <a class="btn btn-outline-secondary btn-sm" href="/jobs/edit/@job.Id" data-testid="my-job-edit"
                                                   aria-label="Editar a vaga @job.Title">Editar</a>
                                                <button type="button"
                                                        id="job-actions-@job.Id"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        aria-expanded="@(openMenuId == job.Id ? "true" : "false")"
                                                        aria-controls="job-actions-list-@job.Id"
                                                        aria-label="Mais ações da vaga @job.Title"
                                                        data-testid="my-job-actions"
                                                        @onclick="() => ToggleMenu(job.Id)">
                                                    Ações <Icon Name="chevron-down" Size="16" Class="@(openMenuId == job.Id ? "icon--flip" : null)" />
                                                </button>
                                                @if (openMenuId == job.Id)
                                                {
                                                    <ul class="job-actions__menu" id="job-actions-list-@job.Id">
                                                        <li><a class="job-actions__item" href="@($"/jobs/{job.Id}")">Ver página da vaga</a></li>
                                                        <li><a class="job-actions__item" href="@($"/jobs/{job.Id}/applications")" data-testid="my-job-applications">Ver candidaturas</a></li>
                                                        @if (job.Status == "Active")
                                                        {
                                                            <li><button type="button" class="job-actions__item" @onclick="() => ChangeStatusAsync(job, EJobStatus.Paused)" disabled="@(changingId == job.Id)" data-testid="my-job-pause">Pausar</button></li>
                                                        }
                                                        else if (job.Status is "Paused" or "Expired")
                                                        {
                                                            @if (job.ExpirationDate.Date >= DateTime.UtcNow.Date)
                                                            {
                                                                <li><button type="button" class="job-actions__item" @onclick="() => ChangeStatusAsync(job, EJobStatus.Active)" disabled="@(changingId == job.Id)" data-testid="my-job-activate">Reativar</button></li>
                                                            }
                                                            else
                                                            {
                                                                <li><a class="job-actions__item" href="@($"/jobs/edit/{job.Id}")">Renovar validade</a></li>
                                                            }
                                                        }
                                                        <li>
                                                            <button type="button" class="job-actions__item job-actions__item--danger"
                                                                    @onclick="() => DeleteAsync(job)" disabled="@(deletingId == job.Id)" aria-busy="@(deletingId == job.Id ? "true" : null)"
                                                                    aria-label="Excluir a vaga @job.Title" data-testid="my-job-delete">
                                                                @(deletingId == job.Id ? "Excluindo…" : "Excluir")
                                                            </button>
                                                        </li>
                                                    </ul>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (jobs.Count > 0)
        {
            <EmptyState Icon="search"
                        Title="@(HasSearch ? "Nenhum resultado para estes filtros" : "Nenhuma vaga nesta situação")"
                        Message="@(HasSearch ? "Tente outro termo ou limpe a busca para ver suas publicações." : "Tente outra aba para ver suas outras publicações.")"
                        TestId="my-jobs-tab-empty">
                @if (HasSearch)
                {
                    <a class="btn btn-outline-secondary" href="@ClearSearchUrl">Limpar filtros</a>
                }
                else
                {
                    <a class="btn btn-primary" href="/jobs/create">Publicar vaga</a>
                }
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="briefcase"
                        Title="Nenhuma vaga publicada ainda"
                        Message="Publique sua primeira vaga para começar a receber candidaturas."
                        TestId="my-jobs-empty">
                <a class="btn btn-primary" href="/jobs/create">Publicar vaga</a>
            </EmptyState>
        }
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private static readonly (string Value, string Label)[] Tabs =
    [
        ("ativas", "Ativas"),
        ("pausadas", "Pausadas"),
        ("expiradas", "Expiradas"),
        ("ocultas", "Ocultas e reprovadas")
    ];

    [SupplyParameterFromQuery(Name = "situacao")]
    public string? SituationQuery { get; set; }

    [SupplyParameterFromQuery(Name = "busca")]
    public string? SearchQuery { get; set; }

    private List<JobResponse> jobs = [];
    private List<JobResponse> visibleJobs = [];
    private bool isLoading = true;
    private bool loadFailed;
    private Guid? deletingId;
    private Guid? changingId;
    private Guid? openMenuId;
    private ConfirmDialog confirmDialog = default!;

    private string Situation => SituationQuery switch
    {
        "pausadas" or "expiradas" or "ocultas" => SituationQuery,
        _ => "ativas"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        // O GET do formulário de busca troca só a query string: refiltra sem recarregar
        ApplyFilter();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        if (!advertiserId.HasValue)
        {
            // Sem anunciante o filtro ficava nulo e a busca trazia as vagas de todo mundo
            jobs = [];
            isLoading = false;
            return;
        }

        // Abas e busca filtram em memória: carrega todas as páginas (antes só as 100 primeiras entravam
        // e as contagens ficavam erradas sem aviso). Teto de segurança com aviso explícito.
        var loaded = new List<JobResponse>();
        for (var page = 1; page <= MaxPages; page++)
        {
            var result = await SearchJobsUseCase.ExecuteAsync(new ListJobsRequest
            {
                Page = page,
                Size = PageSize,
                AdvertiserId = advertiserId
            });

            if (result.Status != EResultStatus.Success)
            {
                Logger.LogFailure(result, "Listar vagas do anunciante");
                loadFailed = true;
                isLoading = false;
                return;
            }

            loaded.AddRange(result.Data?.Jobs ?? []);
            totalJobs = result.Data?.TotalCount ?? loaded.Count;
            if (result.Data is null || !result.Data.HasNextPage)
                break;
        }

        jobs = loaded;
        ApplyFilter();
        isLoading = false;
    }

    private const int PageSize = 100;
    private const int MaxPages = 20;
    private int totalJobs;
    private bool IsTruncated => totalJobs > jobs.Count;

    private bool HasSearch => !string.IsNullOrWhiteSpace(SearchQuery);

    private void ApplyFilter()
    {
        IEnumerable<JobResponse> query = jobs.Where(job => MatchesTab(job.Status, Situation));

        // Busca só em memória, sobre as vagas já carregadas — sem novo endpoint
        var term = SearchQuery?.Trim();
        if (!string.IsNullOrEmpty(term))
            query = query.Where(job =>
                job.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (job.Category?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));

        visibleJobs = query.ToList();
    }

    private static bool MatchesTab(string status, string tab) => tab switch
    {
        "ativas" => status == "Active",
        "pausadas" => status == "Paused",
        "expiradas" => status == "Expired",
        "ocultas" => status is "Hidden" or "Rejected",
        _ => true
    };

    private int CountFor(string tab) => jobs.Count(job => MatchesTab(job.Status, tab));

    private string TabUrl(string tab)
    {
        var baseUrl = tab == "ativas" ? "/my-jobs" : $"/my-jobs?situacao={tab}";
        // A busca sobrevive à troca de aba; só o "limpar busca" a remove de propósito
        return HasSearch
            ? baseUrl + (baseUrl.Contains('?') ? "&" : "?") + $"busca={Uri.EscapeDataString(SearchQuery!.Trim())}"
            : baseUrl;
    }

    private string ClearSearchUrl =>
        Situation == "ativas" ? "/my-jobs" : $"/my-jobs?situacao={Situation}";

    private void ToggleMenu(Guid jobId) => openMenuId = openMenuId == jobId ? null : jobId;

    private async Task OnMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || openMenuId is null)
            return;

        var triggerId = $"job-actions-{openMenuId}";
        openMenuId = null;
        try
        {
            await JS.InvokeVoidAsync("monburanFocusById", triggerId);
        }
        catch (JSException)
        {
            // Sem JS o menu apenas fecha
        }
    }

    private async Task ChangeStatusAsync(JobResponse job, EJobStatus newStatus)
    {
        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        if (!advertiserId.HasValue || changingId.HasValue)
            return;

        changingId = job.Id;
        var result = await ChangeJobStatusUseCase.ExecuteAsync(new ChangeJobStatusRequest(job.Id, advertiserId.Value, newStatus));
        changingId = null;
        openMenuId = null;
        try
        {
            // A lista fecha e o botão "Ações" recebe o foco: quem usa teclado não perde o lugar na tabela
            await JS.InvokeVoidAsync("monburanFocusById", $"job-actions-{job.Id}");
        }
        catch (JSException)
        {
        }

        if (result.Status == EResultStatus.Success && result.Data is not null)
        {
            job.Status = result.Data.Status;
            ApplyFilter();
            Toast.ShowSuccess(newStatus == EJobStatus.Paused
                ? $"\"{job.Title}\" foi pausada e não recebe novas candidaturas."
                : $"\"{job.Title}\" está ativa e visível para os candidatos.");
        }
        else
        {
            Logger.LogFailure(result, "Alterar situação da vaga");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível alterar a situação da vaga. Tente novamente."));
        }
    }

    private async Task DeleteAsync(JobResponse job)
    {
        // A lista de ações fecha; o foco vai para o botão "Ações" para o diálogo devolvê-lo ali ao fechar
        openMenuId = null;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("monburanFocusById", $"job-actions-{job.Id}");
        }
        catch (JSException)
        {
            // Sem JS o diálogo devolve o foco ao título da página
        }

        var message = job.Applications > 0
            ? $"A vaga \"{job.Title}\" deixará de aparecer nas buscas. As {job.Applications} candidaturas recebidas continuam no seu histórico."
            : $"A vaga \"{job.Title}\" deixará de aparecer nas buscas.";

        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir vaga?",
            Message = message,
            ConfirmText = "Excluir vaga",
            Destructive = true
        });
        if (!confirmed)
            return;

        // Defesa em profundidade: confere a propriedade antes de excluir
        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        var current = await GetJobByIdUseCase.ExecuteAsync(job.Id);
        if (current.Status != EResultStatus.Success || current.Data?.AdvertiserId != advertiserId)
        {
            Toast.ShowError("Esta vaga não pertence à sua empresa ou já foi removida.");
            await LoadAsync();
            return;
        }

        deletingId = job.Id;
        var result = await DeleteJobUseCase.ExecuteAsync(job.Id);
        deletingId = null;

        if (result.Status == EResultStatus.Success)
        {
            jobs.Remove(job);
            ApplyFilter();
            Toast.ShowSuccess($"A vaga \"{job.Title}\" foi excluída.");
        }
        else
        {
            Logger.LogFailure(result, "Excluir vaga");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível excluir a vaga. Tente novamente."));
        }
    }
}
