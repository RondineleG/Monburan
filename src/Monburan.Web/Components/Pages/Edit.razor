@page "/enderecos/{Id:guid}/editar"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Data.Common
@inject AddressService AddressService
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<Edit> Logger
@using Monburan.Core.Entities;
@using Monburan.Web.Services;

<PageTitle>Editar endereço - Monburan</PageTitle>

<div class="container page-form-shell address-form-page">
    @if (isLoading)
    {
        <LoadingState Message="Carregando endereço…" />
    }
    else if (address == null)
    {
        <EmptyState Icon="search" Title="Endereço não encontrado" HeadingLevel="1" Message="O endereço solicitado não existe ou já foi removido.">
            <a class="btn btn-primary" href="/enderecos">Voltar para a lista</a>
        </EmptyState>
    }
    else
    {
        <PageHeader Title="Editar endereço" Description="Atualize os dados do endereço vinculado ao perfil."
                    BackHref="/enderecos" BackText="Voltar a endereços" />
        <div class="card page-form-card">
            <div class="card-body">
                <EditForm Model="form" OnValidSubmit="HandleValidSubmit" Context="editContext">
                    <UnsavedChangesGuard HasChanges="() => editContext.IsModified() && !isSubmitting" />
                    <DataAnnotationsValidator />
                    <p class="form-required-note">Campos com * são obrigatórios.</p>
                    <AddressFormFields Model="form" />

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting" aria-busy="@(isSubmitting ? "true" : null)" data-testid="address-save">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Salvando…</span>
                            }
                            else
                            {
                                <span>Salvar alterações</span>
                            }
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isSubmitting">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Address? address;
    private AddressForm form = new();
    private bool isLoading = true;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        // Só edita endereço vinculado ao próprio perfil
        var ownedIds = await AddressService.GetOwnedIdsAsync(
            CurrentUserHelper.GetCandidateId(),
            CurrentUserHelper.GetAdvertiserId());

        if (Monburan.Core.ValueObjects.Id.TryCreate(this.Id, out var key) && key is not null && ownedIds.Contains(key))
        {
            address = await AddressService.GetByIdAsync(Id);
            if (address is not null)
                form = AddressForm.From(address);
        }

        isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        if (address is null || isSubmitting)
            return;

        isSubmitting = true;
        try
        {
            form.ApplyTo(address);
            await AddressService.UpdateAsync(address);
            Toast.ShowSuccess("Endereço atualizado.");
            Navigation.NavigateTo("/enderecos");
        }
        catch (Exception ex) when (ex is DbException or DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(ex, "Falha ao atualizar endereço {AddressId}", Id);
            Toast.ShowError("Não foi possível salvar o endereço. Confira os dados e tente novamente.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/enderecos");
}
