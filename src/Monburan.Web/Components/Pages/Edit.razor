@page "/address/edit/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Data.Common
@inject AddressService AddressService
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<Edit> Logger
@using Monburan.Core.Entities;
@using Monburan.Web.Services;

<PageTitle>Editar endereço - Monburan</PageTitle>

<div class="container mt-4 page-form-shell address-form-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">CONFIGURAÇÕES</span>
            <h1>Editar endereço</h1>
            <p>Atualize os dados do endereço vinculado ao perfil.</p>
        </div>
    </header>

    @if (isLoading)
    {
        <LoadingState Message="Carregando endereço..." />
    }
    else if (address == null)
    {
        <section class="empty-state">
            <span class="empty-state__icon" aria-hidden="true">!</span>
            <h2>Endereço não encontrado</h2>
            <p>O endereço solicitado não existe ou já foi removido.</p>
            <a class="btn btn-primary" href="/address/list">Voltar para a lista</a>
        </section>
    }
    else
    {
        <div class="card page-form-card">
            <div class="card-body">
                <EditForm Model="form" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <AddressFormFields Model="form" />

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting" data-testid="address-save">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            }
                            Salvar alterações
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isSubmitting">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Address? address;
    private AddressForm form = new();
    private bool isLoading = true;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        // Só edita endereço vinculado ao próprio perfil
        var ownedIds = await AddressService.GetOwnedIdsAsync(
            CurrentUserHelper.GetCandidateId(),
            CurrentUserHelper.GetAdvertiserId());

        if (Monburan.Core.ValueObjects.Id.TryCreate(this.Id, out var key) && key is not null && ownedIds.Contains(key))
        {
            address = await AddressService.GetByIdAsync(Id);
            if (address is not null)
                form = AddressForm.From(address);
        }

        isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        if (address is null || isSubmitting)
            return;

        isSubmitting = true;
        try
        {
            form.ApplyTo(address);
            await AddressService.UpdateAsync(address);
            Toast.ShowSuccess("Endereço atualizado.");
            Navigation.NavigateTo("/address/list");
        }
        catch (Exception ex) when (ex is DbException or DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(ex, "Falha ao atualizar endereço {AddressId}", Id);
            Toast.ShowError("Não foi possível salvar o endereço. Confira os dados e tente novamente.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/address/list");
}
