@page "/admin/candidatos"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Candidates
@inject ListCandidatesUseCase ListCandidatesUseCase
@inject DeleteCandidateUseCase DeleteCandidateUseCase
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<CandidatesList> Logger

<PageTitle>Candidatos - Administração - Monburan</PageTitle>

@* Mesmo desenho de AdvertisersList: mantenha as duas telas iguais.
   Os filtros e a página ficam no endereço (?busca=&situacao=&pagina=): Voltar e recarregar reproduzem a lista. *@
<div class="container admin-list-page">
    <PageHeader Title="Candidatos" Description="Consulte perfis, situação da conta e atividade na plataforma." />

    <div class="admin-filters" role="search" aria-label="Filtrar candidatos">
        <div>
            <label class="form-label" for="candidate-search">Buscar</label>
            <input id="candidate-search" type="text" class="form-control" @bind="searchTerm" @bind:event="oninput" @onkeydown="OnSearchKeyDown"
                   placeholder="Nome, e-mail ou telefone" enterkeyhint="search" autocomplete="off" data-testid="candidates-search" />
        </div>
        <div>
            <label class="form-label" for="status-filter">Situação</label>
            @* Valores de EAccountStatus — opções inexistentes eram ignoradas pelo filtro *@
            <select id="status-filter" class="form-select" @bind="statusFilter" @bind:after="ApplyFiltersAsync" data-testid="candidates-status">
                <option value="">Todas</option>
                <option value="Active">Ativa</option>
                <option value="Incomplete">Cadastro incompleto</option>
                <option value="Blocked">Bloqueada</option>
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="ApplyFiltersAsync" disabled="@isLoading" data-testid="candidates-apply">Buscar</button>
            @if (IsFiltered)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" data-testid="candidates-clear">Limpar filtros</button>
            }
        </div>
    </div>

    @if (isLoading && listResponse is null)
    {
        <LoadingState Message="Carregando candidatos…" />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar os candidatos"
                    Message="Tivemos um problema ao buscar os perfis. Tente novamente em instantes."
                    OnRetry="() => LoadAsync(currentPage)" />
    }
    else if (listResponse is null || !listResponse.Items.Any())
    {
        if (IsFiltered)
        {
            <EmptyState Icon="search" Title="Nenhum resultado para estes filtros" Message="Tente outra busca ou mude a situação." TestId="candidates-empty">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">Limpar filtros</button>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="users" Title="Nenhum candidato cadastrado" Message="Os candidatos aparecem aqui assim que criam a conta." TestId="candidates-empty" />
        }
    }
    else
    {
        <div class="card" aria-busy="@(isLoading ? "true" : null)">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-cards mb-0" data-testid="candidates-table">
                        <caption class="visually-hidden">Candidatos cadastrados</caption>
                        <thead>
                            <tr>
                                <th scope="col">Nome</th>
                                <th scope="col">E-mail</th>
                                <th scope="col">Situação</th>
                                <th scope="col">Cidade/UF</th>
                                <th scope="col" class="text-center">Currículos</th>
                                <th scope="col" class="text-center">Candidaturas</th>
                                <th scope="col">Cadastro</th>
                                <th scope="col">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in listResponse.Items)
                            {
                                <tr data-testid="candidate-row">
                                    <td data-label="Nome"><strong>@candidate.Name</strong></td>
                                    <td data-label="E-mail">@candidate.Email</td>
                                    <td data-label="Situação"><StatusBadge Text="@StatusLabel(candidate.Status)" Tone="@StatusToneFor(candidate.Status)" /></td>
                                    <td data-label="Cidade/UF">@Place(candidate.City, candidate.State)</td>
                                    <td data-label="Currículos" class="text-center">@candidate.ResumesCount</td>
                                    <td data-label="Candidaturas" class="text-center">@candidate.ApplicationsCount</td>
                                    <td data-label="Cadastro">@UiLabels.FormatMomentDate(candidate.CreatedAt)</td>
                                    <td data-label="Ações">
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(candidate)"
                                                disabled="@(deletingId == candidate.Id)" aria-busy="@(deletingId == candidate.Id ? "true" : null)"
                                                aria-label="Excluir o candidato @candidate.Name">
                                            @(deletingId == candidate.Id ? "Excluindo…" : "Excluir")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <Pager Page="listResponse.Page" TotalPages="listResponse.TotalPages" OnPageChanged="GoToPageAsync"
               Total="listResponse.TotalCount" PageSize="PageSize" ItemName="@(listResponse.TotalCount == 1 ? "candidato" : "candidatos")"
               AriaLabel="Paginação de candidatos" />
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private const int PageSize = 20;

    private static readonly string[] StatusValues = ["Active", "Incomplete", "Blocked"];

    [SupplyParameterFromQuery(Name = "busca")]
    private string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "situacao")]
    private string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int? PageQuery { get; set; }

    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private ListCandidatesResponse? listResponse;
    private bool isLoading = true;
    private bool loadFailed;
    private int currentPage = 1;
    private int loadVersion;
    private Guid? deletingId;
    private ConfirmDialog confirmDialog = default!;

    // Filtros que já estão no endereço: quando o endereço muda por fora (Voltar/Avançar), a lista recarrega
    private string? appliedQuery;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(searchTerm) || statusFilter.Length > 0;

    private string StateKey => $"{searchTerm}\n{statusFilter}\n{currentPage}";

    protected override async Task OnParametersSetAsync()
    {
        var search = (SearchQuery ?? string.Empty).Trim();
        var status = StatusQuery is not null && StatusValues.Contains(StatusQuery) ? StatusQuery : string.Empty;
        var page = Math.Max(1, PageQuery ?? 1);

        var key = $"{search}\n{status}\n{page}";
        if (key == appliedQuery)
            return;

        appliedQuery = key;
        searchTerm = search;
        statusFilter = status;
        await LoadAsync(page);
    }

    private async Task LoadAsync(int page)
    {
        // Filtros trocados em sequência: só a última busca vale
        var version = ++loadVersion;
        isLoading = true;
        loadFailed = false;

        var result = await ListCandidatesUseCase.ExecuteAsync(new ListCandidatesRequest
        {
            Page = page,
            Size = PageSize,
            SearchTerm = searchTerm,
            Status = statusFilter
        });

        if (version != loadVersion)
            return;

        if (result.Status == EResultStatus.Success)
        {
            listResponse = result.Data;
            currentPage = page;
        }
        else
        {
            Logger.LogFailure(result, "Listar candidatos (admin)");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync() => GoToPageAsync(1);

    private Task ClearFiltersAsync()
    {
        searchTerm = string.Empty;
        statusFilter = string.Empty;
        return GoToPageAsync(1);
    }

    private async Task GoToPageAsync(int page)
    {
        searchTerm = searchTerm.Trim();
        currentPage = page;
        SyncUrl();
        await LoadAsync(page);
    }

    // Leva os filtros para o endereço (entrada nova no histórico); a recarga é feita aqui mesmo
    private void SyncUrl()
    {
        appliedQuery = StateKey;
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["busca"] = searchTerm.Length > 0 ? searchTerm : null,
            ["situacao"] = statusFilter.Length > 0 ? statusFilter : null,
            ["pagina"] = currentPage > 1 ? currentPage : null
        });

        if (uri != Navigation.Uri)
            Navigation.NavigateTo(uri, replace: false);
    }

    private async Task DeleteAsync(CandidateResponse candidate)
    {
        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir candidato?",
            Message = $"O perfil de {candidate.Name} ({candidate.Email}) será excluído e deixará de aparecer na plataforma.",
            ConfirmText = "Excluir candidato",
            Destructive = true
        });
        if (!confirmed)
            return;

        deletingId = candidate.Id;
        var result = await DeleteCandidateUseCase.ExecuteAsync(candidate.Id);
        deletingId = null;

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess($"O perfil de {candidate.Name} foi excluído.");
            await LoadAsync(currentPage);
        }
        else
        {
            Logger.LogFailure(result, "Excluir candidato (admin)");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível excluir o candidato. Tente novamente."));
        }
    }

    private static string StatusLabel(string status) =>
        Enum.TryParse<EAccountStatus>(status, out var parsed) ? UiLabels.AccountStatus(parsed) : "Indefinida";

    private static StatusTone StatusToneFor(string status) =>
        Enum.TryParse<EAccountStatus>(status, out var parsed) ? UiLabels.AccountStatusTone(parsed) : StatusTone.Neutral;

    private static string Place(string? city, string? state)
    {
        if (string.IsNullOrWhiteSpace(city))
            return "Não informada";
        return string.IsNullOrWhiteSpace(state) ? city : $"{city} / {state}";
    }
}
