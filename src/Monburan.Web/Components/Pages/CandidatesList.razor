@page "/admin/candidates"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Candidates
@inject ListCandidatesUseCase ListCandidatesUseCase
@inject DeleteCandidateUseCase DeleteCandidateUseCase
@inject IToastService Toast
@inject ILogger<CandidatesList> Logger

<PageTitle>Gerenciar Candidatos - Monburan</PageTitle>

<div class="container mt-4 admin-list-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">ADMINISTRAÇÃO</span>
            <h1>Candidatos</h1>
            <p>Consulte perfis, situação da conta e atividade na plataforma.</p>
        </div>
    </header>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="candidate-search">Buscar</label>
                    <input id="candidate-search" type="text" class="form-control" @bind="searchTerm" @onkeydown="OnSearchKeyDown" placeholder="Nome, e-mail ou telefone..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="status-filter">Situação</label>
                    @* Valores de EAccountStatus — opções inexistentes eram ignoradas pelo filtro *@
                    <select id="status-filter" class="form-select" @bind="statusFilter">
                        <option value="">Todas</option>
                        <option value="Active">Ativa</option>
                        <option value="Incomplete">Cadastro incompleto</option>
                        <option value="Blocked">Bloqueada</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="() => LoadAsync(1)" disabled="@isLoading">Aplicar filtros <span aria-hidden="true">↗</span></button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <LoadingState Message="Carregando candidatos..." />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar os candidatos"
                    Message="Tivemos um problema ao buscar os perfis. Tente novamente em instantes."
                    OnRetry="() => LoadAsync(currentPage)" />
    }
    else if (listResponse is null || !listResponse.Items.Any())
    {
        <EmptyState Icon="☰" Title="Nenhum candidato encontrado" Message="Ajuste a busca ou os filtros." />
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Situação</th>
                                <th>Cidade/UF</th>
                                <th>Currículos</th>
                                <th>Candidaturas</th>
                                <th>Cadastro</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in listResponse.Items)
                            {
                                <tr>
                                    <td>@candidate.Name</td>
                                    <td>@candidate.Email</td>
                                    <td><span class="badge @StatusBadge(candidate.Status)">@StatusLabel(candidate.Status)</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(candidate.City))
                                        {
                                            @candidate.City@(string.IsNullOrEmpty(candidate.State) ? "" : $" / {candidate.State}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">@candidate.ResumesCount</td>
                                    <td class="text-center">@candidate.ApplicationsCount</td>
                                    <td>@UiLabels.FormatMomentDate(candidate.CreatedAt)</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(candidate)" disabled="@(deletingId == candidate.Id)" title="Excluir candidato">
                                            @(deletingId == candidate.Id ? "Excluindo..." : "Excluir")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (listResponse.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Paginação de candidatos">
                <ul class="pagination justify-content-center">
                    @if (listResponse.HasPreviousPage)
                    {
                        <li class="page-item">
                            <button class="page-link" @onclick="() => LoadAsync(listResponse.Page - 1)">Anterior</button>
                        </li>
                    }

                    @{
                        var startPage = Math.Max(1, listResponse.Page - 2);
                        var endPage = Math.Min(listResponse.TotalPages, startPage + 4);
                        startPage = Math.Max(1, endPage - 4);
                    }
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(pageNum == listResponse.Page ? "active" : "")">
                            <button class="page-link" @onclick="() => LoadAsync(pageNum)">@pageNum</button>
                        </li>
                    }

                    @if (listResponse.HasNextPage)
                    {
                        <li class="page-item">
                            <button class="page-link" @onclick="() => LoadAsync(listResponse.Page + 1)">Próximo</button>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="text-muted text-center mt-3">
            Mostrando @listResponse.Items.Count() de @listResponse.TotalCount candidatos
        </div>
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private ListCandidatesResponse? listResponse;
    private bool isLoading = true;
    private bool loadFailed;
    private int currentPage = 1;
    private Guid? deletingId;
    private ConfirmDialog confirmDialog = default!;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        isLoading = true;
        loadFailed = false;

        var result = await ListCandidatesUseCase.ExecuteAsync(new ListCandidatesRequest
        {
            Page = page,
            Size = 20,
            SearchTerm = searchTerm,
            Status = statusFilter
        });

        if (result.Status == EResultStatus.Success)
        {
            listResponse = result.Data;
            currentPage = page;
        }
        else
        {
            Logger.LogFailure(result, "Listar candidatos (admin)");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadAsync(1);
    }

    private async Task DeleteAsync(CandidateResponse candidate)
    {
        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir candidato?",
            Message = $"O perfil de {candidate.Name} ({candidate.Email}) será desativado e deixará de aparecer na plataforma.",
            ConfirmText = "Excluir candidato",
            Destructive = true
        });
        if (!confirmed)
            return;

        deletingId = candidate.Id;
        var result = await DeleteCandidateUseCase.ExecuteAsync(candidate.Id);
        deletingId = null;

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess($"O perfil de {candidate.Name} foi excluído.");
            await LoadAsync(currentPage);
        }
        else
        {
            Logger.LogFailure(result, "Excluir candidato (admin)");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível excluir o candidato. Tente novamente."));
        }
    }

    private static string StatusLabel(string status) =>
        Enum.TryParse<EAccountStatus>(status, out var parsed) ? UiLabels.AccountStatus(parsed) : "Indefinida";

    private static string StatusBadge(string status) => status switch
    {
        "Active" => "bg-success",
        "Incomplete" => "bg-warning",
        "Blocked" => "bg-danger",
        _ => "bg-secondary"
    };
}
