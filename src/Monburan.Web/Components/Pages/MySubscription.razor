@page "/minha-assinatura"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccountProfile")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.UseCases.Subscriptions
@inject GetAvailablePlansUseCase GetAvailablePlansUseCase
@inject CancelSubscriptionUseCase CancelSubscriptionUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject IToastService Toast
@inject ILogger<MySubscription> Logger

<PageTitle>Plano e assinatura - Monburan</PageTitle>

<div class="container subscription-layout">
    <PageHeader Title="Plano e assinatura" Description="Confira os recursos disponíveis e gerencie sua assinatura." />

    @if (isLoading)
    {
        <LoadingState Message="Carregando assinatura…" />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar sua assinatura"
                    Message="Tivemos um problema ao buscar os dados do seu plano. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (availablePlans?.PendingSubscription is { } pending)
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status" aria-label="Pagamento em processamento"></div>
                        <h2 class="h5">Pagamento em processamento</h2>
                        <p class="text-muted">
                            Recebemos seu pedido do plano <strong>@UiLabels.PlanName(pending.PlanName)</strong> e estamos
                            aguardando a confirmação do Mercado Pago. O plano libera automaticamente — em geral leva
                            poucos minutos.
                        </p>
                        <button type="button" class="btn btn-outline-primary" @onclick="LoadAsync">Atualizar status</button>
                        <a class="btn btn-link" href="@PlansHref">Voltar aos planos</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (availablePlans?.CurrentSubscription is { } subscription)
    {
        var currentPlan = availablePlans.Plans.FirstOrDefault(p => p.Name == subscription.PlanName);

        <section class="subscription-summary" aria-labelledby="subscription-plan-title">
            <h2 id="subscription-plan-title" class="subscription-summary__title">@UiLabels.PlanName(subscription.PlanName)</h2>
            <dl class="subscription-facts">
                <div>
                    <dt>Situação</dt>
                    <dd><StatusBadge Kind="StatusKind.Subscription" Value="@subscription.Status" TestId="subscription-status" /></dd>
                </div>
                <div>
                    <dt>Preço</dt>
                    <dd>@PriceText(subscription.Price, currentPlan)</dd>
                </div>
                <div>
                    <dt>Início</dt>
                    <dd>@UiLabels.FormatMomentDate(subscription.StartDate)</dd>
                </div>
                <div>
                    <dt>Válido até</dt>
                    <dd>@(subscription.EndDate.HasValue ? UiLabels.FormatMomentDate(subscription.EndDate) : "Sem vencimento")</dd>
                </div>
            </dl>

            <h3 class="subscription-summary__subtitle">O que o plano inclui</h3>
            @if (currentPlan != null)
            {
                @* Só o que o servidor aplica (o limite de currículos ainda não é aplicado e não é anunciado) *@
                <ul class="plan-card__features">
                    @if (currentPlan.Audience == "Candidate")
                    {
                        <li><Icon Name="file" Size="16" /><span>Candidaturas e currículos sem custo</span></li>
                        @if (currentPlan.HasAiAssistant)
                        {
                            <li><Icon Name="sparkles" Size="16" /><span>Assistente de IA para melhorar o currículo: você revisa e escolhe o que aplicar</span></li>
                        }
                    }
                    else
                    {
                        <li><Icon Name="briefcase" Size="16" /><span>@(currentPlan.MaxJobs == -1 ? "Vagas ativas ilimitadas" : $"Até {currentPlan.MaxJobs} vagas ativas ao mesmo tempo")</span></li>
                        <li><Icon Name="users" Size="16" /><span>Candidaturas ilimitadas em cada vaga</span></li>
                        <li><Icon Name="layout" Size="16" /><span>Painel com indicadores das suas vagas</span></li>
                    }
                    <li><Icon Name="@(currentPlan.IsAdFree ? "shield" : "info")" Size="16" /><span>@(currentPlan.IsAdFree ? "Sem publicidade" : "Pode mostrar um anúncio local na página da vaga")</span></li>
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">Detalhes do plano indisponíveis no momento.</p>
            }

            <div class="subscription-summary__actions">
                <a class="btn btn-outline-secondary" href="@PlansHref">Mudar de plano</a>
                @* Plano grátis não tem o que cancelar *@
                @if (subscription.Status == "Active" && subscription.Price > 0)
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="CancelAsync" disabled="@isCancelling" aria-busy="@(isCancelling ? "true" : null)" data-testid="subscription-cancel">
                        @(isCancelling ? "Cancelando…" : "Cancelar assinatura")
                    </button>
                }
            </div>
        </section>
    }
    else
    {
        var freePlan = availablePlans?.Plans.FirstOrDefault(p => p.Price == 0);
        var freeMessage = isCandidate
            ? "Conheça os planos pagos: assistente de IA para o currículo e nenhuma publicidade."
            : freePlan is null
                ? "Conheça os planos para ampliar quantas vagas você mantém ativas."
                : freePlan.MaxJobs == -1
                    ? "Ele permite vagas ativas ilimitadas. Os planos pagos não exibem publicidade."
                    : $"Ele permite até {freePlan.MaxJobs} vagas ativas ao mesmo tempo. Precisa de mais? Conheça os outros planos.";
        <EmptyState Icon="banknote"
                    Title="Você está no plano gratuito"
                    Message="@freeMessage"
                    TestId="subscription-free">
            <a class="btn btn-primary" href="@PlansHref">Ver planos disponíveis</a>
        </EmptyState>
    }
</div>

<ConfirmDialog @ref="cancelDialog">
    <label class="form-label" for="cancel-reason">Motivo do cancelamento (opcional)</label>
    <textarea id="cancel-reason" class="form-control" rows="3" maxlength="500" @bind="cancelReason" placeholder="Conte-nos o motivo para melhorarmos"></textarea>
</ConfirmDialog>

@code {
    private string PlansHref => isCandidate ? "/plans?para=candidatos" : "/plans?para=empresas";

    // Plano anual cobra por ano: o rótulo não pode dizer "por mês"
    private static string PriceText(decimal price, PlanResponse? plan) =>
        price == 0 ? "Grátis" : $"R$ {price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))} {(plan?.Period == "Annual" ? "por ano" : "por mês")}";

    private AvailablePlansResponse? availablePlans;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isCancelling;
    private bool isCandidate;
    private string cancelReason = string.Empty;
    private ConfirmDialog cancelDialog = default!;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        var candidateId = CurrentUserHelper.GetCandidateId();
        isCandidate = advertiserId is null && candidateId is not null;
        if (advertiserId is null && candidateId is null)
        {
            loadFailed = true;
            isLoading = false;
            return;
        }

        var result = advertiserId is { } advId
            ? await GetAvailablePlansUseCase.ExecuteAsync(advId)
            : await GetAvailablePlansUseCase.ExecuteForCandidateAsync(candidateId!.Value);
        if (result.Status == Core.Enums.EResultStatus.Success)
        {
            availablePlans = result.Data;
        }
        else
        {
            Logger.LogFailure(result, "Carregar assinatura");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task CancelAsync()
    {
        if (availablePlans?.CurrentSubscription is not { } subscription || isCancelling)
            return;

        cancelReason = string.Empty;
        var confirmed = await cancelDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Cancelar assinatura?",
            Message = $"O plano {UiLabels.PlanName(subscription.PlanName)} será encerrado agora e sua conta volta para o plano gratuito, com menos recursos.",
            ConfirmText = "Cancelar assinatura",
            CancelText = "Manter plano",
            Destructive = true
        });
        if (!confirmed)
            return;

        isCancelling = true;
        var result = await CancelSubscriptionUseCase.ExecuteAsync(new CancelSubscriptionRequest
        {
            SubscriptionId = subscription.Id,
            Reason = string.IsNullOrWhiteSpace(cancelReason) ? null : cancelReason.Trim(),
            // O dono vem da sessão, nunca do navegador: o use case só cancela a
            // assinatura que for desta conta
            AdvertiserId = CurrentUserHelper.GetAdvertiserId(),
            CandidateId = CurrentUserHelper.GetCandidateId()
        });
        isCancelling = false;

        if (result.Status == Core.Enums.EResultStatus.Success)
        {
            Toast.ShowSuccess("Sua assinatura foi cancelada. Você está no plano gratuito.");
            await LoadAsync();
        }
        else
        {
            Logger.LogFailure(result, "Cancelar assinatura");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível cancelar a assinatura. Tente novamente."));
        }
    }
}
