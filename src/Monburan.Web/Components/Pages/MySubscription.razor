@page "/my-subscription"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdvertiserOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.UseCases.Subscriptions
@inject GetAvailablePlansUseCase GetAvailablePlansUseCase
@inject CancelSubscriptionUseCase CancelSubscriptionUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject IToastService Toast
@inject ILogger<MySubscription> Logger

<PageTitle>Minha Assinatura - Monburan</PageTitle>

<div class="container mt-4 subscription-layout">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">CONTA DA EMPRESA</span>
            <h1>Plano e assinatura</h1>
            <p>Confira os recursos disponíveis e gerencie sua assinatura.</p>
        </div>
    </header>

    @if (isLoading)
    {
        <LoadingState Message="Carregando assinatura..." />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar sua assinatura"
                    Message="Tivemos um problema ao buscar os dados do seu plano. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (availablePlans?.CurrentSubscription is { } subscription)
    {
        var currentPlan = availablePlans.Plans.FirstOrDefault(p => p.Name == subscription.PlanName);

        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Plano atual: @subscription.PlanName</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Situação:</strong></p>
                                <span class="badge @UiLabels.SubscriptionStatusBadge(subscription.Status)">@UiLabels.SubscriptionStatus(subscription.Status)</span>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Preço:</strong></p>
                                <p class="fs-5 text-primary">
                                    @(subscription.Price == 0 ? "Grátis" : $"R$ {subscription.Price:N2}/mês")
                                </p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Início:</strong></p>
                                <p>@UiLabels.FormatMomentDate(subscription.StartDate)</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Válido até:</strong></p>
                                <p>@(subscription.EndDate.HasValue ? UiLabels.FormatMomentDate(subscription.EndDate) : "Sem vencimento")</p>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <a class="btn btn-outline-primary" href="/plans">Mudar de plano</a>
                            @* Plano grátis não tem o que cancelar *@
                            @if (subscription.Status == "Active" && subscription.Price > 0)
                            {
                                <button class="btn btn-outline-danger" @onclick="CancelAsync" disabled="@isCancelling" data-testid="subscription-cancel">
                                    @(isCancelling ? "Cancelando..." : "Cancelar assinatura")
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Recursos do plano</h5>
                    </div>
                    <div class="card-body">
                        @if (currentPlan != null)
                        {
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <strong>Vagas ativas:</strong>
                                    @(currentPlan.MaxJobs == -1 ? "ilimitadas" : $"até {currentPlan.MaxJobs} ao mesmo tempo")
                                </li>
                                <li class="mb-2">Candidaturas ilimitadas</li>
                                <li>Painel com indicadores das vagas</li>
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Detalhes do plano indisponíveis no momento.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        var freePlan = availablePlans?.Plans.FirstOrDefault(p => p.Price == 0);
        <EmptyState Icon="◈"
                    Kicker="PLANO GRATUITO"
                    Title="Você está no plano gratuito"
                    Message="@(freePlan is null ? "Conheça os planos para ampliar quantas vagas você mantém ativas." : $"Ele permite até {freePlan.MaxJobs} vagas ativas ao mesmo tempo. Precisa de mais? Conheça os outros planos.")"
                    TestId="subscription-free">
            <a class="btn btn-primary" href="/plans">Ver planos disponíveis</a>
        </EmptyState>
    }
</div>

<ConfirmDialog @ref="cancelDialog">
    <label class="form-label" for="cancel-reason"><strong>Motivo do cancelamento (opcional)</strong></label>
    <textarea id="cancel-reason" class="form-control" rows="3" maxlength="500" @bind="cancelReason" placeholder="Conte-nos o motivo para melhorarmos"></textarea>
</ConfirmDialog>

@code {
    private AvailablePlansResponse? availablePlans;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isCancelling;
    private string cancelReason = string.Empty;
    private ConfirmDialog cancelDialog = default!;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        var advertiserId = CurrentUserHelper.GetAdvertiserId();
        if (!advertiserId.HasValue)
        {
            loadFailed = true;
            isLoading = false;
            return;
        }

        var result = await GetAvailablePlansUseCase.ExecuteAsync(advertiserId.Value);
        if (result.Status == Core.Enums.EResultStatus.Success)
        {
            availablePlans = result.Data;
        }
        else
        {
            Logger.LogFailure(result, "Carregar assinatura");
            loadFailed = true;
        }

        isLoading = false;
    }

    private async Task CancelAsync()
    {
        if (availablePlans?.CurrentSubscription is not { } subscription || isCancelling)
            return;

        cancelReason = string.Empty;
        var confirmed = await cancelDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Cancelar assinatura?",
            Message = $"O plano {subscription.PlanName} será encerrado agora e sua conta volta para o plano gratuito, com limite menor de vagas ativas.",
            ConfirmText = "Cancelar assinatura",
            CancelText = "Manter plano",
            Destructive = true
        });
        if (!confirmed)
            return;

        isCancelling = true;
        var result = await CancelSubscriptionUseCase.ExecuteAsync(new CancelSubscriptionRequest
        {
            SubscriptionId = subscription.Id,
            Reason = string.IsNullOrWhiteSpace(cancelReason) ? null : cancelReason.Trim()
        });
        isCancelling = false;

        if (result.Status == Core.Enums.EResultStatus.Success)
        {
            Toast.ShowSuccess("Sua assinatura foi cancelada. Você está no plano gratuito.");
            await LoadAsync();
        }
        else
        {
            Logger.LogFailure(result, "Cancelar assinatura");
            Toast.ShowError(ResultMessages.ToUserMessage(result, "Não foi possível cancelar a assinatura. Tente novamente."));
        }
    }
}
