@page "/Error"
@using System.Diagnostics

<PageTitle>Ocorreu um erro - Monburan</PageTitle>

<section class="auth-message-page error-page">
    <span class="empty-state__icon" aria-hidden="true">!</span>
    <span class="page-kicker">MONBURAN</span>
    <h1>Não foi possível concluir esta ação</h1>
    <p>Ocorreu um problema inesperado. Tente novamente ou volte para a página inicial.</p>
    @if (ShowRequestId)
    {
        <p class="error-reference">Referência de suporte: <code>@RequestId</code></p>
    }
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" href="/">Voltar ao início</a>
        <a class="btn btn-outline-primary" href="/jobs">Ver oportunidades</a>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}