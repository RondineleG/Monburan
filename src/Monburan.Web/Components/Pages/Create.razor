@page "/address/create"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Data.Common
@inject AddressService AddressService
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<Create> Logger
@using Monburan.Core.Entities

<PageTitle>Novo endereço - Monburan</PageTitle>

<div class="container mt-4 page-form-shell address-form-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">CONFIGURAÇÕES</span>
            <h1>Novo endereço</h1>
            <p>Informe os dados para adicionar um endereço ao perfil.</p>
        </div>
    </header>
    <div class="card page-form-card">
        <div class="card-body">
            <EditForm Model="form" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <AddressFormFields Model="form" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting" data-testid="address-save">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Salvar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isSubmitting">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private readonly AddressForm form = new();
    private bool isSubmitting;

    private async Task HandleValidSubmit()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        try
        {
            var address = new Address();
            form.ApplyTo(address);
            await AddressService.AddAsync(address);
            await AddressService.LinkToOwnerAsync(
                address.Id,
                CurrentUserHelper.GetCandidateId(),
                CurrentUserHelper.GetAdvertiserId());

            Toast.ShowSuccess("Endereço adicionado ao seu perfil.");
            Navigation.NavigateTo("/address/list");
        }
        catch (Exception ex) when (ex is DbException or DbUpdateException or InvalidOperationException)
        {
            // Antes a exceção derrubava o circuito ("Algo inesperado aconteceu")
            Logger.LogError(ex, "Falha ao salvar endereço");
            Toast.ShowError("Não foi possível salvar o endereço. Confira os dados e tente novamente.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/address/list");
}
