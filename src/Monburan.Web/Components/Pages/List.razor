@page "/address/list"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Data.Common
@inject AddressService AddressService
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<List> Logger
@using Monburan.Core.Entities;
@using Monburan.Web.Services;

<PageTitle>Endereços - Monburan</PageTitle>

<div class="container address-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">CONFIGURAÇÕES</span>
            <h1>Endereços</h1>
            <p>Gerencie os endereços associados à sua conta.</p>
        </div>
        <button class="btn btn-primary" @onclick="Create">Novo endereço <span aria-hidden="true">＋</span></button>
    </header>

    @if (isLoading)
    {
        <LoadingState Message="Carregando endereços..." />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar os endereços"
                    Message="Tivemos um problema ao buscar seus endereços. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (Addresses.Count == 0)
    {
        <section class="empty-state">
            <span class="empty-state__icon" aria-hidden="true">⌖</span>
            <h2>Nenhum endereço cadastrado</h2>
            <p>Adicione um endereço para completar suas informações de perfil.</p>
            <button class="btn btn-primary" @onclick="Create">Adicionar endereço</button>
        </section>
    }
    else
    {
        <div class="card address-table-card">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Rua</th>
                            <th>Número</th>
                            <th>Bairro</th>
                            <th>Cidade</th>
                            <th>Estado</th>
                            <th>CEP</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var address in Addresses)
                        {
                            <tr>
                                <td>@address.Street</td>
                                <td>@address.Number</td>
                                <td>@address.District</td>
                                <td>@address.City</td>
                                <td>@address.State</td>
                                <td>@address.ZipCode</td>
                                <td>
                                    <div class="btn-group">
                                        <button class="btn btn-outline-primary btn-sm"
                                                @onclick="() => Edit(address.Id)"
                                                aria-label="@($"Editar endereço {address.Street}, {address.Number}")">Editar</button>
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => DeleteAsync(address)"
                                                disabled="@(deletingId == address.Id.Value)"
                                                aria-label="@($"Excluir endereço {address.Street}, {address.Number}")">Excluir</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<ConfirmDialog @ref="confirmDialog" />

@code {
    private List<Address> Addresses = new();
    private bool isLoading = true;
    private bool loadFailed;
    private Guid? deletingId;
    private ConfirmDialog confirmDialog = default!;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;
        try
        {
            Addresses = await AddressService.GetOwnedAsync(
                CurrentUserHelper.GetCandidateId(),
                CurrentUserHelper.GetAdvertiserId());
        }
        catch (Exception ex) when (ex is DbException or DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(ex, "Falha ao listar endereços");
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Create() => Navigation.NavigateTo("/address/create");

    private void Edit(Guid id) => Navigation.NavigateTo($"/address/edit/{id}");

    private async Task DeleteAsync(Address address)
    {
        var description = string.Join(", ", new[] { address.Street, address.Number, address.City }.Where(p => !string.IsNullOrWhiteSpace(p)));
        var confirmed = await confirmDialog.ShowAsync(new ConfirmOptions
        {
            Title = "Excluir endereço?",
            Message = $"O endereço \"{description}\" será removido do seu perfil.",
            ConfirmText = "Excluir endereço",
            Destructive = true
        });
        if (!confirmed)
            return;

        deletingId = address.Id.Value;
        try
        {
            // Só remove endereço que pertence ao perfil (a lista já é filtrada por dono)
            await AddressService.UnlinkFromOwnerAsync(address.Id);
            await AddressService.DeleteAsync(address.Id.Value);
            Addresses.Remove(address);
            Toast.ShowSuccess("Endereço removido.");
        }
        catch (Exception ex) when (ex is DbException or DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(ex, "Falha ao excluir endereço {AddressId}", address.Id.Value);
            Toast.ShowError("Não foi possível remover o endereço. Tente novamente.");
        }
        finally
        {
            deletingId = null;
        }
    }
}
