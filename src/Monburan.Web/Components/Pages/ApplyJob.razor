@page "/candidatar/{jobId:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.Requests
@using Monburan.Core.UseCases.Applications
@using Monburan.Core.UseCases.Jobs
@using Monburan.Core.UseCases.Resumes
@using Monburan.Web.Services
@inject CreateApplicationUseCase CreateApplicationUseCase
@inject GetJobByIdUseCase GetJobByIdUseCase
@inject ListResumesByCandidateUseCase ListResumesByCandidateUseCase
@inject ApplicationLookupService ApplicationLookup
@inject ILogger<ApplyJob> Logger
@inject ICurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>Candidatar-se - Monburan</PageTitle>

<div class="page-narrow application-page">
    <PageHeader Title="Candidatar-se à vaga" Description="Revise os detalhes e envie seu perfil para a empresa."
                BackHref="@($"/jobs/{JobId}")" BackText="Voltar à vaga" />
    <div>
        <div>

            @if (isLoading)
            {
                <LoadingState Message="Carregando a vaga…" />
            }
            else if (!isCandidate)
            {
                <AccessRestricted Reason="A candidatura é exclusiva para contas de candidato. Entre com uma conta de candidato para enviar sua candidatura." />
            }
            else if (lookupFailed)
            {
                <ErrorState Title="Não foi possível verificar sua candidatura"
                            Message="Tivemos um problema ao conferir se você já se candidatou a esta vaga. Sem essa verificação não dá para enviar de novo — tente novamente em instantes."
                            OnRetry="LoadAsync" />
            }
            else if (existingApplication is not null)
            {
                <section class="card" data-testid="application-already" aria-live="polite">
                    <div class="card-body">
                        <h2 class="h4" id="apply-step-title" tabindex="-1">Você já se candidatou a esta vaga</h2>
                        <p>Situação atual: <StatusBadge Kind="StatusKind.Application" Value="@existingApplication.Status" /></p>
                        <p>A empresa já recebeu seu perfil. Você pode acompanhar as etapas do processo seletivo em Minhas candidaturas.</p>
                        <a class="btn btn-primary" href="/minhas-candidaturas?aba=candidaturas" data-testid="application-track">Acompanhar candidatura</a>
                    </div>
                </section>
            }
            else if (submitted)
            {
                <section class="card" data-testid="application-feedback" aria-live="polite">
                    <div class="card-body">
                        <h2 class="h4" id="apply-step-title" tabindex="-1">Candidatura enviada</h2>
                        <p>A empresa já pode ver seu perfil para esta vaga. Acompanhe as atualizações em Minhas candidaturas.</p>
                        <h3 class="h6">Próximos passos</h3>
                        <ul>
                            <li>Acompanhe as etapas do processo seletivo em <a href="/minhas-candidaturas?aba=candidaturas">Minhas candidaturas</a>.</li>
                            <li>Continue explorando <a href="/jobs">outras oportunidades</a>.</li>
                            <li>Mantenha seu <a href="/curriculos">currículo</a> atualizado.</li>
                        </ul>
                        <a class="btn btn-primary" href="/minhas-candidaturas?aba=candidaturas">Ver minhas candidaturas</a>
                    </div>
                </section>
            }
            else if (jobUnavailableMessage is not null)
            {
                <div class="alert alert-warning" role="status" data-testid="application-unavailable">
                    @jobUnavailableMessage
                    <a href="/jobs">Ver outras vagas</a>
                </div>
            }
            else
            {
                <ol class="apply-steps" aria-label="Etapas da candidatura">
                    <li class="apply-steps__item@(step == 1 ? " apply-steps__item--active" : string.Empty)" aria-current="@(step == 1 ? "step" : null)">
                        1. Revisar
                    </li>
                    <li class="apply-steps__item@(step == 2 ? " apply-steps__item--active" : string.Empty)" aria-current="@(step == 2 ? "step" : null)">
                        2. Confirmar
                    </li>
                </ol>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert" data-testid="application-feedback">@errorMessage</div>
                }

                <div class="card">
                    <div class="card-body">
                        @if (step == 1)
                        {
                            <h2 class="h4" id="apply-step-title" tabindex="-1">Revisar</h2>
                            <p class="text-muted">
                                Você está se candidatando à vaga <strong>@job?.Title</strong>. Preencha as informações abaixo (opcional):
                            </p>

                            <dl class="apply-summary">
                                <dt>Empresa</dt>
                                <dd>@(job?.AdvertiserName ?? "Empresa confidencial")</dd>
                                <dt>Local</dt>
                                <dd>@JobDisplay.Location(job)</dd>
                                <dt>Modalidade</dt>
                                <dd>@UiLabels.JobType(job?.Type)</dd>
                                @if (!string.IsNullOrWhiteSpace(UiLabels.ContractType(job?.ContractType)))
                                {
                                    <dt>Contrato</dt>
                                    <dd>@UiLabels.ContractType(job?.ContractType)</dd>
                                }
                                @if (salary is not null)
                                {
                                    <dt>Salário</dt>
                                    <dd>@salary</dd>
                                }
                            </dl>

                            @if (resumes.Count > 0)
                            {
                                <div class="mb-3">
                                    <label class="form-label" for="application-resume">Currículo enviado com a candidatura</label>
                                    <InputSelect id="application-resume" class="form-select" @bind-Value="model.ResumeId" data-testid="application-resume">
                                        <option value="">Não anexar currículo</option>
                                        @foreach (var resume in resumes)
                                        {
                                            <option value="@resume.Id">@resume.Title@(resume.IsActive ? " (ativo)" : "")</option>
                                        }
                                    </InputSelect>
                                    <div class="form-text">A empresa poderá ver o currículo escolhido.</div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info" role="status">
                                    Você ainda não tem currículo cadastrado. <a href="/curriculos/assistente">Crie um currículo</a> para enviá-lo junto com a candidatura.
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label" for="application-notes">Observações (opcional)</label>
                                <InputTextArea id="application-notes" class="form-control" @bind-Value="model.Notes" rows="4" data-testid="application-notes"
                                               placeholder="Escreva uma breve mensagem ou destaque suas qualificações…" />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-primary btn-lg" @onclick="GoToConfirm" data-testid="application-continue">
                                    Continuar<Icon Name="arrow-right" Size="18" />
                                </button>
                            </div>
                        }
                        else
                        {
                            <h2 class="h4" id="apply-step-title" tabindex="-1">Confirmar</h2>
                            <p class="text-muted">Confira um resumo do que a empresa vai receber:</p>

                            <dl class="apply-summary">
                                <dt>Vaga</dt>
                                <dd>@job?.Title</dd>
                                <dt>Empresa</dt>
                                <dd>@(job?.AdvertiserName ?? "Empresa confidencial")</dd>
                                <dt>Local</dt>
                                <dd>@JobDisplay.Location(job)</dd>
                                @if (salary is not null)
                                {
                                    <dt>Salário</dt>
                                    <dd>@salary</dd>
                                }
                                <dt>Currículo</dt>
                                <dd>@(SelectedResumeTitle ?? "Sem currículo anexado")</dd>
                                <dt>Observações</dt>
                                <dd>@(string.IsNullOrWhiteSpace(model.Notes) ? "Sem observações" : model.Notes)</dd>
                            </dl>

                            <label class="form-check form-check--boxed mb-3" for="application-confirm">
                                <input type="checkbox" class="form-check-input" id="application-confirm"
                                       @bind="confirmed" data-testid="application-confirm" />
                                <span class="form-check-label">Confirmo que as informações estão corretas</span>
                            </label>

                            @if (!confirmed)
                            {
                                @* Explica por que o envio está desabilitado *@
                                <p id="application-confirm-hint" class="form-text mb-3">Marque a confirmação acima para enviar.</p>
                            }
                            <div class="form-actions">
                                <button type="button" class="btn btn-outline-secondary" @onclick="BackToReview">
                                    <Icon Name="arrow-left" Size="18" />Voltar
                                </button>
                                <button type="button" class="btn btn-primary btn-lg flex-grow-1" disabled="@(!confirmed || isSubmitting)"
                                        aria-busy="@(isSubmitting ? "true" : null)"
                                        aria-describedby="@(confirmed ? null : "application-confirm-hint")"
                                        @onclick="SubmitForm" data-testid="application-submit">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Enviando…</span>
                                    }
                                    else
                                    {
                                        <span>Enviar candidatura</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid JobId { get; set; }

    private CreateApplicationRequest model = new();
    private JobResponse? job;
    private string? salary;
    private string errorMessage = string.Empty;
    private bool submitted;
    private bool confirmed;
    private bool isSubmitting;
    private bool isCandidate;
    private string? jobUnavailableMessage;
    private bool isLoading = true;
    private int step = 1;
    private List<ResumeResponse> resumes = [];
    private ApplicationResponse? existingApplication;
    private bool lookupFailed;

    private string? SelectedResumeTitle =>
        resumes.FirstOrDefault(resume => resume.Id == model.ResumeId)?.Title;

    protected override async Task OnParametersSetAsync()
    {
        // Trocar de vaga reaproveita o componente: zera tudo e recarrega para o novo JobId
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        model = new CreateApplicationRequest { JobId = JobId };
        job = null;
        salary = null;
        resumes = [];
        step = 1;
        submitted = false;
        confirmed = false;
        isSubmitting = false;
        errorMessage = string.Empty;
        jobUnavailableMessage = null;
        existingApplication = null;
        lookupFailed = false;

        var jobResult = await GetJobByIdUseCase.ExecuteAsync(JobId, CurrentUserHelper.GetCandidateId());
        if (jobResult.Status == EResultStatus.Success && jobResult.Data is not null)
        {
            job = jobResult.Data;
            salary = JobDisplay.Salary(job);

            if (job.Status != "Active")
                jobUnavailableMessage = "Esta vaga não está mais recebendo candidaturas.";
            else if (JobChannel.IsExternal(job))
                jobUnavailableMessage = "Esta vaga recebe candidaturas no canal da empresa, fora da Monburan. Veja as instruções na página da vaga.";
        }
        else if (jobResult.Status == EResultStatus.EntityNotFound)
        {
            jobUnavailableMessage = "Vaga não encontrada. Ela pode ter sido removida pela empresa.";
        }
        else
        {
            Logger.LogFailure(jobResult, "Carregar vaga para candidatura");
            jobUnavailableMessage = "Não foi possível carregar a vaga agora. Tente novamente em instantes.";
        }

        var candidateId = CurrentUserHelper.GetCandidateId();
        isCandidate = candidateId.HasValue;
        if (!isCandidate || jobUnavailableMessage is not null)
        {
            isLoading = false;
            return;
        }

        model.CandidateId = candidateId!.Value;

        // Verificação ANTES do formulário: já candidatado vê a situação e não o wizard;
        // falha na consulta bloqueia o envio (nunca fingir "não se candidatou")
        RequestResult<ApplicationResponse?> lookup;
        try
        {
            lookup = await ApplicationLookup.GetAsync(JobId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Falha ao verificar candidatura existente antes do formulário");
            lookupFailed = true;
            isLoading = false;
            return;
        }
        if (lookup.Status != EResultStatus.Success)
        {
            Logger.LogFailure(lookup, "Verificar candidatura existente antes do formulário");
            lookupFailed = true;
            isLoading = false;
            return;
        }

        if (lookup.Data is not null)
        {
            existingApplication = lookup.Data;
            isLoading = false;
            return;
        }

        // Antes a tela prometia enviar "o currículo ativo", mas nenhum era anexado
        var resumesResult = await ListResumesByCandidateUseCase.ExecuteAsync(candidateId.Value);
        if (resumesResult.Status == EResultStatus.Success && resumesResult.Data is not null)
        {
            resumes = resumesResult.Data.ToList();
            model.ResumeId = resumes.FirstOrDefault(r => r.IsActive)?.Id ?? resumes.FirstOrDefault()?.Id;
        }

        isLoading = false;
    }

    private async Task GoToConfirm()
    {
        step = 2;
        await FocusStepTitleAsync();
    }

    private async Task BackToReview()
    {
        // Volta sem perder o que já foi digitado: o modelo continua o mesmo
        step = 1;
        await FocusStepTitleAsync();
    }

    private async Task FocusStepTitleAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("monburanFocusById", "apply-step-title");
        }
        catch (JSException)
        {
            // Sem JS disponível o foco é o de menos: a navegação por etapas continua funcionando
        }
    }

    private async Task SubmitForm()
    {
        // Clique duplo antes do re-render não pode enviar duas candidaturas
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = string.Empty;

        var result = await CreateApplicationUseCase.ExecuteAsync(model);

        if (result.Status == EResultStatus.Success)
        {
            submitted = true;
            Toast.ShowSuccess("A empresa já pode ver sua candidatura. Acompanhe em Minhas candidaturas.", "Candidatura enviada");
            await FocusStepTitleAsync();
        }
        else
        {
            // "Já se candidatou" (409) e validações chegavam com Message vazio — nada aparecia.
            // O alerta da página (role="alert") já anuncia: um toast repetiria a mesma mensagem.
            Logger.LogFailure(result, "Enviar candidatura");
            errorMessage = ResultMessages.ToUserMessage(result, "Não foi possível enviar sua candidatura. Tente novamente.");
        }

        isSubmitting = false;
    }
}
