@page "/perfil-profissional"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@using System.Globalization
@using Monburan.Core.Catalogs
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Enums
@using Monburan.Core.UseCases.Candidates
@using Monburan.Web.Services
@inject GetCareerProfileUseCase GetCareerProfileUseCase
@inject UpsertCareerProfileUseCase UpsertCareerProfileUseCase
@inject GetInternationalPreferencesUseCase GetInternationalPreferences
@inject UpsertInternationalPreferencesUseCase UpsertInternationalPreferences
@inject GetCandidateLanguagesUseCase GetCandidateLanguages
@inject ReplaceCandidateLanguagesUseCase ReplaceCandidateLanguages
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IFeatureFlags FeatureFlags
@inject CurrentUserHelper CurrentUserHelper
@inject NavigationManager Navigation
@inject IToastService Toast
@inject ILogger<CareerProfile> Logger
@inject Monburan.Core.Interfaces.Services.IFeatureFlags FeatureFlags

<PageTitle>Perfil de carreira - Monburan</PageTitle>

<div class="container my-applications-page">
    <PageHeader Title="Perfil de carreira" Description="Usamos estas informações para recomendar vagas." />

    @if (isLoading)
    {
        <LoadingState Message="Carregando seu perfil de carreira…" />
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar seu perfil"
                    Message="Tivemos um problema ao buscar seu perfil de carreira. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <article class="card">
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert" data-testid="career-profile-error">@errorMessage</div>
                        }

                        <EditForm Model="model" OnValidSubmit="SaveAsync" Context="form" @ref="editForm" novalidate>
                            <DataAnnotationsValidator />
                            <UnsavedChangesGuard HasChanges="() => form.IsModified() && !isSaving" />
                            <div class="mb-3">
                                <label class="form-label" for="career-role">Cargo desejado</label>
                                <InputText id="career-role" class="form-control" @bind-Value="model.DesiredRole" data-testid="career-role"
                                           placeholder="Ex.: Atendente, Vendedor(a), Desenvolvedor(a)" />
                            </div>

                            <div class="row g-2">
                                <div class="col-8">
                                    <label class="form-label" for="career-city">Cidade</label>
                                    <InputText id="career-city" class="form-control" @bind-Value="model.City" data-testid="career-city" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label" for="career-state">UF</label>
                                    <InputSelect id="career-state" class="form-select" @bind-Value="model.State" data-testid="career-state">
                                        <option value="">Selecione</option>
                                        @foreach (var uf in States)
                                        {
                                            <option value="@uf">@uf</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="row g-2 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label" for="career-mode">Modalidade</label>
                                    <InputSelect id="career-mode" class="form-select" @bind-Value="model.Mode" data-testid="career-mode">
                                        <option value="">Qualquer modalidade</option>
                                        <option value="OnSite">Presencial</option>
                                        <option value="Remote">Remoto</option>
                                        <option value="Hybrid">Híbrido</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="career-contract">Tipo de contrato</label>
                                    <InputSelect id="career-contract" class="form-select" @bind-Value="model.ContractType" data-testid="career-contract">
                                        <option value="">Qualquer contrato</option>
                                        @foreach (var contract in Enum.GetValues<EContractType>())
                                        {
                                            <option value="@contract">@UiLabels.ContractType(contract.ToString())</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="row g-2 mt-1">
                                <div class="col-md-7">
                                    <label class="form-label" for="career-category">Categoria</label>
                                    <InputSelect id="career-category" class="form-select" @bind-Value="model.Category" data-testid="career-category">
                                        <option value="">Qualquer categoria</option>
                                        @foreach (var category in JobCategories.All)
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="career-salary">Salário mínimo (R$)</label>
                                    <InputNumber id="career-salary" class="form-control" @bind-Value="model.MinimumSalary"
                                                 Culture="@BrazilianCulture" inputmode="decimal" data-testid="career-salary" />
                                </div>
                            </div>

                            @if (internationalJobsEnabled)
                            {
                            <div class="mt-3">
                                <label class="form-label" for="career-countries">Países de interesse (vagas internacionais)</label>
                                <select id="career-countries" class="form-select" multiple size="6"
                                        @onchange="OnCountriesChanged" data-testid="career-countries">
                                    @foreach (var country in InternationalCountries)
                                    {
                                        <option value="@country.Code" selected="@(model.PreferredCountries?.Contains(country.Code) == true)">
                                            @country.Label
                                        </option>
                                    }
                                </select>
                                <div class="form-text">
                                    Vagas internacionais exigem plano Premium. Sem seleção, mostramos vagas de todos os países fora do Brasil.
                                </div>
                            </div>
                            }

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@isSaving" aria-busy="@(isSaving ? "true" : null)" data-testid="career-profile-submit">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Salvando…</span>
                                    }
                                    else
                                    {
                                        <span>Salvar perfil de carreira</span>
                                    }
                                </button>
                                <a class="btn btn-outline-secondary" href="/">Voltar ao início</a>
                            </div>
                        </EditForm>
                    </div>
                </article>

                @if (showInternational)
                {
                    <article class="card mt-3" data-testid="international-preferences-card">
                        <div class="card-body">
                            <h2 class="h5">Carreira internacional</h2>
                            <p class="text-muted small">
                                Preferências autodeclaradas para vagas fora do Brasil. Opcionais —
                                informar não determina elegibilidade legal para trabalhar em outro país.
                            </p>
                            @if (!string.IsNullOrEmpty(internationalError))
                            {
                                <div class="alert alert-danger" role="alert" data-testid="international-error">@internationalError</div>
                            }

                            <EditForm Model="intlModel" OnValidSubmit="SaveInternationalAsync" Context="intlForm" novalidate>
                                <div class="mb-3">
                                    <label class="form-label" for="intl-countries">Países de interesse</label>
                                    <InputText id="intl-countries" class="form-control" @bind-Value="intlModel.CountriesInput"
                                               placeholder="ES, PT, DE" data-testid="intl-countries" />
                                    <div class="form-text">Códigos de 2 letras separados por vírgula (máx. 20).</div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label" for="intl-mobility">Disponibilidade</label>
                                        <InputSelect id="intl-mobility" class="form-select" @bind-Value="intlModel.Mobility" data-testid="intl-mobility">
                                            <option value="@EInternationalMobility.NotInformed">Prefiro não informar</option>
                                            <option value="@EInternationalMobility.RemoteOnly">Somente remoto para o exterior</option>
                                            <option value="@EInternationalMobility.Relocation">Somente com realocação</option>
                                            <option value="@EInternationalMobility.RemoteOrRelocation">Remoto ou realocação</option>
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="intl-work-auth">Autorização de trabalho (autodeclarada)</label>
                                        <InputSelect id="intl-work-auth" class="form-select" @bind-Value="intlModel.WorkAuthorizationStatus" data-testid="intl-work-auth">
                                            <option value="@EWorkAuthorizationStatus.NotInformed">Prefiro não informar</option>
                                            <option value="@EWorkAuthorizationStatus.None">Não tenho autorização</option>
                                            <option value="@EWorkAuthorizationStatus.Citizen">Cidadania do país de destino</option>
                                            <option value="@EWorkAuthorizationStatus.PermanentResidency">Residência permanente</option>
                                            <option value="@EWorkAuthorizationStatus.WorkVisa">Visto de trabalho vigente</option>
                                            <option value="@EWorkAuthorizationStatus.Other">Outra situação</option>
                                        </InputSelect>
                                    </div>
                                </div>

                                <div class="form-actions mt-3">
                                    <button type="submit" class="btn btn-primary" disabled="@intlSaving" data-testid="intl-submit">
                                        @(intlSaving ? "Salvando…" : "Salvar preferências internacionais")
                                    </button>
                                </div>
                            </EditForm>

                            <hr />

                            <h3 class="h6">Idiomas (autodeclarados)</h3>
                            @foreach (var (item, index) in languages.Select((l, i) => (l, i)))
                            {
                                <div class="row g-2 align-items-end mb-2" data-testid="language-row">
                                    <div class="col-md-4">
                                        <label class="form-label">Idioma (ex.: es-ES)</label>
                                        <InputText class="form-control" @bind-Value="item.LanguageTag" placeholder="es-ES" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Nível</label>
                                        <InputSelect class="form-select" @bind-Value="item.Level">
                                            @foreach (var level in Enum.GetValues<ELanguageLevel>())
                                            {
                                                <option value="@level">@LanguageLevelLabel(level)</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Evidência</label>
                                        <InputSelect class="form-select" @bind-Value="item.Evidence">
                                            <option value="@ELanguageEvidence.SelfDeclared">Autodeclarado</option>
                                            <option value="@ELanguageEvidence.Certificate">Certificado</option>
                                            <option value="@ELanguageEvidence.Native">Nativo</option>
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-outline-danger btn-sm w-100" @onclick="() => languages.RemoveAt(index)">Remover</button>
                                    </div>
                                </div>
                            }
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddLanguage" data-testid="language-add">Adicionar idioma</button>
                                <button type="button" class="btn btn-primary btn-sm" disabled="@intlSaving" @onclick="SaveLanguagesAsync" data-testid="languages-submit">Salvar idiomas</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] States =
    [
        "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG",
        "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO"
    ];

    private static readonly CultureInfo BrazilianCulture = CultureInfo.GetCultureInfo("pt-BR");

    private static readonly (string Code, string Label)[] InternationalCountries =
    [
        ("PT", "Portugal"), ("ES", "Espanha"), ("DE", "Alemanha"), ("NL", "Países Baixos"),
        ("IE", "Irlanda"), ("GB", "Reino Unido"), ("FR", "França"), ("IT", "Itália"),
        ("US", "Estados Unidos"), ("CA", "Canadá"), ("AU", "Austrália"), ("NZ", "Nova Zelândia"),
        ("UY", "Uruguai"), ("AR", "Argentina"), ("CL", "Chile"), ("PY", "Paraguai"),
        ("MX", "México"), ("JP", "Japão"), ("AE", "Emirados Árabes"), ("CH", "Suíça")
    ];

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private CareerProfileRequest model = new();
    private EditForm? editForm;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private bool isSaving;
    private bool loadFailed;
    private bool internationalJobsEnabled;

    private bool showInternational;
    private bool intlSaving;
    private string internationalError = string.Empty;
    private InternationalFormModel intlModel = new();
    private List<CandidateLanguageItem> languages = [];

    private sealed class InternationalFormModel
    {
        public string CountriesInput { get; set; } = string.Empty;
        public EInternationalMobility Mobility { get; set; } = EInternationalMobility.NotInformed;
        public EWorkAuthorizationStatus WorkAuthorizationStatus { get; set; } = EWorkAuthorizationStatus.NotInformed;
    }

    private static string LanguageLevelLabel(ELanguageLevel level) => level switch
    {
        ELanguageLevel.Basic => "Básico",
        ELanguageLevel.Intermediate => "Intermediário",
        ELanguageLevel.Advanced => "Avançado",
        ELanguageLevel.Fluent => "Fluente",
        ELanguageLevel.Native => "Nativo",
        _ => level.ToString()
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        showInternational = await FeatureFlags.IsEnabledAsync("carreira-internacional", authState.User);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        // Flag do rollout: a preferência de países só aparece (e só é enviada) quando a
        // funcionalidade de vagas internacionais está ligada para a conta.
        var user = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User;
        internationalJobsEnabled = await FeatureFlags.IsEnabledAsync("vagas-internacionais", user);

        var result = await GetCareerProfileUseCase.ExecuteAsync(CurrentUserHelper.GetCandidateId()!.Value);
        if (result.Status == EResultStatus.Success && result.Data is not null)
        {
            model = new CareerProfileRequest
            {
                DesiredRole = result.Data.DesiredRole,
                City = result.Data.City,
                State = result.Data.State,
                Mode = result.Data.Mode,
                Category = result.Data.Category,
                MinimumSalary = result.Data.MinimumSalary,
                ContractType = result.Data.ContractType,
                PreferredCountries = result.Data.PreferredCountries
            };
        }
        else
        {
            Logger.LogFailure(result, "Carregar perfil de carreira");
            loadFailed = true;
        }

        if (showInternational)
            await LoadInternationalAsync();

        isLoading = false;
    }

    private async Task LoadInternationalAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var candidateId = CurrentUserHelper.GetCandidateId()!.Value;

        var prefs = await GetInternationalPreferences.ExecuteAsync(
            new GetInternationalPreferencesCommand(candidateId), authState.User);
        if (prefs.Status == EResultStatus.Success && prefs.Data is not null)
        {
            intlModel = new InternationalFormModel
            {
                CountriesInput = string.Join(", ", prefs.Data.InterestedCountries),
                Mobility = prefs.Data.Mobility,
                WorkAuthorizationStatus = prefs.Data.WorkAuthorizationStatus
            };
        }

        var langs = await GetCandidateLanguages.ExecuteAsync(
            new GetCandidateLanguagesCommand(candidateId), authState.User);
        if (langs.Status == EResultStatus.Success && langs.Data is not null)
            languages = langs.Data.Languages;
    }

    private async Task SaveInternationalAsync()
    {
        if (intlSaving)
            return;
        intlSaving = true;
        internationalError = string.Empty;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var candidateId = CurrentUserHelper.GetCandidateId()!.Value;
        var countries = intlModel.CountriesInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        var result = await UpsertInternationalPreferences.ExecuteAsync(
            new UpsertInternationalPreferencesCommand(candidateId, new InternationalPreferencesRequest
            {
                InterestedCountries = countries,
                Mobility = intlModel.Mobility,
                WorkAuthorizationStatus = intlModel.WorkAuthorizationStatus
            }), authState.User);

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess("Preferências internacionais salvas.", "Carreira internacional");
        }
        else
        {
            Logger.LogFailure(result, "Salvar preferências internacionais");
            internationalError = ResultMessages.ToUserMessage(result, "Não foi possível salvar. Revise os campos e tente novamente.");
        }

        intlSaving = false;
    }

    private void AddLanguage() => languages.Add(new CandidateLanguageItem());

    private async Task SaveLanguagesAsync()
    {
        if (intlSaving)
            return;
        intlSaving = true;
        internationalError = string.Empty;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var candidateId = CurrentUserHelper.GetCandidateId()!.Value;

        var result = await ReplaceCandidateLanguages.ExecuteAsync(
            new ReplaceCandidateLanguagesCommand(candidateId, new CandidateLanguagesRequest { Languages = languages }),
            authState.User);

        if (result.Status == EResultStatus.Success)
        {
            languages = result.Data!.Languages;
            Toast.ShowSuccess("Idiomas salvos.", "Carreira internacional");
        }
        else
        {
            Logger.LogFailure(result, "Salvar idiomas");
            internationalError = ResultMessages.ToUserMessage(result, "Não foi possível salvar os idiomas.");
        }

        intlSaving = false;
    }

    private async Task SaveAsync(EditContext form)
    {
        if (isSaving)
            return;

        isSaving = true;
        errorMessage = string.Empty;

        // Com a flag desligada o campo não apareceu na tela: envia nulo para preservar o valor salvo.
        if (!internationalJobsEnabled)
            model.PreferredCountries = null;

        var result = await UpsertCareerProfileUseCase.ExecuteAsync(
            new UpsertCareerProfileCommand(CurrentUserHelper.GetCandidateId()!.Value, model));

        if (result.Status == EResultStatus.Success)
        {
            Toast.ShowSuccess("Perfil salvo. Suas recomendações já consideram as novas informações.", "Perfil de carreira");
            // Salvo: sair da página não precisa mais de confirmação
            form.MarkAsUnmodified();
        }
        else
        {
            Logger.LogFailure(result, "Salvar perfil de carreira");
            // O alerta da página (role="alert") já anuncia: sem toast repetindo
            errorMessage = ResultMessages.ToUserMessage(result, "Não foi possível salvar o perfil. Revise os campos e tente novamente.");
        }

        isSaving = false;
    }

    private void OnCountriesChanged(ChangeEventArgs args)
    {
        model.PreferredCountries = args.Value switch
        {
            string single when !string.IsNullOrWhiteSpace(single) => [single],
            string[] multiple => [.. multiple],
            _ => null
        };
        editForm?.EditContext?.NotifyFieldChanged(
            editForm.EditContext.Field(nameof(model.PreferredCountries)));
    }

    private void BackToDashboard() => Navigation.NavigateTo("/painel");
}
