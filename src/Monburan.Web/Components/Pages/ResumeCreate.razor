@page "/resumes/new"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.Entities
@using Monburan.Core.Enums
@using Monburan.Core.Interfaces.Repositories.Base
@using Monburan.Core.Interfaces.Validations
@using Monburan.Core.UseCases.Resumes
@using Monburan.Core.ValueObjects
@using Monburan.Web.Services
@inject CreateResumeUseCase CreateResumeUseCase
@inject IBaseRepository<Candidate> CandidateRepository
@inject IEntityValidator<Resume> ResumeValidator
@inject ICurrentUserHelper CurrentUserHelper
@inject IToastService Toast
@inject ILogger<ResumeCreate> Logger

<PageTitle>Criar Currículo - Monburan</PageTitle>

<div class="container mt-4 page-form-shell resume-create-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Criar currículo</h1>
            <p>Comece com um resumo claro. Você pode completar as outras seções depois.</p>
        </div>
        <button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
    </header>
    <div class="row">
        <div class="col-lg-8 mx-auto">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }

            @if (!isCandidate)
            {
                <EmptyState Icon="!" Title="Área exclusiva para candidatos" Message="Entre com uma conta de candidato para criar currículos.">
                    <a class="btn btn-primary" href="/dashboard">Voltar ao início</a>
                </EmptyState>
            }
            else
            {
                <div class="card page-form-card">
                    <div class="card-body">
                        <EditForm Model="model" OnValidSubmit="SubmitForm">
                            <DataAnnotationsValidator />
                            <ServerValidationErrors @ref="serverErrors" />

                            <!-- Assistente -->
                            <div class="resume-assistant">
                                <div>
                                    <strong><i class="bi bi-stars"></i> Gerador de currículo</strong>
                                    <p>Preenche o rascunho com os dados do seu perfil. Você ajusta antes de salvar.</p>
                                </div>
                                <button type="button" class="btn btn-secondary" @onclick="GenerateDraftAsync" disabled="@isGenerating" data-testid="resume-generate">
                                    @(isGenerating ? "Gerando..." : "Gerar rascunho")
                                </button>
                            </div>

                            @if (validationHints.Count > 0)
                            {
                                <div class="alert alert-warning mt-3 mb-0">
                                    <strong><i class="bi bi-clipboard-check"></i> Validação</strong>
                                    <ul class="mb-0 mt-1">
                                        @foreach (var hint in validationHints)
                                        {
                                            <li>@hint</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <!-- Informações Básicas -->
                            <h5 class="mb-3"><i class="bi bi-info-circle"></i> Informações Básicas</h5>
                            
                            <div class="mb-3">
                                <label class="form-label" for="model.Title">Título do Currículo *</label>
                                <InputText class="form-control" @bind-Value="model.Title" id="model.Title"
                                    placeholder="Ex: Desenvolvedor Full Stack Pleno" />
                                <ValidationMessage class="text-danger" For="@(() => model.Title)" />
                                <div class="form-text">Um título claro ajuda os recrutadores a entenderem seu perfil</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="model.Summary">Resumo Profissional</label>
                                <InputTextArea class="form-control" @bind-Value="model.Summary" id="model.Summary" rows="4"
                                    placeholder="Escreva um breve resumo sobre sua experiência e objetivos profissionais..." />
                                <ValidationMessage class="text-danger" For="@(() => model.Summary)" />
                                <div class="form-text">Máximo 2000 caracteres</div>
                            </div>

                            <div class="mb-3 form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="model.IsActive" />
                                <label class="form-check-label" for="model.IsActive">
                                    <strong>Definir como currículo ativo</strong>
                                    <br />
                                    <small class="text-muted">Ele vem selecionado por padrão quando você se candidatar</small>
                                </label>
                            </div>

                            <hr class="my-4" />

                            <!-- Próximas Seções -->
                            <div class="alert alert-info">
                                <h5><i class="bi bi-info-circle"></i> Você poderá complementar depois</h5>
                                <p class="mb-2">Após criar o currículo básico, você poderá adicionar:</p>
                                <ul class="mb-0">
                                    <li><strong>Formação acadêmica</strong> — sua educação e cursos</li>
                                    <li><strong>Experiência profissional</strong> — trabalhos anteriores</li>
                                    <li><strong>Idiomas</strong> — línguas que você domina</li>
                                    <li><strong>Habilidades</strong> — suas competências técnicas</li>
                                </ul>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg" disabled="@isSubmitting" data-testid="resume-create-submit">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    <i class="bi bi-check-circle"></i> Criar Currículo
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private CreateResumeRequest model = new()
    {
        IsActive = true
    };
    private string errorMessage = string.Empty;
    private bool isCandidate;
    private ServerValidationErrors serverErrors = default!;
    private bool isSubmitting = false;
    private bool isGenerating = false;
    private List<string> validationHints = [];
    private Candidate? candidateProfile;

    protected override async Task OnInitializedAsync()
    {
        var candidateId = CurrentUserHelper.GetCandidateId();
        isCandidate = candidateId.HasValue;
        if (candidateId.HasValue)
        {
            model.CandidateId = candidateId.Value;
            var result = await CandidateRepository.GetByIdAsync(Id.Create(candidateId.Value));
            if (result.Status == EResultStatus.Success)
                candidateProfile = result.Data;
        }
    }

    private Task GenerateDraftAsync()
    {
        isGenerating = true;
        validationHints = [];

        var c = candidateProfile;
        var location = c?.Address is not null
            ? string.Join(" - ", new[] { c.Address.City, c.Address.State }.Where(s => !string.IsNullOrWhiteSpace(s)))
            : null;

        if (string.IsNullOrWhiteSpace(model.Title) && c is not null)
            model.Title = $"Currículo de {c.Name}";

        var lines = new List<string>();
        if (c is not null)
        {
            lines.Add(c.Name);
            lines.Add($"E-mail: {c.Email}");
            if (!string.IsNullOrWhiteSpace(c.Phone)) lines.Add($"Telefone: {c.Phone}");
            if (!string.IsNullOrWhiteSpace(location)) lines.Add($"Localização: {location}");
            if (!string.IsNullOrWhiteSpace(c.LinkedIn)) lines.Add($"LinkedIn: {c.LinkedIn}");
        }
        lines.Add("");
        lines.Add("Resumo profissional:");
        lines.Add("Profissional comprometido(a), em busca de novas oportunidades para aplicar minhas habilidades e crescer junto à empresa.");

        model.Summary = string.Join("\n", lines);

        ValidateDraft();
        isGenerating = false;
        return Task.CompletedTask;
    }

    private void ValidateDraft()
    {
        validationHints.Clear();
        var resume = new Resume
        {
            CandidateId = Id.Create(model.CandidateId),
            Title = model.Title,
            Summary = model.Summary,
            IsActive = model.IsActive,
            TenantId = "default"
        };

        var result = ResumeValidator.Validate(resume);
        if (!result.IsValid)
            validationHints.AddRange(result.Errors.Select(e => e.Message));

        if (string.IsNullOrWhiteSpace(model.Summary) || model.Summary.Length < 80)
            validationHints.Add("Dica: um resumo com pelo menos 80 caracteres aumenta suas chances.");
        if (candidateProfile is not null && string.IsNullOrWhiteSpace(candidateProfile.Phone))
            validationHints.Add("Dica: adicione um telefone no seu perfil para recrutadores entrarem em contato.");
    }

    private async Task SubmitForm()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = string.Empty;

        var result = await CreateResumeUseCase.ExecuteAsync(model);

        if (result.Status == EResultStatus.Success && result.Data is not null)
        {
            Toast.ShowSuccess("Agora complete experiências, formação e habilidades.", "Currículo criado");
            Navigation.NavigateTo($"/resumes/{result.Data.Id}");
            return;
        }

        Logger.LogFailure(result, "Criar currículo");
        var fieldErrors = ResultMessages.FieldErrors(result);
        var unmatched = serverErrors.Display(fieldErrors);
        errorMessage = fieldErrors.Count > 0 && unmatched.Count == 0
            ? "Revise os campos destacados no formulário."
            : ResultMessages.ToUserMessage(result, "Não foi possível criar o currículo. Tente novamente.");
        Toast.ShowError(errorMessage);

        isSubmitting = false;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/resumes");
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
}
