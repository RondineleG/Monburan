@page "/profile/advertiser"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdvertiserOnly")]
@inject Monburan.Core.UseCases.Advertisers.UpdateAdvertiserUseCase UpdateAdvertiserUseCase
@inject Monburan.Core.Interfaces.Repositories.Base.IBaseRepository<Monburan.Core.Entities.Advertiser> AdvertiserRepository
@inject Monburan.Web.Services.ICurrentUserHelper CurrentUserHelper
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject ILogger<AdvertiserProfile> Logger
@inject IToastService Toast

<PageTitle>Perfil da empresa - Monburan</PageTitle>

<div class="container mt-4 profile-layout advertiser-profile-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">ÁREA DA EMPRESA</span>
            <h1>Perfil da empresa</h1>
            <p>Apresente sua organização para atrair profissionais alinhados à oportunidade.</p>
        </div>
    </header>

    @if (_isLoading)
    {
        <LoadingState Message="Carregando o perfil da empresa..." />
    }
    else if (_loadFailed)
    {
        <ErrorState Title="Não foi possível carregar o perfil"
                    Message="Tivemos um problema ao buscar os dados da empresa. Tente novamente em instantes."
                    OnRetry="LoadAdvertiserAsync" />
    }
    else if (_advertiser != null)
    {
        <div class="settings-layout">
                <section class="settings-main" aria-labelledby="company-heading">
                    <h2 id="company-heading">Dados da empresa</h2>
                    <div>
                        <EditForm Model="_editModel" OnValidSubmit="HandleSaveAsync" Context="form">
                            <UnsavedChangesGuard HasChanges="() => form.IsModified() && !_isSaving" />
                            <p class="form-text">Campos com * são obrigatórios.</p>
                            <div class="form-grid">
                            <DataAnnotationsValidator />
                            <ServerValidationErrors @ref="_serverErrors" />

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="_editModel.Name">Nome da empresa *</label>
                                <InputText @bind-Value="_editModel.Name" class="form-control" id="_editModel.Name" autocomplete="organization" data-testid="advertiser-profile-name" />
                                <ValidationMessage For="@(() => _editModel.Name)" />
                            </div>

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="_editModel.Email">E-mail</label>
                                <InputText @bind-Value="_editModel.Email" type="email" class="form-control" id="_editModel.Email" disabled aria-describedby="advertiser-email-help" />
                                <small class="form-text" id="advertiser-email-help">Para trocar o e-mail de acesso, use <a href="/Account/Manage/Email">Conta e segurança</a>.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="_editModel.Phone">Telefone *</label>
                                <InputText @bind-Value="_editModel.Phone" type="tel" class="form-control" id="_editModel.Phone" autocomplete="tel" placeholder="(00) 00000-0000" />
                                <ValidationMessage For="@(() => _editModel.Phone)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="_editModel.TaxId">CPF/CNPJ *</label>
                                <InputText @bind-Value="_editModel.TaxId" class="form-control" id="_editModel.TaxId" autocomplete="off" />
                                <ValidationMessage For="@(() => _editModel.TaxId)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="_editModel.PersonType">Tipo de pessoa *</label>
                                <InputSelect @bind-Value="_editModel.PersonType" class="form-select" id="_editModel.PersonType">
                                    <option value="@Monburan.Core.Enums.EPersonType.Individual">Pessoa Física</option>
                                    <option value="@Monburan.Core.Enums.EPersonType.Company">Pessoa Jurídica</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _editModel.PersonType)" />
                            </div>

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="_editModel.CompanyDescription">Descrição da empresa</label>
                                <InputTextArea @bind-Value="_editModel.CompanyDescription" class="form-control" id="_editModel.CompanyDescription" rows="4" placeholder="Descreva sua empresa, cultura e benefícios..." />
                                <ValidationMessage class="text-danger" For="@(() => _editModel.CompanyDescription)" />
                            </div>

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="_editModel.Website">Site</label>
                                <InputText @bind-Value="_editModel.Website" type="url" autocomplete="url" inputmode="url" class="form-control" id="_editModel.Website" placeholder="https://www.suaempresa.com.br" />
                                <ValidationMessage class="text-danger" For="@(() => _editModel.Website)" />
                            </div>

                            <div class="mb-3 col-span-2">
                                <label class="form-label" for="_editModel.LogoUrl">Logo da empresa</label>
                                <InputText @bind-Value="_editModel.LogoUrl" type="url" inputmode="url" class="form-control" id="_editModel.LogoUrl" placeholder="https://www.suaempresa.com.br/logo.png" />
                                <ValidationMessage class="text-danger" For="@(() => _editModel.LogoUrl)" />
                                <div class="form-text">Cole o endereço de uma imagem ou <a href="/advertiser/upload-logo">envie um arquivo do seu computador</a>.</div>
                                @if (!string.IsNullOrEmpty(_editModel.LogoUrl))
                                {
                                    <div class="mt-2">
                                        <img src="@_editModel.LogoUrl" alt="Prévia do logo da empresa" class="img-thumbnail logo-preview" onerror="this.hidden=true" />
                                    </div>
                                }
                            </div>

                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                        <span>Salvando...</span>
                                    }
                                    else
                                    {
                                        <span>Salvar alterações</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Desfazer alterações</button>
                            </div>
                        </EditForm>
                    </div>
                </section>

            <aside class="settings-aside" aria-label="Informações da conta">
                <div class="settings-group">
                    <h3>Conta</h3>
                    <p class="small"><span class="badge @(GetStatusBadgeClass())">@UiLabels.AccountStatus(_advertiser.Status)</span></p>
                    <p class="small">Plano: <a class="badge bg-info" href="/my-subscription">@UiLabels.PlanName(_advertiser.ActivePlan)</a></p>
                    <p class="small">E-mail verificado:
                        @if (_advertiser.IsEmailVerified) { <span class="badge bg-success">Sim</span> }
                        else { <span class="badge bg-warning">Não</span> }
                    </p>
                    <p class="small text-muted">Desde @UiLabels.FormatMomentDate(_advertiser.CreatedAt)</p>
                </div>
                <div class="settings-group">
                    <h3>Atalhos</h3>
                    <a class="btn btn-outline-secondary btn-sm" href="/my-jobs">Minhas vagas</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/received-applications">Candidaturas recebidas</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/advertiser/upload-logo">Enviar logo</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/address/list">Endereço da empresa</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/Account/Manage">Senha e segurança</a>
                </div>
            </aside>
        </div>
    }
    else
    {
        <EmptyState Icon="!" Title="Perfil de empresa não encontrado" Message="Esta área é exclusiva para contas de empresa.">
            <a class="btn btn-primary" href="/dashboard">Voltar ao início</a>
        </EmptyState>
    }
</div>

@code {
    private Monburan.Core.Entities.Advertiser? _advertiser;
    private EditModel _editModel = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _loadFailed;
    private ServerValidationErrors _serverErrors = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAdvertiserAsync();
    }

    private async Task LoadAdvertiserAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        try
        {
            var advertiserId = CurrentUserHelper.GetAdvertiserId();
            if (advertiserId.HasValue)
            {
                var result = await AdvertiserRepository.GetByIdAsync(Monburan.Core.ValueObjects.Id.Create(advertiserId.Value));
                if (result.Status is not (Monburan.Core.Enums.EResultStatus.Success or Monburan.Core.Enums.EResultStatus.EntityNotFound))
                {
                    Logger.LogFailure(result, "Carregar perfil do anunciante");
                    _loadFailed = true;
                }
                else if (result.Status == Monburan.Core.Enums.EResultStatus.Success && result.Data != null)
                {
                    _advertiser = result.Data;
                    _editModel = new EditModel
                    {
                        Id = _advertiser.Id.Value,
                        Name = _advertiser.Name,
                        Email = _advertiser.Email,
                        Phone = _advertiser.Phone ?? string.Empty,
                        TaxId = _advertiser.TaxId ?? string.Empty,
                        PersonType = _advertiser.PersonType,
                        CompanyDescription = _advertiser.CompanyDescription,
                        Website = _advertiser.Website,
                        LogoUrl = _advertiser.LogoUrl
                    };
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        if (_isSaving)
            return;

        _isSaving = true;

        try
        {
            var request = new Monburan.Core.DTOs.Request.UpdateAdvertiserRequest
            {
                Id = _editModel.Id,
                Name = _editModel.Name,
                Phone = _editModel.Phone,
                TaxId = _editModel.TaxId,
                PersonType = _editModel.PersonType,
                CompanyDescription = _editModel.CompanyDescription,
                Website = _editModel.Website,
                LogoUrl = _editModel.LogoUrl,
                AddressId = _editModel.AddressId
            };

            var result = await UpdateAdvertiserUseCase.ExecuteAsync(request);

            if (result.Status == Monburan.Core.Enums.EResultStatus.Success)
            {
                Toast.ShowSuccess("Os dados da empresa foram atualizados.", "Perfil salvo");
                await LoadAdvertiserAsync();
            }
            else
            {
                Logger.LogFailure(result, "Atualizar perfil do anunciante");
                var fieldErrors = ResultMessages.FieldErrors(result);
                var unmatched = _serverErrors.Display(fieldErrors);
                Toast.ShowError(fieldErrors.Count > 0 && unmatched.Count == 0
                    ? "Revise os campos destacados no formulário."
                    : ResultMessages.ToUserMessage(result, "Não foi possível salvar o perfil. Tente novamente."));
            }
        }
        catch (Exception ex)
        {
            // Exceção nunca vai crua para a tela (pode conter SQL/caminhos internos)
            Logger.LogError(ex, "Erro ao salvar o perfil do anunciante");
            Toast.ShowError(ResultMessages.GenericError);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CancelEdit()
    {
        if (_advertiser != null)
        {
            _editModel = new EditModel
            {
                Id = _advertiser.Id.Value,
                Name = _advertiser.Name,
                Email = _advertiser.Email,
                Phone = _advertiser.Phone ?? string.Empty,
                TaxId = _advertiser.TaxId ?? string.Empty,
                PersonType = _advertiser.PersonType,
                CompanyDescription = _advertiser.CompanyDescription,
                Website = _advertiser.Website,
                LogoUrl = _advertiser.LogoUrl
            };
            _serverErrors.Clear();
        }
    }

    private string GetStatusBadgeClass()
    {
        return _advertiser?.Status switch
        {
            Monburan.Core.Enums.EAdvertiserStatus.Active => "bg-success",
            Monburan.Core.Enums.EAdvertiserStatus.Incomplete => "bg-warning",
            Monburan.Core.Enums.EAdvertiserStatus.Blocked => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private void NavigateToJobs()
    {
        Navigation.NavigateTo("/my-jobs");
    }

    private void NavigateToApplications()
    {
        Navigation.NavigateTo("/received-applications");
    }

    private class EditModel
    {
        public Guid Id { get; set; }
        [Required(ErrorMessage = "Informe o nome da empresa.")]
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe um telefone de contato.")]
        public string Phone { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o CPF ou CNPJ.")]
        public string TaxId { get; set; } = string.Empty;
        public Monburan.Core.Enums.EPersonType PersonType { get; set; }
        public string? CompanyDescription { get; set; }
        public string? Website { get; set; }
        public string? LogoUrl { get; set; }
        public Guid? AddressId { get; set; }
    }
}
