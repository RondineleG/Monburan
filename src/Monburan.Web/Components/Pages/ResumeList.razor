@page "/resumes"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CandidateOnly")]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Entities
@using Monburan.Core.Interfaces.Repositories.Base
@using Monburan.Core.UseCases.Resumes
@using Monburan.Core.ValueObjects
@using Monburan.Web.Services
@inject ListResumesByCandidateUseCase ListResumesByCandidateUseCase
@inject ICurrentUserHelper CurrentUserHelper
@inject ILogger<ResumeList> Logger

<PageTitle>Meus currículos - Monburan</PageTitle>

<div class="container mt-4 resumes-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Meus currículos</h1>
            <p>Mantenha seu perfil profissional atualizado para cada oportunidade.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" href="/resumes/upload"><Icon Name="upload" Size="16" /> Importar PDF</a>
            <a class="btn btn-primary" href="/resumes/wizard"><Icon Name="plus" Size="16" /> Novo currículo</a>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="skeleton-stack" role="status" aria-live="polite" data-testid="loading-state">
            <span class="visually-hidden">Carregando currículos...</span>
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (loadFailed)
    {
        <ErrorState Title="Não foi possível carregar seus currículos"
                    Message="Tivemos um problema ao buscar seus currículos. Tente novamente em instantes."
                    OnRetry="LoadAsync" />
    }
    else if (resumes?.Any() == true)
    {
        <div class="resume-list" data-testid="resume-list">
            @foreach (var resume in resumes)
            {
                <article class="resume-row">
                    <span class="resume-row__icon" aria-hidden="true"><Icon Name="file" Size="20" /></span>
                    <div class="resume-row__body">
                        <h2 class="resume-row__title"><a href="@($"/resumes/{resume.Id}")">@resume.Title</a>
                            <span class="badge @(resume.IsActive ? "bg-success" : "bg-secondary")">@(resume.IsActive ? "Ativo" : "Inativo")</span>
                        </h2>
                        @if (!string.IsNullOrEmpty(resume.Summary))
                        {
                            <p class="resume-row__summary">@resume.Summary</p>
                        }
                        <p class="resume-row__meta">
                            @CountLabel(resume.ExperienceHistory?.Count ?? 0, "experiência", "experiências") · @CountLabel(resume.EducationHistory?.Count ?? 0, "formação", "formações") · @CountLabel(resume.Skills?.Count ?? 0, "habilidade", "habilidades")
                            · atualizado @UiLabels.FormatMomentDate(resume.UpdatedAt ?? resume.CreatedAt)
                        </p>
                    </div>
                    <div class="resume-row__actions">
                        @* Nome acessível com o título: vários "Editar" iguais na lista não dizem qual currículo *@
                        <a class="btn btn-primary btn-sm" href="/resumes/@resume.Id/edit" aria-label="@($"Editar o currículo {resume.Title}")">Editar</a>
                        <a class="btn btn-outline-secondary btn-sm" href="/resumes/@resume.Id/cv" aria-label="@($"Ver CV do currículo {resume.Title}")">Ver CV</a>
                        <a class="btn btn-outline-secondary btn-sm" href="/resumes/@resume.Id?melhorar=true" aria-label="@($"Melhorar o currículo {resume.Title}")">Melhorar</a>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <EmptyState Icon="▤"
                    Title="Nenhum currículo criado"
                    Message="Crie seu primeiro currículo para se candidatar às vagas com mais chances."
                    TestId="resumes-empty">
            <a class="btn btn-primary" href="/resumes/wizard">Criar meu primeiro currículo</a>
        </EmptyState>
    }
</div>

@code {
    private List<ResumeResponse>? resumes;
    private bool isLoading = true;
    private bool loadFailed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        var candidateId = CurrentUserHelper.GetCandidateId();
        if (!candidateId.HasValue)
        {
            resumes = [];
            isLoading = false;
            return;
        }

        var result = await ListResumesByCandidateUseCase.ExecuteAsync(candidateId.Value);
        if (result.Status != EResultStatus.Success)
        {
            Logger.LogFailure(result, "Listar currículos");
            loadFailed = true;
            isLoading = false;
            return;
        }

        resumes = result.Data?.ToList();

        // Sem currículo criado em leitura: criar/importar é sempre ação explícita da pessoa
        isLoading = false;
    }

    private static string CountLabel(int count, string singular, string plural) =>
        $"{count} {(count == 1 ? singular : plural)}";
}
