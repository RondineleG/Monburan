@page "/resumes"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Monburan.Core.DTOs.Request
@using Monburan.Core.DTOs.Response
@using Monburan.Core.Entities
@using Monburan.Core.Interfaces.Repositories.Base
@using Monburan.Core.UseCases.Resumes
@using Monburan.Core.ValueObjects
@using Monburan.Web.Services
@inject ListResumesByCandidateUseCase ListResumesByCandidateUseCase
@inject CreateResumeUseCase CreateResumeUseCase
@inject IBaseRepository<Candidate> CandidateRepository
@inject ICurrentUserHelper CurrentUserHelper

<PageTitle>Meus Currículos - Monburan</PageTitle>

<div class="container mt-4 resumes-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Meus currículos</h1>
            <p>Mantenha seu perfil profissional atualizado para cada oportunidade.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" href="/resumes/upload"><i class="bi bi-upload"></i> Importar PDF</a>
            <button class="btn btn-primary" @onclick="CreateResume">Novo currículo <span aria-hidden="true">↗</span></button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (baseResumeGenerated)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-stars"></i> Criamos um <strong>currículo base</strong> com os dados do seu perfil. Complete-o com experiências e habilidades para se destacar.
            <button type="button" class="btn-close" @onclick="() => baseResumeGenerated = false"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Carregando currículos...</p>
        </div>
    }
    else if (resumes?.Any() == true)
    {
        <div class="row g-3">
            @foreach (var resume in resumes)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 @(resume.IsActive ? "border-success" : "")">
                        <div class="card-body">
                            @if (resume.IsActive)
                            {
                                <span class="badge bg-success mb-2">Ativo</span>
                            }
                            <h5 class="card-title">@resume.Title</h5>
                            @if (!string.IsNullOrEmpty(resume.Summary))
                            {
                                <p class="card-text text-muted small">
                                    @(resume.Summary.Length > 100 ? resume.Summary.Substring(0, 100) + "..." : resume.Summary)
                                </p>
                            }
                            <p class="card-text small text-muted">
                                <i class="bi bi-calendar"></i> Criado em: @resume.CreatedAt.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => ViewResume(resume.Id)">
                                <i class="bi bi-eye"></i> Ver Currículo
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <i class="bi bi-file-earmark-text display-1 text-muted"></i>
            <h3 class="mt-3">Nenhum currículo criado</h3>
            <p class="text-muted">Crie seu primeiro currículo para se candidatar às vagas!</p>
            <button class="btn btn-primary btn-lg" @onclick="CreateResume">
                <i class="bi bi-plus-circle"></i> Criar Meu Primeiro Currículo
            </button>
        </div>
    }
</div>

@code {
    private List<ResumeResponse>? resumes;
    private bool isLoading = true;
    private string? errorMessage;
    private bool baseResumeGenerated;

    protected override async Task OnInitializedAsync()
    {
        errorMessage = null;

        var candidateId = CurrentUserHelper.GetCandidateId();
        if (!candidateId.HasValue)
        {
            errorMessage = "Usuário não autenticado como candidato.";
            isLoading = false;
            return;
        }

        var result = await ListResumesByCandidateUseCase.ExecuteAsync(candidateId.Value);
        if (result.Status != EResultStatus.Success)
        {
            errorMessage = result.Message;
            isLoading = false;
            return;
        }

        resumes = result.Data?.ToList();

        if (resumes is null || resumes.Count == 0)
        {
            await GenerateBaseResumeAsync(candidateId.Value);
        }

        isLoading = false;
    }

    private async Task GenerateBaseResumeAsync(Guid candidateId)
    {
        var candidateResult = await CandidateRepository.GetByIdAsync(Id.Create(candidateId));
        if (candidateResult.Status != EResultStatus.Success || candidateResult.Data is null)
            return;

        var c = candidateResult.Data;
        var location = c.Address is not null
            ? string.Join(" - ", new[] { c.Address.City, c.Address.State }.Where(s => !string.IsNullOrWhiteSpace(s)))
            : null;

        var summaryParts = new List<string>
        {
            $"{c.Name}",
            $"E-mail: {c.Email}"
        };
        if (!string.IsNullOrWhiteSpace(c.Phone)) summaryParts.Add($"Telefone: {c.Phone}");
        if (!string.IsNullOrWhiteSpace(location)) summaryParts.Add($"Localização: {location}");
        if (!string.IsNullOrWhiteSpace(c.LinkedIn)) summaryParts.Add($"LinkedIn: {c.LinkedIn}");

        var createResult = await CreateResumeUseCase.ExecuteAsync(new CreateResumeRequest
        {
            CandidateId = candidateId,
            Title = $"Currículo de {c.Name}",
            Summary = string.Join("\n", summaryParts) + "\n\nResumo profissional:\n(Descreva aqui seus objetivos e principais qualificações)",
            IsActive = true
        });

        if (createResult.Status == EResultStatus.Success)
        {
            baseResumeGenerated = true;
            var reload = await ListResumesByCandidateUseCase.ExecuteAsync(candidateId);
            if (reload.Status == EResultStatus.Success)
                resumes = reload.Data?.ToList();
        }
    }

    private void CreateResume()
    {
        Navigation.NavigateTo("/resumes/new");
    }

    private void ViewResume(Guid resumeId)
    {
        Navigation.NavigateTo($"/resumes/{resumeId}");
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
}
