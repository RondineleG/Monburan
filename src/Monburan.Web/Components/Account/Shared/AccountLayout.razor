@inherits LayoutComponentBase
@layout Monburan.Web.Components.Layout.MainLayout
@inject NavigationManager NavigationManager

@if (IsManagePage)
{
    @* Gerenciamento de conta roda dentro do app shell (MainLayout já fornece o <main>) *@
    <section class="container account-settings-page">
        @if (HttpContext is null)
        {
            <LoadingState Message="Carregando…" Compact="true" />
        }
        else
        {
            @Body
        }
    </section>
}
else
{
<div class="auth-layout">
    <aside class="auth-hero">
        <div class="auth-hero__grid" aria-hidden="true"></div>
        <div class="auth-hero__content">
            <span class="auth-hero__eyebrow">Monburan · vagas de emprego</span>
            @* Frase de marca, não título: o h1 da página é o do formulário ao lado *@
            <p class="auth-hero__title">O trabalho certo muda tudo.</p>
            <p>Uma forma mais humana de encontrar oportunidades, contratar melhor e construir o próximo capítulo.</p>
            <div class="auth-hero__proof">
                <div>
                    <span class="auth-hero__proof-icon" aria-hidden="true"><Icon Name="check" Size="16" /></span>
                    <span>Perfil em um só lugar</span>
                </div>
                <div>
                    <span class="auth-hero__proof-icon" aria-hidden="true"><Icon Name="search" Size="16" /></span>
                    <span>Busca sem complicação</span>
                </div>
            </div>
        </div>
        <div class="auth-hero__foot">
            <span class="auth-hero__dot" aria-hidden="true"></span>
            <span>Ambiente seguro e gratuito para começar</span>
        </div>
    </aside>
    <section class="auth-content" data-testid="auth-content">
        @if (HttpContext is null)
        {
            <LoadingState Message="Carregando…" Compact="true" />
        }
        else
        {
            @Body
        }
    </section>
</div>
}

@code {
    private bool IsManagePage => NavigationManager.Uri.Contains("/conta", StringComparison.OrdinalIgnoreCase);

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            // If this code runs, we're currently rendering in interactive mode, so there is no HttpContext.
            // The identity pages need to set cookies, so they require an HttpContext. To achieve this we
            // must transition back from interactive mode to a server-rendered page.
            NavigationManager.Refresh(forceReload: true);
        }
    }
}