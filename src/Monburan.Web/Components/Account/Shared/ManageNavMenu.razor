@using Microsoft.AspNetCore.Identity
@using Monburan.Web.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

<nav aria-label="Seções de conta e segurança">
<ul class="nav">
    <li class="nav-item">
        <NavLink class="nav-link" href="/conta" Match="NavLinkMatch.All" aria-current="@Current("/conta", exact: true)">Perfil</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="/conta/email" aria-current="@Current("/conta/email")">E-mail</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="/conta/alterar-senha" aria-current="@Current("/conta/alterar-senha")">Senha</NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <NavLink class="nav-link" href="/conta/logins-externos" aria-current="@Current("/conta/logins-externos")">Contas conectadas</NavLink>
        </li>
    }
    <li class="nav-item">
        <NavLink class="nav-link" href="/conta/seguranca-2fa" aria-current="@Current("/conta/seguranca-2fa")">Verificação em duas etapas</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="/conta/dados-pessoais" aria-current="@Current("/conta/dados-pessoais")">Dados pessoais</NavLink>
    </li>
</ul>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }

    // Mesmo critério de correspondência do NavLink (classe "active"), exposto para leitores de tela.
    private string? Current(string href, bool exact = false)
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var cut = path.IndexOfAny(['?', '#']);
        if (cut >= 0)
            path = path[..cut];
        path = path.TrimEnd('/');

        var matches = exact
            ? string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
            : string.Equals(path, href, StringComparison.OrdinalIgnoreCase)
              || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
        return matches ? "page" : null;
    }
}
