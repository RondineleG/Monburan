@* Só é exibido depois de gerar os códigos: a mensagem é sempre de sucesso *@
<StatusMessage Message="@StatusMessage" IsError="false" />
<h2>Códigos de recuperação</h2>
<div class="alert alert-warning">
    <p>
        <strong>Guarde estes códigos em um lugar seguro.</strong>
    </p>
    <p>
        Se você perder o dispositivo e não tiver os códigos de recuperação, perderá o acesso à conta.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}