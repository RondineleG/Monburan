@page "/confirmar-email"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Monburan.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject AccountProfileService AccountProfiles

<PageTitle>Confirmar e-mail - Monburan</PageTitle>

<section class="auth-message-page">
    <h1>Confirmação de e-mail</h1>
    <StatusMessage Message="@statusMessage" IsError="@isError" />
    @* Sem estas ações a página era um beco sem saída depois de clicar no link do e-mail *@
    <div class="form-actions">
        <a class="btn btn-primary" href="/entrar">Entrar</a>
        <a class="btn btn-outline-secondary" href="./">Ir para o início</a>
    </div>
</section>

@code {
    private string? statusMessage;
    private bool isError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            // Sem StatusCode 404: a reexecução de páginas de status quebrava a resposta (erro 500)
            statusMessage = "Erro: não foi possível localizar a conta associada a este link.";
            isError = true;
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            if (result.Succeeded && !string.IsNullOrWhiteSpace(user.Email))
            {
                // O selo "e-mail verificado" do perfil (site e app) lê o flag do perfil
                await AccountProfiles.MarkEmailVerifiedAsync(user.Email);
            }

            isError = !result.Succeeded;
            statusMessage = result.Succeeded ? "E-mail confirmado com sucesso." : "Erro: não foi possível confirmar o e-mail.";
        }
    }
}