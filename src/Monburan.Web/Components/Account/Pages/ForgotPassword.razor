@page "/esqueci-senha"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Monburan.Web.Models
@using Monburan.Core.UseCases.Notifications
@using Monburan.Core.Enums

@inject UserManager<ApplicationUser> UserManager
@inject PasswordResetUseCase PasswordResetUseCase
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Recuperar senha - Monburan</PageTitle>

<div class="auth-form-page">
    <header class="auth-form-heading">
        <h1>Recupere sua senha</h1>
        <p>Enviaremos um link para o endereço de e-mail associado à sua conta.</p>
    </header>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <section class="auth-form-card">
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText id="email" @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder=" " />
                <label for="email" class="form-label">E-mail</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary" disabled="@isSubmitting" aria-busy="@(isSubmitting ? "true" : null)">
                @(isSubmitting ? "Enviando…" : "Enviar link de recuperação")
            </button>
        </EditForm>
    </section>
    <a class="auth-back-link" href="/entrar">Voltar ao login</a>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    private InputModel? _input;

    private string? successMessage;
    private string? errorMessage;
    private bool isSubmitting;

    private async Task OnValidSubmitAsync()
    {
        isSubmitting = true;
        successMessage = null;
        errorMessage = null;

        var user = await UserManager.FindByEmailAsync(Input.Email);

        // Não revela se a conta existe: a resposta é a mesma. O e-mail confirmado não é exigido porque o cadastro também não
        // exige (RequireConfirmedAccount = false): quem nunca clicou no link de confirmação ficaria sem como recuperar a senha,
        // vendo a mensagem de enviado sem receber nada. A API já envia nesse caso
        if (user is null)
        {
            RedirectManager.RedirectTo("/esqueci-senha/enviado");
            return;
        }

        // Gerar token de reset de senha
        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("/redefinir-senha").AbsoluteUri,
            new Dictionary<string, object?> { ["code"] = code, ["email"] = Input.Email });

        // Um e-mail só, com o modelo do Monburan (o mesmo da API). Antes ia também o e-mail simples do Identity, com o mesmo link
        var passwordResetRequest = new PasswordResetRequest
        {
            Email = Input.Email,
            ResetLink = callbackUrl
        };

        var emailResult = await PasswordResetUseCase.ExecuteAsync(passwordResetRequest);
        if (emailResult.Status == EResultStatus.Success && emailResult.Data)
        {
            Logger.LogInformation("E-mail de recuperação de senha enviado para a conta {UserId}", user.Id);
        }
        else if (emailResult.Status == EResultStatus.Success)
        {
            Logger.LogWarning("E-mail de recuperação não entregue para a conta {UserId}: provedor indisponível ou não configurado", user.Id);
        }
        else
        {
            Logger.LogWarning("Falha ao enviar email de recuperação via UseCase: {Message}", emailResult.Message);
        }

        RedirectManager.RedirectTo("/esqueci-senha/enviado");
        isSubmitting = false;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        [Display(Name = "E-mail")]
        public string Email { get; set; } = "";
    }
}