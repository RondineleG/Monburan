@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Monburan.Web.Models
@using Monburan.Core.UseCases.Notifications
@using Monburan.Core.Enums

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject PasswordResetUseCase PasswordResetUseCase
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Recuperar senha - Monburan</PageTitle>

<div class="auth-form-page">
    <header class="auth-form-heading">
        <span class="auth-kicker">RECUPERAÇÃO DE ACESSO</span>
        <h1>Recupere sua senha</h1>
        <p>Enviaremos um link para o endereço de e-mail associado à sua conta.</p>
    </header>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <section class="auth-form-card">
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText id="email" @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder=" " />
                <label for="email" class="form-label">E-mail</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary" disabled="@isSubmitting">
                @(isSubmitting ? "Enviando..." : "Enviar link de recuperação")
            </button>
        </EditForm>
    </section>
    <a class="auth-back-link" href="Account/Login">Voltar ao login</a>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    private InputModel? _input;

    private string? successMessage;
    private string? errorMessage;
    private bool isSubmitting;

    private async Task OnValidSubmitAsync()
    {
        isSubmitting = true;
        successMessage = null;
        errorMessage = null;

        var user = await UserManager.FindByEmailAsync(Input.Email);
        
        // Don't reveal that the user does not exist or is not confirmed
        if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
        {
            // Ainda assim, enviamos o email se o usuário existir e estiver confirmado
            // Para segurança, sempre mostramos mensagem de sucesso
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        // Gerar token de reset de senha
        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
            new Dictionary<string, object?> { ["code"] = code, ["email"] = Input.Email });

        // Enviar email via IEmailSender (padrão Identity)
        await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        // Enviar email via PasswordResetUseCase (template rico)
        var passwordResetRequest = new PasswordResetRequest
        {
            Email = Input.Email,
            ResetLink = callbackUrl
        };

        var emailResult = await PasswordResetUseCase.ExecuteAsync(passwordResetRequest);
        if (emailResult.Status == EResultStatus.Success && emailResult.Data)
        {
            Logger.LogInformation("Email de recuperação de senha enviado para {Email}", Input.Email);
        }
        else if (emailResult.Status == EResultStatus.Success)
        {
            Logger.LogWarning("Email de recuperação não entregue para {Email}: provedor indisponível ou não configurado", Input.Email);
        }
        else
        {
            Logger.LogWarning("Falha ao enviar email de recuperação via UseCase: {Message}", emailResult.Message);
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
        isSubmitting = false;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        [Display(Name = "E-mail")]
        public string Email { get; set; } = "";
    }
}