@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using Monburan.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger

<PageTitle>Desativar verificação em duas etapas - Monburan</PageTitle>

<h2>Desativar verificação em duas etapas</h2>
<StatusMessage />

<div class="alert alert-warning">
    <p>
        <strong>Esta ação apenas desativa a verificação em duas etapas.</strong>
    </p>
    <p>
        A chave cadastrada no aplicativo autenticador continua a mesma. Para trocá-la,
        <a href="Account/Manage/ResetAuthenticator">redefina a chave do autenticador</a>.
    </p>
</div>

<div>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="btn btn-danger" type="submit">Desativar verificação em duas etapas</button>
    </form>
</div>

@code {
    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            // Acesso direto pela URL sem 2FA ativa: volta para a tela de 2FA em vez de dar erro 500
            RedirectManager.RedirectToWithStatus(
                "Account/Manage/TwoFactorAuthentication",
                "A verificação em duas etapas já está desativada.",
                HttpContext);
        }
    }

    private async Task OnSubmitAsync()
    {
        var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            Logger.LogError("Falha ao desativar a 2FA: {Errors}", string.Join(", ", disable2faResult.Errors.Select(e => e.Code)));
            RedirectManager.RedirectToWithStatus(
                "Account/Manage/TwoFactorAuthentication",
                "Erro: não foi possível desativar a verificação em duas etapas. Tente novamente.",
                HttpContext);
        }

        await SignInManager.RefreshSignInAsync(user); // a sessão deixa de trazer a claim de 2FA
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            "Verificação em duas etapas desativada. Você pode reativá-la configurando um aplicativo autenticador.",
            HttpContext);
    }
}