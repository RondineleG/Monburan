@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Dados pessoais - Monburan</PageTitle>

<h2>Dados pessoais</h2>
<StatusMessage />

<div class="row">
    <div class="col-md-6">
        <p>Sua conta contém dados pessoais que você nos informou. Aqui você pode baixar uma cópia desses dados ou excluí-los.</p>
        <p>
            <strong>Excluir os dados remove sua conta de forma permanente — não é possível desfazer.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post" class="mb-3">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Baixar meus dados</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-outline-danger">Excluir minha conta</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}