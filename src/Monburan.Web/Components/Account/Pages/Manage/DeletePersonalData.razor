@page "/conta/excluir-dados"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Monburan.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject AccountProfileService AccountProfiles
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Excluir conta - Monburan</PageTitle>

<h2>Excluir conta e dados pessoais</h2>

@* Nesta página a mensagem local só aparece em falha: o sucesso redireciona para o login *@
<StatusMessage Message="@message" IsError="true" />

<div class="alert alert-warning">
    <p>
        <strong>Esta ação é permanente.</strong> Sua conta será removida e seus dados pessoais
        (nome, e-mail, telefone, currículos) serão apagados. Não será possível recuperá-los.
    </p>
</div>

<div>
    <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />
        @if (requirePassword)
        {
            <div class="mb-3">
                <label for="password" class="form-label">Confirme sua senha</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
        }
        <button class="w-100 btn btn-lg btn-outline-danger" type="submit">Excluir minha conta</button>
    </EditForm>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    private InputModel? _input;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (requirePassword)
        {
            // lockoutOnFailure: a senha errada conta como tentativa e bloqueia a conta pelas regras do Identity
            // (5 erros, 15 minutos); CheckPasswordAsync não contava nada
            var check = await SignInManager.CheckPasswordSignInAsync(user, Input.Password, lockoutOnFailure: true);
            if (check.IsLockedOut)
            {
                message = "Erro: muitas tentativas com senha incorreta. Tente de novo em alguns minutos.";
                return;
            }

            if (!check.Succeeded)
            {
                message = "Erro: senha incorreta.";
                return;
            }
        }

        var email = user.Email;
        var userId = await UserManager.GetUserIdAsync(user);

        // Perfil de candidato/anunciante guarda os dados pessoais exibidos no site. A anonimização vem ANTES de apagar o
        // usuário: na ordem inversa, uma falha deixava nome, telefone e currículos no banco sem dono (LGPD). Agora, se ela
        // falhar, nada foi apagado e a pessoa pode tentar de novo.
        if (!string.IsNullOrWhiteSpace(email))
        {
            try
            {
                await AccountProfiles.AnonymizeProfilesAsync(email);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Falha ao anonimizar o perfil da conta {UserId}; a exclusão foi interrompida", userId);
                message = "Erro: não foi possível excluir sua conta agora. Tente novamente em instantes.";
                return;
            }
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            Logger.LogError("Falha ao excluir a conta {UserId}: {Errors}", userId,
                string.Join("; ", result.Errors.Select(e => e.Code)));
            message = "Erro: não foi possível excluir sua conta agora. Tente novamente em instantes.";
            return;
        }

        await SignInManager.SignOutAsync();
        Logger.LogInformation("Usuário {UserId} excluiu a própria conta.", userId);

        RedirectManager.RedirectToWithStatus("/entrar", "Sua conta e seus dados pessoais foram excluídos.", HttpContext);
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}