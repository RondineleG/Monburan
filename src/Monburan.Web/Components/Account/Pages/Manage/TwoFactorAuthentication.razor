@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using Monburan.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verificação em duas etapas - Monburan</PageTitle>

<h2>Verificação em duas etapas</h2>
<StatusMessage />
@if (AdminRequired && !is2faEnabled)
{
    <div class="alert alert-warning" role="alert" data-testid="admin-2fa-required">
        <strong>Para usar as áreas de administração, ative a verificação em duas etapas.</strong>
        <p class="mb-0">Contas de administrador têm acesso a dados de todos os usuários. Configure um aplicativo autenticador abaixo
            (Google Authenticator, Microsoft Authenticator, Authy...), guarde os códigos de recuperação e depois volte à administração.</p>
    </div>
}
@if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>Você não tem mais códigos de recuperação.</strong>
                <p>Você precisa <a href="Account/Manage/GenerateRecoveryCodes">gerar novos códigos de recuperação</a> antes de entrar com um código de recuperação.</p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>Resta apenas 1 código de recuperação.</strong>
                <p>Você pode <a href="Account/Manage/GenerateRecoveryCodes">gerar novos códigos de recuperação</a>.</p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>Restam @recoveryCodesLeft códigos de recuperação.</strong>
                <p>Recomendamos <a href="Account/Manage/GenerateRecoveryCodes">gerar novos códigos de recuperação</a>.</p>
            </div>
        }

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">Esquecer este navegador</button>
            </form>
        }

        <a href="Account/Manage/Disable2fa" class="btn btn-primary">Desativar verificação em duas etapas</a>
        <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-primary">Gerar novos códigos de recuperação</a>
    }

    <h3>Aplicativo autenticador</h3>
    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">Adicionar aplicativo autenticador</a>
    }
    else
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">Configurar aplicativo autenticador</a>
        <a href="Account/Manage/ResetAuthenticator" class="btn btn-primary">Redefinir aplicativo autenticador</a>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>A política de privacidade e cookies não foi aceita.</strong>
        <p>Aceite a política para habilitar a verificação em duas etapas.</p>
    </div>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private bool AdminRequired { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Este navegador foi esquecido. No próximo login por ele, o código de verificação será solicitado.",
            HttpContext);
    }
}