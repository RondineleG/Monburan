@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

@* Primeiro elemento da página: quem navega por teclado pula a navegação e vai direto ao conteúdo. *@
<a class="skip-link" href="#main">Pular para o conteúdo</a>

@if (IsAccountPage)
{
    <header class="auth-header">
        <Brand />
        <a class="header-backlink" href="/"><Icon Name="arrow-left" Size="16" />Voltar ao início</a>
    </header>
    <main id="main" class="app-main app-main--auth">
        @Body
    </main>
}
else
{
    <div class="app-shell@(isAuthenticated ? string.Empty : " app-shell--public")" data-testid="app-shell" data-blazor-ready="false">
        @if (isAuthenticated)
        {
        <aside id="app-sidebar" class="app-sidebar" aria-label="Menu" data-testid="app-sidebar">
            <div class="app-sidebar__top">
                <Brand />
                @* aria-expanded acompanha o estado real (app-shell.js reaplica depois do primeiro paint) *@
                <button class="sidebar-pin" type="button" data-action="sidebar-pin" aria-expanded="true" aria-controls="app-sidebar" title="Recolher ou expandir o menu" aria-label="Recolher ou expandir o menu">
                    <Icon Name="chevron-left" Size="16" />
                </button>
                <button class="sidebar-close" type="button" aria-label="Fechar menu"><Icon Name="x" Size="20" /></button>
            </div>

            <nav class="sidebar-nav" aria-label="Navegação principal">
                @if (IsAdvertiser)
                {
                    <span class="sidebar-nav__label">Recrutamento</span>
                    <NavLink class="@HomeLinkClass" href="/" Match="NavLinkMatch.All" data-testid="nav-dashboard" data-label="Visão geral">
                        <span class="sidebar-link__icon"><Icon Name="home" /></span><span>Visão geral</span>
                    </NavLink>
                    <NavLink class="@SectionClass(IsRecruitJobsPath)" href="/minhas-vagas" data-testid="nav-my-jobs" data-label="Minhas vagas">
                        <span class="sidebar-link__icon"><Icon Name="briefcase" /></span><span>Minhas vagas</span>
                    </NavLink>
                    <NavLink class="@SectionClass(IsReceivedPath)" href="/candidaturas-recebidas" data-testid="nav-received-applications" data-label="Candidaturas recebidas">
                        <span class="sidebar-link__icon"><Icon Name="users" /></span><span>Candidaturas recebidas</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/notifications" data-testid="nav-notifications" data-label="Notificações">
                        <span class="sidebar-link__icon"><Icon Name="bell" /></span><span>Notificações</span>
                    </NavLink>
                    <span class="sidebar-nav__label sidebar-nav__label--spaced">Descobrir</span>
                    <NavLink class="@SectionClass(IsPublicJobsPath)" href="/jobs" data-testid="nav-jobs" data-label="Vagas publicadas">
                        <span class="sidebar-link__icon"><Icon Name="search" /></span><span>Vagas publicadas</span>
                    </NavLink>
                    <span class="sidebar-nav__label sidebar-nav__label--spaced">Conta da empresa</span>
                    <NavLink class="sidebar-link" href="/minha-assinatura" data-label="Plano e assinatura">
                        <span class="sidebar-link__icon"><Icon Name="banknote" /></span><span>Plano e assinatura</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/conta" Match="NavLinkMatch.Prefix" data-label="Conta e segurança">
                        <span class="sidebar-link__icon"><Icon Name="shield" /></span><span>Conta e segurança</span>
                    </NavLink>
                }
                else if (IsCandidate)
                {
                    <span class="sidebar-nav__label">Minha carreira</span>
                    <NavLink class="@HomeLinkClass" href="/" Match="NavLinkMatch.All" data-testid="nav-dashboard" data-label="Início">
                        <span class="sidebar-link__icon"><Icon Name="home" /></span><span>Início</span>
                    </NavLink>
                    <NavLink class="@SectionClass(IsPublicJobsPath)" href="/jobs" data-testid="nav-jobs" data-label="Explorar vagas">
                        <span class="sidebar-link__icon"><Icon Name="search" /></span><span>Explorar vagas</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/minhas-candidaturas" data-testid="nav-applications" data-label="Minhas candidaturas">
                        <span class="sidebar-link__icon"><Icon Name="send" /></span><span>Minhas candidaturas</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/curriculos" data-label="Meus currículos">
                        <span class="sidebar-link__icon"><Icon Name="file" /></span><span>Meus currículos</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/perfil-profissional" data-label="Perfil de carreira">
                        <span class="sidebar-link__icon"><Icon Name="sparkles" /></span><span>Perfil de carreira</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/notifications" data-label="Notificações">
                        <span class="sidebar-link__icon"><Icon Name="bell" /></span><span>Notificações</span>
                    </NavLink>
                    <span class="sidebar-nav__label sidebar-nav__label--spaced">Minha conta</span>
                    <NavLink class="sidebar-link" href="/conta" Match="NavLinkMatch.Prefix" data-label="Conta e segurança">
                        <span class="sidebar-link__icon"><Icon Name="shield" /></span><span>Conta e segurança</span>
                    </NavLink>
                }
                else if (!IsAdmin)
                {
                    <NavLink class="@SectionClass(IsPublicJobsPath)" href="/jobs" data-testid="nav-jobs" data-label="Vagas">
                        <span class="sidebar-link__icon"><Icon Name="search" /></span><span>Vagas</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/notifications" data-label="Notificações">
                        <span class="sidebar-link__icon"><Icon Name="bell" /></span><span>Notificações</span>
                    </NavLink>
                }

                @if (IsAdmin)
                {
                    <span class="sidebar-nav__label@(IsAdminOnly ? string.Empty : " sidebar-nav__label--spaced")">Administração</span>
                    @if (IsAdminOnly)
                    {
                        <NavLink class="@HomeLinkClass" href="/" Match="NavLinkMatch.All" data-testid="nav-dashboard" data-label="Visão geral">
                            <span class="sidebar-link__icon"><Icon Name="home" /></span><span>Visão geral</span>
                        </NavLink>
                    }
                    <NavLink class="sidebar-link" href="/admin/contas" data-testid="nav-admin-accounts" data-label="Contas">
                        <span class="sidebar-link__icon"><Icon Name="shield" /></span><span>Contas</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/admin/vagas" data-testid="nav-admin-jobs" data-label="Vagas">
                        <span class="sidebar-link__icon"><Icon Name="briefcase" /></span><span>Vagas</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/admin/sugestoes" data-testid="nav-admin-submissions" data-label="Sugestões">
                        <span class="sidebar-link__icon"><Icon Name="file" /></span><span>Sugestões</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/admin/candidatos" data-label="Candidatos">
                        <span class="sidebar-link__icon"><Icon Name="users" /></span><span>Candidatos</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/admin/empresas" data-label="Empresas">
                        <span class="sidebar-link__icon"><Icon Name="building" /></span><span>Empresas</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/admin/provedores-ia" data-testid="nav-admin-ai-providers" data-label="Provedores de IA">
                        <span class="sidebar-link__icon"><Icon Name="sparkles" /></span><span>Provedores de IA</span>
                    </NavLink>
                    <NavLink class="sidebar-link" href="/admin/auditoria" data-testid="nav-admin-audit" data-label="Auditoria">
                        <span class="sidebar-link__icon"><Icon Name="clock" /></span><span>Auditoria</span>
                    </NavLink>
                    @if (IsAdminOnly)
                    {
                        <span class="sidebar-nav__label sidebar-nav__label--spaced">Descobrir</span>
                        <NavLink class="@SectionClass(IsPublicJobsPath)" href="/jobs" data-testid="nav-jobs" data-label="Vagas publicadas">
                            <span class="sidebar-link__icon"><Icon Name="search" /></span><span>Vagas publicadas</span>
                        </NavLink>
                    }
                }
            </nav>

            <div class="app-sidebar__bottom">
                @* Identidade da conta: o perfil fica aqui, sem item repetido no menu *@
                <NavLink class="profile-link" href="@ProfileHref" data-label="@ProfileLabel">
                    <span class="avatar" aria-hidden="true">@initials</span>
                    <span class="profile-link__copy">
                        <strong>@displayName</strong>
                        <small>@ProfileLabel</small>
                    </span>
                    <span class="profile-link__arrow"><Icon Name="chevron-right" Size="16" /></span>
                </NavLink>
                <form class="sidebar-logout" action="/Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="/" />
                    <button type="submit" class="sidebar-logout__btn" data-label="Sair" data-testid="nav-logout">
                        <span class="sidebar-link__icon"><Icon Name="log-out" /></span>
                        <span class="sidebar-logout__text">Sair</span>
                    </button>
                </form>
            </div>
        </aside>
        <button class="sidebar-scrim" type="button" aria-label="Fechar menu" tabindex="-1"></button>
        }

        <div class="app-stage">
            @if (isAuthenticated)
            {
            <header class="app-topbar">
                <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="app-sidebar" aria-label="Abrir menu" data-testid="mobile-menu-toggle">
                    <Icon Name="menu" Size="20" />
                </button>
                <nav class="app-topbar__trail" aria-label="Você está em">
                    <ol class="trail" data-testid="trail">
                        @{
                            var trail = Trail;
                        }
                        @for (var index = 0; index < trail.Count; index++)
                        {
                            var item = trail[index];
                            var isLast = index == trail.Count - 1;
                            <li class="trail__item" aria-current="@(isLast ? "page" : null)">
                                @if (!isLast && item.Href is not null)
                                {
                                    <a href="@item.Href">@item.Label</a>
                                }
                                else
                                {
                                    <span>@item.Label</span>
                                }
                            </li>
                        }
                    </ol>
                </nav>
                <div class="app-topbar__actions">
                    <ThemeToggle />
                    @if (IsAdvertiser)
                    {
                        <a class="btn btn-primary btn-sm topbar-publish" href="/vagas/nova" aria-label="Publicar vaga" data-testid="topbar-publish"><Icon Name="plus" Size="16" /><span class="topbar-publish__text">Publicar vaga</span></a>
                    }
                </div>
            </header>
            }
            else
            {
            <header class="public-header">
                <Brand />
                <nav class="public-nav" aria-label="Navegação principal">
                    <a href="/entrar">Entrar</a>
                    <a class="btn btn-primary btn-sm" href="/criar-conta">Criar conta</a>
                </nav>
                <ThemeToggle />
            </header>
            }

            <main id="main" class="app-main">
                @Body
            </main>

            @* Ilha interativa: toasts disparados pelas páginas (mesmo circuito, mesmo IToastService) *@
            <ToastHost @rendermode="InteractiveServer" />

            @* Rodapé enxuto e centralizado: marca, uma linha de links (conforme o papel) e os créditos *@
            <footer class="site-footer">
                <div class="site-footer__inner">
                    <Brand />
                    <nav class="site-footer__nav" aria-label="Rodapé">
                        <a href="/jobs">Buscar vagas</a>
                        @if (IsCandidate)
                        {
                            <a href="/minhas-candidaturas">Minhas candidaturas</a>
                            <a href="/curriculos">Meus currículos</a>
                        }
                        @if (IsAdvertiser)
                        {
                            <a href="/vagas/nova">Publicar vaga</a>
                            <a href="/candidaturas-recebidas">Candidaturas recebidas</a>
                        }
                        @if (!isAuthenticated)
                        {
                            <a href="/criar-conta?AccountType=advertiser">Para empresas</a>
                        }
                        <a href="/plans">Planos</a>
                        <a href="/termos">Termos de uso</a>
                        <a href="/privacidade">Privacidade</a>
                    </nav>
                    <p class="site-footer__legal">© @DateTime.Now.Year Monburan · Vagas de emprego e recrutamento</p>
                </div>
            </footer>
        </div>
    </div>
}

<ReconnectScreen />

<div id="blazor-error-ui" class="alert alert-danger" role="alert" style="display: none;">
    Algo inesperado aconteceu.
    <a href="" class="reload">Recarregar</a>
    <button type="button" class="dismiss" aria-label="Fechar aviso">×</button>
</div>

@code {
    private string currentUserType = string.Empty;
    private bool isAdmin;
    private bool isAuthenticated;
    private string displayName = string.Empty;
    private string initials = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // Layout "auth" só nas páginas de entrada: o gerenciamento da conta usa o app shell normal
    private bool IsAccountPage =>
        AuthRoutes.IsAuthPage(CurrentPath);
    private bool IsAdvertiser => string.Equals(currentUserType, "advertiser", StringComparison.OrdinalIgnoreCase);
    private bool IsCandidate => string.Equals(currentUserType, "candidate", StringComparison.OrdinalIgnoreCase);
    private bool IsAdmin => isAdmin;
    private bool IsAdminOnly => IsAdmin && !IsAdvertiser && !IsCandidate;

    private NavRole Role => IsAdvertiser ? NavRole.Advertiser : IsCandidate ? NavRole.Candidate : IsAdmin ? NavRole.Admin : NavRole.Visitor;
    private IReadOnlyList<TrailItem> Trail => NavigationTrail.For(CurrentPath, Role);

    private string ProfileHref => IsAdvertiser ? "/perfil/empresa" : IsCandidate ? "/perfil/candidato" : "/conta";
    private string ProfileLabel => IsAdvertiser ? "Perfil da empresa" : IsCandidate ? "Meu perfil" : "Minha conta";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            isAuthenticated = user.Identity?.IsAuthenticated == true;
            currentUserType = user.FindFirst(Monburan.Web.Services.ClaimsExtensions.UserTypeClaimType)?.Value ?? string.Empty;
            isAdmin = user.IsInRole("Admin");
            displayName = user.GetDisplayName();
            initials = user.GetInitials();
        }
    }

    // "/" e "/painel" são a mesma página: o item de início fica ativo nas duas
    private string HomeLinkClass => SectionClass(CurrentPath is "/" or "/painel");

    // Item ativo também nas subpáginas da seção (o NavLink só marca o endereço exato)
    private static string SectionClass(bool active) => active ? "sidebar-link active" : "sidebar-link";

    private bool IsRecruitJobsPath =>
        CurrentPath.StartsWith("/minhas-vagas", StringComparison.OrdinalIgnoreCase)
        || CurrentPath.StartsWith("/vagas/nova", StringComparison.OrdinalIgnoreCase)
        || (CurrentPath.StartsWith("/vagas/", StringComparison.OrdinalIgnoreCase) && CurrentPath.EndsWith("/editar", StringComparison.OrdinalIgnoreCase));

    private bool IsReceivedPath =>
        CurrentPath.StartsWith("/candidaturas-recebidas", StringComparison.OrdinalIgnoreCase)
        || (CurrentPath.StartsWith("/vagas/", StringComparison.OrdinalIgnoreCase) && CurrentPath.EndsWith("/candidaturas", StringComparison.OrdinalIgnoreCase));

    // Lista pública, página da vaga e da empresa (fora do fluxo de recrutamento)
    private bool IsPublicJobsPath =>
        !IsRecruitJobsPath && !IsReceivedPath
        && (CurrentPath.Equals("/jobs", StringComparison.OrdinalIgnoreCase)
            || CurrentPath.StartsWith("/jobs/", StringComparison.OrdinalIgnoreCase)
            || CurrentPath.StartsWith("/empresas/", StringComparison.OrdinalIgnoreCase)
            || CurrentPath.StartsWith("/candidatar/", StringComparison.OrdinalIgnoreCase));

    private string CurrentPath => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
        .Split('?', '#')[0]
        .Trim('/');
}
