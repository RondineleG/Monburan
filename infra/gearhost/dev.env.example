# Configurações do ambiente de homologação para o deploy local (deploy-dev.sh).
# Copie para dev.env (fica fora do Git) e preencha. Os mesmos valores ficam no environment "dev" do GitHub.

# Banco Neon no formato do Npgsql (não a URL postgresql://)
DB_CONNECTION="Host=<host>.neon.tech;Database=neondb;Username=<usuario>;Password=<senha>;SSL Mode=Require;Channel Binding=Require"

# Chave de assinatura dos tokens do app: openssl rand -base64 48
JWT_SIGNING_KEY=""

# Senha de todas as contas da massa de demonstração (mínimo 10 caracteres, com maiúscula, minúscula e número)
SEED_PASSWORD=""
