# ============================================================
# Monburan — Chaves dos provedores de IA (VPS)
# Copie para ai-keys.env, preencha e proteja. NUNCA commite o ai-keys.env preenchido.
#
#   cp ai-keys.env.example ai-keys.env
#   chmod 600 ai-keys.env
#   docker compose up -d --force-recreate app     # recria o contêiner para ele ler as variáveis
#
# Uma linha por provedor, no formato NOME=chave, sem aspas nem espaços. O NOME tem de começar com AI_KEY_ e usar só letras
# MAIÚSCULAS, números e sublinhado: é esse nome que o administrador informa na tela "Provedores de IA". Variáveis fora desse
# padrão são ignoradas pelo app, então um provedor cadastrado nunca consegue ler a senha do banco nem a chave do JWT.
# Provedor sem a variável aparece como "chave não definida" e não é usado.
# ============================================================

AI_KEY_XIAOMI=
AI_KEY_OPENROUTER=
AI_KEY_DEEPSEEK=
AI_KEY_ANTHROPIC=
AI_KEY_OPENAI=
