# ============================================================
# Monburan — Variáveis de ambiente de produção (VPS)
# Copie para .env e preencha. NUNCA commite o .env preenchido.
#
#   cp env.example .env
#   chmod 600 .env
# ============================================================

# --- Banco de Postgres (rede interna do compose) ---
DB_NAME=monburan
DB_USER=monburan
DB_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_AQUI

# --- Segurança JWT (obrigatório) ---
# Gere com: openssl rand -base64 48
JWT_SIGNING_KEY=TROQUE_POR_UMA_CHAVE_ALEATORIA_AQUI

# --- Base pública (links de e-mail de confirmação/reset) ---
APP_PUBLIC_BASE_URL=https://monburan.com.br

# --- E-mail via SMTP (Resend) ---
# Se SMTP_PASSWORD vazio, o app desativa envio de e-mail (log de aviso).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@monburan.com.br
SMTP_FROM_NAME=Monburan

# --- Administradores (por e-mail) ---
# E-mails, separados por vírgula, que viram administradores quando a conta tem o e-mail CONFIRMADO. É o que libera as telas de
# administração (por exemplo "Provedores de IA") em produção: cadastre-se no site, confirme o e-mail e coloque-o aqui.
# Tirar um e-mail daqui tira o acesso no próximo login.
ADMIN_EMAILS=

# --- IA ---
# As chaves dos provedores NÃO ficam neste arquivo: vão em ai-keys.env (modelo em ai-keys.env.example). O endereço, o modelo
# e o nome da variável de cada provedor o administrador cadastra na tela "Provedores de IA" (docs/IA-PROVEDORES.md).
