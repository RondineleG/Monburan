# ============================================================
# Monburan — Configuração do backup (VPS)
# Copie para /opt/monburan/backup.env e preencha. NUNCA commite o backup.env preenchido.
#
#   cp backup.env.example backup.env
#   chmod 600 backup.env
# ============================================================

# URI do banco na nuvem para o pg_dump (mesmo banco do DB_CONNECTION do .env, mas em formato de URI, que é o que o
# pg_dump entende). No Neon, copie a "connection string" e troque o início para postgresql://. Ex.:
#   postgresql://monburan:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/monburan?sslmode=require&channel_binding=require
BACKUP_DB_URL=

# Chave PÚBLICA do age. Gere o par FORA da VPS (age-keygen -o chave-privada.txt); a linha "Public key: age1..." vai aqui.
# A chave privada (chave-privada.txt) NÃO entra na VPS: guarde-a no gerenciador de senhas e em uma cópia offline.
BACKUP_AGE_RECIPIENT=

# Destino do rclone (configure antes com: rclone config). Exemplos: b2:monburan-backups/vps1  |  s3:meu-bucket/monburan
# Vazio: o backup fica só no disco da VPS (protege de erro, não da perda do servidor) e o script avisa a cada execução.
BACKUP_REMOTE=

# Quantos dias guardar: na VPS e no armazenamento remoto
KEEP_LOCAL_DAYS=7
KEEP_REMOTE_DAYS=30

# Inclui a pasta de uploads do app (currículos e logos) e as imagens das sugestões de vaga no backup
BACKUP_UPLOADS=true

# Opcional: imagem do PostgreSQL usada para o pg_dump. Precisa ser da MESMA versão maior do servidor ou mais nova
# (o pg_dump não lê servidores mais novos que ele). Padrão: postgres:18-alpine
BACKUP_PG_IMAGE=

# Opcional: URL de um monitor (healthchecks.io, por exemplo) que avisa quando o backup falha ou para de rodar
HEALTHCHECK_URL=
