# ============================================================
# Monburan — Configuração do backup (VPS)
# Copie para /opt/monburan/backup.env e preencha. NUNCA commite o backup.env preenchido.
#
#   cp backup.env.example backup.env
#   chmod 600 backup.env
# ============================================================

# Chave PÚBLICA do age. Gere o par FORA da VPS (age-keygen -o chave-privada.txt); a linha "Public key: age1..." vai aqui.
# A chave privada (chave-privada.txt) NÃO entra na VPS: guarde-a no gerenciador de senhas e em uma cópia offline.
BACKUP_AGE_RECIPIENT=

# Destino do rclone (configure antes com: rclone config). Exemplos: b2:monburan-backups/vps1  |  s3:meu-bucket/monburan
BACKUP_REMOTE=

# Quantos dias guardar: na VPS e no armazenamento remoto
KEEP_LOCAL_DAYS=7
KEEP_REMOTE_DAYS=30

# Inclui a pasta de uploads do app (currículos e logos) no backup
BACKUP_UPLOADS=true

# Opcional: URL de um monitor (healthchecks.io, por exemplo) que avisa quando o backup falha ou para de rodar
HEALTHCHECK_URL=
